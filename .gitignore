node_modules/
dist/
dist-single/
*.tsbuildinfo
.DS_Store
framework/node_modules/
__pycache__/
.axf-console/
# console-control inventory: generated from each plugin's registered targets (apps/console-web/scripts/control-inventory.mjs),
# published to axf-data as the control_targets table; never hand-edited, never committed (builds used to clash on it)
apps/console-web/src/control/inventory.json

# Synced copies of /projects/_shared/_claude (claude-sync); committed once, at the repo root (_claude/shared/)
apps/*/_claude/shared/
projects/*/_claude/shared/

# Session check-in (plugin): per-clone install + settings backups
.claude/*.local.json
.claude/*.bak

# Boilerplate screenshot runs generate these in CI (boilerplate-shots.yml); never commit them
apps/shots-*/

# Build agents' git worktrees in the console checkout (agent-manager gittools, Oct 28 2026)
.mosses/
_claude/builds/store.json.exports.json
_claude/builds/store.json.lock
_claude/builds/store.json.tmp-*

# Watch live previews (framework/cli/watch-live.mjs): focus file, generated Vite configs + caches, watcher log
.axf-focus.json
.axf-preview*
.axf-watch-live.log

# Per-build Claude login copies (deploy/claude-login.mjs): private, deleted when the build ends, never committed
.axf-claude/
_claude/builds/store.json.live-outbox.jsonl*
_claude/builds/store.json.live.json

# Auto-land (push banner): a finished worktree claude-sync leaves alone
.claude-sync-hold

# builds journal (builds-journal@1): lives on the hub data store (/projects/amberx-axf/_data/builds/journal); the repo
# folder is only the spool and the old parts until the migration untracks them
_claude/builds/journal/

# Retired pipeline status file (Nov 25 2026): build status lives in the builds store on Postgres. Never committed again;
# framework/spec/check-no-pipeline-status-file.mjs fails CI if it comes back.
_claude/builds/orchestrator.json
_claude/builds/profiles/*/orchestrator.json
