{
  "$axf": "asset@1",
  "type": "themed-controls",
  "id": "native",
  "name": "Native",
  "version": "0.1.0",
  "description": "Today's look, written out: an accent-coloured mark on a surface box with the theme border, the focus ring, an accent-soft hover wash, a surface3 track with an accent fill, the text field's borders and ring. Switching the plugin on changes behaviour, not the look.",
  "author": "AmberX AXF",
  "tags": [
    "controls",
    "default"
  ],
  "data": {
    "checkbox": {
      "size": 16,
      "radius": "sm",
      "rest": { "bg": "surface", "border": "border" },
      "hover": { "border": "muted" },
      "focus": { "border": "accent", "ring": "focus" },
      "active": { "bg": "accentSoft", "border": "accent" },
      "checked": { "bg": "accent", "border": "accent", "mark": "accentText" },
      "invalid": { "border": "danger" }
    },
    "radio": {
      "size": 16,
      "dotScale": 50,
      "rest": { "bg": "surface", "border": "border" },
      "hover": { "border": "muted" },
      "focus": { "border": "accent", "ring": "focus" },
      "active": { "bg": "accentSoft", "border": "accent" },
      "checked": { "bg": "surface", "border": "accent", "mark": "accent" },
      "invalid": { "border": "danger" }
    },
    "range": {
      "trackHeight": 4,
      "thumbSize": 16,
      "showValue": "drag",
      "ticks": true,
      "rest": { "track": "surface3", "fill": "accent", "thumb": "accent", "thumbBorder": "surface" },
      "focus": { "ring": "focus" },
      "active": { "thumb": "accent", "thumbBorder": "accentSoft" },
      "disabled": { "fill": "muted", "thumb": "muted" },
      "invalid": { "fill": "danger", "thumb": "danger" }
    },
    "number": {
      "stepper": "ends",
      "stepperWidth": 28,
      "repeatDelayMs": 400,
      "repeatMs": 80,
      "rest": { "bg": "surface", "border": "border", "text": "text", "stepperBg": "surface2", "stepperIcon": "muted" },
      "hover": { "border": "muted", "stepperBg": "surface3", "stepperIcon": "text" },
      "focus": { "border": "accent", "ring": "accentSoft" },
      "active": { "stepperBg": "accentSoft", "stepperIcon": "accent" },
      "disabled": { "text": "muted" },
      "invalid": { "border": "danger" }
    },
    "datetime": {
      "cellSize": 36,
      "cellRadius": "md",
      "surfaceRadius": "md",
      "weekStart": "locale",
      "hourCycle": "locale",
      "minuteStep": 5,
      "rest": { "surface": "surface", "text": "text", "border": "border", "muted": "muted" },
      "hover": { "cellBg": "accentSoft" },
      "focus": { "cellBorder": "accent", "ring": "focus" },
      "selected": { "cellBg": "accent", "cellText": "accentText", "cellBorder": "accent" },
      "today": { "cellText": "accent", "cellBorder": "accent" },
      "disabled": { "cellText": "muted" },
      "invalid": { "border": "danger" }
    },
    "color": {
      "swatchSize": 24,
      "swatchRadius": "sm",
      "surfaceRadius": "md",
      "recent": 8,
      "themeSwatches": true,
      "areaHeight": 140,
      "rest": { "surface": "surface", "text": "text", "border": "border", "swatchBorder": "border" },
      "hover": { "swatchBorder": "muted" },
      "focus": { "swatchBorder": "accent", "ring": "focus" },
      "selected": { "swatchBorder": "accent", "check": "accentText" },
      "invalid": { "border": "danger" }
    },
    "dialogs": {
      "width": 420,
      "radius": "lg",
      "okTone": "primary",
      "cancelTone": "neutral",
      "icon": true,
      "selectText": true,
      "surface": { "bg": "surface", "text": "text", "border": "border" },
      "title": { "text": "text", "icon": "accent" },
      "message": { "text": "muted" },
      "field": { "bg": "surface", "border": "border", "text": "text" },
      "focus": { "ring": "focus", "border": "accent" }
    },
    "file": {
      "minHeight": 120,
      "radius": "md",
      "borderStyle": "dashed",
      "borderWidth": "2",
      "progressHeight": 6,
      "showList": true,
      "rest": { "bg": "surface2", "border": "border", "text": "muted", "icon": "muted" },
      "hover": { "bg": "surface3", "border": "muted", "text": "text", "icon": "text" },
      "focus": { "border": "accent", "ring": "focus" },
      "active": { "bg": "accentSoft", "border": "accent" },
      "dragover": { "bg": "accentSoft", "border": "accent", "text": "accent", "icon": "accent" },
      "disabled": { "text": "muted", "icon": "muted" },
      "invalid": { "border": "danger", "text": "danger", "icon": "danger" },
      "progress": { "track": "surface3", "fill": "accent", "done": "success", "failed": "danger" }
    },
    "tooltip": {
      "delayMs": 500,
      "hideMs": 100,
      "longPressMs": 500,
      "maxWidth": 280,
      "radius": "md",
      "placement": "top",
      "arrow": false,
      "rest": { "bg": "surface", "text": "text", "border": "accent" }
    },
    "scrollbar": {
      "width": 10,
      "radius": "pill",
      "thin": false,
      "autoHide": false,
      "gutter": "auto",
      "thumb": { "bg": "muted" },
      "thumbHover": { "bg": "text" },
      "thumbActive": { "bg": "accent" }
    }
  }
}
