{
  "$axf": "asset@1",
  "type": "behavior-theme",
  "id": "standard",
  "name": "Standard",
  "version": "1.0.0",
  "description": "How AmberX apps have always behaved: the style theme's motion, soft fades, tinted hover, toasts at the bottom, a confirm before deleting what can't be undone.",
  "author": "AmberX AXF",
  "tags": [
    "default"
  ],
  "data": {
    "motion": {
      "speed": "theme",
      "easing": "standard",
      "reduced": "system",
      "entrance": "theme"
    },
    "interaction": {
      "hover": "theme",
      "press": "theme",
      "focusRing": "auto",
      "cursor": "pointer",
      "longPressMs": 550,
      "doubleTapMs": 300,
      "dragThreshold": 10
    },
    "windows": {
      "dialogOpen": "asset",
      "backdrop": "asset",
      "popupOpen": "asset",
      "drawerOpen": "asset",
      "snap": false,
      "snapGrid": 8,
      "stack": "cascade",
      "minimize": "cursor",
      "closeOnBackdrop": true,
      "closeOnEscape": true
    },
    "feedback": {
      "toastPosition": "asset",
      "toastMs": 0,
      "sound": "off",
      "vibration": "off",
      "confirmDelete": "risky",
      "busyCursor": true
    }
  }
}
