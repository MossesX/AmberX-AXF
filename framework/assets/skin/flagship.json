{
  "$axf": "asset@1",
  "version": "1.0.0",
  "author": "AmberX AXF",
  "type": "skin",
  "id": "flagship",
  "name": "Flagship",
  "description": "The flagship professional skin: one product look for the console, axHub web and AmberX. Covers colours (light + dark), style, type, layout, every menu and chrome kind, banners and widgets, grids, dialogs, settings, motion, behaviour and hooks.",
  "tags": [
    "flagship",
    "professional",
    "skin",
    "compact"
  ],
  "data": {
    "layoutTheme": "flagship",
    "colorTheme": "flagship-dark",
    "colorThemes": {
      "light": "flagship-light",
      "dark": "flagship-dark"
    },
    "styleTheme": "flagship",
    "behaviorTheme": "standard",
    "assets": {
      "typography": "flagship",
      "density": "flagship",
      "sizing": "flagship",
      "context-menu": "flagship",
      "app-menu": "flagship",
      "nav-menu": "flagship",
      "nav-style": "flagship",
      "tab-group": "flagship",
      "toolbar": "flagship"
    },
    "preview": {
      "caption": "Blue-black and amber, compact, quiet motion: one product across console, axHub and AmberX."
    },
    "iconPack": "amberx-outline",
    "extras": {
      "spacing": "compact",
      "hidden": {
        "banner": false,
        "app-menu": false,
        "toolbar": false,
        "nav-menu": false
      }
    },
    "behavior": {
      "tapConfirm": {
        "armMs": 3000,
        "toolbar": "on",
        "tab-group": "on",
        "nav-menu": "on",
        "app-menu": "on",
        "context-menu": "on",
        "banner": "on"
      },
      "overflow": {
        "tab-group": "more"
      },
      "sticky": {
        "tab-group": true
      },
      "collapse": {
        "toolbar": true
      }
    }
  }
}
