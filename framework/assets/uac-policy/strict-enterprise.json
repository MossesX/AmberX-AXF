{
  "$frame": "asset@1",
  "type": "uac-policy",
  "id": "strict-enterprise",
  "name": "Strict Enterprise",
  "version": "1.0.0",
  "description": "Read-only by default; anything you cannot use is hidden.",
  "author": "Frame",
  "tags": [],
  "data": {
    "defaultRole": "viewer",
    "gating": "hide",
    "permissions": {
      "assets.swap": "Hot-swap UI assets",
      "assets.import": "Import new assets",
      "uac.manage": "Change the account control policy",
      "files.write": "Save, export and delete files",
      "dev.tools": "Build and open the developer console",
      "dev.deploy": "Deploy the application"
    },
    "roles": [
      {
        "id": "viewer",
        "label": "Viewer",
        "description": "Read-only. Cannot change the look.",
        "permissions": []
      },
      {
        "id": "editor",
        "label": "Editor",
        "description": "Can theme and write files.",
        "permissions": [
          "assets.swap",
          "files.write"
        ]
      },
      {
        "id": "owner",
        "label": "Owner",
        "description": "Full control.",
        "permissions": [
          "*"
        ]
      }
    ]
  }
}
