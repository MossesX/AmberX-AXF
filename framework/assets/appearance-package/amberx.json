{
  "$axf": "asset@1",
  "type": "appearance-package",
  "id": "amberx",
  "name": "AmberX",
  "version": "1.0.0",
  "description": "AmberX: the framework's default look (Arctic Daylight + Glass Orbit), super-tight spacing, top toolbar hidden.",
  "author": "AmberX AXF",
  "tags": [],
  "data": {
    "slots": {
      "color-theme": "arctic-daylight",
      "style-theme": "glass-orbit",
      "layout": "classic-ide",
      "app-menu": "standard-desktop",
      "toolbar": "standard-icons",
      "nav-menu": "sidebar-list",
      "context-menu": "compact-classic",
      "tab-group": "underline",
      "dialog": "centered-modal",
      "popup": "corner-solid",
      "button": "rounded-solid",
      "slider": "classic-round",
      "container": "soft-card",
      "gauge": "classic-arc",
      "meter": "striped-pill",
      "banner": "amberx-thin",
      "clock": "digital-12h",
      "search-bar": "everything",
      "logo": "wordmark",
      "action-button": "settings",
      "label": "version",
      "status": "online",
      "counter": "alerts",
      "progress": "build",
      "avatar": "account",
      "link": "docs",
      "theme-switch": "day-night",
      "spacer": "gap",
      "divider": "rule",
      "badge": "new",
      "settings": "standard"
