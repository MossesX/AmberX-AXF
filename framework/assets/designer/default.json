{
  "$axf": "asset@1",
  "type": "designer",
  "id": "default",
  "name": "Designer interface (default)",
  "version": "1.0.0",
  "description": "The shared designer interface (designer@1): how every UI asset designer screen is laid out and behaves — canvas, panels, preview, info, context-menu sections, history, output, voice, autosave. Every add-on (app-menu, nav-menu, toolbar, banner, embed, widget) has its own copy named after it that follows this one until edited.",
  "author": "AmberX AXF",
  "tags": [
    "default",
    "designer"
  ],
  "data": {
    "for": "host",
    "canvas": {
      "mode": "both",
      "grid": 8,
      "snap": true,
      "zoomMin": 25,
      "zoomMax": 400,
      "rulers": false,
      "guides": true
    },
    "panels": {
      "library": "left",
      "layers": "left",
      "inspector": "right",
      "preview": "bottom",
      "help": "right",
      "history": "hidden"
    },
    "preview": {
      "mode": "docked",
      "device": "both",
      "refresh": "live"
    },
    "info": {
      "tooltip": true,
      "hoverCard": true,
      "sidePanel": true,
      "helpText": true,
      "say": false
    },
    "context": {
      "preview": true,
      "insert": true,
      "arrange": true,
      "clipboard": true,
      "help": true
    },
    "history": {
      "limit": 100,
      "coalesceMs": 400
    },
    "output": {
      "to": "app",
      "idPrefix": "",
      "register": true,
      "version": "patch"
    },
    "voice": true,
    "autosave": true
  }
}
