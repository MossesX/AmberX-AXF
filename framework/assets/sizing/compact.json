{
  "$axf": "asset@1",
  "type": "sizing",
  "id": "compact",
  "name": "Compact",
  "version": "1.0.0",
  "description": "The framework's own component sizes (Oct 30 2026): 2.1-line buttons, small square-cornered chips, md-radius cards, 2-line page descriptions. Every value is the default.",
  "author": "AmberX AXF",
  "tags": [
    "compact",
    "default"
  ],
  "data": {
    "button": {
      "height": 2.1,
      "padX": 1.2,
      "font": 0.88,
      "icon": 1
    },
    "iconButton": {
      "size": 1.75
    },
    "chip": {
      "height": 1.6,
      "padX": 0.9,
      "font": 0.78,
      "radius": "sm"
    },
    "field": {
      "height": 2.2,
      "padX": 0.75,
      "font": 0.92
    },
    "tab": {
      "padY": 0.8,
      "padX": 1.2,
      "font": 0.9
    },
    "segment": {
      "padY": 0.4,
      "padX": 1.1,
      "font": 0.86
    },
    "card": {
      "pad": 1.6,
      "headFont": 0.92,
      "radius": "md"
    },
    "listRow": {
      "minHeight": 2.75,
      "padX": 1.25,
      "metaFont": 0.82
    },
    "countStrip": {
      "number": 1.1,
      "label": 0.71,
      "pad": 0.5
    },
    "table": {
      "padY": 0.75,
      "padX": 1.25,
      "font": 0.9
    },
    "pageHead": {
      "descriptionFont": 0.92,
      "descriptionLines": 2
    }
  }
}
