{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axf/plugin.schema.json",
  "title": "AmberX AXF plugin manifest (plugin@1)",
  "type": "object",
  "required": ["$axf", "id", "name", "version", "kind", "apiLevel"],
  "properties": {
    "$axf": { "const": "plugin@1" },
    "id": { "type": "string", "description": "namespaced, e.g. com.example.myplugin" },
    "name": { "type": "string" },
    "version": { "type": "string" },
    "kind": { "enum": ["pack", "module", "script"] },
    "apiLevel": { "type": "integer", "minimum": 1 },
    "minFrameworkVersion": { "type": "string" },
    "author": { "type": "string" },
    "description": { "type": "string" },
    "provides": { "type": "array", "items": { "type": "string" } },
    "requires": { "type": "array", "items": { "type": "string" } },
    "scopes": { "type": "array", "items": { "enum": ["assets", "actions", "routes", "settings", "menu_items", "network", "files", "notifications", "background", "device", "identity", "billing"] } },
    "entry": { "type": "string", "description": "module: entry class; pack: entry asset or macro id" },
    "targets": { "type": "array", "items": { "type": "string" }, "description": "host app ids, * for any" },
    "signed": { "type": "boolean" }
  }
}
