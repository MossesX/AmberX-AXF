    "repo:_claude/builds/store.json.live-outbox.jsonl": null,
    "projects:amberx-axf/_data/agent-slots/state.json": "console/agent-slots/state.json",
    "projects:amberx-axf/_data/agent-slots/build-limit.json": "console/agent-slots/build-limit.json",
