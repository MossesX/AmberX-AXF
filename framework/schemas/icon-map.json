                  "badge",
                  "logo"
                ]
              },
              "role": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "glyph": {
                "type": "string"
              },
              "screen": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "pins": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
