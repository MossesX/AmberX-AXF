            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*\\/[a-z0-9][a-z0-9_-]*\\/[a-z0-9][a-z0-9-]*\\/[a-z0-9][a-z0-9_.-]*$"
              },
              "name": {
