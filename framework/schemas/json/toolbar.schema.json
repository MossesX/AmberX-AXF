{
  "$defs": {
    "widgetHint": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "size": {
          "enum": [
            "icon",
            "compact",
            "normal",
            "wide"
          ]
        },
        "show": {
          "enum": [
            "auto",
            "both",
            "icon",
            "text",
            "number"
          ]
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        },
        "hideWhenEmpty": {
          "type": "boolean"
        },
        "overflow": {
          "type": "boolean"
        },
        "hidden": {
          "type": "boolean"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "shape": {
          "enum": [
            "circle",
            "square",
            "rounded",
            "pill",
            "hexagon",
            "custom"
          ],
          "description": "The outline the widget is clipped to (default circle)."
        },
        "customPath": {
          "type": "string",
          "maxLength": 400,
          "description": "SVG path in a 0..100 square (commands M L H V C S Q T A Z), shape custom only."
        },
        "iconOverride": {
          "type": "object",
          "required": [
            "pack",
            "id"
          ],
          "properties": {
            "pack": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{1,47}$"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
            }
          },
          "additionalProperties": false,
          "description": "Draw this glyph of this icon pack instead of the widget's own icon."
        }
      },
      "additionalProperties": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axf/toolbar.schema.json",
  "title": "AmberX AXF Toolbar asset",
  "type": "object",
  "required": [
    "$axf",
    "type",
    "id",
    "name",
    "version",
    "data"
  ],
  "properties": {
    "$axf": {
      "const": "asset@1"
    },
    "type": {
      "const": "toolbar"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "variant",
        "align",
        "groups",
        "showSearch"
      ],
      "properties": {
        "variant": {
          "enum": [
            "icons",
            "icons-labels",
            "labels"
          ]
        },
        "align": {
          "enum": [
            "start",
            "center",
            "spread"
          ]
        },
        "groups": {},
        "showSearch": {},
        "widgets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "id",
              "at"
            ],
            "properties": {
              "type": {
                "enum": [
                  "clock",
                  "search-bar",
                  "action-button",
                  "logo",
                  "label",
                  "status",
                  "counter",
                  "progress",
                  "avatar",
                  "link",
                  "theme-switch",
                  "spacer",
                  "divider"
                ]
              },
              "id": {
                "type": "string"
              },
              "at": {
                "enum": [
                  "start",
                  "end"
                ]
              },
              "order": {
                "type": "number"
              },
              "widget": {
                "$ref": "#/$defs/widgetHint"
              }
            }
          }
        }
      }
    }
  }
}
