{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amberx.ai/axf/schemas/pipeline-2.schema.json",
  "title": "pipeline-2@1: Pipeline 2.0 build and step status (the contract fields of a builds@1 record)",
  "description": "framework/spec/PIPELINE-2.md. Only the contract's fields are described; a builds@1 build carries its other fields as before. Enums are checked against framework/core/pipeline-status.mjs by framework/spec/check-pipeline-2.mjs.",
  "type": "object",
  "required": ["id", "flow", "status", "statusAt", "statusBy", "steps"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 80 },
    "flow": { "const": "pipeline-2" },
    "status": { "$ref": "#/$defs/buildStatus" },
    "statusAt": { "type": "string", "format": "date-time" },
    "statusBy": { "type": "string", "minLength": 1, "maxLength": 80 },
    "attempt": { "type": "integer", "minimum": 1 },
    "failedFrom": { "$ref": "#/$defs/buildStatus" },
    "statusLog": { "type": "array", "maxItems": 60, "items": { "$ref": "#/$defs/logLine" } },
    "landing": { "type": "object", "description": "lander@1 landing record (normLanding): split, merged, closed, reruns, rules, ciKick, fullKick, lastMerge" },
    "landedAt": { "type": "string", "format": "date-time" },
    "steps": { "type": "array", "items": { "$ref": "#/$defs/step" } }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "failed" } } }, "then": { "required": ["attempt", "failedFrom"] } }
  ],
  "$defs": {
    "buildStatus": {
      "enum": ["pending", "splitting", "split", "pulling-main", "assigning-models", "ready", "sending", "building", "build-complete", "merging-pr", "pr-pulling-main", "running-ci", "merging-main", "landed", "failed"]
    },
    "stepStatus": {
      "enum": ["pending", "pulling-main", "ready", "sending", "building", "completed", "in-pr", "failed"]
    },
    "logLine": {
      "type": "object",
      "required": ["status", "at", "by", "attempt"],
      "properties": {
        "status": { "type": "string", "minLength": 1, "maxLength": 40 },
        "at": { "type": "string" },
        "by": { "type": "string", "maxLength": 80 },
        "attempt": { "type": "integer", "minimum": 1 },
        "why": { "type": "string", "maxLength": 300 }
      }
    },
    "step": {
      "type": "object",
      "required": ["id", "text", "model"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 40 },
        "text": { "type": "string" },
        "status": { "$ref": "#/$defs/stepStatus" },
        "statusAt": { "type": "string" },
        "statusBy": { "type": "string", "maxLength": 80 },
        "attempt": { "type": "integer", "minimum": 1 },
        "failedFrom": { "$ref": "#/$defs/stepStatus" },
        "statusLog": { "type": "array", "maxItems": 60, "items": { "$ref": "#/$defs/logLine" } },
        "model": { "enum": ["Fable", "Opus"] },
        "account": { "type": "string", "maxLength": 300 },
        "slot": { "type": "string", "maxLength": 300 },
        "worktree": { "type": "string", "maxLength": 300 },
        "branch": { "type": "string", "maxLength": 300 },
        "tmux": { "type": "string", "maxLength": 300 },
        "tried": { "type": "array", "maxItems": 10, "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
        "prNumber": { "type": "integer", "minimum": 1 },
        "files": { "type": "array", "items": { "type": "string" } }
      },
      "allOf": [
        { "if": { "properties": { "status": { "const": "in-pr" } }, "required": ["status"] }, "then": { "required": ["prNumber"] } },
        { "if": { "properties": { "status": { "const": "failed" } }, "required": ["status"] }, "then": { "required": ["attempt", "failedFrom"] } }
      ]
    }
  }
}
