{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amberx.ai/axf/schemas/library-instance.schema.json",
  "title": "library-instance@1: a configured library in one app",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$axf",
    "id",
    "library",
    "version",
    "status",
    "createdAt",
    "updatedAt",
    "capabilities"
  ],
  "properties": {
    "$axf": {
      "const": "library-instance@1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "library": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "app": {
      "type": "string"
    },
    "status": {
      "enum": [
        "configured",
        "disabled",
        "removed"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "capabilityParams": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "params": {
      "type": "object"
    },
    "connections": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "kind",
          "ref"
        ],
        "properties": {
          "kind": {
            "enum": [
              "dataset",
              "registry-ui",
              "plugin",
              "service",
              "action",
              "asset"
            ]
          },
          "ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        }
      }
    },
    "credentials": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "ref"
        ],
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^(env|secret|hub):[A-Za-z0-9_.:/-]+$"
          }
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "at",
          "kind"
        ],
        "properties": {
          "at": {
            "type": "string"
          },
          "by": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "configured",
              "reconfigured",
              "disabled",
              "enabled",
              "removed"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
