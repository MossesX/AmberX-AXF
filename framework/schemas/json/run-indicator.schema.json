{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axf/run-indicator.schema.json",
  "title": "AmberX AXF Run indicator asset",
  "type": "object",
  "required": [
    "$axf",
    "type",
    "id",
    "name",
    "version",
    "data"
  ],
  "properties": {
    "$axf": {
      "const": "asset@1"
    },
    "type": {
      "const": "run-indicator"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "animation",
        "icon",
        "tones"
      ],
      "properties": {
        "animation": {
          "enum": [
            "flash",
            "pulse",
            "glow",
            "spin",
            "none"
          ]
        },
        "icon": {},
        "tones": {
          "type": "object",
          "required": [
            "running",
            "broke"
          ]
        }
      }
    }
  }
}
