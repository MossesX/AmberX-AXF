{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axf/instance-look.schema.json",
  "title": "AmberX AXF Instance look asset",
  "type": "object",
  "required": [
    "$axf",
    "type",
    "id",
    "name",
    "version",
    "data"
  ],
  "properties": {
    "$axf": {
      "const": "asset@1"
    },
    "type": {
      "const": "instance-look"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "kind",
        "look"
      ],
      "properties": {
        "kind": {
          "enum": [
            "tab-group",
            "grid"
          ]
        },
        "look": {
          "type": "object",
          "description": "instance-look@1 record: token references and scaled steps only, never raw px or colours.",
          "properties": {
            "rowBg": {
              "description": "Background of a plain row / an idle tab.",
              "type": "string",
              "enum": [
                "bg",
                "surface",
                "surface2",
                "surface3",
                "text",
                "muted",
                "border",
                "accent",
                "accentText",
                "accent-text",
                "accentSoft",
                "accent-soft",
                "danger",
                "success",
                "warning",
                "info",
                "focus",
                "shadow",
                "transparent"
              ]
            },
            "rowAltBg": {
              "description": "Background of every second row (zebra striping; grids only).",
              "type": "string",
              "enum": [
                "bg",
                "surface",
                "surface2",
                "surface3",
                "text",
                "muted",
                "border",
                "accent",
                "accentText",
                "accent-text",
                "accentSoft",
                "accent-soft",
                "danger",
                "success",
                "warning",
                "info",
                "focus",
                "shadow",
                "transparent"
              ]
            },
            "textSize": {
              "description": "Text size step of the rows / tabs (typography scale).",
              "type": "string",
              "enum": [
                "2xs",
                "xs",
                "sm",
                "md",
                "lg",
                "xl",
                "2xl"
              ]
            },
            "spacing": {
              "description": "Space step between cells / tabs (density gap scale).",
              "type": "string",
              "enum": [
                "2xs",
                "xs",
                "sm",
                "md",
                "lg",
                "xl",
                "2xl",
                "3xl",
                "4xl"
              ]
            },
            "borderW": {
              "description": "Line thickness: none, thin, medium or thick (multiples of the style theme's border width).",
              "type": "string",
              "enum": [
                "none",
                "thin",
                "medium",
                "thick"
              ]
            },
            "borderColor": {
              "description": "Grid lines / the rule under the tab row.",
              "type": "string",
              "enum": [
                "bg",
                "surface",
                "surface2",
                "surface3",
                "text",
                "muted",
                "border",
                "accent",
                "accentText",
                "accent-text",
                "accentSoft",
                "accent-soft",
                "danger",
                "success",
                "warning",
                "info",
                "focus",
                "shadow",
                "transparent"
              ]
            },
            "radius": {
              "description": "Corner radius step: none, sm, md, lg or pill.",
              "type": "string",
              "enum": [
                "none",
                "sm",
                "md",
                "lg",
                "pill"
              ]
            },
            "hoverBg": {
              "description": "Background of the row / tab under the pointer.",
              "type": "string",
              "enum": [
                "bg",
                "surface",
                "surface2",
                "surface3",
                "text",
                "muted",
                "border",
                "accent",
                "accentText",
                "accent-text",
                "accentSoft",
                "accent-soft",
                "danger",
                "success",
                "warning",
                "info",
                "focus",
                "shadow",
                "transparent"
              ]
            },
            "selectedBg": {
              "description": "Background of the selected row / the active tab.",
              "type": "string",
              "enum": [
                "bg",
                "surface",
                "surface2",
                "surface3",
                "text",
                "muted",
                "border",
                "accent",
                "accentText",
                "accent-text",
                "accentSoft",
                "accent-soft",
                "danger",
                "success",
                "warning",
                "info",
                "focus",
                "shadow",
                "transparent"
              ]
            },
            "selectedFg": {
              "description": "Text colour of the selected row / the active tab.",
              "type": "string",
              "enum": [
                "bg",
                "surface",
                "surface2",
                "surface3",
                "text",
                "muted",
                "border",
                "accent",
                "accentText",
                "accent-text",
                "accentSoft",
                "accent-soft",
                "danger",
                "success",
                "warning",
                "info",
                "focus",
                "shadow"
              ]
            }
          },
          "additionalProperties": false
        },
        "for": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:/-]{0,119}$"
          }
        }
      }
    }
  }
}
