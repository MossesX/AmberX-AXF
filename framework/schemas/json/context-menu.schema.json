{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "frame/context-menu.schema.json",
  "title": "Frame Context menu asset",
  "type": "object",
  "required": [
    "$frame",
    "type",
    "id",
    "name",
    "version",
    "data"
  ],
  "properties": {
    "$frame": {
      "const": "asset@1"
    },
    "type": {
      "const": "context-menu"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "variant",
        "showIcons",
        "showShortcuts",
        "targets"
      ],
      "properties": {
        "variant": {
          "enum": [
            "compact",
            "roomy",
            "glass"
          ]
        },
        "showIcons": {},
        "showShortcuts": {},
        "targets": {
          "type": "object",
          "required": [
            "default"
          ]
        }
      }
    }
  }
}
