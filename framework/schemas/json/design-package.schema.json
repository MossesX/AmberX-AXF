{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axf/design-package.schema.json",
  "title": "AmberX AXF AmberX Design Package asset",
  "type": "object",
  "required": [
    "$axf",
    "type",
    "id",
    "name",
    "version",
    "data"
  ],
  "properties": {
    "$axf": {
      "const": "asset@1"
    },
    "type": {
      "const": "design-package"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "style-theme",
        "color-theme",
        "layout",
        "behavior-theme"
      ],
      "properties": {
        "style-theme": {},
        "color-theme": {},
        "layout": {},
        "behavior-theme": {}
      }
    }
  }
}
