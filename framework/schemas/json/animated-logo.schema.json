{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axf/animated-logo.schema.json",
  "title": "AmberX AXF Animated logo asset",
  "type": "object",
  "required": [
    "$axf",
    "type",
    "id",
    "name",
    "version",
    "data"
  ],
  "properties": {
    "$axf": {
      "const": "asset@1"
    },
    "type": {
      "const": "animated-logo"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "mark",
        "preset"
      ],
      "properties": {
        "mark": {},
        "preset": {
          "enum": [
            "spin",
            "pulse",
            "draw",
            "orbit",
            "float",
            "shimmer",
            "wink",
            "none"
          ]
        }
      }
    }
  }
}
