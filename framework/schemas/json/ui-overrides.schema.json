{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axf.amberx.ai/schemas/ui-overrides.schema.json",
  "title": "ui-overrides@1",
  "description": "What was changed through the UI Manager: per element, per property, one value from its predetermined choices. Reset = the key is gone.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$axf",
    "elements"
  ],
  "properties": {
    "$axf": {
      "const": "ui-overrides@1"
    },
    "elements": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9._:/@=%+-]{0,199}$"
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "pattern": "^[a-z][a-z0-9.:_-]{0,119}$"
        },
        "additionalProperties": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ]
        }
      }
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedBy": {
      "type": "string",
      "maxLength": 80
    }
  }
}
