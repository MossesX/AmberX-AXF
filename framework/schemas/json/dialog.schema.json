{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "frame/dialog.schema.json",
  "title": "Frame Dialog asset",
  "type": "object",
  "required": [
    "$frame",
    "type",
    "id",
    "name",
    "version",
    "data"
  ],
  "properties": {
    "$frame": {
      "const": "asset@1"
    },
    "type": {
      "const": "dialog"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "variant",
        "width",
        "backdrop",
        "animation",
        "header",
        "closeOnBackdrop"
      ],
      "properties": {
        "variant": {
          "enum": [
            "modal",
            "drawer",
            "sheet"
          ]
        },
        "width": {},
        "backdrop": {
          "enum": [
            "dim",
            "blur",
            "none"
          ]
        },
        "animation": {
          "enum": [
            "scale",
            "slide",
            "fade"
          ]
        },
        "header": {
          "enum": [
            "plain",
            "accent-bar",
            "filled"
          ]
        },
        "closeOnBackdrop": {}
      }
    }
  }
}
