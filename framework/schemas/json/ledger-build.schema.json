    },
    "profile": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "branch": {
      "type": "string"
    },
    "pr": {
      "type": "integer",
