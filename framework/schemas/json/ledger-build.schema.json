    },
    "repo": {
      "type": "string"
    },
    "mergedAt": {
      "type": "string"
    },
    "builtAt": {
      "type": "string"
    },
    "createdAt": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "thinking": {
      "type": "string"
    },
    "agent": {
      "type": "string"
    },
    "session": {
      "type": "string"
    },
    "prompt": {
      "type": "string"
    },
    "report": {
      "type": "string"
    },
    "features": {
