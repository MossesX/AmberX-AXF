{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amberx.ai/axf/schemas/prompt-manifest.schema.json",
  "title": "prompt-manifest@1: the events, actions and connectors a plugin, app, tool or service registers with the prompting engine",
  "type": "object",
  "required": [
    "source"
  ],
  "additionalProperties": false,
  "properties": {
    "$axf": {
      "const": "prompt-manifest@1"
    },
    "source": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
    },
    "title": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "app",
        "plugin",
        "tool",
        "service",
        "framework"
      ]
    },
    "group": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "string",
                    "number",
                    "boolean",
                    "enum",
                    "object",
                    "list",
                    "build",
                    "plugin",
                    "macro",
                    "pipeline",
                    "rule",
                    "command",
                    "address",
                    "duration",
                    "cron",
                    "text"
                  ]
                },
                "title": {
                  "type": "string"
                },
                "required": {
                  "type": "boolean"
                },
                "enum": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "dependsOn": {
                  "type": "string"
                },
                "from": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "effect": {
            "enum": [
              "read",
              "write",
              "destructive",
              "navigate",
              "ask"
            ]
          },
          "input": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "string",
                    "number",
                    "boolean",
                    "enum",
                    "object",
                    "list",
                    "build",
                    "plugin",
                    "macro",
                    "pipeline",
                    "rule",
                    "command",
                    "address",
                    "duration",
                    "cron",
                    "text"
                  ]
                },
                "title": {
                  "type": "string"
                },
                "required": {
                  "type": "boolean"
                },
                "enum": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "dependsOn": {
                  "type": "string"
                },
                "from": {
                  "type": "string"
                }
              }
            }
          },
          "confirm": {
            "type": "boolean"
          },
          "brettOnly": {
            "type": "boolean"
          },
          "needs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "connectors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "available": {
            "type": "boolean"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    }
  }
}
