{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axf/console-control-targets.schema.json",
  "title": "AmberX AXF console-control target snapshot (console-control@1)",
  "description": "Generated from framework/core/engines/console-control-rules.mjs. What an open console has on screen right now: every addressable target; what the engine resolves against and what list answers.",
  "type": "object",
  "required": [
    "$axf",
    "view",
    "targets"
  ],
  "additionalProperties": false,
  "properties": {
    "$axf": {
      "const": "console-control-targets@1"
    },
    "app": {
      "type": "string",
      "maxLength": 80
    },
    "view": {
      "type": "string",
      "maxLength": 160
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "scroll": {
      "type": "object",
      "required": [
        "container",
        "top",
        "left",
        "height",
        "extent",
        "atTop",
        "atBottom",
        "fraction"
      ],
      "additionalProperties": false,
      "properties": {
        "container": {
          "type": "string",
          "description": "the scroll container address (scroll:main for the main pane)"
        },
        "top": {
          "type": "number",
          "minimum": 0
        },
        "left": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0,
          "description": "visible height (px)"
        },
        "extent": {
          "type": "number",
          "minimum": 0,
          "description": "scrollable height (px)"
        },
        "atTop": {
          "type": "boolean"
        },
        "atBottom": {
          "type": "boolean"
        },
        "fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "top / max(1, extent - height), three decimals"
        }
      }
    },
    "targets": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "required": [
          "address",
          "kind",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "address": {
            "type": "string",
            "pattern": "^(view|tab|subtab|setting|button|function|plugin|grid|row|step|panel|scroll):[^/]{1,160}(/(view|tab|subtab|setting|button|function|plugin|grid|row|step|panel|scroll):[^/]{1,160}){0,7}$",
            "description": "Text form: kind:id segments joined by /, outermost first (view:builds/tab:pipeline/grid:queue/row:<id>)."
          },
          "kind": {
            "enum": [
              "view",
              "tab",
              "subtab",
              "setting",
              "button",
              "function",
              "plugin",
              "grid",
              "row",
              "step",
              "panel",
              "scroll"
            ]
          },
          "label": {
            "type": "string",
            "maxLength": 200
          },
          "detail": {
            "type": "string",
            "maxLength": 200
          },
          "icon": {
            "type": "string",
            "maxLength": 60
          },
          "keywords": {
            "type": "array",
            "maxItems": 24,
            "items": {
              "type": "string",
              "maxLength": 80
            }
          },
          "requires": {
            "type": "string",
            "maxLength": 120,
            "description": "UAC permission the target itself needs"
          },
          "can": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "open",
                "state",
                "press",
                "set",
                "scroll",
                "focus",
                "search",
                "list",
                "plugin.enable",
                "plugin.disable"
              ]
            }
          },
          "parent": {
            "type": "string",
            "pattern": "^(view|tab|subtab|setting|button|function|plugin|grid|row|step|panel|scroll):[^/]{1,160}(/(view|tab|subtab|setting|button|function|plugin|grid|row|step|panel|scroll):[^/]{1,160}){0,7}$",
            "description": "Text form: kind:id segments joined by /, outermost first (view:builds/tab:pipeline/grid:queue/row:<id>)."
          },
          "value": {
            "description": "current value as text (a setting, a tab row, a selection); never for secrets"
          },
          "disabled": {
            "type": "boolean"
          },
          "destructive": {
            "type": "boolean",
            "description": "pressing it deletes something: the confirm flow applies"
          },
          "virtual": {
            "type": "boolean",
            "description": "a grid row not materialised yet; focus asks the grid to render it first"
          }
        }
      }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "required": [
        "address",
        "kind",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "address": {
          "type": "string",
          "pattern": "^(view|tab|subtab|setting|button|function|plugin|grid|row|step|panel|scroll):[^/]{1,160}(/(view|tab|subtab|setting|button|function|plugin|grid|row|step|panel|scroll):[^/]{1,160}){0,7}$",
          "description": "Text form: kind:id segments joined by /, outermost first (view:builds/tab:pipeline/grid:queue/row:<id>)."
        },
        "kind": {
          "enum": [
            "view",
            "tab",
            "subtab",
            "setting",
            "button",
            "function",
            "plugin",
            "grid",
            "row",
            "step",
            "panel",
            "scroll"
          ]
        },
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "detail": {
          "type": "string",
          "maxLength": 200
        },
        "icon": {
          "type": "string",
          "maxLength": 60
        },
        "keywords": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "type": "string",
            "maxLength": 80
          }
        },
        "requires": {
          "type": "string",
          "maxLength": 120,
          "description": "UAC permission the target itself needs"
        },
        "can": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "open",
              "state",
              "press",
              "set",
              "scroll",
              "focus",
              "search",
              "list",
              "plugin.enable",
              "plugin.disable"
            ]
          }
        },
        "parent": {
          "type": "string",
          "pattern": "^(view|tab|subtab|setting|button|function|plugin|grid|row|step|panel|scroll):[^/]{1,160}(/(view|tab|subtab|setting|button|function|plugin|grid|row|step|panel|scroll):[^/]{1,160}){0,7}$",
          "description": "Text form: kind:id segments joined by /, outermost first (view:builds/tab:pipeline/grid:queue/row:<id>)."
        },
        "value": {
          "description": "current value as text (a setting, a tab row, a selection); never for secrets"
        },
        "disabled": {
          "type": "boolean"
        },
        "destructive": {
          "type": "boolean",
          "description": "pressing it deletes something: the confirm flow applies"
        },
        "virtual": {
          "type": "boolean",
          "description": "a grid row not materialised yet; focus asks the grid to render it first"
        }
      }
    },
    "scrollState": {
      "type": "object",
      "required": [
        "container",
        "top",
        "left",
        "height",
        "extent",
        "atTop",
        "atBottom",
        "fraction"
      ],
      "additionalProperties": false,
      "properties": {
        "container": {
          "type": "string",
          "description": "the scroll container address (scroll:main for the main pane)"
        },
        "top": {
          "type": "number",
          "minimum": 0
        },
        "left": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0,
          "description": "visible height (px)"
        },
        "extent": {
          "type": "number",
          "minimum": 0,
          "description": "scrollable height (px)"
        },
        "atTop": {
          "type": "boolean"
        },
        "atBottom": {
          "type": "boolean"
        },
        "fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "top / max(1, extent - height), three decimals"
        }
      }
    }
  }
}
