{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axf/console-control-result.schema.json",
  "title": "AmberX AXF console-control answer (console-control@1)",
  "description": "Generated from framework/core/engines/console-control-rules.mjs. What a console-control command answers: ok with data per verb, or a wire code with the extras that explain it.",
  "type": "object",
  "required": [
    "$axf",
    "ok"
  ],
  "properties": {
    "$axf": {
      "const": "console-control@1"
    },
    "ok": {
      "type": "boolean"
    },
    "verb": {
      "enum": [
        "open",
        "state",
        "press",
        "set",
        "scroll",
        "focus",
        "search",
        "list",
        "plugin.enable",
        "plugin.disable"
      ]
    },
    "address": {
      "type": "string",
      "pattern": "^(view|tab|subtab|setting|button|function|plugin|grid|row|step|panel|scroll):[^/]{1,160}(/(view|tab|subtab|setting|button|function|plugin|grid|row|step|panel|scroll):[^/]{1,160}){0,7}$",
      "description": "Text form: kind:id segments joined by /, outermost first (view:builds/tab:pipeline/grid:queue/row:<id>)."
    },
    "opened": {
      "type": "string",
      "pattern": "^(view|tab|subtab|setting|button|function|plugin|grid|row|step|panel|scroll):[^/]{1,160}(/(view|tab|subtab|setting|button|function|plugin|grid|row|step|panel|scroll):[^/]{1,160}){0,7}$",
      "description": "Text form: kind:id segments joined by /, outermost first (view:builds/tab:pipeline/grid:queue/row:<id>)."
    },
    "focused": {
      "type": "string",
      "pattern": "^(view|tab|subtab|setting|button|function|plugin|grid|row|step|panel|scroll):[^/]{1,160}(/(view|tab|subtab|setting|button|function|plugin|grid|row|step|panel|scroll):[^/]{1,160}){0,7}$",
      "description": "Text form: kind:id segments joined by /, outermost first (view:builds/tab:pipeline/grid:queue/row:<id>)."
    },
    "pressed": {
      "type": "string",
      "pattern": "^(view|tab|subtab|setting|button|function|plugin|grid|row|step|panel|scroll):[^/]{1,160}(/(view|tab|subtab|setting|button|function|plugin|grid|row|step|panel|scroll):[^/]{1,160}){0,7}$",
      "description": "Text form: kind:id segments joined by /, outermost first (view:builds/tab:pipeline/grid:queue/row:<id>)."
    },
    "changed": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(view|tab|subtab|setting|button|function|plugin|grid|row|step|panel|scroll):[^/]{1,160}(/(view|tab|subtab|setting|button|function|plugin|grid|row|step|panel|scroll):[^/]{1,160}){0,7}$",
        "description": "Text form: kind:id segments joined by /, outermost first (view:builds/tab:pipeline/grid:queue/row:<id>)."
      }
    },
    "value": {},
    "result": {},
    "view": {
      "type": "string"
    },
    "state": {},
    "scroll": {
      "type": "object",
      "required": [
        "container",
        "top",
        "left",
        "height",
        "extent",
        "atTop",
        "atBottom",
        "fraction"
      ],
      "additionalProperties": false,
      "properties": {
        "container": {
          "type": "string",
          "description": "the scroll container address (scroll:main for the main pane)"
        },
        "top": {
          "type": "number",
          "minimum": 0
        },
        "left": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0,
          "description": "visible height (px)"
        },
        "extent": {
          "type": "number",
          "minimum": 0,
          "description": "scrollable height (px)"
        },
        "atTop": {
          "type": "boolean"
        },
        "atBottom": {
          "type": "boolean"
        },
        "fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "top / max(1, extent - height), three decimals"
        }
      }
    },
    "hits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "address",
          "kind",
          "label",
          "score"
        ],
        "properties": {
          "address": {
            "type": "string",
            "pattern": "^(view|tab|subtab|setting|button|function|plugin|grid|row|step|panel|scroll):[^/]{1,160}(/(view|tab|subtab|setting|button|function|plugin|grid|row|step|panel|scroll):[^/]{1,160}){0,7}$",
            "description": "Text form: kind:id segments joined by /, outermost first (view:builds/tab:pipeline/grid:queue/row:<id>)."
          },
          "kind": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "score": {
            "type": "number"
          }
        }
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "address",
          "kind",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "address": {
            "type": "string",
            "pattern": "^(view|tab|subtab|setting|button|function|plugin|grid|row|step|panel|scroll):[^/]{1,160}(/(view|tab|subtab|setting|button|function|plugin|grid|row|step|panel|scroll):[^/]{1,160}){0,7}$",
            "description": "Text form: kind:id segments joined by /, outermost first (view:builds/tab:pipeline/grid:queue/row:<id>)."
          },
          "kind": {
            "enum": [
              "view",
              "tab",
              "subtab",
              "setting",
              "button",
              "function",
              "plugin",
              "grid",
              "row",
              "step",
              "panel",
              "scroll"
            ]
          },
          "label": {
            "type": "string",
            "maxLength": 200
          },
          "detail": {
            "type": "string",
            "maxLength": 200
          },
          "icon": {
            "type": "string",
            "maxLength": 60
          },
          "keywords": {
            "type": "array",
            "maxItems": 24,
            "items": {
              "type": "string",
              "maxLength": 80
            }
          },
          "requires": {
            "type": "string",
            "maxLength": 120,
            "description": "UAC permission the target itself needs"
          },
          "can": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "open",
                "state",
                "press",
                "set",
                "scroll",
                "focus",
                "search",
                "list",
                "plugin.enable",
                "plugin.disable"
              ]
            }
          },
          "parent": {
            "type": "string",
            "pattern": "^(view|tab|subtab|setting|button|function|plugin|grid|row|step|panel|scroll):[^/]{1,160}(/(view|tab|subtab|setting|button|function|plugin|grid|row|step|panel|scroll):[^/]{1,160}){0,7}$",
            "description": "Text form: kind:id segments joined by /, outermost first (view:builds/tab:pipeline/grid:queue/row:<id>)."
          },
          "value": {
            "description": "current value as text (a setting, a tab row, a selection); never for secrets"
          },
          "disabled": {
            "type": "boolean"
          },
          "destructive": {
            "type": "boolean",
            "description": "pressing it deletes something: the confirm flow applies"
          },
          "virtual": {
            "type": "boolean",
            "description": "a grid row not materialised yet; focus asks the grid to render it first"
          }
        }
      }
    },
    "plugin": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    },
    "audit": {
      "type": "object",
      "required": [
        "by",
        "reason",
        "at"
      ],
      "properties": {
        "by": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "code": {
      "enum": [
        "invalid",
        "not_found",
        "ambiguous",
        "denied",
        "validation",
        "unavailable",
        "confirmation_required",
        "not_implemented",
        "unexpected"
      ]
    },
    "message": {
      "type": "string"
    },
    "field": {
      "type": "string"
    },
    "segment": {
      "type": "string"
    },
    "nearest": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string",
        "pattern": "^(view|tab|subtab|setting|button|function|plugin|grid|row|step|panel|scroll):[^/]{1,160}(/(view|tab|subtab|setting|button|function|plugin|grid|row|step|panel|scroll):[^/]{1,160}){0,7}$",
        "description": "Text form: kind:id segments joined by /, outermost first (view:builds/tab:pipeline/grid:queue/row:<id>)."
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(view|tab|subtab|setting|button|function|plugin|grid|row|step|panel|scroll):[^/]{1,160}(/(view|tab|subtab|setting|button|function|plugin|grid|row|step|panel|scroll):[^/]{1,160}){0,7}$",
        "description": "Text form: kind:id segments joined by /, outermost first (view:builds/tab:pipeline/grid:queue/row:<id>)."
      }
    },
    "requires": {
      "type": "string"
    },
    "because": {
      "type": "string"
    },
    "confirm": {
      "type": "string"
    },
    "can": {
      "type": "array",
      "items": {
        "enum": [
          "open",
          "state",
          "press",
          "set",
          "scroll",
          "focus",
          "search",
          "list",
          "plugin.enable",
          "plugin.disable"
        ]
      }
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "$axf",
          "ok",
          "verb"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "ok": {
            "const": false
          }
        }
      },
      "then": {
        "required": [
          "$axf",
          "ok",
          "code",
          "message"
        ]
      }
    }
  ],
  "$defs": {
    "scrollState": {
      "type": "object",
      "required": [
        "container",
        "top",
        "left",
        "height",
        "extent",
        "atTop",
        "atBottom",
        "fraction"
      ],
      "additionalProperties": false,
      "properties": {
        "container": {
          "type": "string",
          "description": "the scroll container address (scroll:main for the main pane)"
        },
        "top": {
          "type": "number",
          "minimum": 0
        },
        "left": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0,
          "description": "visible height (px)"
        },
        "extent": {
          "type": "number",
          "minimum": 0,
          "description": "scrollable height (px)"
        },
        "atTop": {
          "type": "boolean"
        },
        "atBottom": {
          "type": "boolean"
        },
        "fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "top / max(1, extent - height), three decimals"
        }
      }
    },
    "target": {
      "type": "object",
      "required": [
        "address",
        "kind",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "address": {
          "type": "string",
          "pattern": "^(view|tab|subtab|setting|button|function|plugin|grid|row|step|panel|scroll):[^/]{1,160}(/(view|tab|subtab|setting|button|function|plugin|grid|row|step|panel|scroll):[^/]{1,160}){0,7}$",
          "description": "Text form: kind:id segments joined by /, outermost first (view:builds/tab:pipeline/grid:queue/row:<id>)."
        },
        "kind": {
          "enum": [
            "view",
            "tab",
            "subtab",
            "setting",
            "button",
            "function",
            "plugin",
            "grid",
            "row",
            "step",
            "panel",
            "scroll"
          ]
        },
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "detail": {
          "type": "string",
          "maxLength": 200
        },
        "icon": {
          "type": "string",
          "maxLength": 60
        },
        "keywords": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "type": "string",
            "maxLength": 80
          }
        },
        "requires": {
          "type": "string",
          "maxLength": 120,
          "description": "UAC permission the target itself needs"
        },
        "can": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "open",
              "state",
              "press",
              "set",
              "scroll",
              "focus",
              "search",
              "list",
              "plugin.enable",
              "plugin.disable"
            ]
          }
        },
        "parent": {
          "type": "string",
          "pattern": "^(view|tab|subtab|setting|button|function|plugin|grid|row|step|panel|scroll):[^/]{1,160}(/(view|tab|subtab|setting|button|function|plugin|grid|row|step|panel|scroll):[^/]{1,160}){0,7}$",
          "description": "Text form: kind:id segments joined by /, outermost first (view:builds/tab:pipeline/grid:queue/row:<id>)."
        },
        "value": {
          "description": "current value as text (a setting, a tab row, a selection); never for secrets"
        },
        "disabled": {
          "type": "boolean"
        },
        "destructive": {
          "type": "boolean",
          "description": "pressing it deletes something: the confirm flow applies"
        },
        "virtual": {
          "type": "boolean",
          "description": "a grid row not materialised yet; focus asks the grid to render it first"
        }
      }
    },
    "hit": {
      "type": "object",
      "required": [
        "address",
        "kind",
        "label",
        "score"
      ],
      "properties": {
        "address": {
          "type": "string",
          "pattern": "^(view|tab|subtab|setting|button|function|plugin|grid|row|step|panel|scroll):[^/]{1,160}(/(view|tab|subtab|setting|button|function|plugin|grid|row|step|panel|scroll):[^/]{1,160}){0,7}$",
          "description": "Text form: kind:id segments joined by /, outermost first (view:builds/tab:pipeline/grid:queue/row:<id>)."
        },
        "kind": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "score": {
          "type": "number"
        }
      }
    }
  }
}
