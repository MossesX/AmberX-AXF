{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amberx.ai/axf/schemas/prompt-toolset.schema.json",
  "title": "prompt-toolset@1: the set tools the prompting engine may run (plugin.command, plugin.*, console.verb, console.*)",
  "type": "object",
  "required": [
    "id",
    "tools"
  ],
  "additionalProperties": false,
  "properties": {
    "$axf": {
      "const": "prompt-toolset@1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{0,79}(\\.\\*)?$|^\\*$"
      }
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "by": {
      "type": "string"
    }
  }
}
