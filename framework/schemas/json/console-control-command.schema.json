{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axf/console-control-command.schema.json",
  "title": "AmberX AXF console-control command (console-control@1)",
  "description": "Generated from framework/core/engines/console-control-rules.mjs. One verb on one address, the same on REST, MCP, the CLI and voice.",
  "type": "object",
  "required": [
    "verb"
  ],
  "additionalProperties": false,
  "properties": {
    "$axf": {
      "const": "console-control@1"
    },
    "verb": {
      "enum": [
        "open",
        "state",
        "press",
        "set",
        "scroll",
        "focus",
        "search",
        "list",
        "plugin.enable",
        "plugin.disable"
      ]
    },
    "address": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(view|tab|subtab|setting|button|function|plugin|grid|row|step|panel|scroll):[^/]{1,160}(/(view|tab|subtab|setting|button|function|plugin|grid|row|step|panel|scroll):[^/]{1,160}){0,7}$",
          "description": "Text form: kind:id segments joined by /, outermost first (view:builds/tab:pipeline/grid:queue/row:<id>)."
        },
        {
          "type": "object",
          "required": [
            "path"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "object",
                "required": [
                  "kind",
                  "id"
                ],
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "enum": [
                      "view",
                      "tab",
                      "subtab",
                      "setting",
                      "button",
                      "function",
                      "plugin",
                      "grid",
                      "row",
                      "step",
                      "panel",
                      "scroll"
                    ]
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  }
                }
              }
            }
          }
        }
      ]
    },
    "value": {
      "description": "set: the new value (true / false / \"toggle\", a number, a choice, text, a list); press: the function argument"
    },
    "scroll": {
      "type": "object",
      "required": [
        "dir"
      ],
      "additionalProperties": false,
      "properties": {
        "dir": {
          "enum": [
            "up",
            "down",
            "page-up",
            "page-down",
            "top",
            "bottom",
            "to"
          ]
        },
        "amount": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100000,
          "description": "px, or a fraction of the visible height when <= 1 (default 1/3)"
        },
        "to": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(view|tab|subtab|setting|button|function|plugin|grid|row|step|panel|scroll):[^/]{1,160}(/(view|tab|subtab|setting|button|function|plugin|grid|row|step|panel|scroll):[^/]{1,160}){0,7}$",
              "description": "Text form: kind:id segments joined by /, outermost first (view:builds/tab:pipeline/grid:queue/row:<id>)."
            },
            {
              "type": "object",
              "required": [
                "path"
              ],
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "items": {
                    "type": "object",
                    "required": [
                      "kind",
                      "id"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "enum": [
                          "view",
                          "tab",
                          "subtab",
                          "setting",
                          "button",
                          "function",
                          "plugin",
                          "grid",
                          "row",
                          "step",
                          "panel",
                          "scroll"
                        ]
                      },
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160
                      }
                    }
                  }
                }
              }
            }
          ],
          "description": "dir to: the address to scroll to inside the container"
        }
      }
    },
    "query": {
      "type": "object",
      "required": [
        "q"
      ],
      "additionalProperties": false,
      "properties": {
        "q": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "kinds": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "enum": [
              "view",
              "tab",
              "subtab",
              "setting",
              "button",
              "function",
              "plugin",
              "grid",
              "row",
              "step",
              "panel",
              "scroll"
            ]
          }
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 12
        }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "select": {
          "type": "boolean",
          "default": true
        },
        "expand": {
          "type": "boolean"
        },
        "highlight": {
          "type": "boolean",
          "default": true
        },
        "highlightMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000,
          "default": 1800
        }
      }
    },
    "confirm": {
      "type": "string",
      "maxLength": 200,
      "description": "the confirm token a destructive press sends on its second call"
    },
    "by": {
      "type": "string",
      "maxLength": 80
    },
    "reason": {
      "type": "string",
      "maxLength": 400
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verb": {
            "const": "open"
          }
        }
      },
      "then": {
        "required": [
          "verb",
          "address"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "verb": {
            "const": "press"
          }
        }
      },
      "then": {
        "required": [
          "verb",
          "address"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "verb": {
            "const": "set"
          }
        }
      },
      "then": {
        "required": [
          "verb",
          "address"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "verb": {
            "const": "focus"
          }
        }
      },
      "then": {
        "required": [
          "verb",
          "address"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "verb": {
            "const": "plugin.enable"
          }
        }
      },
      "then": {
        "required": [
          "verb",
          "address"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "verb": {
            "const": "plugin.disable"
          }
        }
      },
      "then": {
        "required": [
          "verb",
          "address"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "verb": {
            "const": "search"
          }
        }
      },
      "then": {
        "required": [
          "verb",
          "query"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "verb": {
            "const": "scroll"
          }
        }
      },
      "then": {
        "required": [
          "verb",
          "scroll"
        ]
      }
    }
  ],
  "$defs": {
    "segment": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "view",
            "tab",
            "subtab",
            "setting",
            "button",
            "function",
            "plugin",
            "grid",
            "row",
            "step",
            "panel",
            "scroll"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "scrollSpec": {
      "type": "object",
      "required": [
        "dir"
      ],
      "additionalProperties": false,
      "properties": {
        "dir": {
          "enum": [
            "up",
            "down",
            "page-up",
            "page-down",
            "top",
            "bottom",
            "to"
          ]
        },
        "amount": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100000,
          "description": "px, or a fraction of the visible height when <= 1 (default 1/3)"
        },
        "to": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(view|tab|subtab|setting|button|function|plugin|grid|row|step|panel|scroll):[^/]{1,160}(/(view|tab|subtab|setting|button|function|plugin|grid|row|step|panel|scroll):[^/]{1,160}){0,7}$",
              "description": "Text form: kind:id segments joined by /, outermost first (view:builds/tab:pipeline/grid:queue/row:<id>)."
            },
            {
              "type": "object",
              "required": [
                "path"
              ],
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "items": {
                    "type": "object",
                    "required": [
                      "kind",
                      "id"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "enum": [
                          "view",
                          "tab",
                          "subtab",
                          "setting",
                          "button",
                          "function",
                          "plugin",
                          "grid",
                          "row",
                          "step",
                          "panel",
                          "scroll"
                        ]
                      },
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160
                      }
                    }
                  }
                }
              }
            }
          ],
          "description": "dir to: the address to scroll to inside the container"
        }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "select": {
          "type": "boolean",
          "default": true
        },
        "expand": {
          "type": "boolean"
        },
        "highlight": {
          "type": "boolean",
          "default": true
        },
        "highlightMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000,
          "default": 1800
        }
      }
    },
    "query": {
      "type": "object",
      "required": [
        "q"
      ],
      "additionalProperties": false,
      "properties": {
        "q": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "kinds": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "enum": [
              "view",
              "tab",
              "subtab",
              "setting",
              "button",
              "function",
              "plugin",
              "grid",
              "row",
              "step",
              "panel",
              "scroll"
            ]
          }
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 12
        }
      }
    }
  }
}
