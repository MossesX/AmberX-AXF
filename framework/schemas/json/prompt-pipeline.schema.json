{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amberx.ai/axf/schemas/prompt-pipeline.schema.json",
  "title": "prompt-pipeline@1: ordered stages of actions; a stage may carry a gate Brett answers before it goes on",
  "type": "object",
  "required": [
    "id",
    "stages"
  ],
  "additionalProperties": false,
  "properties": {
    "$axf": {
      "const": "prompt-pipeline@1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "params": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "enum": [
              "string",
              "number",
              "boolean",
              "enum",
              "object",
              "list",
              "build",
              "plugin",
              "macro",
              "pipeline",
              "rule",
              "command",
              "address",
              "duration",
              "cron",
              "text"
            ]
          },
          "title": {
            "type": "string"
          },
          "default": {},
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
          },
          "title": {
            "type": "string"
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "action"
              ],
              "additionalProperties": false,
              "properties": {
                "action": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
                },
                "input": {
                  "type": "object"
                },
                "title": {
                  "type": "string"
                },
                "continueOnError": {
                  "type": "boolean"
                }
              }
            }
          },
          "gate": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "none",
                  "approve",
                  "veto",
                  "pick",
                  "text"
                ]
              },
              "title": {
                "type": "string"
              },
              "text": {
                "type": "string",
                "maxLength": 4000
              },
              "options": {
                "type": "array",
                "maxItems": 12,
                "items": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
                    },
                    "label": {
                      "type": "string"
                    }
                  }
                }
              },
              "countdownSec": {
                "type": "integer",
                "minimum": 0
              },
              "outputs": {
                "type": "array",
                "items": {
                  "enum": [
                    "dialog",
                    "push",
                    "email",
                    "sms",
                    "call"
                  ]
                }
              },
              "defaultOption": {
                "type": "string"
              }
            }
          },
          "continueOnError": {
            "type": "boolean"
          }
        }
      }
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "by": {
      "type": "string"
    }
  }
}
