{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amberx.ai/axf/schemas/lander-state.schema.json",
  "title": "lander-state@1 (gate-rules@1)",
  "type": "object",
  "required": [
    "$axf",
    "at",
    "status",
    "paused",
    "mode",
    "lastRuns",
    "waiting"
  ],
  "additionalProperties": true,
  "properties": {
    "$axf": {
      "const": "lander-state@1"
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "running",
        "paused",
        "idle",
        "off",
        "error"
      ]
    },
    "enabled": {
      "type": "boolean",
      "description": "the one On/Off the cron reads first"
    },
    "paused": {
      "type": "boolean"
    },
    "pause": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "why": {
          "type": "string"
        },
        "by": {
          "type": "string"
        },
        "at": {
          "type": "string"
        }
      }
    },
    "mode": {
      "enum": [
        "serial",
        "batch",
        "stack"
      ]
    },
    "source": {
      "enum": [
        "merge-queue@1",
        "landing-line@1",
        "axf-molly"
      ]
    },
    "landing": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "pr"
      ],
      "properties": {
        "pr": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string"
        },
        "build": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "ci": {
          "type": "string"
        },
        "since": {
          "type": "string"
        },
        "runUrl": {
          "type": "string"
        }
      }
    },
    "lastRuns": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": [
          "startedAt",
          "result"
        ],
        "properties": {
          "$axf": {
            "const": "auto-lander-run@1"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "finishedAt": {
            "type": "string"
          },
          "result": {
            "enum": [
              "landed",
              "landing",
              "idle",
              "skipped",
              "error"
            ]
          },
          "mode": {
            "enum": [
              "serial",
              "batch",
              "stack"
            ]
          },
          "reason": {
            "enum": [
              "switched-off",
              "paused",
              "queue-empty",
              "ci-waiting",
              "conflict",
              "ui-review",
              "token-missing",
              "locked",
              "error",
              ""
            ]
          },
          "reasonText": {
            "type": "string",
            "maxLength": 600
          },
          "landing": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "pr"
            ],
            "properties": {
              "pr": {
                "type": "integer",
                "minimum": 1
              },
              "title": {
                "type": "string"
              },
              "build": {
                "type": "string"
              },
              "branch": {
                "type": "string"
              },
              "ci": {
                "type": "string"
              },
              "since": {
                "type": "string"
              },
              "runUrl": {
                "type": "string"
              }
            }
          },
          "merged": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "waiting": {
            "type": "integer",
            "minimum": 0
          },
          "error": {
            "type": "string"
          }
        }
      }
    },
    "waiting": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": [
          "pr",
          "state",
          "reason"
        ],
        "properties": {
          "position": {
            "type": "integer",
            "minimum": 0
          },
          "pr": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string"
          },
          "build": {
            "type": "string"
          },
          "branch": {
            "type": "string"
          },
          "head": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "state": {
            "enum": [
              "waiting",
              "testing",
              "passed",
              "merging",
              "held",
              "kicked",
              "skipped",
              "paused"
            ]
          },
          "rule": {
            "type": "string",
            "pattern": "(^[a-z0-9][a-z0-9-]{0,40}$)|^$",
            "description": "the gate rule that holds it, or empty for a hold by hand / a queue state"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600,
            "description": "why it waits, in plain words"
          },
          "since": {
            "type": "string"
          }
        }
      }
    },
    "landedRecently": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "order": {
      "title": "land-order@1 (gate-rules@1)",
      "description": "The order the auto-lander lands finished builds / PRs in. default = closest-to-main first; brett = a hand set it and it is kept as is. New PRs append at the bottom, merged / closed ones drop out. Missing while the lander still runs the merge queue's own order.",
      "type": "object",
      "required": [
        "$axf",
        "rev",
        "source",
        "updatedAt",
        "items"
      ],
      "additionalProperties": true,
      "properties": {
        "$axf": {
          "const": "land-order@1"
        },
        "rev": {
          "type": "integer",
          "minimum": 0,
          "description": "+1 on every change, by hand or by reconcile"
        },
        "source": {
          "enum": [
            "default",
            "brett"
          ],
          "description": "default = the engine's sort (behind main ascending, then line position); brett = a hand set it"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedBy": {
          "type": "string",
          "maxLength": 80,
          "description": "who last changed it: brett, a session name, or empty for the engine"
        },
        "items": {
          "type": "array",
          "maxItems": 200,
          "description": "top = lands first; ids unique",
          "items": {
            "type": "object",
            "required": [
              "id",
              "pr",
              "build"
            ],
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 100,
                "description": "pr-<n> when the PR exists, else build-<id> (landing-line@1 entry id)"
              },
              "pr": {
                "type": "integer",
                "minimum": 0,
                "description": "the PR number, 0 while there is none yet"
              },
              "build": {
                "type": "string",
                "maxLength": 80
              },
              "behind": {
                "type": "integer",
                "minimum": 0,
                "description": "commits behind main when known: the default sort key"
              }
            }
          }
        },
        "migratedFrom": {
          "type": "object",
          "properties": {
            "frame": {
              "enum": [
                "merge-queue@1",
                "landing-line@1"
              ]
            },
            "at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "description": "set once when the order was first built from the merge queue or the landing line"
        }
      }
    },
    "error": {
      "type": "string"
    }
  }
}
