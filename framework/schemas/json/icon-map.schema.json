{
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "builtin",
            "upload",
            "url",
            "library",
            "generated",
            "mixed"
          ]
        },
        "url": {
          "type": "string"
        },
        "library": {
          "type": "string"
        },
        "importedAt": {
          "type": "string"
        }
      }
    },
    "license": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]{0,63}$"
        },
        "holder": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axf/icon-map.schema.json",
  "title": "AmberX AXF Icon map asset",
  "type": "object",
  "required": [
    "$axf",
    "type",
    "id",
    "name",
    "version",
    "data"
  ],
  "properties": {
    "$axf": {
      "const": "asset@1"
    },
    "type": {
      "const": "icon-map"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "spots"
      ],
      "properties": {
        "spots": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]*:[a-z0-9][a-z0-9.-]*\\/[a-z0-9][a-z0-9.-]*$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "icon",
                  "badge",
                  "app-icon"
                ]
              },
              "glyph": {
                "type": "string"
              },
              "dynamic": {
                "type": "boolean"
              },
              "size": {
                "type": "string"
              },
              "tint": {
                "enum": [
                  "currentColor",
                  "text",
                  "muted",
                  "bg",
                  "surface",
                  "accent",
                  "accentText",
                  "success",
                  "warning",
                  "danger",
                  "info",
                  "brand1",
                  "brand2",
                  "brand3"
                ]
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "label": {
                "type": "string",
                "maxLength": 80
              },
              "help": {
                "type": "string",
                "maxLength": 300
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "app": {
          "type": "string"
        },
        "extends": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,47}$"
        },
        "generatedAt": {
          "type": "string"
        }
      }
    }
  }
}
