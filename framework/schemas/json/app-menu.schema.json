{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "frame/app-menu.schema.json",
  "title": "Frame Application menu asset",
  "type": "object",
  "required": [
    "$frame",
    "type",
    "id",
    "name",
    "version",
    "data"
  ],
  "properties": {
    "$frame": {
      "const": "asset@1"
    },
    "type": {
      "const": "app-menu"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "menus"
      ],
      "properties": {
        "menus": {}
      }
    }
  }
}
