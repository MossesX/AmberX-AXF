{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amberx.ai/axf/schemas/dup-gate-match.schema.json",
  "title": "dup-gate-match@1 (dup-gate@1): one thing that already exists",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "score"
  ],
  "properties": {
    "$axf": {
      "const": "dup-gate-match@1"
    },
    "kind": {
      "enum": [
        "shipped",
        "plugin",
        "file",
        "setting",
        "build"
      ],
      "description": "shipped = a Shipped features manifest landed on main; plugin = a plugin on main; file = a file on main; setting = an existing setting key; build = a builds@1 record not landed yet (or a shipped manifest with no landed commit)"
    },
    "id": {
      "type": "string",
      "maxLength": 300
    },
    "title": {
      "type": "string",
      "maxLength": 300
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "weighted fuzzy similarity 0..1 (trigram Dice + token Jaccard over the fields, synonyms folded)"
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "field",
          "score"
        ],
        "additionalProperties": false,
        "properties": {
          "field": {
            "enum": [
              "title",
              "said",
              "detail",
              "plugin",
              "setting",
              "file",
              "id"
            ]
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "against": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "where": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 300
        },
        "pr": {
          "type": "integer",
          "minimum": 0
        },
        "commit": {
          "type": "string"
        },
        "plugin": {
          "type": "string",
          "maxLength": 80
        },
        "key": {
          "type": "string",
          "maxLength": 120
        },
        "branch": {
          "type": "string",
          "maxLength": 200
        },
        "build": {
          "type": "string"
        },
        "status": {
          "enum": [
            "",
            "pending",
            "queued",
            "running",
            "waiting",
            "blocked",
            "failed",
            "built",
            "recorded"
          ]
        }
      },
      "description": "where it lives: the manifest / file path, PR, landed commit, plugin id, setting key, branch, build id and status"
    },
    "landed": {
      "type": "boolean",
      "description": "true when it is on main (a sha or a merged PR), false for a record or branch only"
    },
    "since": {
      "type": "string",
      "format": "date-time"
    },
    "state": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "on": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "source": {
          "type": "string",
          "maxLength": 200
        },
        "key": {
          "type": "string",
          "maxLength": 120
        },
        "since": {
          "type": "string",
          "format": "date-time"
        }
      },
      "description": "whether the matched thing is switched on, read from `source` (lander-config, gate-lander, plugin-settings, plugin-enabled, build-options, or another named reader); null when it has no switch"
    },
    "fix": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "setting",
            "action",
            "reuse",
            "none"
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 600
        },
        "key": {
          "type": "string",
          "maxLength": 120
        },
        "value": {},
        "source": {
          "type": "string",
          "maxLength": 200
        },
        "action": {
          "type": "string",
          "maxLength": 120
        },
        "args": {
          "type": "object"
        },
        "build": {
          "type": "string"
        },
        "pr": {
          "type": "integer",
          "minimum": 0
        }
      },
      "description": "the one fix that makes the build unnecessary: setting = turn key to value; action = run a named console action; reuse = the build / PR already carrying it; none"
    },
    "note": {
      "type": "string",
      "maxLength": 600
    }
  }
}
