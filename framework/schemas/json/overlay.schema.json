{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axf/overlay.schema.json",
  "title": "AmberX AXF Overlay asset",
  "type": "object",
  "required": [
    "$axf",
    "type",
    "id",
    "name",
    "version",
    "data"
  ],
  "properties": {
    "$axf": {
      "const": "asset@1"
    },
    "type": {
      "const": "overlay"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "pill",
        "log",
        "strip",
        "mini"
      ],
      "properties": {
        "pill": {
          "type": "object",
          "required": [
            "chips"
          ]
        },
        "log": {
          "type": "object",
          "required": [
            "show"
          ]
        },
        "strip": {
          "type": "object",
          "required": [
            "show"
          ]
        },
        "mini": {
          "type": "object",
          "required": [
            "defaultOpen"
          ]
        }
      }
    }
  }
}
