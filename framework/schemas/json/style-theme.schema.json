{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "frame/style-theme.schema.json",
  "title": "Frame Style theme asset",
  "type": "object",
  "required": [
    "$frame",
    "type",
    "id",
    "name",
    "version",
    "data"
  ],
  "properties": {
    "$frame": {
      "const": "asset@1"
    },
    "type": {
      "const": "style-theme"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "fontFamily",
        "fontDisplay",
        "fontMono",
        "fontSize",
        "radius",
        "space",
        "borderWidth",
        "shadow",
        "density",
        "motion",
        "blur",
        "headingWeight",
        "tracking"
      ],
      "properties": {
        "fontFamily": {},
        "fontDisplay": {},
        "fontMono": {},
        "fontSize": {},
        "radius": {
          "type": "object",
          "required": [
            "sm",
            "md",
            "lg"
          ]
        },
        "space": {},
        "borderWidth": {},
        "shadow": {
          "type": "object",
          "required": [
            "sm",
            "md",
            "lg"
          ]
        },
        "density": {
          "enum": [
            "compact",
            "comfortable",
            "spacious"
          ]
        },
        "motion": {},
        "blur": {},
        "headingWeight": {},
        "tracking": {}
      }
    }
  }
}
