{
  "$id": "axf/asset-types",
  "frameworkVersion": "0.2.0",
  "envelope": {
    "frame": "asset@1",
    "required": [
      "$axf",
      "type",
      "id",
      "name",
      "version",
      "data"
    ],
    "idPattern": "^[a-z0-9][a-z0-9-]{1,47}$",
    "optional_fields": {
      "description": "string",
      "author": "string",
      "tags": "string[]",
      "roll": "boolean — whether a randomize roll may pick this asset. Default: the type's roll.asset (true unless the type says otherwise). Runtime overrides (settings) win over this."
    }
  },
  "types": {
    "color-theme": {
      "label": "Color theme",
      "group": "Themes",
      "icon": "palette",
      "required": [
        "scheme",
        "tokens"
      ],
      "enums": {
        "scheme": [
          "light",
          "dark"
        ]
      },
      "nested": {
        "tokens": [
          "bg",
          "surface",
          "surface2",
          "surface3",
          "text",
          "muted",
          "border",
          "accent",
          "accentText",
          "accentSoft",
          "danger",
          "success",
          "warning",
          "info",
          "focus",
          "shadow"
        ]
      }
    },
    "style-theme": {
      "label": "Style theme",
      "group": "Themes",
      "icon": "type",
      "required": [
        "fontFamily",
        "fontDisplay",
        "fontMono",
        "fontSize",
        "radius",
        "space",
        "borderWidth",
        "shadow",
        "density",
        "motion",
        "blur",
        "headingWeight",
        "tracking"
      ],
      "enums": {
        "density": [
          "compact",
          "comfortable",
          "spacious"
        ]
      },
      "nested": {
        "radius": [
          "sm",
          "md",
          "lg"
        ],
        "shadow": [
          "sm",
          "md",
          "lg"
        ]
      },
      "optional_fields": {
        "wrapGroups": "boolean, default false — every section / group (Container) is collapsible with a toggle in its top-right corner (build option --wrap-groups; compiles to --fx-wrap-groups 1|0)"
      }
    },
    "layout": {
      "label": "Layout",
      "group": "Themes",
      "icon": "layout",
      "required": [
        "nav",
        "navWidth",
        "showMenubar",
        "showToolbar",
        "toolbarPosition",
        "showStatusbar",
        "inspector",
        "inspectorWidth",
        "contentMaxWidth"
      ],
      "enums": {
        "nav": [
          "left",
          "right",
          "top"
        ],
        "toolbarPosition": [
          "top",
          "bottom"
        ],
        "inspector": [
          "left",
          "right",
          "none"
        ]
      },
      "slots": {
        "regions": [
          "menubar",
          "toolbar",
          "nav",
          "main",
          "inspector",
          "status",
          "fab",
          "sheet",
          "overlay"
        ],
        "defaults": {
          "menubar": [
            "app-menu"
          ],
          "toolbar": [
            "toolbar"
          ],
          "nav": [
            "nav-menu"
          ],
          "main": [],
          "inspector": [],
          "status": [],
          "fab": [],
          "sheet": [],
          "overlay": [
            "dialog",
            "popup",
            "context-menu"
          ]
        }
      },
      "optional_fields": {
        "slots": "region → list of asset types that region accepts. Overrides the defaults in `slots.defaults` per region; a chrome region renders only when it accepts its asset type. Keys must be a region in `slots.regions`, values known asset types."
      }
    },
    "app-menu": {
      "label": "Application menu",
      "group": "Navigation",
      "icon": "menu",
      "required": [
        "menus"
      ],
      "enums": {
        "density": [
          "compact",
          "regular",
          "roomy"
        ],
        "surface": [
          "flat",
          "raised",
          "glass"
        ]
      },
      "optional_fields": {
        "density": "compact | regular (default) | roomy — menubar height",
        "surface": "flat (default) | raised | glass"
      },
      "hideable": true
    },
    "toolbar": {
      "label": "Toolbar",
      "group": "Navigation",
      "icon": "sliders",
      "required": [
        "variant",
        "align",
        "groups",
        "showSearch"
      ],
      "enums": {
        "variant": [
          "icons",
          "icons-labels",
          "labels"
        ],
        "align": [
          "start",
          "center",
          "spread"
        ],
        "density": [
          "compact",
          "regular",
          "roomy"
        ],
        "surface": [
          "flat",
          "raised",
          "glass"
        ]
      },
      "optional_fields": {
        "window": "id or kind of the window this toolbar is attached to (`main` by default); the window-settings icon renders only when the toolbar is inside a floating window",
        "density": "compact | regular (default) | roomy — toolbar padding and button height",
        "surface": "flat (default) | raised | glass",
        "divider": "boolean, default true — rule between item groups",
        "search": "object — live search: { live: boolean (dropdown that updates on every keystroke), placeholder?: string, maxResults?: number (default 12), kinds?: string[] (limit to result kinds: view, action, setting, settings-tab, dialog, asset, window, text) }. Without it (or live:false) the search box is the classic submit-to-jump box.",
        "groups[].items[].badge": "string — name of a runtime counter (runtime.setBadge) shown as a small badge on the button, e.g. `alerts.unread`; hidden at 0",
        "widgets": "[{type, id, at: start|end, order?}] — widget assets (clock, search bar) placed at the toolbar's start or end. Runtime widgets (rt.attachToToolbar) with the same type+id replace these."
      },
      "hideable": true,
      "widgets": {
        "_doc": "Widget host: only widget types (\"widget\": true) are placed; missing assets are skipped.",
        "sides": [
          "start",
          "end"
        ]
      }
    },
    "nav-menu": {
      "label": "Navigation menu",
      "group": "Navigation",
      "icon": "grid",
      "required": [
        "style",
        "sections"
      ],
      "enums": {
        "style": [
          "list",
          "pills",
          "rail"
        ],
        "density": [
          "compact",
          "regular",
          "roomy"
        ],
        "indicator": [
          "auto",
          "bar",
          "fill",
          "none"
        ]
      },
      "optional_fields": {
        "density": "compact | regular (default) | roomy — item padding",
        "indicator": "auto (default, per style) | bar | fill | none — active-item marker",
        "showIcons": "boolean, default true"
      },
      "hideable": true
    },
    "context-menu": {
      "label": "Context menu",
      "group": "Navigation",
      "icon": "chevron-right",
      "required": [
        "variant",
        "showIcons",
        "showShortcuts",
        "targets"
      ],
      "enums": {
        "variant": [
          "compact",
          "roomy",
          "glass"
        ]
      },
      "nested": {
        "targets": [
          "default"
        ]
      },
      "roll": {
        "slot": false,
        "asset": false
      },
      "hideable": true
    },
    "dialog": {
      "label": "Dialog",
      "group": "Overlays",
      "icon": "box",
      "required": [
        "variant",
        "width",
        "backdrop",
        "animation",
        "header",
        "closeOnBackdrop"
      ],
      "enums": {
        "variant": [
          "modal",
          "drawer",
          "sheet"
        ],
        "backdrop": [
          "dim",
          "blur",
          "none"
        ],
        "animation": [
          "scale",
          "slide",
          "fade"
        ],
        "header": [
          "plain",
          "accent-bar",
          "filled"
        ]
      }
    },
    "popup": {
      "label": "Popup / toast",
      "group": "Overlays",
      "icon": "bell",
      "required": [
        "position",
        "variant",
        "duration",
        "showIcon",
        "maxVisible"
      ],
      "enums": {
        "position": [
          "top-right",
          "bottom-right",
          "bottom-center",
          "top-center"
        ],
        "variant": [
          "solid",
          "outline",
          "minimal"
        ]
      }
    },
    "button": {
      "label": "Button",
      "group": "Controls",
      "icon": "zap",
      "required": [
        "shape",
        "fill",
        "weight",
        "uppercase",
        "size",
        "elevation"
      ],
      "enums": {
        "shape": [
          "rounded",
          "pill",
          "square"
        ],
        "fill": [
          "solid",
          "soft",
          "outline",
          "gradient"
        ],
        "size": [
          "sm",
          "md",
          "lg"
        ]
      }
    },
    "slider": {
      "label": "Slider",
      "group": "Controls",
      "icon": "sliders",
      "required": [
        "track",
        "thumb",
        "thumbSize",
        "fill",
        "showValue",
        "ticks"
      ],
      "enums": {
        "thumb": [
          "circle",
          "square",
          "bar"
        ],
        "fill": [
          "solid",
          "gradient",
          "none"
        ],
        "showValue": [
          "always",
          "hover",
          "never"
        ]
      }
    },
    "container": {
      "label": "Container",
      "group": "Controls",
      "icon": "box",
      "required": [
        "variant",
        "header",
        "padding",
        "elevation",
        "collapsible"
      ],
      "enums": {
        "variant": [
          "card",
          "panel",
          "glass",
          "outline"
        ],
        "header": [
          "plain",
          "divided",
          "accent"
        ],
        "padding": [
          "sm",
          "md",
          "lg"
        ]
      }
    },
    "banner": {
      "label": "Banner",
      "group": "Chrome",
      "icon": "menu",
      "description": "Thin permanent bar across the top of the screen (above the layout). Shows the app logo and holds attached assets (badges, clocks) on its left, center or right; plugins attach more at run time.",
      "required": [
        "height",
        "surface",
        "logo",
        "attach"
      ],
      "enums": {
        "surface": [
          "flat",
          "raised",
          "accent"
        ]
      },
      "nested": {
        "logo": [
          "show",
          "text"
        ]
      },
      "optional": true,
      "hideable": true,
      "attach": {
        "_doc": "data.attach = [{type, id, at: left|center|right, order?}]. Only attachable types (badge, clock) are placed; an entry whose asset doesn't exist is skipped. Runtime attachments (rt.attachToBanner) with the same type+id replace the asset's own.",
        "types": [
          "badge",
          "clock",
          "search-bar"
        ],
        "sides": [
          "left",
          "center",
          "right"
        ]
      },
      "optional_fields": {
        "divider": "boolean — line under the banner (default true)",
        "height": "number — px, 16 to 48 (thin = 24)"
      }
    },
    "clock": {
      "label": "Clock",
      "group": "Widgets",
      "icon": "clock",
      "description": "A clock widget: attaches to banners and toolbars (any widget host).",
      "required": [
        "format",
        "seconds",
        "date"
      ],
      "enums": {
        "format": [
          "24h",
          "12h"
        ],
        "date": [
          "none",
          "short",
          "weekday"
        ]
      },
      "optional": true,
      "attachable": true,
      "roll": {
        "slot": false,
        "asset": false
      },
      "optional_fields": {
        "timezone": "string — IANA zone (e.g. America/New_York); default the device's",
        "mono": "boolean — monospace digits (default true)"
      },
      "widget": true
    },
    "search-bar": {
      "label": "Search bar",
      "group": "Widgets",
      "icon": "search",
      "description": "A search bar widget: searches the whole app (views, settings, actions, assets, windows, words on the page, and anything a module adds, e.g. the console's plan features, pending builds and plugins). Attaches to banners and toolbars.",
      "required": [
        "placeholder",
        "maxResults",
        "width"
      ],
      "enums": {
        "width": [
          "compact",
          "regular",
          "wide"
        ]
      },
      "optional": true,
      "attachable": true,
      "widget": true,
      "roll": {
        "slot": false,
        "asset": false
      },
      "optional_fields": {
        "kinds": "string[] — only these result kinds (default: all)",
        "shortcut": "boolean — Ctrl/Cmd+K and / focus it (default true)"
      }
    },
    "badge": {
      "label": "Badge",
      "group": "Chrome",
      "icon": "star",
      "description": "A small status badge (icon, label, tone) that attaches to the banner. Plugins supply their own badges.",
      "required": [
        "icon",
        "label",
        "tone",
        "shape"
      ],
      "enums": {
        "tone": [
          "neutral",
          "success",
          "warning",
          "danger",
          "accent",
          "muted"
        ],
        "shape": [
          "pill",
          "icon",
          "dot"
        ]
      },
      "optional": true,
      "attachable": true,
      "roll": {
        "slot": false,
        "asset": false
      },
      "optional_fields": {
        "tooltip": "string — shown on hover/long-press",
        "link": "string — action spec run on tap (e.g. settings.open:x)"
      }
    },
    "uac-policy": {
      "label": "User account control",
      "group": "System",
      "icon": "shield",
      "required": [
        "defaultRole",
        "gating",
        "roles",
        "permissions"
      ],
      "enums": {
        "gating": [
          "hide",
          "disable"
        ]
      }
    }
  },
  "rollDefaults": {
    "_doc": "Randomize rolls. slot = the slot takes part in a roll (randomize all); asset = default for an asset's own `roll` flag. Types may override with their own `roll` block. uac-policy is never rolled.",
    "slot": true,
    "asset": true,
    "never": [
      "uac-policy"
    ]
  },
  "hideDefaults": {
    "_doc": "Hidden slots. A type with \"hideable\": true gets a Hidden choice in Settings → Appearance → Assets; while hidden its chrome is not drawn (the layout drops its region; a hidden context menu leaves the platform's own menu) and rolls skip it. Only chrome types: hiding a theme, layout, control or policy would leave nothing to draw with. Runtime overrides: settings axf.hide.<type> (Kotlin: KV <key>:hide)."
  },
  "attachDefaults": {
    "_doc": "Attachable types (\"attachable\": true) aren't slots you pick in Appearance → Assets: their assets are attached to a host by the host's data or by modules at run time, and they're never rolled. Widgets (\"widget\": true: clock, search bar) attach to banners and toolbars; badges to banners."
  }
}
