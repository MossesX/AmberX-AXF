{
  "frame": "widget-icon-defaults@1",
  "about": "Inventory of every banner and settings widget the Dev Console draws (widget-icons@1, spec/WIDGET-ICONS.md), what it showed before this build, and the default icon each one gets when it has none of its own. Read by resolveWidgetIcon's host (the default stands in as the widget's own icon), the /api/widget-icons routes, the MCP tools and the CLI. Append-only: a new widget adds a row; an id never changes meaning.",
  "inventoried": "2026-11-17",
  "fields": {
    "id": "widget id <host>:<kind>:<id>",
    "owner": "the plugin, library or framework module that attaches it",
    "label": "its name in the Widgets picker",
    "hadIcon": "did it draw an icon before this build",
    "longText": "can it draw text past --fx-size-widget-text-max (24 characters by default)",
    "icon": "its default icon (a framework glyph); the person's pick wins"
  },
