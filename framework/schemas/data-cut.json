{
  "$axf": "data-cut@1",
  "note": "Which data-store@1 keys move onto axf-data's Postgres rows, group by group (framework/spec/DATA-INVENTORY.md, build postgres-part-c-console-state-settings). Run by framework/cli/data-cut.mjs: copy (backfill) → verify (every key's content equal on both sides, read back from its rows; row counts per table) → cutover (flip the entries with flip: true to key-level cutover, data-store-mode@1 keys). An entry is one key (`key`) or every key under a prefix (`prefix`, ends in '/'). `flip: false` = a writer outside the data layer still writes the file (a shell installer, axHub's files API, claude-sync): the key is kept equal on axf-data by `data-cut sync` (cron) and named in `why`, and flips once that writer goes through the data layer. `writers` lists every writer the flip depends on. `table` is the Postgres table (services/axf-data/tables.py) the rows land in.",
  "groups": {
    "console": {
      "title": "Console state, settings, alerts, notifications, home cards, token log, notes, control inventory, AmberX notes, app catalog",
      "step": "postgres-part-c s1 (s4.4)",
      "entries": [
        {
          "key": "console/state.json",
          "table": "console_state",
          "flip": true,
          "writers": [
            "apps/console-web/server/main.py (data_store)",
            "framework/cli/plugin-lifecycle.mjs (data-files)"
          ]
        },
        {
          "key": "console/alerts.json",
          "table": "alerts",
          "flip": true,
          "writers": [
            "apps/console-web/server/alerts.py (data_store)"
          ]
        },
        {
          "key": "console/alerts-seen.json",
          "table": "alerts_seen",
          "flip": true,
          "writers": [
            "apps/console-web/server/alerts.py (data_store)"
          ]
        },
        {
          "key": "console/alerts-run.json",
          "table": "console_state",
          "flip": true,
          "writers": [
            "apps/console-web/server/alerts.py (data_store)"
          ]
        },
        {
          "key": "console/alerts-config.json",
          "table": "console_state",
          "flip": true,
          "writers": [
            "apps/console-web/server/alerts.py (data_store)"
          ]
        },
        {
          "prefix": "console/home-cards/",
          "table": "home_cards",
          "flip": true,
          "writers": [
            "apps/console-web/server/main.py /api/home/layout (data_store)"
          ]
        },
        {
          "key": "console/deploys/log",
          "table": "console_deploys",
          "flip": false,
          "why": "also appended by the deploy scripts (deploy/install-console.sh) before the console runs"
        },
        {
          "key": "console/host-check.json",
          "table": "console_state",
          "flip": false,
          "why": "written by deploy/console-doctor.sh on the host"
        },
        {
          "key": "console/nightly.json",
          "table": "console_state",
          "flip": false,
          "why": "written by deploy/console-nightly.mjs (host cron)"
        },
        {
          "key": "console/update-status.json",
          "table": "console_state",
          "flip": false,
          "why": "written by the install scripts during an update"
        },
        {
          "key": "console/project-wizard.json",
          "table": "console_state",
          "flip": false,
          "why": "written by apps/console-web/plugins/project-wizard/wizard.mjs with plain file writes"
        },
        {
          "key": "console/control/inventory.json",
          "table": "control_targets",
          "flip": false,
          "why": "read from the hub file by axHub (console_open / console_show targets)"
        },
        {
          "key": "console/shared/app-catalog/catalog.json",
          "table": "app_catalog",
          "flip": false,
          "why": "read from /projects/_shared/_data/app-catalog by axHub and the AmberX app"
        },
        {
          "prefix": "settings/",
          "table": "settings",
          "flip": false,
          "why": "hub-settings@1 is written by every app through axHub's files API: axf-data becomes the writer's target once axHub routes /projects/_shared/_data/settings to it"
        },
        {
          "prefix": "console/shared/notifications/",
          "table": "notifications",
          "flip": false,
          "why": "the inbox is written through axHub (AmberX push) and activity/server/complete.py"
        },
        {
          "prefix": "console/token-log/",
          "table": "token_log",
          "flip": false,
          "why": "token-turn@1 lines are appended by axHub"
        },
        {
          "prefix": "console/amberx-notes/",
          "table": "amberx_notes",
          "flip": false,
          "why": "hub-table@1 chunks written by the AmberX app through axHub"
        },
        {
          "prefix": "notes/",
          "table": "notes",
          "flip": false,
          "why": "the hub copy is also written by claude-sync from every session"
        }
      ]
    },
    "plugins-large": {
      "title": "Large plugin data: Chat viewer, Shipped features ledger, push-banner (lander), agent-swarm, UI Review",
      "step": "postgres-part-c s2 (s4.5a)",
      "entries": [
        {
          "key": "plugins/shipped-features/ledger.sqlite",
          "table": "ledger_*",
          "flip": true,
          "writers": [
            "apps/console-web/plugins/shipped-features/server (data_store.sqlite_upload)",
            "apps/console-web/plugins/shipped-features/ledger/db.mjs (data-files sqliteUpload)"
          ],
          "note": "every upload is exploded into the ledger_* rows on axf-data (blob-sqlite mirror); in cutover the plugin opens axf-data's copy (sqlite_hydrate)"
        },
        {
          "key": "plugins/chat-viewer/chats.db",
          "table": "chats_*",
          "flip": false,
          "why": "over the 256 MiB blob limit (683 MB): it never travels as a blob; mirror_sync explodes the mounted file into the chats_* rows hourly and on demand (axf data tables --sync chats)"
        },
        {
          "prefix": "console/chat-viewer/audio/",
          "table": "chat_audio",
          "flip": false,
          "why": "written by the Chat viewer through axHub's files API (hub _data/chat-viewer/audio)"
        },
        {
          "key": "plugins/agent-swarm/runs.json",
          "table": "swarm_runs",
          "flip": true,
          "writers": [
            "apps/console-web/plugins/agent-swarm/swarm.mjs writeJson (data-files)"
          ]
        },
        {
          "key": "plugins/agent-swarm/state.json",
          "table": "swarm_messages",
          "flip": true,
          "writers": [
            "apps/console-web/plugins/agent-swarm/swarm.mjs withState / writeJson (data-files)"
          ]
        },
        {
          "key": "plugins/agent-swarm/sections-said.json",
          "table": "swarm_sections_said",
          "flip": true,
          "writers": [
            "apps/console-web/plugins/agent-swarm/sections.mjs via swarm.mjs writeJson (data-files)"
          ]
        },
        {
          "prefix": "plugins/agent-swarm/job-briefs/",
          "table": "swarm_jobs",
          "flip": true,
          "writers": [
            "apps/console-web/plugins/agent-swarm/jobs.mjs (data-files writeTextSync)"
          ]
        },
        {
          "prefix": "plugins/agent-swarm/job-reports/",
          "table": "swarm_jobs",
          "flip": true,
          "writers": [
            "apps/console-web/plugins/agent-swarm/jobs.mjs (data-files writeTextSync)"
          ]
        },
        {
          "key": "plugins/push-banner/land.json",
          "table": "land_items",
          "flip": true,
          "writers": [
            "apps/console-web/plugins/push-banner/land/land.mjs (data-files)",
            "push-banner server (data_store)"
          ]
        },
        {
          "key": "plugins/push-banner/merge-queue.json",
          "table": "merge_queue",
          "flip": true,
          "writers": [
            "apps/console-web/plugins/push-banner/land/merge-queue.mjs (data-files)",
            "push-banner server (data_store)"
          ]
        },
        {
          "key": "plugins/push-banner/land-control.json",
          "table": "plugin_settings",
          "flip": true,
          "writers": [
            "gate/gate-store.mjs, land/land.mjs, land/merge-queue.mjs (data-files)",
            "push-banner server (data_store)"
          ]
        },
        {
          "key": "plugins/push-banner/merge-queue-control.json",
          "table": "plugin_settings",
          "flip": true,
          "writers": [
            "gate/gate-store.mjs, land/merge-queue.mjs (data-files)",
            "push-banner server (data_store)"
          ]
        },
        {
          "key": "plugins/push-banner/config.json",
          "table": "plugin_settings",
          "flip": true,
          "writers": [
            "push-banner server (data_store)"
          ]
        },
        {
          "key": "plugins/push-banner/done.json",
          "table": "plugin_settings",
          "flip": true,
          "writers": [
            "push-banner server (data_store)"
          ]
        },
        {
          "key": "plugins/push-banner/failed.json",
          "table": "plugin_settings",
          "flip": true,
          "writers": [
            "push-banner server (data_store)"
          ]
        },
        {
          "key": "plugins/push-banner/auto-merge.json",
          "table": "plugin_settings",
          "flip": true,
          "writers": [
            "push-banner server (data_store)"
          ]
        },
        {
          "key": "plugins/push-banner/protection.json",
          "table": "plugin_settings",
          "flip": true,
          "writers": [
            "push-banner server (data_store)"
          ]
        },
        {
          "key": "plugins/push-banner/landing-line.json",
          "table": "landing_line",
          "flip": false,
          "why": "its writer is not in this repository's console plugins (the landing-line runner); flips once it writes through data-files"
        },
        {
          "key": "plugins/push-banner/lander-control.json",
          "table": "plugin_settings",
          "flip": false,
          "why": "its writer is not in this repository's console plugins"
        },
        {
          "prefix": "plugins/push-banner/",
          "table": "land_log",
          "flip": false,
          "why": "the remaining files: land-runs / land-batches / gate-log journals appended by gate-store.mjs and the gate runner with plain appends, settings.json"
        },
        {
          "key": "ui-review/items.json",
          "table": "ui_review_items",
          "flip": true,
          "writers": [
            "apps/console-web/plugins/ui-review/server (data_store)",
            "apps/console-web/plugins/ui-review/review.mjs (data-files)"
          ]
        },
        {
          "key": "ui-review/screenshots/index.json",
          "table": "ui_review_screenshots",
          "flip": false,
          "why": "also written by framework/cli shot tools (axf shot) with plain file writes"
        },
        {
          "prefix": "ui-review/",
          "table": "ui_review_shots",
          "flip": false,
          "why": "images, option assets and predictions written by the screenshot tools and the review runner with plain file writes; the images are blobs listed by the ui_review_shots view"
        }
      ]
    },
    "plugins-rest": {
      "title": "The remaining plugin data folders, plugin_settings and plugin_audit",
      "step": "postgres-part-c s3 (s4.5b)",
      "entries": [
        {
          "prefix": "plugins/todo-manager/",
          "table": "todo_items",
          "flip": true,
          "writers": [
            "apps/console-web/plugins/todo-manager/server/model.py (axf_server.storage → data_store)"
          ]
        },
        {
          "key": "plugins/whats-shipped/feed.json",
          "table": "shipped_feed",
          "flip": true,
          "writers": [
            "apps/console-web/plugins/whats-shipped/server (axf_server.storage → data_store)"
          ]
        },
        {
          "key": "plugins/whats-shipped/pr-files.json",
          "table": "plugin_settings",
          "flip": true,
          "writers": [
            "apps/console-web/plugins/whats-shipped/server (axf_server.storage → data_store)"
          ]
        },
        {
          "key": "plugins/systems-check/health-state.json",
          "table": "health_checks",
          "flip": true,
          "writers": [
            "apps/console-web/plugins/systems-check/server/health.py (axf_server.storage → data_store)"
          ]
        },
        {
          "key": "plugins/systems-check/settings.json",
          "table": "plugin_settings",
          "flip": true,
          "writers": [
            "apps/console-web/plugins/systems-check/server/store.py (axf_server.storage → data_store)",
            "systems-check/hooks.mjs (install: writes the default only when none exists)"
          ]
        },
        {
          "key": "plugins/systems-check/routine.json",
          "table": "plugin_settings",
          "flip": true,
          "writers": [
            "apps/console-web/plugins/systems-check/server/store.py (axf_server.storage → data_store), delete via data_store.remove"
          ]
        },
        {
          "prefix": "plugins/claude-settings/",
          "table": "plugin_audit",
          "flip": true,
          "writers": [
            "apps/console-web/plugins/claude-settings (data_store)"
          ]
        },
        {
          "prefix": "phone/devices/",
          "table": "phone_devices",
          "flip": true,
          "writers": [
            "apps/console-web/plugins/phone-connect/server/store.py (data_store)"
          ]
        },
        {
          "prefix": "phone/pairings/",
          "table": "phone_pairings",
          "flip": true,
          "writers": [
            "apps/console-web/plugins/phone-connect/server/store.py (data_store)"
          ]
        },
        {
          "prefix": "phone/commands/",
          "table": "phone_commands",
          "flip": true,
          "writers": [
            "apps/console-web/plugins/phone-connect/server/store.py (data_store)"
          ]
        },
        {
          "key": "phone/aliases.json",
          "table": "",
          "flip": true,
          "writers": [
            "apps/console-web/plugins/phone-connect/server/store.py (data_store)"
          ]
        },
        {
          "key": "phone/log",
          "table": "phone_log",
          "flip": true,
          "writers": [
            "apps/console-web/plugins/phone-connect/server/store.py (data_store.append_jsonl)"
          ]
        },
        {
          "prefix": "plugins/systems-check/",
          "table": "plugin_docs",
          "flip": false,
          "why": "whatsnew/ is pruned with a directory glob (store.py save_summary): needs data_store.list_files before it flips"
        },
        {
          "prefix": "plugins/agent-manager/",
          "table": "agent_runs",
          "flip": false,
          "why": "memory/ and the library are listed with directory globs and addons.py / gittools.py write files directly"
        },
        {
          "prefix": "plugins/ai-assistant/",
          "table": "plugin_docs",
          "flip": false,
          "why": "conversations are listed with a directory index (store.py _index) and hooks.mjs writes config.json directly"
        },
        {
          "prefix": "plugins/activity/",
          "table": "plugin_docs",
          "flip": false,
          "why": "reports, hooks and seen files are also written with plain file writes (10 call sites)"
        },
        {
          "prefix": "plugins/claude-accounts/",
          "table": "worker_accounts",
          "flip": false,
          "why": "written by framework/cli account tools with plain file writes"
        },
        {
          "prefix": "plugins/claude-handoff/",
          "table": "plugin_docs",
          "flip": false,
          "why": "written by handoff.mjs with plain file writes"
        },
        {
          "prefix": "plugins/console-terminal/",
          "table": "terminal_feeds",
          "flip": false,
          "why": "store.py still writes through axf_server.storage and the terminal runner appends sessions.jsonl directly; ssh/ holds keys (secrets, never moved)"
        },
        {
          "prefix": "plugins/glossary-index/",
          "table": "glossary_terms",
          "flip": false,
          "why": "catalog.json is generated by the glossary indexer with plain file writes"
        },
        {
          "prefix": "plugins/maintenance/",
          "table": "plugin_docs",
          "flip": false,
          "why": "plans and snapshots written by maintenance scripts with plain file writes"
        },
        {
          "prefix": "plugins/console-commands/",
          "table": "command_catalog",
          "flip": false,
          "why": "catalog-owner.json and audit.jsonl written with plain file writes"
        },
        {
          "prefix": "plugins/plugin-commands/",
          "table": "plugin_audit",
          "flip": false,
          "why": "audit.jsonl appended with plain writes"
        },
        {
          "prefix": "plugins/token-control/",
          "table": "plugin_audit",
          "flip": false,
          "why": "passes and audit written with plain writes (5 modules); the salt is a secret and stays local"
        },
        {
          "prefix": "plugins/container-access/",
          "table": "plugin_audit",
          "flip": false,
          "why": "batches and audit also written with plain writes"
        },
        {
          "prefix": "plugins/approvals-banner/",
          "table": "plugin_audit",
          "flip": false,
          "why": "relay.jsonl appended by the approvals relay with plain writes"
        },
        {
          "prefix": "plugins/gate/",
          "table": "plugin_audit",
          "flip": false,
          "why": "history.jsonl is rewritten whole by gate-store.mjs writeHistory (a journal is append-only on axf-data)"
        },
        {
          "prefix": "plugins/snapshot-manager/",
          "table": "plugin_docs",
          "flip": false,
          "why": "snapshots also written with plain writes"
        },
        {
          "prefix": "plugins/",
          "table": "plugin_settings",
          "flip": false,
          "why": "every other plugin's small files (molly, plan-studio, brand-library, follow-amber, agent-voice, wake-listener…): mirrored until each plugin's writer moves"
        }
      ]
    }
  }
}
