{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amberx.ai/axf/schemas/build-live.json",
  "title": "build-live@1: build changes and liveness on the console live channel (build-live-event@1, build-live-state@1, build-live-snapshot@1)",
  "description": "Every builds store change and every 15-second liveness pass the VPS makes is one build-live-event@1 frame on the console live channel (SSE event build-live, id = seq); framework/core/engines/build-live.mjs folds the stream into one build-live-state@1 per build (idle, running, stale, broke, done) that every grid row, the broke alert and the dialog read. Liveness reuses the recovery watchdog's cause (build-watchdog@1) and the stale-row watchdog's verdict (stale-row@1) and adds no check of its own. Spec: framework/spec/BUILD-LIVE.md.",
  "type": "object",
  "$ref": "#/$defs/event",
  "$defs": {
    "iso": {
      "type": "string",
      "format": "date-time"
    },
    "isoOrNone": {
      "type": "string",
      "description": "ISO date-time, or \"\" for none"
    },
    "buildId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
    },
    "kind": {
      "enum": [
        "change",
        "liveness",
        "watchdog",
        "snapshot"
      ]
    },
    "status": {
      "enum": [
        "pending",
        "queued",
        "running",
        "waiting",
        "fixing",
        "blocked",
        "failed",
        "built",
        "landing",
        "landed",
        "complete",
        "escalated",
        "archived"
      ]
    },
    "alive": {
      "enum": [
        "alive",
        "stale",
        "dead",
        "unknown",
        "none"
      ]
    },
    "cause": {
      "enum": [
        "",
        "usage-limit",
        "auth-failed",
        "exit-clean",
        "exit-killed",
        "exit-oom",
        "exit-failed",
        "tmux-missing",
        "pid-gone",
        "stale-heartbeat",
        "starting",
        "live",
        "unknown"
      ]
    },
    "watchdogAction": {
      "enum": [
        "",
        "none",
        "requeue",
        "retry",
        "retry-other-account",
        "kill-retry",
        "give-up"
      ]
    },
    "change": {
      "enum": [
        "",
        "created",
        "steps-added",
        "step-done",
        "status",
        "pr-opened",
        "pr-merged",
        "addendum",
        "cancelled",
        "restored",
        "shipped"
      ]
    },
    "state": {
      "title": "build-live-state@1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$axf",
        "build",
        "status",
        "state",
        "alive",
        "at",
        "seq"
      ],
      "properties": {
        "$axf": {
          "const": "build-live-state@1"
        },
        "build": {
          "$ref": "#/$defs/buildId"
        },
        "title": {
          "type": "string",
          "maxLength": 160
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "step": {
          "$ref": "#/$defs/step"
        },
        "lastStep": {
          "$ref": "#/$defs/lastStep"
        },
        "alive": {
          "$ref": "#/$defs/alive"
        },
        "cause": {
          "$ref": "#/$defs/cause"
        },
        "exit": {
          "type": [
            "integer",
            "null"
          ]
        },
        "signal": {
          "type": "string",
          "maxLength": 8
        },
        "watchdog": {
          "$ref": "#/$defs/watchdog"
        },
        "stale": {
          "$ref": "#/$defs/stale"
        },
        "broke": {
          "$ref": "#/$defs/broke"
        },
        "lastBroke": {
          "$ref": "#/$defs/broke"
        },
        "recovering": {
          "type": "boolean"
        },
        "lastChange": {
          "$ref": "#/$defs/lastChange"
        },
        "at": {
          "$ref": "#/$defs/isoOrNone"
        },
        "checkedAt": {
          "$ref": "#/$defs/isoOrNone"
        },
        "seen": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "change": {
              "$ref": "#/$defs/isoOrNone"
            },
            "liveness": {
              "$ref": "#/$defs/isoOrNone"
            },
            "watchdog": {
              "$ref": "#/$defs/isoOrNone"
            },
            "snapshot": {
              "$ref": "#/$defs/isoOrNone"
            }
          },
          "description": "the newest `at` folded per kind: an older frame of a kind is dropped"
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "events": {
          "type": "integer",
          "minimum": 0
        },
        "note": {
          "type": "string",
          "maxLength": 400
        },
        "line": {
          "type": "string",
          "maxLength": 300
        }
      }
    },
    "step": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "phase": {
          "type": "string",
          "maxLength": 80
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "lastStep": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "doneAt": {
          "$ref": "#/$defs/isoOrNone"
        }
      }
    },
    "watchdog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action"
      ],
      "properties": {
        "action": {
          "$ref": "#/$defs/watchdogAction"
        },
        "attempt": {
          "type": "integer",
          "minimum": 0
        },
        "note": {
          "type": "string",
          "maxLength": 400
        },
        "at": {
          "$ref": "#/$defs/isoOrNone"
        }
      }
    },
    "stale": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "action",
        "reason"
      ],
      "properties": {
        "action": {
          "enum": [
            "keep",
            "complete",
            "remove"
          ]
        },
        "reason": {
          "enum": [
            "invalid-row",
            "live",
            "pr-merged",
            "on-main",
            "build-complete",
            "pr-closed",
            "build-failed",
            "build-cancelled",
            "own-status",
            "no-facts",
            "open"
          ]
        }
      }
    },
    "broke": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "at",
        "cause",
        "what"
      ],
      "properties": {
        "at": {
          "$ref": "#/$defs/iso"
        },
        "cause": {
          "$ref": "#/$defs/cause"
        },
        "exit": {
          "type": [
            "integer",
            "null"
          ]
        },
        "signal": {
          "type": "string",
          "maxLength": 8
        },
        "what": {
          "type": "string",
          "maxLength": 400
        },
        "recovering": {
          "type": "boolean"
        }
      }
    },
    "lastChange": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "event",
        "at"
      ],
      "properties": {
        "event": {
          "$ref": "#/$defs/change"
        },
        "at": {
          "$ref": "#/$defs/iso"
        },
        "by": {
          "type": "string",
          "maxLength": 80
        }
      }
    },
    "event": {
      "title": "build-live-event@1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$axf",
        "id",
        "seq",
        "kind",
        "build",
        "at",
        "status",
        "alive"
      ],
      "properties": {
        "$axf": {
          "const": "build-live-event@1"
        },
        "id": {
          "type": "string",
          "maxLength": 200,
          "description": "<build>:<kind>:<seq>: stable, so a replayed frame is folded once"
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "description": "channel-wide, monotonic on the publishing host; the SSE id"
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "build": {
          "$ref": "#/$defs/buildId"
        },
        "title": {
          "type": "string",
          "maxLength": 160
        },
        "at": {
          "$ref": "#/$defs/iso"
        },
        "by": {
          "type": "string",
          "maxLength": 80,
          "description": "liveness | watchdog | store:<by> | snapshot"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "step": {
          "$ref": "#/$defs/step"
        },
        "lastStep": {
          "$ref": "#/$defs/lastStep"
        },
        "alive": {
          "$ref": "#/$defs/alive"
        },
        "cause": {
          "$ref": "#/$defs/cause"
        },
        "exit": {
          "type": [
            "integer",
            "null"
          ]
        },
        "signal": {
          "type": "string",
          "maxLength": 8
        },
        "watchdog": {
          "$ref": "#/$defs/watchdog"
        },
        "stale": {
          "$ref": "#/$defs/stale"
        },
        "change": {
          "$ref": "#/$defs/change"
        },
        "everySec": {
          "anyOf": [
            {
              "const": 0
            },
            {
              "type": "integer",
              "minimum": 5,
              "maximum": 300
            }
          ],
          "description": "how often the liveness pass runs (15); carried on liveness and snapshot, 0 = not carried"
        },
        "note": {
          "type": "string",
          "maxLength": 400
        }
      }
    },
    "snapshot": {
      "title": "build-live-snapshot@1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$axf",
        "at",
        "seq",
        "everySec",
        "builds"
      ],
      "properties": {
        "$axf": {
          "const": "build-live-snapshot@1"
        },
        "at": {
          "$ref": "#/$defs/iso"
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "everySec": {
          "anyOf": [
            {
              "const": 0
            },
            {
              "type": "integer",
              "minimum": 5,
              "maximum": 300
            }
          ],
          "description": "how often the liveness pass runs (15); carried on liveness and snapshot, 0 = not carried"
        },
        "builds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/state"
          }
        }
      }
    }
  }
}
