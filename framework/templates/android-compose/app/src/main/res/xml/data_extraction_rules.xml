<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Same exclusions as backup_rules.xml: secrets and WebView sessions never leave the phone. -->
    <cloud-backup><exclude domain="sharedpref" path="axf.secure.xml" /><exclude domain="root" path="app_webview/" /></cloud-backup>
    <device-transfer><exclude domain="sharedpref" path="axf.secure.xml" /><exclude domain="root" path="app_webview/" /></device-transfer>
</data-extraction-rules>
