        "module": "lib-lock",
        "name": "App lock (fingerprint/face or PIN)",
        "description": "Second-step unlock any app can put after its own first step: strong biometrics through BiometricPrompt, or a 4–12 digit PIN kept only as a salted PBKDF2 hash in the Keystore-backed secure store. Failed PINs lock out with a doubling delay. Settings group App lock (mode, auto-lock delay) and a set/change PIN screen (current PIN required to change). Fills the platform's android.biometric placeholder.",
        "features": [
          "u.bio"
        ],
        "dependsOn": [],
        "manifestKey": "libraries.lock",
        "params": [
          {
            "key": "defaultMode",
            "label": "Default second step",
            "type": "choice",
            "choices": [
              "none",
              "biometric",
              "pin"
            ],
            "default": "none",
            "required": true
          }
        ],
        "install": {
          "gradle": "implementation(\"ai.amberx.axf:lib-lock:$axf\")",
          "module": "LockModule()",
          "import": "ai.amberx.axf.lock.LockModule",
          "routes": [
            "lock-pin"
          ]
        },
        "placeholders": [
          {
            "capability": "axf.lock.keybound",
            "note": "Keystore keys that need the fingerprint for every decrypt (CryptoObject). Not built: the lock gates the UI; data keys don't require auth yet."
          }
        ]
      },
      {
        "$axf": "library@1",
        "id": "ai.amberx.axf.mcp",
        "module": "lib-mcp",
        "name": "MCP client (connect to MCP servers)",
        "description": "Any AXF app as an MCP client: a server registry (records in the key-value store, tokens only in the platform secure store), Streamable HTTP sessions (JSON-RPC, SSE replies, session ids, version negotiation, pagination, cancellation, timeouts), browsing tools/resources/prompts and calling tools under the kernel interop exposure rules (mcp.call / mcp.call.write / mcp.call.destructive + confirmation). Pure-Kotlin engine in the kernel (ai.amberx.axf.kernel.mcp) mirrors framework/core/engines/mcp.ts and framework/python/axf_libs/mcp; all three replay spec/fixtures/mcp-client.json. Registers the kernel's axf.remote (RemoteServices) provider.",
        "features": [
          "w.mcp",
          "f.interop.remote"
        ],
        "dependsOn": [
          "ai.amberx.axf.network"
        ],
        "manifestKey": "libraries.mcp",
        "params": [
          {
            "key": "timeoutMs",
            "label": "Call timeout (ms)",
            "type": "number",
            "default": 30000,
            "min": 1000,
            "max": 600000
          }
        ],
        "install": {
          "gradle": "implementation(\"ai.amberx.axf:lib-mcp:$axf\")",
          "module": "McpModule()",
          "import": "ai.amberx.axf.mcp.McpModule",
          "routes": [
            "mcp",
            "mcp-servers"
          ]
        },
        "ports": {
          "android": {
            "status": "scaffolded",
