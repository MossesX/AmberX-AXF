        "kind": "mask",
        "mask": "  M 0 0  L 100 0\n L 100 100 Z ",
        "viewBox": "0 0 100 100"
      },
      "expected": {
        "kind": "mask",
        "mask": "M 0 0 L 100 0 L 100 100 Z"
