{
  "$axf": "shape@1",
  "_doc": "shape@1 reference outputs (core/engines/shape-rules.mjs + core/engines/shape.ts). Every port replays these: normalizeShape, shapeErrors, shapeRadius, shapeClip, shapeMask, shapeSquare, compileShape (slot widget). Regenerate with `npx -y tsx framework/spec/check-shape.mts --write`.",
  "cases": [
    {
      "fn": "normalizeShape",
      "name": "nothing = the default pill",
      "input": null,
      "expected": {
        "kind": "pill"
      }
    },
    {
      "fn": "normalizeShape",
      "name": "unknown kind = the default",
      "input": {
        "kind": "blob"
      },
      "expected": {
        "kind": "pill"
      }
    },
    {
      "fn": "normalizeShape",
      "name": "unknown fields dropped",
      "input": {
        "kind": "hexagon",
        "bogus": 1
      },
      "expected": {
        "kind": "hexagon"
      }
    },
    {
      "fn": "normalizeShape",
      "name": "bad corners dropped, good kept",
      "input": {
        "kind": "rounded",
        "corners": {
          "tl": "lg",
          "tr": "huge",
          "zz": "sm",
          "bl": 12
        }
      },
      "expected": {
        "kind": "rounded",
        "corners": {
          "tl": "lg"
        }
      }
    },
    {
      "fn": "normalizeShape",
      "name": "corners kind keeps its corners",
      "input": {
        "kind": "corners",
        "corners": {
          "tl": "pill",
          "br": "pill"
        }
      },
      "expected": {
        "kind": "corners",
        "corners": {
          "tl": "pill",
          "br": "pill"
        }
      }
    },
    {
      "fn": "normalizeShape",
      "name": "bad mask dropped",
      "input": {
        "kind": "mask",
        "mask": "url(javascript:1)"
      },
      "expected": {
        "kind": "mask"
      }
    },
