{
  "$axf": "plugin-package-fixture@1",
  "reference": "framework/cli/plugin-catalog.mjs verifyPackage (Python port: framework/python/axf_server/plugin_package.py)",
  "limits": {
    "files": 600,
    "fileBytes": 2097152,
    "totalBytes": 8388608,
    "pathChars": 200
  },
  "kinds": {
    "console": {
      "label": "Dev Console plugin",
      "manifest": "plugin@1",
      "allow": null
    },
    "pilot": {
      "label": "Build Pilot plugin",
      "manifest": "pilot-plugin@1",
      "allow": "^(plugin\\.json|README\\.md|web\\/.+)$"
    }
  },
  "pathProblems": [
    {
      "kind": "console",
      "path": "plugin.json",
      "expect": ""
    },
    {
      "kind": "pilot",
      "path": "plugin.json",
      "expect": ""
    },
    {
      "kind": "console",
      "path": "web/a b.ts",
      "expect": "web/a b.ts: \"a b.ts\" is not allowed in a plugin path"
    },
    {
      "kind": "pilot",
      "path": "web/a b.ts",
      "expect": "web/a b.ts: \"a b.ts\" is not allowed in a plugin path"
    },
    {
      "kind": "console",
      "path": "web/ok-1_2@3+4.ts",
      "expect": ""
    },
    {
      "kind": "pilot",
      "path": "web/ok-1_2@3+4.ts",
      "expect": ""
    },
    {
      "kind": "console",
      "path": "dist/x.js",
      "expect": "dist/x.js: dist is never shipped"
    },
    {
      "kind": "pilot",
      "path": "dist/x.js",
      "expect": "dist/x.js: dist is never shipped"
    },
    {
      "kind": "console",
      "path": "a//b",
      "expect": "a//b: \"\" is not allowed in a plugin path"
    },
    {
      "kind": "pilot",
      "path": "a//b",
      "expect": "a//b: \"\" is not allowed in a plugin path"
    },
    {
      "kind": "console",
      "path": "",
      "expect": "empty path"
    },
    {
      "kind": "pilot",
      "path": "",
      "expect": "empty path"
    },
    {
      "kind": "console",
      "path": "web/app.KEY",
      "expect": "web/app.KEY: looks like a secret and is never shipped"
    },
    {
      "kind": "pilot",
      "path": "web/app.KEY",
      "expect": "web/app.KEY: looks like a secret and is never shipped"
    },
    {
      "kind": "console",
      "path": "README.md",
      "expect": ""
    },
    {
      "kind": "pilot",
      "path": "README.md",
      "expect": ""
    }
  ],
  "cases": [
