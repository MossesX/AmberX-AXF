 "fields": {
  "override": {
   "kind": "boolean",
   "default": true,
   "title": "Override the shared menus",
   "text": "Show the generated menus instead of the app’s shared app-menu and nav-menu assets."
  },
  "maxPerLevel": {
   "kind": "number",
   "min": 4,
   "max": 30,
   "default": 12,
   "title": "Rows per level",
   "text": "The most rows a menu or sub menu shows before the rest goes into sub menus."
  },
  "recentsMax": {
   "kind": "number",
   "min": 0,
   "max": 24,
   "default": 8,
   "title": "Recents kept",
   "text": "How many recently opened pages and dialogs the Recent list keeps (0 hides it)."
  },
  "showFavorites": {
   "kind": "boolean",
   "default": true,
   "title": "Favourites on top",
   "text": "A Favourites list first in the navigation and in the Start menu."
  },
  "showRecents": {
   "kind": "boolean",
   "default": true,
   "title": "Recent on top",
   "text": "A Recent list after Favourites."
  },
  "groupByPlugin": {
   "kind": "boolean",
   "default": true,
   "title": "Group by plugin",
   "text": "When a category is over the cap, a plugin with several entries becomes its own sub menu."
  },
  "style": {
   "kind": "enum",
   "options": [
    "list",
    "rail",
    "pills"
   ],
   "default": "list",
   "title": "Navigation style",
   "text": "How the generated navigation is drawn."
  },
  "hidden": {
   "kind": "list",
   "default": [],
   "title": "Hidden",
   "text": "Category ids or entry ids left out of the generated menus."
  },
  "favorites": {
   "kind": "list",
   "default": [],
   "title": "Favourites",
   "text": "Entry ids pinned to the Favourites list, in order."
  }
 },
