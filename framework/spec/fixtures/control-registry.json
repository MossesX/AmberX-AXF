{
  "$axf": "control-registry-fixture@1",
  "readme": "Replayed by framework/spec/check-control-registry.mjs: a small index (entries) and what the deterministic dispatcher must answer for each input (cases). A port (the AmberX twin, PORTING.md) replays the same file. Inputs: a string = a phrase, a list = a CLI argv, an object = a command { id, action, params }.",
  "entries": [
    { "id": "console-web/page/plan-studio", "type": "page", "owner": "console-web", "label": "Plan Studio", "description": "Every plan in one place.",
      "where": { "app": "console-web", "plugin": "plan-studio", "view": "plan-studio", "file": "apps/console-web/plugins/plan-studio/plugin.json" },
      "open": { "kind": "screen", "target": "plan-studio", "deepLink": "?axf-view=plan-studio" },
      "state": { "read": "plan-studio/plans", "shape": "the plans" },
      "actions": [ { "id": "open", "label": "Open Plan Studio", "effect": "navigate", "run": "view:plan-studio", "phrases": ["open plan studio", "plans"], "surfaces": { "mcp": "console_open", "cli": "axf console open plan-studio" } } ],
      "aliases": ["view:plan-studio", "plans"], "keywords": ["plans", "planner"], "tags": ["view"], "source": { "kind": "plugin-manifest", "file": "apps/console-web/plugins/plan-studio/plugin.json", "frame": "plugin@1" } },
    { "id": "console-web/page/build-orchestrator", "type": "page", "owner": "console-web", "label": "Build orchestrator",
      "where": { "app": "console-web", "plugin": "build-orchestrator", "view": "build-orchestrator" },
      "open": { "kind": "screen", "target": "build-orchestrator", "deepLink": "?axf-view=build-orchestrator" },
      "actions": [ { "id": "open", "effect": "navigate", "run": "view:build-orchestrator" } ],
      "synonyms": ["orchestrator"], "source": { "kind": "plugin-manifest" } },
    { "id": "console-web/page/builds", "type": "page", "owner": "console-web", "label": "Builds",
      "where": { "app": "console-web", "plugin": "builds-page", "view": "builds" },
      "open": { "kind": "screen", "target": "builds", "deepLink": "?axf-view=builds" },
      "actions": [ { "id": "open", "effect": "navigate", "run": "view:builds" } ], "source": { "kind": "plugin-manifest" } },
    { "id": "console-web/setting/axf.display.fontScale", "type": "setting", "owner": "console-web", "label": "Font scale",
      "where": { "app": "console-web", "settingsTab": "appearance" },
      "open": { "kind": "settings", "target": "appearance", "anchor": "setting:axf.display.fontScale", "deepLink": "?axf-settings=appearance" },
      "state": { "read": "value:axf.display.fontScale", "fields": [ { "name": "value", "type": "number", "min": 0.8, "max": 1.6, "step": 0.1, "default": 1 } ] },
      "actions": [
        { "id": "read", "effect": "read", "run": "value:axf.display.fontScale" },
        { "id": "set", "effect": "write", "run": "value:axf.display.fontScale", "params": [ { "name": "value", "type": "number", "min": 0.8, "max": 1.6, "step": 0.1, "required": true, "position": 0 } ], "phrases": ["set font scale to {value}", "font scale {value}"] },
        { "id": "reset", "effect": "write", "run": "control:console.values/reset/axf.display.fontScale" } ],
      "synonyms": ["text size"], "source": { "kind": "control", "frame": "control@1" } },
    { "id": "console-web/plugin/follow-amber", "type": "plugin", "owner": "console-web", "label": "Follow Amber",
      "where": { "app": "console-web", "plugin": "follow-amber" },
      "open": { "kind": "settings", "target": "plugins/follow-amber", "deepLink": "?axf-settings=plugins/follow-amber" },
      "state": { "read": "follow-amber/info" },
      "actions": [ { "id": "open", "effect": "navigate", "run": "settings:plugins/follow-amber" }, { "id": "info", "effect": "read", "run": "follow-amber/info" } ],
      "aliases": ["follow-amber"], "source": { "kind": "plugin-manifest", "frame": "plugin@1" } },
    { "id": "console-web/display/tokens.theme", "type": "display", "owner": "console-web", "label": "Colour theme tokens",
      "where": { "app": "console-web", "plugin": "token-control" },
      "state": { "read": "control:tokens.theme/list", "fields": [ { "name": "bg", "type": "color" }, { "name": "accent", "type": "color" } ] },
      "actions": [
        { "id": "list", "effect": "read", "run": "control:tokens.theme/list" },
        { "id": "set", "effect": "write", "run": "control:tokens.theme/set", "params": [ { "name": "path", "type": "enum", "enum": ["bg", "accent"], "required": true, "position": 0 }, { "name": "value", "type": "color", "required": true, "position": 1 } ] } ],
      "aliases": ["tokens.theme", "color-theme"], "synonyms": ["colour theme", "color theme"], "source": { "kind": "control", "frame": "control@1" } },
    { "id": "console-web/tool/follow-amber/switch", "type": "tool", "owner": "console-web", "label": "Turn Follow Amber on or off",
      "where": { "app": "console-web", "plugin": "follow-amber", "route": "POST /api/plugins/follow-amber/state" },
      "actions": [ { "id": "run", "effect": "write", "run": "follow-amber/switch", "params": [ { "name": "on", "type": "boolean", "required": true } ], "aliases": ["toggle"], "surfaces": { "rest": "POST /api/control/follow-amber/switch", "mcp": "follow_amber_switch", "cli": "axf follow-amber switch" } } ],
      "aliases": ["follow-amber/switch"], "synonyms": ["follow amber", "follow me"], "source": { "kind": "plugin-manifest", "frame": "plugin-commands@1" } },
    { "id": "console-web/tool/follow-amber/state", "type": "tool", "owner": "console-web", "label": "Is Follow Amber on",
      "where": { "app": "console-web", "plugin": "follow-amber", "route": "GET /api/plugins/follow-amber/state" },
      "state": { "read": "follow-amber/state" },
      "actions": [ { "id": "read", "effect": "read", "run": "follow-amber/state" } ],
      "aliases": ["follow-amber/state"], "source": { "kind": "plugin-manifest", "frame": "plugin-commands@1" } },
    { "id": "console-web/tool/notes/search", "type": "tool", "owner": "console-web", "label": "Search notes",
      "where": { "app": "console-web", "plugin": "notes-browser" },
      "actions": [ { "id": "run", "effect": "write", "run": "notes-browser/search", "params": [ { "name": "q", "type": "string", "required": true, "position": 0 }, { "name": "body", "type": "object" } ] } ],
      "source": { "kind": "plugin-manifest" } },
    { "id": "console-web/tool/ai-assistant/ask", "type": "tool", "owner": "console-web", "label": "Ask the assistant",
      "where": { "app": "console-web", "plugin": "ai-assistant" }, "needsAI": true,
      "actions": [ { "id": "run", "effect": "write", "run": "ai-assistant/ask", "params": [ { "name": "text", "type": "text", "required": true, "position": 0 } ] } ],
      "synonyms": ["assistant"], "source": { "kind": "plugin-manifest" } },
    { "id": "console-web/tool/amberx.items", "type": "tool", "owner": "console-web", "label": "AmberX notes, to-dos and tasks",
      "where": { "app": "console-web", "plugin": "token-control" },
      "actions": [
        { "id": "list", "effect": "read", "run": "control:amberx.items/list", "params": [ { "name": "kind", "type": "enum", "enum": ["note", "todo", "task"] }, { "name": "status", "type": "enum", "enum": ["open", "doing", "done", "not-done"] }, { "name": "limit", "type": "integer", "min": 1, "max": 500, "default": 50 } ] },
        { "id": "remove", "effect": "destructive", "run": "control:amberx.items/remove", "params": [ { "name": "path", "type": "id", "of": "amberx.items", "required": true, "position": 0 } ] },
        { "id": "move", "effect": "write", "run": "control:amberx.items/act/move", "params": [ { "name": "path", "type": "id", "of": "amberx.items", "required": true, "position": 0 }, { "name": "list", "type": "string", "required": true, "position": 1, "maxLength": 80 } ] } ],
      "aliases": ["amberx.items"], "synonyms": ["notes", "tasks", "todos"], "source": { "kind": "control", "frame": "control@1" } }
  ],
  "cases": [
    { "name": "phrase: verb + label", "input": "open plan studio", "expect": { "ok": true, "entry": "console-web/page/plan-studio", "action": "open", "params": {} } },
    { "name": "phrase: declared phrase alone", "input": "plans", "expect": { "ok": true, "entry": "console-web/page/plan-studio", "action": "open", "params": {} } },
    { "name": "phrase: wake words and politeness ignored", "input": "Hey Amber, open the plan studio screen please", "expect": { "ok": true, "entry": "console-web/page/plan-studio", "action": "open", "params": {} } },
    { "name": "phrase: synonym", "input": "show the orchestrator", "expect": { "ok": true, "entry": "console-web/page/build-orchestrator", "action": "open", "params": {} } },
    { "name": "phrase: exact label beats a longer label sharing the word", "input": "open builds", "expect": { "ok": true, "entry": "console-web/page/builds", "action": "open", "params": {} } },
    { "name": "phrase: slot fills a number within range and step", "input": "set font scale to 1.2", "expect": { "ok": true, "entry": "console-web/setting/axf.display.fontScale", "action": "set", "params": { "value": 1.2 } } },
    { "name": "phrase: short slot form", "input": "font scale 1.3", "expect": { "ok": true, "entry": "console-web/setting/axf.display.fontScale", "action": "set", "params": { "value": 1.3 } } },
    { "name": "phrase: out of range is refused with the allowed values", "input": "set font scale to 9", "expect": { "ok": false, "code": "validation", "entry": "console-web/setting/axf.display.fontScale", "errors": ["value must be at most 1.6"] } },
    { "name": "phrase: off the step grid is refused", "input": "set font scale to 1.25", "expect": { "ok": false, "code": "validation", "entry": "console-web/setting/axf.display.fontScale", "errors": ["value must be in steps of 0.1 from 0.8"] } },
    { "name": "phrase: a read verb on a setting", "input": "what is the font scale", "expect": { "ok": true, "entry": "console-web/setting/axf.display.fontScale", "action": "read", "params": {} } },
    { "name": "phrase: synonym + read", "input": "what's the text size", "expect": { "ok": true, "entry": "console-web/setting/axf.display.fontScale", "action": "read", "params": {} } },
    { "name": "phrase: reset verb", "input": "reset font scale", "expect": { "ok": true, "entry": "console-web/setting/axf.display.fontScale", "action": "reset", "params": {} } },
    { "name": "phrase: trailing on fills the boolean", "input": "turn follow amber on", "expect": { "ok": true, "entry": "console-web/tool/follow-amber/switch", "action": "run", "params": { "on": true } } },
    { "name": "phrase: trailing off", "input": "follow amber off", "expect": { "ok": true, "entry": "console-web/tool/follow-amber/switch", "action": "run", "params": { "on": false } } },
    { "name": "phrase: leading enable", "input": "enable follow me", "expect": { "ok": true, "entry": "console-web/tool/follow-amber/switch", "action": "run", "params": { "on": true } } },
    { "name": "phrase: a name two things share goes to the one that can do the verb", "input": "enable follow amber", "expect": { "ok": true, "entry": "console-web/tool/follow-amber/switch", "action": "run", "params": { "on": true } } },
    { "name": "phrase: open on a shared name goes to the thing that opens", "input": "open follow amber", "expect": { "ok": true, "entry": "console-web/plugin/follow-amber", "action": "open", "params": {} } },
    { "name": "phrase: a bare name two things share goes to the exact label, not the synonym", "input": "follow amber", "expect": { "ok": true, "entry": "console-web/plugin/follow-amber", "action": "open", "params": {} } },
    { "name": "phrase: a required value missing is refused, not guessed", "input": "toggle follow me", "expect": { "ok": false, "code": "validation", "entry": "console-web/tool/follow-amber/switch", "errors": ["on is required: on or off (true / false)"] } },
    { "name": "phrase: nothing matches → not_found with no invented candidates", "input": "open the kitchen sink", "expect": { "ok": false, "code": "not_found", "candidates": [] } },
    { "name": "phrase: a near word gives candidates but no match", "input": "studio", "expect": { "ok": true, "entry": "console-web/page/plan-studio", "action": "open", "params": {} } },
    { "name": "phrase: needsAI action is flagged, never run blindly", "input": "ask the assistant what time it is", "expect": { "ok": false, "code": "needs_ai", "entry": "console-web/tool/ai-assistant/ask" } },
    { "name": "phrase: ambiguous synonym words", "input": "open notes", "expect": { "ok": true, "entry": "console-web/tool/amberx.items", "action": "list", "params": { "limit": 50 } } },
    { "name": "phrase: two positional values, the enum word first", "input": "set the colour theme accent to #ff8800", "expect": { "ok": true, "entry": "console-web/display/tokens.theme", "action": "set", "params": { "path": "accent", "value": "#ff8800" } } },
    { "name": "phrase: a read verb on a plugin falls to info", "input": "what is follow amber", "expect": { "ok": true, "entry": "console-web/plugin/follow-amber", "action": "info", "params": {} } },
    { "name": "cli: plugin + command + flag (the tool, not the plugin entry)", "input": ["follow-amber", "switch", "--on", "off"], "expect": { "ok": true, "entry": "console-web/tool/follow-amber/switch", "action": "run", "params": { "on": false } } },
    { "name": "cli: plugin alone is the plugin entry", "input": ["follow-amber"], "expect": { "ok": true, "entry": "console-web/plugin/follow-amber", "action": "open", "params": {} } },
    { "name": "cli: display set with positionals", "input": ["tokens.theme", "set", "bg", "#101010"], "expect": { "ok": true, "entry": "console-web/display/tokens.theme", "action": "set", "params": { "path": "bg", "value": "#101010" } } },
    { "name": "cli: full id + action + positional", "input": ["console-web/setting/axf.display.fontScale", "set", "1.5"], "expect": { "ok": true, "entry": "console-web/setting/axf.display.fontScale", "action": "set", "params": { "value": 1.5 } } },
    { "name": "cli: alias + default action", "input": ["plans"], "expect": { "ok": true, "entry": "console-web/page/plan-studio", "action": "open", "params": {} } },
    { "name": "cli: enum value by name, default filled", "input": ["amberx.items", "list", "--kind", "task", "--status", "done"], "expect": { "ok": true, "entry": "console-web/tool/amberx.items", "action": "list", "params": { "kind": "task", "status": "done", "limit": 50 } } },
    { "name": "cli: enum value outside the list is refused", "input": ["amberx.items", "list", "--kind", "idea"], "expect": { "ok": false, "code": "validation", "entry": "console-web/tool/amberx.items", "errors": ["kind must be one of: note, todo, task (got \"idea\")"] } },
    { "name": "cli: positional parameters in order", "input": ["amberx.items", "move", "n-123", "Inbox"], "expect": { "ok": true, "entry": "console-web/tool/amberx.items", "action": "move", "params": { "path": "n-123", "list": "Inbox" } } },
    { "name": "cli: unknown flag refused with the list it takes", "input": ["follow-amber", "switch", "--on", "true", "--loud", "yes"], "expect": { "ok": false, "code": "validation", "entry": "console-web/tool/follow-amber/switch", "errors": ["loud is not a parameter of run (it takes on)"] } },
    { "name": "cli: unknown entry", "input": ["kitchen-sink"], "expect": { "ok": false, "code": "not_found", "candidates": [] } },
    { "name": "command: id + action + typed params", "input": { "id": "console-web/setting/axf.display.fontScale", "action": "set", "params": { "value": "1.4" } }, "expect": { "ok": true, "entry": "console-web/setting/axf.display.fontScale", "action": "set", "params": { "value": 1.4 } } },
    { "name": "command: alias + verb word as action", "input": { "id": "follow-amber/switch", "action": "turn on" }, "expect": { "ok": true, "entry": "console-web/tool/follow-amber/switch", "action": "run", "params": { "on": true } } },
    { "name": "command: destructive action keeps its confirm flag", "input": { "id": "amberx.items", "action": "remove", "params": { "path": "n-1" } }, "expect": { "ok": true, "entry": "console-web/tool/amberx.items", "action": "remove", "params": { "path": "n-1" } } },
    { "name": "command: unknown action lists the real ones", "input": { "id": "plans", "action": "dance" }, "expect": { "ok": false, "code": "not_found", "entry": "console-web/page/plan-studio" } }
  ]
}
