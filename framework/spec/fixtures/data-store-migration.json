{
  "$axf": "data-store-migration@1",
  "note": "Every data source the console writes today, its data-store@1 namespace and key, and the count + hash check that gates each namespace. Checked by framework/spec/check-data-store-migration.mjs (via check-data-store.mjs); `example` is generated with --write.",
  "placeholders": {
    "<projects>": "AXHUB_PROJECTS_DIR, /projects where axHub's volume is mounted in the console container",
    "<repo>": "the console's checkout (ROOT)",
    "<plugins>": "<repo>/.axf-console/plugins, plugin-lifecycle@1 dataDir root",
    "<data>": "AXF_DATA_DIR, the console's own data volume (state.json, deploys/, env)"
  },
  "policies": {
    "copy": "copied key for key; the namespace manifest after the copy must equal the source manifest",
    "journal": "copied line for line as journal entries; entries and the journal hash must match",
    "blob-sqlite": "the SQLite file is one blob; besides the manifest, every table's row count is read from source and target and must match",
    "rebuild": "not copied: regenerated from its upstream (GitHub CI artifacts, the repo) after the cutover",
    "skip": "stays where it is: git-tracked, a secret, or process-local (locks, pids)"
  },
  "fileKinds": {
    ".json": "record",
    ".jsonl": "journal",
    ".ndjson": "journal",
    "*": "blob"
  },
  "order": [
    "settings",
    "changes",
    "notes",
    "planner",
    "ui-review",
    "sessions",
    "console",
    "plugins",
    "builds"
  ],
  "orderWhy": "small and rarely written first; builds last because the orchestrator writes it every minute and the journal is the biggest source (654 MB today)",
  "sources": [
    {
      "id": "builds-store",
      "ns": "builds",
      "from": "<repo>/_claude/builds/store.json",
      "to": "builds/store.json",
      "kind": "record",
      "policy": "copy",
      "writers": [
        "framework/cli/builds-store.mjs",
        "build-orchestrator/orchestrator.mjs",
        "builds-live",
        "builds-page server (via CLI)"
      ],
      "count": "files",
      "size": "9 MB (large)"
    },
    {
      "id": "builds-journal",
      "ns": "builds",
      "from": "<repo>/_claude/builds/journal/<month>.jsonl",
      "to": "builds/journal/<month>",
      "kind": "journal",
      "policy": "journal",
      "writers": [
        "framework/cli/builds-store.mjs"
      ],
      "count": "lines",
      "size": "654 MB in 9 files"
    },
    {
      "id": "builds-exports",
      "ns": "builds",
      "from": "<repo>/_claude/builds/store.json.exports.json",
      "to": "builds/store.exports.json",
      "kind": "record",
      "policy": "copy",
      "writers": [
        "framework/cli/builds-store.mjs"
      ],
      "count": "files"
    },
    {
      "id": "builds-orchestrator-projection",
      "ns": "builds",
      "from": "<repo>/_claude/builds/orchestrator.json",
      "to": "builds/orchestrator.json",
      "kind": "record",
      "policy": "copy",
      "writers": [
        "build-orchestrator/orchestrator.mjs"
      ],
      "count": "files",
      "size": "6.6 MB (large)"
    },
    {
      "id": "builds-origins",
      "ns": "builds",
      "from": "<repo>/_claude/builds/origins.json",
      "to": "builds/origins.json",
      "kind": "record",
      "policy": "copy",
      "writers": [
        "framework/core/build-origin.mjs callers"
      ],
      "count": "files"
    },
    {
      "id": "builds-side-records",
      "ns": "builds",
      "from": "<repo>/_claude/builds/{advice,bugs,matrices}.json",
      "to": "builds/<name>.json",
      "kind": "record",
      "policy": "copy",
      "writers": [
        "build-orchestrator",
        "builds-page"
      ],
      "count": "files"
    },
    {
      "id": "builds-shipped",
      "ns": "builds",
      "from": "<repo>/_claude/builds/shipped/<build>.json",
      "to": "builds/shipped/<build>.json",
      "kind": "record",
      "policy": "copy",
      "writers": [
        "framework/core/shipped-manifest.mjs callers"
      ],
      "count": "files"
    },
    {
      "id": "builds-reports",
      "ns": "builds",
      "from": "<repo>/_claude/builds/reports/**",
      "to": "builds/reports/<path>",
      "kind": "blob",
      "policy": "copy",
      "writers": [
        "headless sessions",
        "build-orchestrator"
      ],
      "count": "files",
      "size": "66 MB"
    },
    {
      "id": "builds-progress-profiles-help",
      "ns": "builds",
      "from": "<repo>/_claude/builds/{progress,profiles,help-src}/**",
      "to": "builds/<folder>/<path>",
      "kind": "by-file",
      "policy": "copy",
      "writers": [
        "build-profiles",
        "build-orchestrator"
      ],
      "count": "files"
    },
    {
