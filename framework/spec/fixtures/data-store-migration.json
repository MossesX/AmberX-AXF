  "excluded": [
    {
      "from": "<data>/env, <repo>/.axf-console/env, AXF_TOKEN_FILE, credentials",
      "policy": "skip",
      "why": "secrets never enter the store; they stay in the container's env files"
    },
    {
      "from": "<repo>/changes/**, <repo>/tracker.json, <repo>/framework/catalog/status.json, <repo>/_claude/handoff/**, <repo>/sessions/**",
      "policy": "skip",
      "why": "git-tracked projections; git is their store, builds-live commits them"
    },
    {
      "from": "**/*.lock, **/*.running, **/*.pid, <projects>/amberx-axf/_data/agent-slots/leases/**",
      "policy": "skip",
      "why": "process-local locks and leases; a new process makes its own"
    },
    {
      "from": "<projects>/amberx-axf/_data/changes/README.md",
      "policy": "skip",
      "why": "a copy of the repo doc; the changes namespace holds records only"
    },
    {
      "from": "<repo>/_claude/builds/**/*.tmp, **/.history-lock",
      "policy": "skip",
      "why": "write temp files"
    }
  ],
  "manifest": {
    "where": "per namespace, before the copy over the source (M0) and after it over the target (M1); both written to _meta/manifests and to <data>/migration/<ns>.json",
    "rev": "a fresh target has rev 1 on every key, so M0 is computed with rev 1: a record's etag is etagOf(1, canonical JSON of the parsed file), a blob's etagOf(1, bytes), a journal's journalEtag(parsed lines)",
    "equal": "count, bytes and hash equal (sameManifest); blob-sqlite sources also need every listed table's row count equal",
    "unparseable": "a .json file that does not parse is listed in the report and stops the namespace unless the namespace allows blobs, in which case it moves as a blob and is listed as `asBlob`",
    "large": "a record over 1 MiB is listed as `large` (store.json, orchestrator.json); it moves as one record, under the 32 MiB limit"
  },
  "rollback": {
    "duringCopy": "the namespace is still in `local` mode and nothing reads the target: a mismatch purges the target prefix, keeps the report, leaves the mode at `local`",
    "inShadow": "local is still the read side: stop mirroring (mode back to `local`), purge the target prefix, keep the drift log for the report",
    "afterCutover": "replay the axf-data change feed since the cutover cursor onto the read-only local copy, check manifests equal, then flip to `local`; if the feed is older than the retained window (cursor_expired), restore the cutover snapshot tar plus the latest snapshot and list every key changed since as the gap",
    "never": "a journal is never truncated on either side; a rollback appends what the other side has"
  },
  "example": {
    "sourceFiles": [
      "plans/p1.json",
      "plans/p2.json",
      "categories.json",
      "shipped-log.jsonl",
      "README.md"
