  "schema": {
    "type": "array",
    "description": "hidden-assets@1: the chrome pieces hidden in this app (absent = nothing hidden); one entry per kind + id, oldest first, at most 500",
    "maxItems": 500,
    "items": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "hiddenAt",
        "by"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "tab-group",
            "toolbar",
            "banner",
            "nav-menu",
            "app-menu",
            "widget"
          ],
          "description": "a hideable kind: the chrome-settings@1 kinds with a region on the page, plus widget"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:/-]{0,119}$",
          "description": "the instance id (the chrome context menu slug, axf.chrome.<kind>.<id>)"
        },
        "assetRef": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,119}$",
          "description": "the asset id the piece was drawn with when hidden"
        },
        "hiddenAt": {
          "type": "string",
          "format": "date-time",
          "description": "when it was hidden"
        },
        "by": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._:@/-]{0,119}$",
          "description": "who hid it: the app id, a plugin, or an API caller"
        }
      }
    }
  }
}
