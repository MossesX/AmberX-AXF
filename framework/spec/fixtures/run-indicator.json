  "errors": {
    "ok": [],
    "bad-enums": [
      "data.animation must be one of: flash, pulse, glow, spin, none",
      "data.iconAnimation must be one of: spin, pulse, bounce, blink, none",
      "data.brokeAnimation must be one of: flash, pulse, none",
      "data.reducedMotion must be one of: still, tint, off"
    ],
    "bad-tones": [
      "data.tones.running must be a colour-theme token: accent, info, success, warning, danger, text, muted (never a colour)",
      "data.tones.idle: not a live state (running, broke, stale, done)"
    ],
    "bad-numbers": [
      "data.speed must be a number 25–400",
      "data.durationMs must be a number 400–8000",
      "data.intensity must be a number 0.05–1"
    ],
    "bad-icon": [
      "data.icon must be a framework icon name (lowercase, dashes)"
    ],
    "not-an-object": [
