{
  "$axf": "build-pipeline-exit@1",
  "note": "Golden cases for the build-pipeline@1 exit transition. `transition` replays nextStatusOnExit() alone (maxRuns 3 unless a case says); `sessions` replays the dispatcher's endOutcome() on build records (steps: id, model, phase, done, doneAt; policy = Fable upgrades need my approval on | off). Regenerate the `out` blocks with: node framework/spec/check-build-pipeline.mjs --write",
  "maxRuns": 3,
  "transition": [
    {
      "name": "every step done: built",
      "in": {
        "exit": 0,
        "stepsLeft": 0,
        "runs": 1,
        "crashes": 0
      },
      "out": {
        "status": "landing",
        "outcome": "finished",
        "reason": "all-done",
        "crashes": 0,
        "keepQueue": false
      }
    },
    {
      "name": "every step done, the session crashed on its way out: still built, the crash counted",
      "in": {
        "exit": 1,
        "stepsLeft": 0,
        "runs": 1,
        "crashes": 0
      },
      "out": {
        "status": "landing",
