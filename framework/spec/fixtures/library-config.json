     "direction": "in",
     "required": false,
     "accepts": [],
     "many": true,
     "help": "",
     "forCapability": "filters"
    }
   ]
  },
  {
   "id": "settings",
   "title": "Settings",
   "ask": "The settings this library needs. Defaults are filled in.",
   "fields": [
    {
     "id": "pageSize",
     "label": "Rows per page",
     "type": "number",
     "default": 25,
     "required": false,
     "help": "",
     "choices": [],
     "min": 5,
     "max": 200
    }
   ]
  },
  {
   "id": "credentials",
