     "id": "export",
     "label": "Export",
     "type": "bool",
     "default": true,
     "help": "",
     "requires": [],
     "params": [
      {
       "key": "format",
       "label": "Format",
       "type": "choice",
       "default": "csv",
       "choices": [
        "csv",
        "json"
       ]
      }
     ]
    }
   ]
  },
  {
   "id": "connections",
