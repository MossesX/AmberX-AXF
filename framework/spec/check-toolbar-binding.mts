/*
 * toolbar-binding@1 conformance (Oct 27 2026):
 *
 *   npx -y tsx framework/spec/check-toolbar-binding.mts            replay spec/fixtures/toolbar-binding.json
 *   npx -y tsx framework/spec/check-toolbar-binding.mts --write    regenerate it from the TS reference
 *
 * The TS reference (core/engines/toolbar.ts), the CLI validator (cli/build-engine.mjs) and the Pydantic model
 * (python/axf/contracts/toolbar.py, `python3 framework/python/axf/contracts/test.py`) must give the same messages.
 * Also checks the runtime: attach targets, attached toolbars, plugin registration, and every toolbar asset in the repo.
 */
import { readFileSync, writeFileSync, readdirSync, statSync, existsSync } from 'node:fs';
import { dirname, join, relative, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';
import { validateToolbarBinding, toolbarsAttachedTo, pluginToolbars } from '../core/engines/toolbar';
import { validateAsset } from '../core/validate';
import { validateAsset as cliValidateAsset, validateToolbarBinding as cliBinding } from '../cli/build-engine.mjs';

const HERE = dirname(fileURLToPath(import.meta.url));
const ROOT = resolve(HERE, '..', '..');
const FIX = join(HERE, 'fixtures', 'toolbar-binding.json');
let n = 0;
const fails: string[] = [];
const check = (ok: boolean, what: string) => { n++; if (!ok) fails.push(what); };

const item = (extra: Record<string, unknown> = {}) => ({ id: 'a', icon: 'list', label: 'A', action: 'x.do', ...extra });
const tb = (extra: Record<string, unknown> = {}, items: Record<string, unknown>[] = [item()]) => ({ variant: 'icons-labels', align: 'start', showSearch: false, groups: [{ id: 'g', items }], ...extra });
const attach = { target: 'console.pending-list', kind: 'list' };

type Case = { name: string; data: Record<string, unknown>; plugin?: string; errors?: string[] };
const CASES: Case[] = [
  { name: 'plain toolbar, no binding', data: tb() },
  { name: 'attached to a list', data: tb({ attach }) },
  { name: 'attached, side + order', data: tb({ attach: { ...attach, at: 'bottom', order: 2 } }) },
  { name: 'open attach kind', data: tb({ attach: { target: 'img.hero', kind: 'heat-map' } }) },
  { name: 'attach not an object', data: tb({ attach: 'console.pending-list' }) },
  { name: 'attach bad target + kind', data: tb({ attach: { target: '-x', kind: 'Grid!' } }) },
  { name: 'attach bad side + order', data: tb({ attach: { ...attach, at: 'left', order: 'first' } }) },
  { name: 'app owner', data: tb({ owner: { kind: 'app', app: 'axf-console-web' } }) },
  { name: 'plugin toolbar, complete', data: tb({ attach, owner: { kind: 'plugin', plugin: 'ai.amberx.axf.console.x', settingsTab: 'x' } }) },
  { name: 'plugin toolbar without plugin', data: tb({ attach, owner: { kind: 'plugin' } }) },
  { name: 'plugin toolbar without attach', data: tb({ owner: { kind: 'plugin', plugin: 'ai.amberx.axf.console.x' } }) },
  { name: 'plugin toolbar without either', data: tb({ owner: { kind: 'plugin' } }) },
  { name: 'unknown owner kind', data: tb({ owner: { kind: 'vendor' } }) },
  { name: 'plugin named on an app toolbar', data: tb({ owner: { kind: 'app', plugin: 'ai.amberx.axf.console.x' } }) },
  { name: 'owner not an object', data: tb({ owner: 'plugin' }) },
  { name: 'empty settings tab + app', data: tb({ owner: { kind: 'app', settingsTab: '', app: '' } }) },
  { name: 'shipped by a plugin: right one', plugin: 'ai.amberx.axf.console.x', data: tb({ attach, owner: { kind: 'plugin', plugin: 'ai.amberx.axf.console.x' } }) },
  { name: 'shipped by a plugin: no owner', plugin: 'ai.amberx.axf.console.x', data: tb({ attach }) },
  { name: 'shipped by a plugin: app owner', plugin: 'ai.amberx.axf.console.x', data: tb({ attach, owner: { kind: 'app' } }) },
  { name: 'shipped by a plugin: other plugin', plugin: 'ai.amberx.axf.console.x', data: tb({ attach, owner: { kind: 'plugin', plugin: 'ai.amberx.axf.console.y' } }) },
  { name: 'sort + filter items, attached', data: tb({ attach }, [item({ kind: 'sort', value: 'status' }), item({ id: 'b', kind: 'filter', value: 'pending', count: 'pending' })]) },
  { name: 'sort item, not attached', data: tb({}, [item({ kind: 'sort', value: 'status' })]) },
  { name: 'count item, not attached', data: tb({}, [item({ count: 'pending' })]) },
  { name: 'unknown item kind', data: tb({ attach }, [item({ kind: 'drag' })]) },
  { name: 'bad value + count', data: tb({ attach }, [item({ kind: 'filter', value: 3, count: 'has space' })]) },
  { name: 'toggle without attach, two groups', data: { ...tb(), groups: [{ id: 'a', items: [item()] }, { id: 'b', items: [item({ kind: 'toggle' })] }] } },
];

if (process.argv.includes('--write')) {
  const cases = CASES.map((c) => ({ ...c, errors: validateToolbarBinding(c.data, c.plugin !== undefined ? { plugin: c.plugin } : {}) }));
  writeFileSync(FIX, JSON.stringify({ contract: 'toolbar-binding@1', note: 'Generated by framework/spec/check-toolbar-binding.mts --write. Replayed by it (TS + CLI) and python3 framework/python/axf/contracts/test.py (Pydantic).', cases }, null, 2) + '\n');
  console.log(`wrote ${relative(ROOT, FIX)} (${cases.length} cases)`);
}

const fx = JSON.parse(readFileSync(FIX, 'utf8')) as { contract: string; cases: Required<Pick<Case, 'name' | 'data' | 'errors'>>[] & { plugin?: string }[] };
check(fx.contract === 'toolbar-binding@1', 'fixture is toolbar-binding@1');
check(fx.cases.length === CASES.length, `fixture has every case (${fx.cases.length}/${CASES.length}); run --write`);
for (const c of fx.cases as unknown as Case[]) {
  const ctx = c.plugin !== undefined ? { plugin: c.plugin } : {};
  const ts = validateToolbarBinding(c.data, ctx);
  check(JSON.stringify(ts) === JSON.stringify(c.errors), `TS: ${c.name} → ${JSON.stringify(ts)}`);
  const cli = cliBinding(c.data, ctx);
  check(JSON.stringify(cli) === JSON.stringify(c.errors), `CLI: ${c.name} → ${JSON.stringify(cli)}`);
  const asset = { $axf: 'asset@1', type: 'toolbar', id: 't-case', name: 'Case', version: '1.0.0', data: c.data };
  check(validateAsset(asset, ctx).ok === (c.errors!.length === 0), `validateAsset ok: ${c.name}`);
  check(cliValidateAsset(asset, ctx).ok === (c.errors!.length === 0), `CLI validateAsset ok: ${c.name}`);
}

// attach order + plugin lookup
const a = (id: string, data: Record<string, unknown>) => ({ id, data: data as { attach?: never; owner?: never } });
const list = [a('z', { attach: { ...attach, order: 1 } }), a('b', { attach }), a('c', { attach: { ...attach, at: 'bottom' } }), a('d', { attach: { target: 'other', kind: 'list' } })];
check(toolbarsAttachedTo(list, 'console.pending-list', 'top').map((t) => t.id).join() === 'z,b', 'attached toolbars: top side, attach.order then id');
check(toolbarsAttachedTo(list, 'console.pending-list').length === 3, 'attached toolbars: every side');
check(pluginToolbars([a('p', { owner: { kind: 'plugin', plugin: 'x' } }), a('q', { owner: { kind: 'app' } })], 'x').map((t) => t.id).join() === 'p', 'plugin toolbars');

// every toolbar asset in the repo passes (framework starters, every app's copies)
const walk = (d: string): string[] => readdirSync(d).flatMap((f) => { const p = join(d, f); if (f === 'node_modules' || f === 'dist' || f.startsWith('.')) return []; return statSync(p).isDirectory() ? walk(p) : p.endsWith('.json') ? [p] : []; });
const roots = [join(ROOT, 'framework', 'assets'), join(ROOT, 'apps')].filter(existsSync);
let seen = 0;
for (const f of roots.flatMap(walk).filter((p) => p.includes(`${'/'}toolbar${'/'}`) && !p.includes('/build/'))) {
  let raw: { type?: string } | null = null;
  try { raw = JSON.parse(readFileSync(f, 'utf8')); } catch { continue; }
  if (raw?.type !== 'toolbar') continue;
  seen++;
  const r = validateAsset(raw);
  check(r.ok, `${relative(ROOT, f)}: ${r.errors.join('; ')}`);
}
check(seen > 0, `found toolbar assets in the repo (${seen})`);

if (fails.length) { for (const f of fails) console.error(`✗ ${f}`); console.error(`${fails.length} of ${n} failed`); process.exit(1); }
console.log(`toolbar-binding@1: ${n} checks passed (${seen} toolbar assets)`);
