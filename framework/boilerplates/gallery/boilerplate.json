      "kind": "feed"
    },
    {
      "id": "photo",
      "label": "Photo",
      "kind": "custom"
    },
    {
      "id": "settings",
      "label": "Settings",
      "kind": "settings"
    }
  ],
  "modules": [
    "ai.amberx.axf.media"
  ],
  "defaults": {
    "layout": "focus-top"
  },
  "status": "planned",
  "source": "amberx"
}
