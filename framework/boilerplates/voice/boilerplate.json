{
  "$axf": "boilerplate@1",
  "id": "voice",
  "name": "Voice Control",
  "category": "assistant",
  "description": "Hands-free voice app: speech in, spoken prompts, voice commands users can retrigger, and an app lock (as in Voice Vault, apps/voicevault)",
  "features": [
    "c.voice",
    "u.bio"
  ],
  "screens": [
    {
      "id": "home",
      "label": "Voice",
      "kind": "landing"
    },
    {
      "id": "items",
      "label": "Saved items",
      "kind": "list-detail"
    },
    {
      "id": "voice-triggers",
      "label": "Voice triggers",
      "kind": "list-detail"
    },
    {
      "id": "settings",
      "label": "Settings",
      "kind": "settings"
    }
  ],
  "modules": [
    "ai.amberx.axf.platform"
  ],
  "libraries": [
    {
      "library": "voice",
      "params": {
        "speakPrompts": true,
        "preferOffline": true
      }
    },
    {
      "library": "lock",
      "params": {
        "defaultMode": "none"
      }
    }
  ],
  "defaults": {
    "style-theme": "glass-orbit"
  },
  "status": "built",
  "source": "amberx"
}
