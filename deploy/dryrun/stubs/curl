#!/usr/bin/env bash
# Fake curl: the hub login page (HARNESS_HUB = ready|empty|down), ifconfig.me → a fixed IP.
echo "=== curl $*" >> "$HARNESS_LOG"
case "$*" in
  *auth/login*)
    case "${HARNESS_HUB:-ready}" in
      ready) echo '<form method="post" action="/auth/login"><input name=u></form>';;
      empty) echo '<form method="post" action="/auth/login">No accounts yet</form>';;
      *) exit 7;;
    esac;;
  *ifconfig.me*) echo 203.0.113.7;;
  *) exit 7;;
esac
