# axf-auto-lander.service — the server auto-lander (auto-lander@1, framework/spec/AUTO-LANDER.md): one tick merges main
# into clashing builds, starts fix sessions for red CI, and hands green PRs to the merge queue, with no console.
# Installed by axf_auto_lander_install (framework/deploy/axf-deploy.sh), called from deploy/install-console.sh;
# @DIR@ is the checkout (/opt/axf). Started every minute by axf-auto-lander.timer; the tick holds its own lock file, so
# an overlapping start does nothing. Log: journalctl -u axf-auto-lander (and /var/log/axf-auto-lander.log).
[Unit]
Description=AXF auto-lander: fix and land finished builds on their own
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@DIR@
Environment=AXF_LAND_REPO=@DIR@
Environment=AXF_CONSOLE_ROOT=@DIR@
Environment=AXF_ACTOR=auto-lander
ExecStart=/usr/bin/env node @DIR@/deploy/auto-lander/auto-lander.mjs tick
StandardOutput=append:/var/log/axf-auto-lander.log
StandardError=append:/var/log/axf-auto-lander.log
TimeoutStartSec=25min
Restart=on-failure
RestartSec=60s
Nice=5

[Install]
WantedBy=multi-user.target
