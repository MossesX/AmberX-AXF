{
  "$axf": "asset@1",
  "type": "app-menu",
  "id": "developer",
  "name": "Developer",
  "version": "1.0.0",
  "description": "Build, deploy and asset tooling up front for framework work.",
  "author": "AmberX AXF",
  "tags": [
    "dev"
  ],
  "data": {
    "menus": [
      {
        "id": "file",
        "label": "File",
        "items": [
          {
            "id": "new",
            "label": "New file",
            "icon": "plus",
            "action": "file.new",
            "shortcut": "Alt+N"
          },
          {
            "id": "save",
            "label": "Save",
            "icon": "save",
            "action": "file.save",
            "shortcut": "Ctrl+S",
            "requires": "files.write"
          }
        ]
      },
      {
        "id": "build",
        "label": "Build",
        "items": [
          {
            "id": "build",
            "label": "Build app",
            "icon": "package",
            "action": "run.build",
            "shortcut": "Alt+B",
            "requires": "dev.tools"
          },
          {
            "id": "deploy",
            "label": "Deploy",
            "icon": "rocket",
            "action": "run.deploy",
            "requires": "dev.deploy"
          },
          {
            "id": "s1",
            "separator": true
          },
          {
            "id": "console",
            "label": "Developer console",
            "icon": "terminal",
            "action": "dev.console",
            "shortcut": "Alt+J",
            "requires": "dev.tools"
          }
        ]
      },
      {
        "id": "assets",
        "label": "Assets",
        "items": [
          {
            "id": "import",
            "label": "Import asset…",
            "icon": "upload",
            "action": "dialog:import-asset",
            "requires": "assets.import"
          },
          {
            "id": "cycle",
            "label": "Cycle slot",
            "icon": "refresh",
            "items": [
              {
                "id": "next-color",
                "label": "Next color theme",
                "icon": "palette",
                "action": "swap:color-theme:next",
                "shortcut": "Alt+C"
              },
              {
                "id": "next-style",
                "label": "Next style theme",
                "icon": "type",
                "action": "swap:style-theme:next",
                "shortcut": "Alt+S"
              },
              {
                "id": "next-layout",
                "label": "Next layout",
                "icon": "layout",
                "action": "swap:layout:next",
                "shortcut": "Alt+L"
              },
              {
                "id": "next-button",
                "label": "Next button",
                "icon": "zap",
                "action": "swap:button:next",
                "shortcut": "Alt+1"
              },
              {
                "id": "next-slider",
                "label": "Next slider",
                "icon": "sliders",
                "action": "swap:slider:next",
                "shortcut": "Alt+2"
              },
              {
                "id": "next-container",
                "label": "Next container",
                "icon": "box",
                "action": "swap:container:next",
                "shortcut": "Alt+3"
              },
              {
                "id": "next-dialog",
                "label": "Next dialog",
                "icon": "box",
                "action": "swap:dialog:next",
                "shortcut": "Alt+4"
              },
              {
                "id": "next-popup",
                "label": "Next popup",
                "icon": "bell",
                "action": "swap:popup:next",
                "shortcut": "Alt+5"
              }
            ]
          },
          {
            "id": "random",
            "label": "Randomize",
            "icon": "shuffle",
            "action": "assets.random",
            "shortcut": "Alt+R"
          },
          {
            "id": "reset",
            "label": "Reset",
            "icon": "refresh",
            "action": "assets.reset"
          }
        ]
      },
      {
        "id": "window",
        "label": "Window",
        "items": [
          {
            "id": "go-home",
            "label": "Home",
            "icon": "home",
            "action": "nav:home"
          },
          {
            "id": "go-components",
            "label": "Components",
            "icon": "grid",
            "action": "nav:components"
          },
          {
            "id": "go-assets",
            "label": "Assets",
            "icon": "layers",
            "action": "nav:assets"
          },
          {
            "id": "go-account",
            "label": "Account",
            "icon": "user",
            "action": "nav:account"
          },
          {
            "id": "settings",
            "label": "Settings",
            "icon": "settings",
            "action": "app.settings"
          }
        ]
      },
      {
        "id": "help",
        "label": "Help",
        "items": [
          {
            "id": "shortcuts",
            "label": "Shortcuts",
            "icon": "keyboard",
            "action": "view.shortcuts",
            "shortcut": "Alt+K"
          },
          {
            "id": "about",
            "label": "About",
            "icon": "info",
            "action": "help.about"
          }
        ]
      }
    ]
  }
}
