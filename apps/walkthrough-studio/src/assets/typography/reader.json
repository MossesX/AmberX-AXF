{
  "$axf": "asset@1",
  "type": "typography",
  "id": "reader",
  "name": "Reader",
  "version": "1.1.0",
  "description": "Larger, calmer text for reading: a 1.1 base scale, generous line heights, plain-case eyebrows.",
  "author": "AmberX AXF",
  "tags": [
    "reader",
    "roomy"
  ],
  "data": {
    "scale": {
      "2xs": 0.74,
      "xs": 0.82,
      "sm": 0.9,
      "md": 1,
      "lg": 1.2,
      "xl": 1.6,
      "2xl": 2.2
    },
    "headings": {
      "h1": 1.8,
      "h2": 1.4,
      "h3": 1.1,
      "h4": 1
    },
    "weights": {
      "body": 400,
      "medium": 500,
      "strong": 650
    },
    "line": {
      "tight": 1.3,
      "normal": 1.6,
      "loose": 1.85
    },
    "eyebrow": {
      "size": 0.75,
      "weight": 600,
      "tracking": 0.02,
      "case": "normal"
    },
    "mono": {
      "size": 0.95
    }
  }
}
