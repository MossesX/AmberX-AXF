{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axf.amberx.app/schemas/landing-line.json",
  "title": "landing-line@1",
  "description": "One ordered line of finished builds / PRs landed on main one at a time (Brett, Nov 14 2026: no merge tier, no stacking). Exactly one entry is in flight; a cancelled, superseded or stale CI run is never a result. framework/core/landing-line.mjs is the reference engine; this file is the record it reads and writes.",
  "type": "object",
  "required": ["$axf", "rev", "at", "on", "entries", "history"],
  "additionalProperties": true,
  "properties": {
    "$axf": { "const": "landing-line@1" },
    "rev": { "type": "integer", "minimum": 0 },
    "at": { "type": "string", "format": "date-time" },
    "on": { "type": "boolean", "description": "false = the line holds: the entry in flight finishes, nothing new starts" },
    "onBy": { "type": "string", "maxLength": 80 },
    "onAt": { "type": "string" },
    "mainSha": { "$ref": "#/$defs/shaOrEmpty" },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" }, "description": "The line, front first. Only live states (waiting, in flight, paused, fix-filed); at most one entry in an in-flight state." },
    "history": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/entry" }, "description": "Entries that left the line: landed or skipped, oldest first." },
    "migratedFrom": { "type": "object", "description": "Set once by the merge-queue@1 → landing-line@1 migration", "properties": { "frame": { "type": "string" }, "at": { "type": "string" }, "entries": { "type": "integer" }, "landed": { "type": "integer" } } }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{7,64}$" },
    "shaOrEmpty": { "type": "string", "pattern": "^([0-9a-f]{7,64})?$" },
    "state": {
      "type": "string",
      "enum": ["waiting", "merging-main", "regenerating", "checking", "landing", "landed", "fix-filed", "skipped", "paused"]
    },
    "inFlight": { "type": "string", "enum": ["merging-main", "regenerating", "checking", "landing"] },
    "terminal": { "type": "string", "enum": ["landed", "skipped"] },
    "attemptResult": { "type": "string", "enum": ["landed", "retry", "red", "conflict", "aborted"] },
    "checkVerdict": {
      "type": "string",
      "enum": ["green", "red", "running", "retry", "ignore", "none"],
      "description": "green = success | neutral; red = failure | timed_out | action_required | startup_failure; retry = cancelled | stale | superseded (another head) | no conclusion: not a result, run again; ignore = skipped job or a check from another app"
    },
    "event": {
      "type": "string",
      "enum": ["add", "start", "merged-main", "conflict", "regenerated", "check", "main-moved", "land", "landed", "land-rejected", "pause", "resume", "skip", "move", "rejoin", "remove", "on", "off"]
    },
    "outcome": {
      "type": "object",
      "required": ["kind", "text", "at"],
      "properties": {
        "kind": { "type": "string", "enum": ["landed", "ci", "conflict", "paused", "skipped", "removed"] },
        "text": { "type": "string", "maxLength": 600 },
        "at": { "type": "string" },
        "by": { "type": "string", "maxLength": 80 },
        "fix": { "type": "string", "maxLength": 40, "description": "id of the fix build filed for a red / conflicting entry" },
        "runUrl": { "type": "string", "maxLength": 300 }
      }
    },
    "fix": {
      "type": "object",
      "description": "The fix build request the runner files (pure data; the host creates the build). One per (entry, head).",
      "required": ["id", "title", "kind", "for", "text"],
      "properties": {
        "id": { "type": "string", "maxLength": 40 },
        "title": { "type": "string", "maxLength": 120 },
        "kind": { "type": "string", "enum": ["ci", "conflict"] },
        "for": { "type": "string" },
        "pr": { "type": "integer", "minimum": 0 },
        "branch": { "type": "string" },
        "head": { "$ref": "#/$defs/shaOrEmpty" },
        "text": { "type": "string", "maxLength": 600 },
        "failing": { "type": "array", "items": { "type": "string" }, "maxItems": 10 },
        "files": { "type": "array", "items": { "type": "string" }, "maxItems": 20 },
        "runUrl": { "type": "string", "maxLength": 300 },
        "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] }
      }
    },
    "attempt": {
      "type": "object",
      "title": "landing-attempt@1",
      "description": "One try at landing the entry: from taking the slot to landed, red, conflict, retry (main moved / merge rejected) or aborted (paused / skipped by hand). Cancelled, superseded or stale CI runs are `retries` inside the attempt, never a result.",
      "required": ["n", "startedAt", "steps"],
      "properties": {
        "$axf": { "const": "landing-attempt@1" },
        "n": { "type": "integer", "minimum": 1 },
        "startedAt": { "type": "string" },
        "endedAt": { "type": "string" },
        "head": { "$ref": "#/$defs/shaOrEmpty" },
        "mergeSha": { "$ref": "#/$defs/shaOrEmpty", "description": "the branch head after main was merged in" },
        "landedSha": { "$ref": "#/$defs/shaOrEmpty" },
        "steps": { "type": "array", "items": { "$ref": "#/$defs/state" }, "description": "the states this attempt passed through, in order" },
        "result": { "$ref": "#/$defs/attemptResult" },
        "retries": { "type": "array", "maxItems": 10, "items": { "type": "object", "required": ["at", "why"], "properties": { "at": { "type": "string" }, "why": { "type": "array", "items": { "type": "string" } } } } },
        "failing": { "type": "array", "items": { "type": "string" }, "maxItems": 10 },
        "files": { "type": "array", "items": { "type": "string" }, "maxItems": 20 },
        "runUrl": { "type": "string", "maxLength": 300 },
        "fix": { "type": "string", "maxLength": 40 },
        "why": { "type": "string", "maxLength": 300 },
        "note": { "type": "string", "maxLength": 600 }
      }
    },
    "entry": {
      "type": "object",
      "title": "landing-entry@1",
      "required": ["id", "state", "since", "addedAt", "attempts"],
      "anyOf": [
        { "required": ["pr"], "properties": { "pr": { "type": "integer", "minimum": 1 } } },
        { "required": ["build"], "properties": { "build": { "type": "string", "minLength": 1 } } }
      ],
      "properties": {
        "$axf": { "const": "landing-entry@1" },
        "id": { "type": "string", "maxLength": 100, "description": "pr-<n> when it has a PR, else build-<id>" },
        "pr": { "type": "integer", "minimum": 0 },
        "build": { "type": "string", "maxLength": 80 },
        "branch": { "type": "string", "maxLength": 200 },
        "title": { "type": "string", "maxLength": 300 },
        "url": { "type": "string", "maxLength": 300 },
        "agent": { "type": "string", "maxLength": 80 },
        "priority": { "type": "string", "enum": ["", "P0", "P1", "P2", "P3"] },
        "head": { "$ref": "#/$defs/shaOrEmpty", "description": "the branch head as last seen; a rejoin after a fix needs a new one" },
        "mainSha": { "$ref": "#/$defs/shaOrEmpty", "description": "main when the current attempt started" },
        "state": { "$ref": "#/$defs/state" },
        "since": { "type": "string", "description": "when the state was entered" },
        "addedAt": { "type": "string" },
        "hold": { "type": "string", "maxLength": 200, "description": "not ready (UI Review, draft, red PR checks): passed over until it clears" },
        "note": { "type": "string", "maxLength": 600 },
        "attempts": { "type": "array", "maxItems": 30, "items": { "$ref": "#/$defs/attempt" } },
        "ci": { "type": "object", "properties": { "verdict": { "$ref": "#/$defs/checkVerdict" }, "at": { "type": "string" }, "why": { "type": "array", "items": { "type": "string" } }, "runUrl": { "type": "string" } } },
        "outcome": { "$ref": "#/$defs/outcome" },
        "fix": { "$ref": "#/$defs/fix" },
        "pausedFrom": { "$ref": "#/$defs/state" },
        "moved": { "type": "object", "properties": { "at": { "type": "string" }, "by": { "type": "string" } } },
        "landedAt": { "type": "string" },
        "landedSha": { "$ref": "#/$defs/shaOrEmpty" },
        "legacy": { "type": "object", "description": "what the merge-queue@1 migration kept of the old record (state words, kick reason); never read by the engine" }
      }
    }
  }
}
