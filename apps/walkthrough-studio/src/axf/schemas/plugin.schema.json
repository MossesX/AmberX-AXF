{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axf/plugin.schema.json",
  "title": "AmberX AXF plugin manifest (plugin@1)",
  "type": "object",
  "required": [
    "$axf",
    "id",
    "name",
    "version",
    "kind",
    "apiLevel"
  ],
  "properties": {
    "$axf": {
      "const": "plugin@1"
    },
    "id": {
      "type": "string",
      "description": "namespaced, e.g. com.example.myplugin"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "pack",
        "module",
        "script"
      ]
    },
    "apiLevel": {
      "type": "integer",
      "minimum": 1
    },
    "minFrameworkVersion": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "provides": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scopes": {
      "type": "array",
      "items": {
        "enum": [
          "assets",
          "actions",
          "routes",
          "settings",
          "menu_items",
          "network",
          "files",
          "notifications",
          "background",
          "device",
          "identity",
          "billing"
        ]
      }
    },
    "entry": {
      "type": "string",
      "description": "module: entry class; pack: entry asset or macro id"
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "host app ids, * for any"
    },
    "signed": {
      "type": "boolean"
    },
    "optional": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "capabilities used when present (service:<name>@<v>); the plugin works without them"
    },
    "enabledByDefault": {
      "type": "boolean"
    },
    "uiEditor": {
      "type": "array",
      "items": {
        "enum": [
          "theme",
          "style",
          "layout",
          "manager",
          "builder"
        ]
      },
      "description": "UI-editing plugin kinds: last save wins per key; reload current values on open/load/focus (useEditorSync / refreshFromSaved)"
    },
    "banner": {
      "description": "Does this plugin include a banner (the live banners above every page, AxfWebLibrary.banners)? false (default) = none; otherwise the ids of the banners it contributes. Every declared banner gets the shared banner settings (Hide, Hide all banners, the hide timer). Checked against the plugin's web code by plugins.mjs --check.",
      "default": false,
      "oneOf": [
        { "const": false },
        { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" } }
      ]
    },
    "tabable": {
      "description": "Can a host app add this plugin to its tab group (e.g. Patches' tabs)? false (default) = never. true = its first page; {view, label?, icon?} = that page. Only plugins with a page (a view other than settings) can be tabable. Every plugin with a GUI other than settings starts not tabable.",
      "default": false,
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "required": [
            "view"
          ],
          "additionalProperties": false,
          "properties": {
            "view": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
              "description": "the view id the tab shows (embed@1 page view:<id>)"
            },
            "label": {
              "type": "string",
              "maxLength": 80
            },
            "icon": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
            }
          }
        }
      ]
    },
    "builtWith": {
      "type": "object",
      "description": "model that built it and what replaces it (e.g. a pending Fable rebuild)"
    },
    "lifecycle": {
      "type": "object",
      "description": "plugin-lifecycle@1: dataDir, env, mentions"
    }
  }
}
