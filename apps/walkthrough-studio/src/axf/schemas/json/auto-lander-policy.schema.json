{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amberx.ai/axf/schemas/auto-lander-policy.schema.json",
  "title": "auto-lander-policy@1 (auto-lander@1)",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "$axf": {
      "const": "auto-lander-policy@1"
    },
    "enabled": {
      "type": "boolean"
    },
    "maxAttempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "description": "failures of one kind on one build before it escalates"
    },
    "backoff": {
      "type": "object",
      "properties": {
        "baseMin": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "factor": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maxMin": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "description": "wait after the n-th failure: min(maxMin, baseMin × factor^(n−1)) minutes"
    },
    "attemptTimeoutMin": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "mergeMain": {
      "type": "boolean"
    },
    "fixSessions": {
      "type": "boolean"
    },
    "land": {
      "type": "boolean"
    },
    "escalateTo": {
      "enum": [
        "banner",
        "note",
        "none"
      ]
    }
  }
}
