{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axf/layout.schema.json",
  "title": "AmberX AXF Layout asset",
  "type": "object",
  "required": [
    "$axf",
    "type",
    "id",
    "name",
    "version",
    "data"
  ],
  "properties": {
    "$axf": {
      "const": "asset@1"
    },
    "type": {
      "const": "layout"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "nav",
        "navWidth",
        "showMenubar",
        "showToolbar",
        "toolbarPosition",
        "showStatusbar",
        "inspector",
        "inspectorWidth",
        "contentMaxWidth"
      ],
      "properties": {
        "nav": {
          "enum": [
            "left",
            "right",
            "top"
          ]
        },
        "navWidth": {},
        "showMenubar": {},
        "showToolbar": {},
        "toolbarPosition": {
          "enum": [
            "top",
            "bottom"
          ]
        },
        "showStatusbar": {},
        "inspector": {
          "enum": [
            "left",
            "right",
            "none"
          ]
        },
        "inspectorWidth": {},
        "contentMaxWidth": {}
      }
    }
  }
}
