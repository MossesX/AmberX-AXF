{
  "$axf": "manifest@1",
  "app": {
    "id": "amberx-droid",
    "name": "AmberX",
    "version": "0.1.0"
  },
  "framework": {
    "version": "0.2.0",
    "template": "react-ts"
  },
  "initializedAt": "2026-10-25T16:10:00.000Z",
  "targets": [
    "web",
    "android"
  ],
  "startView": "home",
  "defaults": {
    "color-theme": "fresh-light",
    "style-theme": "fresh",
    "layout": "axhub-console",
    "app-menu": "amberx-droid",
    "toolbar": "amberx-droid",
    "nav-menu": "amberx-droid",
    "context-menu": "amberx-droid",
    "tab-group": "underline",
    "dialog": "centered-modal",
    "popup": "corner-solid",
    "button": "rounded-solid",
    "slider": "classic-round",
    "container": "soft-card",
    "banner": "amberx-thin",
    "clock": "digital-12h",
    "search-bar": "everything",
    "logo": "wordmark",
    "action-button": "settings",
    "label": "version",
    "status": "online",
    "counter": "alerts",
    "progress": "build",
    "avatar": "account",
    "link": "docs",
    "theme-switch": "fresh-day-night",
    "spacer": "gap",
    "divider": "rule",
    "badge": "new",
    "gauge": "classic-arc",
    "meter": "striped-pill",
    "settings": "console",
    "uac-policy": "standard"
  },
  "hidden": [],
  "developer": {
    "hub": "https://axhub.amberxai.com"
  },
  "options": {
    "wrap-groups": false
  },
  "structure": [
    {
      "path": "project.manifest.json",
      "purpose": "Project manifest (project-manifest@1): name (= hub folder /projects/<name>), repo, relation to AXF, shared data. Nothing is loaded or compiled without a valid one."
    },
    {
      "path": "axf.manifest.json",
      "purpose": "App identity, framework version and the default asset for every slot."
    },
    {
      "path": "axf.lock.json",
      "purpose": "Hashes of the baked framework files, used for conformance checks."
    },
    {
      "path": "src/axf",
      "purpose": "Baked framework runtime: engines, React layer and base CSS. Managed by the build engine."
    },
    {
      "path": "src/assets",
      "purpose": "Hot-swappable assets, one folder per asset type."
    },
    {
      "path": "src/views",
      "purpose": "App views registered with the shell."
    },
    {
      "path": "src/actions.ts",
      "purpose": "Handlers bound to the standard action vocabulary."
    },
    {
      "path": "src/dialogs.tsx",
      "purpose": "App-specific dialogs opened through the dialog engine."
    },
    {
      "path": "public",
      "purpose": "Static files served as-is."
    }
  ],
  "libraries": {
    "hubsync": {
      "hub": "https://axhub.amberxai.com",
      "look": "required",
      "settings": true,
      "data": "off"
    }
  }
}
