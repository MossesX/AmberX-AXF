<?xml version="1.0" encoding="utf-8"?>
<!-- The hub session (app_webview/) and the watch settings never leave the phone in a backup or a device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
