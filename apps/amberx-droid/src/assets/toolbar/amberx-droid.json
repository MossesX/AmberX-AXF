{
  "$axf": "asset@1",
  "type": "toolbar",
  "id": "amberx-droid",
  "name": "AmberX",
  "version": "2.0.0",
  "description": "The empty shell's toolbar: speak a command, approvals, the live search box (finds any page, action or setting a plugin adds), settings.",
  "author": "AmberX AXF",
  "tags": [
    "search",
    "live"
  ],
  "data": {
    "variant": "icons",
    "align": "start",
    "showSearch": true,
    "search": {
      "live": true,
      "placeholder": "Search AmberX…  (Ctrl K)",
      "maxResults": 14
    },
    "groups": [
      {
        "id": "go",
        "items": [
          {
            "id": "voice",
            "icon": "mic",
            "label": "Speak a command",
            "action": "voice.listen"
          },
          {
            "id": "home",
            "icon": "shield",
            "label": "Approvals",
            "action": "nav:home",
            "badge": "approvals.waiting"
          }
        ]
      },
      {
        "id": "tools",
        "items": [
          {
            "id": "settings",
            "icon": "settings",
            "label": "Settings",
            "action": "app.settings"
          }
        ]
      }
    ]
  }
}
