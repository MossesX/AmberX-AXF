{
  "$axf": "asset@1",
  "type": "toolbar",
  "id": "amberx-droid",
  "name": "AmberX",
  "version": "3.0.0",
  "description": "AmberX's toolbar on the enterprise design language: speak a command, Mic off (one tap lets go of every microphone) and Approvals, then Settings; the day/night switch and the account sit at the end. Search lives once, on the banner (Ctrl K). It folds on a phone.",
  "author": "AmberX AXF",
  "tags": [
    "branded",
    "enterprise",
    "live",
    "search"
  ],
  "data": {
    "variant": "icons",
    "align": "start",
    "density": "regular",
    "surface": "flat",
    "divider": true,
    "collapsible": true,
    "showSearch": false,
    "groups": [
      {
        "id": "go",
        "label": "Go",
        "items": [
          {
            "id": "voice",
            "icon": "mic",
            "label": "Speak a command",
            "action": "voice.listen"
          },
          {
            "id": "mic-off",
            "icon": "pause",
            "label": "Mic off (tap again to listen)",
            "action": "amberx.mic.toggle"
          },
          {
            "id": "home",
            "icon": "shield",
            "label": "Approvals",
            "action": "nav:home",
            "badge": "approvals.waiting"
          }
        ]
      },
      {
        "id": "tools",
        "label": "App",
        "items": [
          {
            "id": "settings",
            "icon": "settings",
            "label": "Settings",
            "action": "app.settings"
          }
        ]
      }
    ],
    "widgets": [
      {
        "type": "theme-switch",
        "id": "amberx-day-night",
        "at": "end",
        "order": 10
      },
      {
        "type": "avatar",
        "id": "account",
        "at": "end",
        "order": 20
      }
    ]
  }
}
