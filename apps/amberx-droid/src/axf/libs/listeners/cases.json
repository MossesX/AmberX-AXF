{
  "$axf": "listener-cases@1",
  "about": "Shared cases for the listener@1 rules: framework/libs/listeners/core.ts (TypeScript, checked by framework/spec/check-listeners.mts) and AmberX's Android ListenerRules.java (ListenerRulesTest) give these answers. A null `want` means give up / none.",
  "defaults": { "on": true, "pauseOnCall": true, "pauseForOtherApps": true, "sound": false, "retries": 6, "backoffMs": 1000, "maxBackoffMs": 30000, "cooldownMs": 60000, "quickEndMs": 1500, "restartMs": 250 },
  "restartDelay": [
    { "attempt": 0, "policy": {}, "want": 0, "why": "the first start waits for nothing" },
    { "attempt": 1, "policy": {}, "want": 1000, "why": "first quick end: 1 s" },
    { "attempt": 2, "policy": {}, "want": 2000 },
    { "attempt": 3, "policy": {}, "want": 4000 },
    { "attempt": 6, "policy": {}, "want": 30000, "why": "capped at maxBackoffMs" },
    { "attempt": 7, "policy": {}, "want": null, "why": "past retries: give up" },
    { "attempt": 7, "policy": { "retries": -1 }, "want": 30000, "why": "retries -1 never gives up, stays at the cap" },
    { "attempt": 1, "policy": { "retries": 0 }, "want": null, "why": "retries 0: never restart after a quick end" },
    { "attempt": 3, "policy": { "backoffMs": 500, "maxBackoffMs": 1500 }, "want": 1500 },
    { "attempt": 2, "policy": { "backoffMs": 50, "maxBackoffMs": 50 }, "want": 100, "why": "backoffMs floor 100, max raised to it" }
  ],
  "afterEnd": [
    { "attempts": 0, "ranMs": 5000, "policy": {}, "want": { "attempts": 0, "delay": 250, "gaveUp": false, "cooldownMs": 0 }, "why": "a turn that ran its course restarts at once and resets the count" },
    { "attempts": 4, "ranMs": 1500, "policy": {}, "want": { "attempts": 0, "delay": 250, "gaveUp": false, "cooldownMs": 0 }, "why": "exactly quickEndMs is not quick" },
    { "attempts": 0, "ranMs": 100, "policy": {}, "want": { "attempts": 1, "delay": 1000, "gaveUp": false, "cooldownMs": 0 } },
    { "attempts": 1, "ranMs": 100, "policy": {}, "want": { "attempts": 2, "delay": 2000, "gaveUp": false, "cooldownMs": 0 } },
    { "attempts": 5, "ranMs": 100, "policy": {}, "want": { "attempts": 6, "delay": 30000, "gaveUp": false, "cooldownMs": 0 } },
    { "attempts": 6, "ranMs": 100, "policy": {}, "want": { "attempts": 7, "delay": null, "gaveUp": true, "cooldownMs": 60000 }, "why": "the seventh quick end in a row: stop with an error, try cold in a minute" },
    { "attempts": 6, "ranMs": 100, "policy": { "cooldownMs": 0 }, "want": { "attempts": 7, "delay": null, "gaveUp": true, "cooldownMs": 0 }, "why": "cooldown 0: never try again by itself" },
    { "attempts": 2, "ranMs": 100, "policy": {}, "fatal": true, "want": { "attempts": 3, "delay": null, "gaveUp": true, "cooldownMs": 0 }, "why": "no permission / no recognizer: never restart" },
    { "attempts": 0, "ranMs": 100, "policy": { "retries": -1, "backoffMs": 2000 }, "want": { "attempts": 1, "delay": 2000, "gaveUp": false, "cooldownMs": 0 } }
  ],
  "startSound": [
    { "policy": { "sound": true }, "reason": "user", "want": true },
    { "policy": { "sound": true }, "reason": "restart", "want": false, "why": "restarts are silent" },
    { "policy": { "sound": true }, "reason": "resume", "want": false, "why": "coming back after a call is silent" },
    { "policy": { "sound": true }, "reason": "auto", "want": false, "why": "a start nobody asked for is silent" },
    { "policy": { "sound": false }, "reason": "user", "want": false },
    { "policy": {}, "reason": "user", "want": false, "why": "silent by default" }
  ],
  "yieldReason": [
    { "scene": { "micOff": true, "call": true, "otherApp": true }, "policy": {}, "want": "mic-off", "why": "Mic off wins" },
    { "scene": { "call": true }, "policy": {}, "want": "call" },
    { "scene": { "call": true }, "policy": { "pauseOnCall": false }, "want": null, "why": "the person switched pause-for-calls off" },
    { "scene": { "otherApp": true }, "policy": {}, "want": "other-app" },
    { "scene": { "focusLost": true }, "policy": {}, "want": "other-app", "why": "another app took audio focus" },
    { "scene": { "otherApp": true, "focusLost": true }, "policy": { "pauseForOtherApps": false }, "want": null },
    { "scene": { "silenced": true }, "policy": { "pauseForOtherApps": false }, "want": "other-app", "why": "Android is handing us silence whatever the policy" },
    { "scene": { "call": true, "otherApp": true }, "policy": { "pauseOnCall": false }, "want": "other-app" },
    { "scene": {}, "policy": {}, "want": null }
  ],
  "mayResume": [
    { "reason": "call", "freeSince": -1, "now": 10000, "want": false, "why": "not free yet" },
    { "reason": "call", "freeSince": 10000, "now": 12999, "want": false },
    { "reason": "call", "freeSince": 10000, "now": 13000, "want": true },
    { "reason": "other-app", "freeSince": 10000, "now": 13000, "want": true },
    { "reason": "mic-off", "freeSince": 10000, "now": 10000, "want": true, "why": "Mic off switched back on: no wait" }
  ],
  "micWinner": [
    { "asking": ["handsfree", "talk"], "want": "talk", "why": "the one Brett is talking to wins" },
    { "asking": ["oneshot", "speak"], "want": "speak" },
    { "asking": ["recorder-mic", "handsfree"], "want": "handsfree" },
    { "asking": ["zzz-unknown", "handsfree"], "want": "handsfree", "why": "unknown ids rank last" },
    { "asking": ["handsfree", "handsfree"], "want": "handsfree" },
    { "asking": [], "want": null }
  ],
  "yieldLabel": [
    { "reason": null, "want": "Listening" },
    { "reason": "mic-off", "want": "Mic off" },
    { "reason": "call", "want": "Paused: a call is using the microphone" },
    { "reason": "other-app", "want": "Paused: another app is using the microphone" },
    { "reason": "silenced", "want": "Paused: another app is using the microphone" }
  ]
}
