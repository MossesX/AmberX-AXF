{
  "$axf": "asset@1",
  "type": "typography",
  "id": "compact",
  "name": "Compact",
  "version": "1.1.0",
  "description": "The framework's own text sizes (Oct 31 2026, tighter): 0.9em body text in pieces, 1.3em page titles, a quiet 0.66em eyebrow, 0.86em buttons. Every value is the default.",
  "author": "AmberX AXF",
  "tags": [
    "compact",
    "default"
  ],
  "data": {
    "scale": {
      "2xs": 0.66,
      "xs": 0.74,
      "sm": 0.82,
      "md": 0.9,
      "lg": 1.06,
      "xl": 1.26,
      "2xl": 1.7
    },
    "headings": {
      "h1": 1.3,
      "h2": 1.12,
      "h3": 0.9,
      "h4": 0.84,
      "tracking": -0.02
    },
    "weights": {
      "body": 400,
      "medium": 550,
      "strong": 600
    },
    "line": {
      "tight": 1.2,
      "normal": 1.4,
      "loose": 1.6
    },
    "eyebrow": {
      "size": 0.66,
      "weight": 600,
      "tracking": 0.06,
      "case": "upper"
    },
    "mono": {
      "size": 0.88
    }
  }
}
