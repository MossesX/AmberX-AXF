{
  "$axf": "asset@1",
  "type": "toolbar",
  "id": "standard-icons",
  "name": "Standard Icons",
  "version": "1.0.0",
  "description": "Icon-only file, edit and view groups with a search box.",
  "author": "AmberX AXF",
  "tags": [],
  "data": {
    "variant": "icons",
    "align": "start",
    "showSearch": true,
    "groups": [
      {
        "id": "file",
        "items": [
          {
            "id": "new",
            "icon": "plus",
            "label": "New file",
            "action": "file.new"
          },
          {
            "id": "open",
            "icon": "folder",
            "label": "Open",
            "action": "file.open"
          },
          {
            "id": "save",
            "icon": "save",
            "label": "Save",
            "action": "file.save",
            "requires": "files.write"
          }
        ]
      },
      {
        "id": "edit",
        "items": [
          {
            "id": "undo",
            "icon": "undo",
            "label": "Undo",
            "action": "edit.undo"
          },
          {
            "id": "redo",
            "icon": "redo",
            "label": "Redo",
            "action": "edit.redo"
          },
          {
            "id": "cut",
            "icon": "cut",
            "label": "Cut",
            "action": "edit.cut"
          },
          {
            "id": "copy",
            "icon": "copy",
            "label": "Copy",
            "action": "edit.copy"
          },
          {
            "id": "paste",
            "icon": "paste",
            "label": "Paste",
            "action": "edit.paste"
          }
        ]
      },
      {
        "id": "view",
        "items": [
          {
            "id": "color",
            "icon": "palette",
            "label": "Next color theme",
            "action": "swap:color-theme:next"
          },
          {
            "id": "style",
            "icon": "type",
            "label": "Next style theme",
            "action": "swap:style-theme:next"
          },
          {
            "id": "layout",
            "icon": "layout",
            "label": "Next layout",
            "action": "swap:layout:next"
          },
          {
            "id": "random",
            "icon": "shuffle",
            "label": "Randomize",
            "action": "assets.random"
          }
        ]
      }
    ]
  }
}
