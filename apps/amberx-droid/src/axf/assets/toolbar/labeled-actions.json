{
  "$axf": "asset@1",
  "type": "toolbar",
  "id": "labeled-actions",
  "name": "Labeled Actions",
  "version": "1.0.0",
  "description": "Icons with labels, spread across the bar: save, theme, build.",
  "author": "AmberX AXF",
  "tags": [],
  "data": {
    "variant": "icons-labels",
    "align": "spread",
    "showSearch": true,
    "groups": [
      {
        "id": "doc",
        "items": [
          {
            "id": "save",
            "icon": "save",
            "label": "Save",
            "action": "file.save",
            "requires": "files.write"
          },
          {
            "id": "export",
            "icon": "download",
            "label": "Export",
            "action": "file.export",
            "requires": "files.write"
          }
        ]
      },
      {
        "id": "look",
        "items": [
          {
            "id": "color",
            "icon": "palette",
            "label": "Theme",
            "action": "swap:color-theme:next"
          },
          {
            "id": "layout",
            "icon": "layout",
            "label": "Layout",
            "action": "swap:layout:next"
          }
        ]
      },
      {
        "id": "ship",
        "items": [
          {
            "id": "build",
            "icon": "package",
            "label": "Build",
            "action": "run.build",
            "requires": "dev.tools"
          },
          {
            "id": "deploy",
            "icon": "rocket",
            "label": "Deploy",
            "action": "run.deploy",
            "requires": "dev.deploy"
          }
        ]
      }
    ]
  }
}
