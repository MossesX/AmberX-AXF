{
  "$axf": "asset@1",
  "type": "context-menu",
  "id": "appearance-quick",
  "name": "Appearance Quick",
  "version": "1.0.0",
  "description": "Restyle from anywhere: step colour, style, layout and design package, pick spacing, randomize or reset.",
  "author": "AmberX AXF",
  "tags": [
    "appearance",
    "designer"
  ],
  "data": {
    "variant": "glass",
    "showIcons": true,
    "showShortcuts": true,
    "targets": {
      "default": [
        {
          "id": "next-package",
          "label": "Next design package",
          "icon": "package",
          "action": "design.package:next",
          "shortcut": "Alt+P",
          "requires": "assets.swap"
        },
        {
          "id": "next-color",
          "label": "Next colour theme",
          "icon": "palette",
          "action": "swap:color-theme:next",
          "shortcut": "Alt+C",
          "requires": "assets.swap"
        },
        {
          "id": "next-style",
          "label": "Next style theme",
          "icon": "type",
          "action": "swap:style-theme:next",
          "shortcut": "Alt+S",
          "requires": "assets.swap"
        },
        {
          "id": "next-layout",
          "label": "Next layout",
          "icon": "layout",
          "action": "swap:layout:next",
          "shortcut": "Alt+L",
          "requires": "assets.swap"
        },
        {
          "id": "s1",
          "separator": true
        },
        {
          "id": "spacing-tight",
          "label": "Super tight spacing",
          "icon": "minimize",
          "action": "spacing:tight",
          "requires": "assets.swap"
        },
        {
          "id": "spacing-compact",
          "label": "Compact spacing",
          "icon": "list",
          "action": "spacing:compact",
          "requires": "assets.swap"
        },
        {
          "id": "spacing-regular",
          "label": "Regular spacing",
          "icon": "grid",
          "action": "spacing:regular",
          "requires": "assets.swap"
        },
        {
          "id": "s2",
          "separator": true
        },
        {
          "id": "random",
          "label": "Randomize the look",
          "icon": "shuffle",
          "action": "assets.random",
          "shortcut": "Alt+R",
          "requires": "assets.swap"
        },
        {
          "id": "reset",
          "label": "Reset the look",
          "icon": "refresh",
          "action": "assets.reset",
          "requires": "assets.swap"
        },
        {
          "id": "appearance",
          "label": "Appearance settings…",
          "icon": "sliders",
          "action": "settings.open:appearance"
        }
      ],
      "asset-card": [
        {
          "id": "activate",
          "label": "Use this",
          "icon": "zap",
          "action": "swap:{payload}",
          "requires": "assets.swap"
        },
        {
          "id": "s1",
          "separator": true
        },
        {
          "id": "json",
          "label": "View JSON",
          "icon": "code",
          "action": "asset.json:{payload}"
        },
        {
          "id": "copy-json",
          "label": "Copy JSON",
          "icon": "copy",
          "action": "asset.copy:{payload}"
        },
        {
          "id": "s2",
          "separator": true
        },
        {
          "id": "import",
          "label": "Import asset…",
          "icon": "upload",
          "action": "dialog:import-asset",
          "requires": "assets.import"
        }
      ],
      "nav-item": [
        {
          "id": "open",
          "label": "Open",
          "icon": "chevron-right",
          "action": "nav:{payload}"
        },
        {
          "id": "s1",
          "separator": true
        },
        {
          "id": "next-nav",
          "label": "Next navigation menu",
          "icon": "grid",
          "action": "swap:nav-menu:next",
          "requires": "assets.swap"
        },
        {
          "id": "next-layout",
          "label": "Next layout",
          "icon": "layout",
          "action": "swap:layout:next",
          "shortcut": "Alt+L",
          "requires": "assets.swap"
        },
        {
          "id": "s2",
          "separator": true
        },
        {
          "id": "toggle-nav",
          "label": "Show or hide navigation",
          "icon": "list",
          "action": "slot.hide:nav-menu:toggle"
        }
      ]
    }
  }
}
