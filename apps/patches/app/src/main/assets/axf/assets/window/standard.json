{
  "$axf": "asset@1",
  "type": "window",
  "id": "standard",
  "name": "Standard windows",
  "version": "0.1.0",
  "description": "Default window schema: dock/floating windows force toolbars on, minimize to the bottom-right corner as stacked title bars.",
  "author": "AmberX AXF",
  "tags": ["android", "default"],
  "data": {
    "kind": "dock",
    "toolbarsAllowed": true,
    "forceToolbarWhenFloating": true,
    "minimize": { "corner": "bottom-right", "mode": "stacked" },
    "size": { "width": 380, "height": 460 },
    "defaults": {
      "main": { "toolbarsAllowed": true, "toolbarEnabled": false },
      "dock": { "toolbarsAllowed": true, "toolbarEnabled": true },
      "floating": { "toolbarsAllowed": true, "toolbarEnabled": true },
      "tool": { "toolbarsAllowed": true, "toolbarEnabled": true },
      "panel": { "toolbarsAllowed": false, "toolbarEnabled": false },
      "dialog": { "toolbarsAllowed": false, "toolbarEnabled": false }
    }
  }
}
