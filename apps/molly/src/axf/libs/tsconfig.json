{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "bundler", "jsx": "react-jsx",
    "strict": true, "noUncheckedIndexedAccess": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "resolveJsonModule": true, "isolatedModules": true, "skipLibCheck": true, "noEmit": true, "types": []
  },
  "include": ["./**/*.ts", "./**/*.tsx", "../core/**/*.ts", "../react/**/*.ts", "../react/**/*.tsx"],
  "exclude": ["node_modules"]
}
