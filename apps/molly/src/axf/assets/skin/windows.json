{
  "$axf": "asset@1",
  "type": "skin",
  "id": "windows",
  "name": "Windows",
  "version": "2.0.0",
  "description": "Makes the app look and behave like a Windows 11 program: Segoe UI, Mica colours, a title bar, a menu bar, an Explorer layout with a sidebar, boxed tabs on top, modal dialogs, right-click menus with flyout sub menus, confirm dialogs on destructive buttons, compact grid tables, Windows-style buttons and scrollbars, the AmberX outline icon pack, and square-cornered widgets (labels, badges, counters, avatars, progress, clocks) through its style parts. It runs inside the browser, so it can't replace the real OS title bar or native pickers such as the file picker. Segoe UI needs a device that has the font.",
  "author": "AmberX AXF",
  "tags": [
    "windows",
    "skin"
  ],
  "data": {
    "layoutTheme": "windows-explorer",
    "colorTheme": "windows-light",
    "colorThemes": {
      "light": "windows-light",
      "dark": "windows-dark"
    },
    "styleTheme": "windows",
    "assets": {
      "banner": "windows-titlebar",
      "app-menu": "standard-desktop",
      "button": "windows",
      "dialog": "windows",
      "context-menu": "windows",
      "toolbar": "windows",
      "container": "windows",
      "nav-menu": "sidebar-list",
      "tab-group": "boxed",
      "popup": "corner-solid",
      "slider": "classic-round",
      "gauge": "classic-arc",
      "meter": "segments",
      "table": "standard",
      "settings": "standard",
      "dock-layout": "main-side",
      "nav-style": "standard",
      "behavior-theme": "brisk",
      "branding": "amberx",
      "agent-card": "corporate-badge",
      "typography": "windows",
      "density": "compact",
      "sizing": "compact"
    },
    "preview": {
      "caption": "Windows 11 look: title bar, menu bar, Explorer layout."
    },
    "extras": {
      "hidden": {
        "toolbar": false,
        "nav-menu": false,
        "banner": false,
        "app-menu": false
      }
    },
    "iconPack": "amberx-outline",
    "parts": {
      "button": {
        "radius": "sm",
        "hover": "highlight"
      },
      "action-button": {
        "radius": "sm",
        "hover": "highlight"
      },
      "badge": {
        "radius": "sm"
      },
      "counter": {
        "radius": "sm",
        "fontWeight": "600"
      },
      "label": {
        "fontWeight": "400"
      },
      "link": {
        "hover": "underline",
        "textColor": "accent"
      },
      "avatar": {
        "radius": "sm"
      },
      "progress": {
        "radius": "none"
      },
      "status": {
        "fontWeight": "400"
      },
      "search-bar": {
        "radius": "sm"
      },
      "clock": {
        "fontFamily": "system",
        "fontWeight": "400"
      },
      "logo": {
        "radius": "none"
      },
      "theme-switch": {
        "radius": "sm"
      },
      "spacer": {
        "padding": "none"
      },
      "divider": {
        "borderColor": "muted"
      }
    },
    "behaviour": {
      "app-menu": {
        "form": "menubar"
      },
      "toolbar": {
        "placement": "top",
        "tapConfirm": "default",
        "labels": "icons"
      },
      "nav-menu": {
        "mode": "sidebar",
        "side": "left"
      },
      "context-menu": {
        "form": "menu",
        "submenus": "flyout"
      },
      "tab-group": {
        "position": "top",
        "overflow": "scroll",
        "style": "boxed",
        "display": "both"
      },
      "dialog": {
        "presentation": "modal",
        "panelSide": "right"
      },
      "button": {
        "press": "theme",
        "confirm": "destructive",
        "confirmBy": "dialog",
        "holdMs": 600
      },
      "table": {
        "form": "grid",
        "density": "compact",
        "rowActions": "hover",
        "stickyHeader": true
      },
      "banner": {
        "placement": "top"
      }
    }
  }
}
