      "root": ".fx-menubar",
      "item": ".fx-menubar__btn, .fx-menu__item"
    },
    "toolbar": {
      "root": ".fx-toolbar",
      "item": ".fx-toolbtn"
    },
    "nav-menu": {
      "root": ".fx-nav",
      "item": ".fx-nav__item",
      "text": ".fx-nav__header, .fx-nav__label"
    },
    "context-menu": {
