{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axf/badge.schema.json",
  "title": "AmberX AXF Badge asset",
  "type": "object",
  "required": [
    "$axf",
    "type",
    "id",
    "name",
    "version",
    "data"
  ],
  "properties": {
    "$axf": {
      "const": "asset@1"
    },
    "type": {
      "const": "badge"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "icon",
        "label",
        "tone",
        "shape"
      ],
      "properties": {
        "icon": {},
        "label": {},
        "tone": {
          "enum": [
            "neutral",
            "success",
            "warning",
            "danger",
            "accent",
            "muted"
          ]
        },
        "shape": {
          "enum": [
            "pill",
            "icon",
            "dot"
          ]
        }
      }
    }
  }
}
