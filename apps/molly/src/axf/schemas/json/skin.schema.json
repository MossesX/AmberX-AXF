        "hooks": {
          "type": "object",
          "description": "skin-slots@1 hooks: hook@1 refs and lib-dnd drop zones per chrome kind and grid row (ids only; axf.hooks.<kind>).",
          "properties": {
            "tab-group": {
              "type": "object",
              "properties": {
                "hooks": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9._:/-]{0,119}$"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "pattern": "^[a-z0-9][a-z0-9._:/-]{0,119}$"
                          },
                          "args": {
                            "type": "object",
                            "additionalProperties": {
                              "type": [
                                "string",
                                "number",
                                "boolean"
                              ]
                            }
                          }
                        },
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "drop": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9._:/-]{0,119}$"
                  }
                }
              },
              "additionalProperties": false
            },
            "toolbar": {
