        "behavior": {
          "type": "object",
          "description": "skin-slots@1 behaviour: settings-layer defaults (tap-to-confirm, hover / press / focus feedback, overflow, sticky, collapse).",
          "properties": {
            "tapConfirm": {
              "type": "object",
              "properties": {
                "armMs": {
                  "type": "number",
                  "minimum": 1000,
                  "maximum": 10000
                },
                "tab-group": {
                  "enum": [
                    "on",
                    "off"
                  ]
                },
                "toolbar": {
                  "enum": [
                    "on",
                    "off"
                  ]
                },
                "banner": {
                  "enum": [
                    "on",
                    "off"
                  ]
                },
                "nav-menu": {
                  "enum": [
                    "on",
                    "off"
                  ]
                },
                "app-menu": {
                  "enum": [
                    "on",
