{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axf/skin.schema.json",
  "title": "AmberX AXF Skin asset",
  "type": "object",
  "required": [
    "$axf",
    "type",
    "id",
    "name",
    "version",
    "data"
  ],
  "properties": {
    "$axf": {
      "const": "asset@1"
    },
    "type": {
      "const": "skin"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "layoutTheme",
        "colorTheme",
        "styleTheme",
        "assets",
        "colorThemes"
      ],
      "properties": {
        "layoutTheme": {},
        "colorTheme": {},
        "styleTheme": {},
        "assets": {},
        "colorThemes": {
          "type": "object",
          "description": "The skin's light and dark colour themes (skin-modes@1); colorTheme is one of the two.",
          "required": [
            "light",
            "dark"
          ],
          "properties": {
            "light": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "dark": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          }
        },
        "behaviorTheme": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "chrome": {
          "type": "object",
          "description": "Chrome settings the skin puts in force per chrome-settings@1 kind; lands in the composed look's settings after extras.settings.",
          "properties": {
            "tab-group": {
              "type": "object",
              "description": "tab-group under this skin: the settings interface its dialog renders through (axf.chrome.settings.tab-group) and field overrides per instance (axf.chrome.tab-group.<instance>, this kind's chrome-settings@1 fields only).",
              "properties": {
                "interface": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                },
                "instances": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "style": {
                        "enum": [
                          "underline",
                          "pills",
                          "boxed",
                          "segmented",
                          "plain",
                          "chips"
                        ]
                      },
                      "position": {
                        "enum": [
                          "top",
                          "bottom",
                          "left",
                          "right"
                        ]
                      },
                      "display": {
                        "enum": [
                          "both",
                          "text",
                          "icons"
                        ]
                      },
                      "density": {
                        "enum": [
                          "compact",
                          "regular",
                          "roomy"
                        ]
                      },
                      "align": {
                        "enum": [
                          "start",
                          "center",
                          "end",
                          "stretch"
                        ]
                      },
                      "divider": {
                        "type": "boolean"
                      },
                      "badges": {
                        "type": "boolean"
                      },
                      "overflow": {
                        "enum": [
                          "scroll",
                          "wrap",
                          "more",
                          "dropdown"
                        ]
                      },
                      "sticky": {
                        "type": "boolean"
                      },
                      "collapsible": {
                        "type": "boolean"
                      },
                      "rememberLast": {
                        "type": "boolean"
                      },
                      "closable": {
                        "type": "boolean"
                      },
                      "reorderable": {
                        "type": "boolean"
                      },
                      "tapConfirm": {
                        "enum": [
                          "inherit",
                          "on",
                          "off"
                        ]
                      },
                      "rows": {
                        "enum": [
                          "1",
                          "2",
                          "3",
                          "4",
                          "5",
                          "6",
                          "auto"
                        ]
                      }
                    }
                  }
                }
              },
              "additionalProperties": false
            },
            "toolbar": {
              "type": "object",
              "description": "toolbar under this skin: the settings interface its dialog renders through (axf.chrome.settings.toolbar) and field overrides per instance (axf.chrome.toolbar.<instance>, this kind's chrome-settings@1 fields only).",
              "properties": {
                "interface": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                },
                "instances": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "variant": {
                        "enum": [
                          "icons",
                          "icons-labels",
                          "labels"
                        ]
                      },
                      "align": {
                        "enum": [
                          "start",
                          "center",
                          "spread"
                        ]
                      },
                      "density": {
                        "enum": [
                          "compact",
                          "regular",
                          "roomy"
                        ]
                      },
                      "surface": {
                        "enum": [
                          "flat",
                          "raised",
                          "glass"
                        ]
                      },
                      "divider": {
                        "type": "boolean"
                      },
                      "showSearch": {
                        "type": "boolean"
                      },
                      "collapsible": {
                        "type": "boolean"
                      },
                      "tapConfirm": {
                        "enum": [
                          "inherit",
                          "on",
                          "off"
                        ]
                      }
                    }
                  }
                }
              },
              "additionalProperties": false
            },
            "banner": {
              "type": "object",
              "description": "banner under this skin: the settings interface its dialog renders through (axf.chrome.settings.banner) and field overrides per instance (axf.chrome.banner.<instance>, this kind's chrome-settings@1 fields only).",
              "properties": {
                "interface": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                },
                "instances": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "surface": {
                        "enum": [
                          "flat",
                          "raised",
                          "accent"
                        ]
                      },
                      "height": {
                        "type": "number",
                        "minimum": 16,
                        "maximum": 48
                      },
                      "divider": {
                        "type": "boolean"
                      },
                      "tapConfirm": {
                        "enum": [
                          "inherit",
                          "on",
                          "off"
                        ]
                      }
                    }
                  }
                }
              },
              "additionalProperties": false
            },
            "nav-menu": {
              "type": "object",
              "description": "nav-menu under this skin: the settings interface its dialog renders through (axf.chrome.settings.nav-menu) and field overrides per instance (axf.chrome.nav-menu.<instance>, this kind's chrome-settings@1 fields only).",
              "properties": {
                "interface": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                },
                "instances": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "style": {
                        "enum": [
                          "list",
                          "pills",
                          "rail"
                        ]
                      },
                      "density": {
                        "enum": [
                          "compact",
                          "regular",
                          "roomy"
                        ]
                      },
                      "indicator": {
                        "enum": [
                          "auto",
                          "bar",
                          "fill",
                          "none"
                        ]
                      },
                      "showIcons": {
                        "type": "boolean"
                      },
                      "navStyle": {
                        "type": "boolean"
                      },
                      "tapConfirm": {
                        "enum": [
                          "inherit",
                          "on",
                          "off"
                        ]
                      }
                    }
                  }
                }
              },
              "additionalProperties": false
            },
            "app-menu": {
              "type": "object",
              "description": "app-menu under this skin: the settings interface its dialog renders through (axf.chrome.settings.app-menu) and field overrides per instance (axf.chrome.app-menu.<instance>, this kind's chrome-settings@1 fields only).",
              "properties": {
                "interface": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                },
                "instances": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "density": {
                        "enum": [
                          "compact",
                          "regular",
                          "roomy"
                        ]
                      },
                      "surface": {
                        "enum": [
                          "flat",
                          "raised",
                          "glass"
                        ]
                      },
                      "tapConfirm": {
                        "enum": [
                          "inherit",
                          "on",
                          "off"
                        ]
                      }
                    }
                  }
                }
              },
              "additionalProperties": false
            },
            "context-menu": {
              "type": "object",
              "description": "context-menu under this skin: the settings interface its dialog renders through (axf.chrome.settings.context-menu) and field overrides per instance (axf.chrome.context-menu.<instance>, this kind's chrome-settings@1 fields only).",
              "properties": {
                "interface": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                },
                "instances": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "variant": {
                        "enum": [
                          "compact",
                          "roomy",
                          "glass"
                        ]
                      },
                      "showIcons": {
                        "type": "boolean"
                      },
                      "showShortcuts": {
                        "type": "boolean"
                      },
                      "tapConfirm": {
                        "enum": [
                          "inherit",
                          "on",
                          "off"
                        ]
                      }
                    }
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "motion": {
          "type": "object",
          "description": "skin-slots@1 motion: durations, easings, enter / exit per chrome kind, reduced motion → --fx-motion-* tokens.",
          "properties": {
            "speed": {
              "type": "object",
              "properties": {
                "fast": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 2000
                },
                "normal": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 2000
                },
                "slow": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 2000
                }
              },
              "additionalProperties": false
            },
            "easing": {
              "type": "object",
              "properties": {
                "standard": {
                  "anyOf": [
                    {
                      "enum": [
                        "standard",
                        "emphasized",
                        "linear",
                        "spring",
                        "bounce"
                      ]
                    },
                    {
                      "enum": [
                        "linear",
                        "ease",
                        "ease-in",
                        "ease-out",
                        "ease-in-out"
                      ]
                    },
                    {
                      "type": "string",
                      "pattern": "^cubic-bezier\\("
                    }
                  ]
                },
                "emphasized": {
                  "anyOf": [
                    {
                      "enum": [
                        "standard",
                        "emphasized",
                        "linear",
                        "spring",
                        "bounce"
                      ]
                    },
                    {
                      "enum": [
                        "linear",
                        "ease",
                        "ease-in",
                        "ease-out",
                        "ease-in-out"
                      ]
                    },
                    {
                      "type": "string",
                      "pattern": "^cubic-bezier\\("
                    }
                  ]
                },
                "exit": {
                  "anyOf": [
                    {
                      "enum": [
                        "standard",
                        "emphasized",
                        "linear",
                        "spring",
                        "bounce"
                      ]
                    },
                    {
                      "enum": [
                        "linear",
                        "ease",
                        "ease-in",
                        "ease-out",
                        "ease-in-out"
                      ]
                    },
                    {
                      "type": "string",
                      "pattern": "^cubic-bezier\\("
                    }
                  ]
                }
              },
              "additionalProperties": false
            },
            "reduced": {
              "enum": [
                "system",
                "always",
                "never"
              ]
            },
            "chrome": {
              "type": "object",
              "properties": {
                "tab-group": {
                  "type": "object",
                  "properties": {
                    "enter": {
                      "enum": [
                        "none",
                        "fade",
                        "rise",
                        "scale",
                        "slide"
                      ]
                    },
                    "exit": {
                      "enum": [
                        "none",
                        "fade",
                        "rise",
                        "scale",
                        "slide"
                      ]
                    },
                    "duration": {
                      "enum": [
                        "fast",
                        "normal",
                        "slow"
                      ]
                    },
                    "stagger": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 200
                    }
                  },
                  "additionalProperties": false
                },
                "toolbar": {
                  "type": "object",
                  "properties": {
                    "enter": {
                      "enum": [
                        "none",
                        "fade",
                        "rise",
                        "scale",
                        "slide"
                      ]
                    },
                    "exit": {
                      "enum": [
                        "none",
                        "fade",
                        "rise",
                        "scale",
                        "slide"
                      ]
                    },
                    "duration": {
                      "enum": [
                        "fast",
                        "normal",
                        "slow"
                      ]
                    },
                    "stagger": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 200
                    }
                  },
                  "additionalProperties": false
                },
                "banner": {
                  "type": "object",
                  "properties": {
                    "enter": {
                      "enum": [
                        "none",
