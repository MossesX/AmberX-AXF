                      ]
                    },
                    "stagger": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 200
                    }
                  },
                  "additionalProperties": false
                },
                "nav-menu": {
                  "type": "object",
                  "properties": {
                    "enter": {
                      "enum": [
                        "none",
