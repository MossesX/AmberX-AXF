{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axf/skin.schema.json",
  "title": "AmberX AXF Skin asset (skin@2)",
  "type": "object",
  "required": [
    "$axf",
    "type",
    "id",
    "name",
    "version",
    "data"
  ],
  "properties": {
    "$axf": {
      "const": "asset@1"
    },
    "type": {
      "const": "skin"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "assets"
      ],
      "properties": {
        "layoutTheme": {
          "type": "string"
        },
        "colorTheme": {
          "type": "string"
        },
        "styleTheme": {
          "type": "string"
        },
        "behaviorTheme": {
          "type": "string"
        },
        "sections": {
          "type": "object",
          "properties": {
            "colors": {
              "type": "object"
            },
            "style": {
              "type": "object"
            },
            "layout": {
              "type": "object"
            },
            "behavior": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "assets": {
          "type": "object"
        },
        "iconPack": {
          "type": "string"
        },
        "parts": {
          "type": "object"
        },
        "preview": {
          "type": "object"
        },
        "extras": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "anyOf": [
            {
              "required": [
                "colorTheme"
              ]
            },
            {
              "properties": {
                "sections": {
                  "required": [
                    "colors"
                  ]
                }
              },
              "required": [
                "sections"
              ]
            }
          ]
        },
        {
          "anyOf": [
            {
              "required": [
                "styleTheme"
              ]
            },
            {
              "properties": {
                "sections": {
                  "required": [
                    "style"
                  ]
                }
              },
              "required": [
                "sections"
              ]
            }
          ]
        },
        {
          "anyOf": [
            {
              "required": [
                "layoutTheme"
              ]
            },
            {
              "properties": {
                "sections": {
                  "required": [
                    "layout"
                  ]
                }
              },
              "required": [
                "sections"
              ]
            }
          ]
        }
      ]
    }
  }
}
