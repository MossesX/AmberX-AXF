{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axf/logo-mark.schema.json",
  "title": "AmberX AXF Logo mark asset",
  "type": "object",
  "required": [
    "$axf",
    "type",
    "id",
    "name",
    "version",
    "data"
  ],
  "properties": {
    "$axf": {
      "const": "asset@1"
    },
    "type": {
      "const": "logo-mark"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "form",
        "paths"
      ],
      "properties": {
        "form": {
          "enum": [
            "mark",
            "wordmark",
            "lockup"
          ]
        },
        "paths": {}
      }
    }
  }
}
