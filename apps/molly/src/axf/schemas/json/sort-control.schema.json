{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axf/sort-control.schema.json",
  "title": "AmberX AXF Sort control asset",
  "type": "object",
  "required": [
    "$axf",
    "type",
    "id",
    "name",
    "version",
    "data"
  ],
  "properties": {
    "$axf": {
      "const": "asset@1"
    },
    "type": {
      "const": "sort-control"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "display",
        "style"
      ],
      "properties": {
        "display": {
          "enum": [
            "icon",
            "label",
            "both"
          ]
        },
        "style": {
          "enum": [
            "menu",
            "chips",
            "buttons"
          ]
        }
      }
    }
  }
}
