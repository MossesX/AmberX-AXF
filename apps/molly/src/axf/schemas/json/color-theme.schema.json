{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axf/color-theme.schema.json",
  "title": "AmberX AXF Color theme asset",
  "type": "object",
  "required": [
    "$axf",
    "type",
    "id",
    "name",
    "version",
    "data"
  ],
  "properties": {
    "$axf": {
      "const": "asset@1"
    },
    "type": {
      "const": "color-theme"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "scheme",
        "tokens"
      ],
      "properties": {
        "scheme": {
          "enum": [
            "light",
            "dark"
          ]
        },
        "tokens": {
          "type": "object",
          "required": [
            "bg",
            "surface",
            "surface2",
            "surface3",
            "text",
            "muted",
            "border",
            "accent",
            "accentText",
            "accentSoft",
            "danger",
            "success",
            "warning",
            "info",
            "focus",
            "shadow"
          ]
        }
      }
    }
  }
}
