{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axf/slider.schema.json",
  "title": "AmberX AXF Slider asset",
  "type": "object",
  "required": [
    "$axf",
    "type",
    "id",
    "name",
    "version",
    "data"
  ],
  "properties": {
    "$axf": {
      "const": "asset@1"
    },
    "type": {
      "const": "slider"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "track",
        "thumb",
        "thumbSize",
        "fill",
        "showValue",
        "ticks"
      ],
      "properties": {
        "track": {},
        "thumb": {
          "enum": [
            "circle",
            "square",
            "bar"
          ]
        },
        "thumbSize": {},
        "fill": {
          "enum": [
            "solid",
            "gradient",
            "none"
          ]
        },
        "showValue": {
          "enum": [
            "always",
            "hover",
            "never"
          ]
        },
        "ticks": {}
      }
    }
  }
}
