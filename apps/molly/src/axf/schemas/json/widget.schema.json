{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axf/widget.schema.json",
  "title": "AmberX AXF Home-screen widget asset",
  "type": "object",
  "required": [
    "$axf",
    "type",
    "id",
    "name",
    "version",
    "data"
  ],
  "properties": {
    "$axf": {
      "const": "asset@1"
    },
    "type": {
      "const": "widget"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "size",
        "content"
      ],
      "properties": {
        "size": {
          "enum": [
            "small",
            "medium",
            "large",
            "extra-large"
          ]
        },
        "content": {}
      }
    }
  }
}
