{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axf/progress.schema.json",
  "title": "AmberX AXF Progress asset",
  "type": "object",
  "required": [
    "$axf",
    "type",
    "id",
    "name",
    "version",
    "data"
  ],
  "properties": {
    "$axf": {
      "const": "asset@1"
    },
    "type": {
      "const": "progress"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "counter",
        "max",
        "width"
      ],
      "properties": {
        "counter": {},
        "max": {},
        "width": {
          "enum": [
            "compact",
            "regular",
            "wide"
          ]
        }
      }
    }
  }
}
