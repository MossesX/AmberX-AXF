{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axf/spacer.schema.json",
  "title": "AmberX AXF Spacer asset",
  "type": "object",
  "required": [
    "$axf",
    "type",
    "id",
    "name",
    "version",
    "data"
  ],
  "properties": {
    "$axf": {
      "const": "asset@1"
    },
    "type": {
      "const": "spacer"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "size"
      ],
      "properties": {
        "size": {
          "enum": [
            "small",
            "regular",
            "large",
            "flex"
          ]
        }
      }
    }
  }
}
