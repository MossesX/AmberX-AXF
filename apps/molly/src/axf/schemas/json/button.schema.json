{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axf/button.schema.json",
  "title": "AmberX AXF Button asset",
  "type": "object",
  "required": [
    "$axf",
    "type",
    "id",
    "name",
    "version",
    "data"
  ],
  "properties": {
    "$axf": {
      "const": "asset@1"
    },
    "type": {
      "const": "button"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "shape",
        "fill",
        "weight",
        "uppercase",
        "size",
        "elevation"
      ],
      "properties": {
        "shape": {
          "enum": [
            "rounded",
            "pill",
            "square"
          ]
        },
        "fill": {
          "enum": [
            "solid",
            "soft",
            "outline",
            "gradient"
          ]
        },
        "weight": {},
        "uppercase": {},
        "size": {
          "enum": [
            "sm",
            "md",
            "lg"
          ]
        },
        "elevation": {}
      }
    }
  }
}
