{
  "$axf": "asset@1",
  "type": "app-menu",
  "id": "molly",
  "name": "Molly menu",
  "version": "0.2.0",
  "description": "Molly's application menu, kept short: the start page, the apps, this app, settings and account at the top; everything else in sub-menus (spec: apps/molly/menus/inventory.md).",
  "author": "AmberX AXF",
  "tags": [
    "molly"
  ],
  "data": {
    "density": "regular",
    "surface": "glass",
    "menus": [
      {
        "id": "molly",
        "label": "Molly",
        "order": 10,
        "items": [
          {
            "id": "go-home",
            "label": "Start page",
            "icon": "home",
            "action": "nav:home",
            "hint": "Molly's start page: every app with Open in Molly and Open on its own."
          },
          {
            "id": "apps",
            "label": "Apps",
            "icon": "grid",
            "hint": "Switch to another app. Each one stays alive in the background.",
            "items": [
              {
                "id": "go-amberx",
                "label": "AmberX",
                "icon": "sparkles",
                "action": "nav:amberx",
                "hint": "AmberX: plugins, voice, walkthroughs."
              },
              {
                "id": "go-axhub",
                "label": "axHub",
                "icon": "shield",
                "action": "nav:axhub",
                "hint": "axHub: approvals, go pass, services."
              },
              {
                "id": "go-console",
                "label": "Console",
                "icon": "terminal",
                "action": "nav:console",
                "hint": "The Dev Console: builds, plugins, UI Review."
              },
              {
                "id": "go-expenses",
                "label": "Expenses",
                "icon": "chart",
                "action": "nav:expenses",
                "hint": "The Expense Tracker: ledger, paydays, reports."
              }
            ]
          },
          {
            "id": "this-app",
            "label": "This app",
            "icon": "monitor",
            "hint": "Commands for the app on screen.",
            "items": [
              {
                "id": "reload",
                "label": "Reload this app",
                "icon": "refresh",
                "action": "molly.reload",
                "shortcut": "Alt+R",
                "hint": "Reload only the app on screen; the others keep their place."
              },
              {
                "id": "own",
                "label": "Open this app on its own",
                "icon": "external",
                "action": "molly.own-tab",
                "hint": "Open the app on screen at its own address in a new tab."
              }
            ]
          },
          {
            "id": "appearance",
            "label": "Appearance",
            "icon": "palette",
            "hint": "Skin, day or night, density, text size and motion: a pick applies at once.",
            "items": [
              {
                "id": "skin",
                "label": "Skin",
                "icon": "layers",
                "setting": "molly.look.skin",
                "status": {
                  "source": "source:molly.skin",
                  "tooltip": "Skin in use"
                },
                "hint": "The whole look of Molly.",
                "choices": [
                  {
                    "value": "molly-flagship",
                    "label": "Flagship",
                    "hint": "Porcelain, ink and violet."
                  },
                  {
                    "value": "molly-flagship-night",
                    "label": "Flagship Night",
                    "hint": "Graphite and violet, for after dark."
                  },
                  {
                    "value": "own",
                    "label": "Molly's own look",
                    "hint": "No skin: Molly's own assets."
                  }
                ]
              },
              {
                "id": "mode",
                "label": "Day / night",
                "icon": "moon",
                "setting": "molly.look.mode",
                "cycle": true,
                "hint": "Click to switch between day and night.",
                "choices": [
                  {
                    "value": "day",
                    "label": "Day",
                    "hint": "Light surfaces."
                  },
                  {
                    "value": "night",
                    "label": "Night",
                    "hint": "Dark surfaces."
                  }
                ]
              },
              {
                "id": "density",
                "label": "Density",
                "icon": "sliders",
                "setting": "molly.look.density",
                "hint": "How tightly rows and controls are packed.",
                "choices": [
                  {
                    "value": "compact",
                    "label": "Compact",
                    "hint": "More on screen."
                  },
                  {
                    "value": "standard",
                    "label": "Standard",
                    "hint": "Balanced."
                  },
                  {
                    "value": "roomy",
                    "label": "Roomy",
                    "hint": "More breathing room."
                  }
                ]
              },
              {
                "id": "text",
                "label": "Text size",
                "icon": "type",
                "setting": "molly.look.text",
                "hint": "The size of text everywhere.",
                "choices": [
                  {
                    "value": "compact",
                    "label": "Small",
                    "hint": "Compact text sizes."
                  },
                  {
                    "value": "molly-flagship",
                    "label": "Medium",
                    "hint": "The flagship text sizes."
                  },
                  {
                    "value": "reader",
                    "label": "Large",
                    "hint": "Larger, easier to read."
                  }
                ]
              },
              {
                "id": "motion",
                "label": "Motion",
                "icon": "zap",
                "setting": "molly.look.motion",
                "hint": "Animations: full, or kept to a minimum.",
                "choices": [
                  {
                    "value": "molly-flagship",
                    "label": "Full",
                    "hint": "Quick, quiet animations."
                  },
                  {
                    "value": "minimal-motion",
                    "label": "Minimal",
                    "hint": "Almost no animation."
                  }
                ]
              },
              {
                "id": "appearance-sep",
                "separator": true
              },
              {
                "id": "appearance-settings",
                "label": "Appearance settings…",
                "icon": "settings",
                "action": "settings.open:appearance",
                "hint": "Settings → Appearance: every skin and theme."
              }
            ]
          },
          {
            "id": "status",
            "label": "Status",
            "icon": "zap",
            "status": {
              "source": "source:hub",
              "tooltip": "axHub connection"
            },
            "hint": "Live status: axHub, the shared look, the skin and your role.",
            "items": [
              {
                "id": "status-hub",
                "label": "axHub connection",
                "icon": "cloud",
                "action": "nav:axhub",
                "status": {
                  "source": "source:hub",
                  "tooltip": "axHub connection"
                },
                "hint": "Green when Molly is connected to axHub, red when not. Opens axHub."
              },
              {
                "id": "status-look",
                "label": "Look sync",
                "icon": "palette",
                "action": "settings.open:appearance",
                "status": {
                  "source": "source:molly.look",
                  "tooltip": "Look sync"
                },
                "hint": "Green when the shared look on axHub is in sync, red when axHub can't be reached."
              },
              {
                "id": "status-skin",
                "label": "Skin",
                "icon": "layers",
                "action": "settings.open:appearance",
                "status": {
                  "source": "source:molly.skin",
                  "tooltip": "Skin"
                },
                "hint": "Which skin is on."
              },
              {
                "id": "status-role",
                "label": "Role",
                "icon": "user",
                "action": "nav:account",
                "status": {
                  "source": "source:molly.role",
                  "tooltip": "Role"
                },
                "hint": "Who you are in Molly. Opens Account."
              }
            ]
          },
          {
            "id": "s1",
            "separator": true
          },
          {
            "id": "settings",
            "label": "Settings",
            "icon": "settings",
            "action": "app.settings",
            "shortcut": "Ctrl+,",
            "hint": "All of Molly's settings: appearance, plugins, account."
          },
          {
            "id": "account",
            "label": "Account",
            "icon": "user",
            "action": "nav:account",
            "hint": "Who you're signed in as, and your roles."
          }
        ]
      }
    ]
  }
}
