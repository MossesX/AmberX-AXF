  {
   "id": "molly/setting/navigation",
   "type": "setting",
   "label": "Molly navigation look",
   "description": "Molly's navigation menu style (nav-style@1): the same look settings as control@1 tokens.nav, kept on axHub, so a change here is a change everywhere that reads axf.tokens.nav. The preset swap and collapse to icons run inside Molly's window only.",
   "where": {
    "app": "molly",
    "plugin": "navigation",
    "file": "apps/molly/plugins/navigation/plugin.json"
   },
   "state": {
    "read": "control:tokens.nav/list",
    "shape": "every nav-style field in force with its allowed values (axf ctl get console-web/display/tokens.nav)"
   },
   "actions": [
    {
     "id": "get",
     "label": "Read the navigation settings",
     "effect": "read",
     "run": "control:tokens.nav/list"
    },
    {
     "id": "set",
     "label": "Change one navigation setting",
     "effect": "write",
     "run": "control:tokens.nav/set",
     "params": [
      {
       "name": "path",
       "type": "id",
       "of": "tokens.nav",
       "required": true,
       "position": 0,
       "description": "a nav-style field (axf ctl get console-web/display/tokens.nav lists them with their allowed values)"
      },
      {
       "name": "value",
       "type": "json",
       "required": true,
       "position": 1
      }
     ],
     "phrases": [
      "set molly navigation {path} to {value}"
     ]
    },
    {
     "id": "reset",
     "label": "Reset the navigation settings",
     "effect": "write",
     "run": "control:tokens.nav/reset",
     "phrases": [
      "reset molly navigation"
     ]
    }
   ],
   "gaps": [
    {
     "what": "actions",
     "why": "navigation.preset (swap the nav-style asset: standard, glide, accordion, soft-fade, push, still) and navigation.collapse run only inside Molly's window: Molly has no remote command channel yet",
     "plan": "a Molly command client on console-commands@1 (app 'molly')"
    }
   ],
   "parent": "molly/plugin/navigation",
   "synonyms": [
    "molly nav",
    "molly menu"
   ],
   "tags": [
    "setting"
   ]
  },
  {
   "id": "molly/tool/navigation/navigation.get",
   "remove": true
  },
  {
   "id": "molly/tool/navigation/navigation.set",
   "remove": true
  },
  {
   "id": "molly/tool/navigation/navigation.reset",
   "remove": true
  }
 ]
