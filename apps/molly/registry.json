{
 "$axf": "control-registry@1",
 "note": "Molly (apps/molly) in the control registry: the app, its framed apps (deep links #/<app>/<route>, run as a URL handoff the caller opens: a browser, AmberX's open_url, axf ctl open) and its navigation look (control@1 tokens.nav, executable from every surface). Molly's own plugins, pages and runtime actions are collected from apps/molly/plugins by the registry's app collector; everything that runs only inside Molly's window is listed as a gap with the reason. Merged by id.",
 "entries": [
  {
   "id": "molly/app/molly",
   "type": "app",
   "label": "Molly",
   "description": "One interface for AmberX, axHub, the Dev Console and Expenses (apps/molly). Each app is framed at its own address; deep links #/<app>/<route>.",
   "where": {
    "app": "molly",
    "file": "apps/molly/src/molly/apps.ts"
   },
   "open": {
    "kind": "url",
    "target": "https://molly.amberxai.com",
    "deepLink": "https://molly.amberxai.com/#/"
   },
   "actions": [
    {
     "id": "open",
     "label": "Open Molly on an app",
     "effect": "navigate",
     "run": "url:https://molly.amberxai.com/#/{app}/{route}",
     "params": [
      {
       "name": "app",
       "type": "enum",
       "enum": [
        "amberx",
        "axhub",
        "console",
        "expenses"
       ],
       "enumLabels": {
        "amberx": "AmberX",
        "axhub": "axHub",
        "console": "Console",
        "expenses": "Expenses"
       },
       "required": true,
       "position": 0
      },
      {
       "name": "route",
       "type": "string",
       "pattern": "^[A-Za-z0-9._~:/?#=&%+-]{0,300}$",
       "description": "the app's own route (e.g. builds), optional",
       "position": 1
      }
     ],
     "phrases": [
      "open molly",
      "open {app} in molly"
     ]
    }
   ],
   "synonyms": [
    "molly"
   ],
   "tags": [
    "app"
   ]
  },
