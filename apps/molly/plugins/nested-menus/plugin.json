{
  "$axf": "plugin@1",
  "id": "ai.amberx.axf.molly.nested-menus",
  "name": "Nested menus",
  "version": "0.1.0",
  "kind": "module",
  "apiLevel": 1,
  "author": "Brett",
  "description": "Molly's application menu and navigation generated from its registry (nested-menu@1, the same generator the Dev Console and AmberX use): the apps it holds, their pages, every plugin's pages, dialogs and settings, as categories and sub menus with at most 12 rows per level, Favourites and Recent on top and Jump to\u2026. Overrides Molly's shared app-menu and nav-menu assets (on by default). Settings \u2192 Plugins \u2192 Menus.",
  "targets": [
    "molly"
  ],
  "provides": [
    "dialog:menus.jump",
    "settings-tab:menus",
    "action:menus.jump",
    "action:menus.override",
    "action:menus.favorite"
  ],
  "scopes": [],
  "enabledByDefault": true,
  "optional": [],
  "banner": false,
  "tabable": false,
  "menu": {
    "category": "look",
    "keywords": [
      "menus",
      "navigation",
      "generated"
    ]
  },
  "lifecycle": {
    "$axf": "plugin-lifecycle@1",
    "dataDir": ".axf-console/plugins/molly-nested-menus",
    "env": [],
    "mentions": [
      "apps/molly/README.md",
      ".github/workflows/android.yml",
      "apps/console-web/plugins/README.md",
      "apps/amberx-droid/src/plugins/README.md"
    ]
  },
  "commands": {
    "$axf": "plugin-commands@1",
    "auto": true,
    "items": [
      {
        "id": "jump",
        "title": "Jump to a menu entry",
        "description": "Search every app, page, dialog, setting and action; one clear match opens at once, otherwise the Jump to\u2026 dialog opens.",
        "action": "menus.jump",
        "input": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string"
            }
          }
        }
      },
      {
        "id": "open",
        "title": "Open a menu entry by id",
        "action": "menus.open",
        "input": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            }
          },
          "required": [
            "id"
          ]
        }
      },
      {
        "id": "favorite",
        "title": "Pin or unpin a favourite",
        "action": "menus.favorite",
        "input": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "enum": [
                "on",
                "off",
                "toggle"
              ]
            }
          }
        }
      },
      {
        "id": "override",
        "title": "Generated menus on / off",
        "action": "menus.override",
        "input": {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "on",
                "off",
                "toggle"
              ]
            }
          }
        }
      },
      {
        "id": "set",
        "title": "Change one menu setting",
        "description": "Fields: maxPerLevel (4-30), recentsMax (0-24), showFavorites, showRecents, groupByPlugin, style (list|rail|pills), hidden (ids), favorites (ids).",
        "action": "menus.set",
        "input": {
          "type": "object",
          "properties": {
            "field": {
              "type": "string"
            },
            "value": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          },
          "required": [
            "field",
            "value"
          ]
        }
      },
      {
        "id": "get",
        "title": "Menu generator status",
        "action": "menus.get",
        "readOnly": true,
        "output": "{ stats, settings, assets }"
      },
      {
        "id": "outline",
        "title": "The generated menu tree",
        "action": "menus.outline",
        "readOnly": true,
        "output": "text"
      },
      {
        "id": "generate",
        "title": "Regenerate the menus now",
        "action": "menus.generate"
      },
      {
        "id": "settings",
        "title": "Open Menu settings",
        "action": "menus.settings"
      }
    ],
    "noReads": "no data folder: favourites, recents and the settings are per-device settings (axf.menus.*)"
  },
  "builtWith": {
    "model": "fable",
    "builtAt": "2026-11-08",
    "branch": "claude/nested-menus-for-console-amberx-and-molly-overri"
  },
  "help": "help.json",
  "opens": "dialog",
  "opensUi": "dialog:menus.jump"
}
