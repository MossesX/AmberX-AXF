  },
  "initializedAt": "2026-11-02T03:31:43.359Z",
  "targets": [
    "web"
  ],
  "startView": "home",
  "defaults": {
    "color-theme": "fresh-light",
    "style-theme": "fresh",
    "layout": "classic-ide",
    "behavior-theme": "standard",
    "design-package": "hub-default",
    "app-menu": "molly",
    "toolbar": "molly",
    "nav-menu": "molly",
    "context-menu": "compact-classic",
    "tab-group": "underline",
    "dialog": "centered-modal",
    "popup": "corner-solid",
    "button": "rounded-solid",
    "slider": "classic-round",
    "container": "soft-card",
    "gauge": "classic-arc",
    "meter": "striped-pill",
    "banner": "amberx-thin",
    "branding": "amberx",
    "clock": "digital-12h",
    "search-bar": "everything",
    "logo": "wordmark",
    "action-button": "settings",
    "label": "version",
    "status": "online",
    "counter": "alerts",
    "progress": "build",
    "avatar": "account",
    "link": "docs",
    "theme-switch": "fresh-day-night",
    "spacer": "gap",
    "divider": "rule",
    "badge": "new",
