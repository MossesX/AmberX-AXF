{
  "$axf": "axnotes-plugins@1",
  "description": "Android plugins the app loads by entry class (each entry is added and removed by that plugin's install.mjs / uninstall.mjs).",
  "plugins": [
    {
      "id": "ai.amberx.axf.axnotes.ai-chat",
      "folder": "ai-chat",
      "entry": "ai.amberx.axf.axnotes.plugins.aichat.AiChatPlugin",
      "dataPrefix": "ai-chat.",
      "version": "0.1.0"
    },
    {
      "id": "ai.amberx.axf.axnotes.ai-build-bridge",
      "folder": "ai-build-bridge",
      "entry": "ai.amberx.axf.axnotes.plugins.buildbridge.BuildBridgePlugin",
      "dataPrefix": "ai-build-bridge.",
      "version": "0.1.0"
    },
    {
      "id": "ai.amberx.axf.axnotes.ai-automations",
      "folder": "ai-automations",
      "entry": "ai.amberx.axf.axnotes.plugins.automations.AutomationsPlugin",
      "dataPrefix": "ai-automations.",
      "version": "0.1.0"
    },
    {
      "id": "ai.amberx.axf.axnotes.note-sorter",
      "folder": "note-sorter",
      "entry": "ai.amberx.axf.axnotes.plugins.notesorter.NoteSorterPlugin",
      "dataPrefix": "note-sorter.",
      "version": "0.1.0"
    },
    {
      "id": "ai.amberx.axf.axnotes.ai-codebase-reader",
      "folder": "ai-codebase-reader",
      "entry": "ai.amberx.axf.axnotes.plugins.codebase.CodebaseReaderPlugin",
      "dataPrefix": "ai-codebase-reader.",
      "version": "0.1.0"
    }
  ]
}
