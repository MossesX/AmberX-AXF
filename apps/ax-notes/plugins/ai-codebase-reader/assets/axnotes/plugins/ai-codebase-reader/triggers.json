{
  "$axf": "axnotes-plugin-triggers@1",
  "description": "AI codebase reader voice triggers (triggers@1 records, registered under the plugin's module id while it is installed). <file> is matched against the paths of the watched repos.",
  "triggers": [
    { "id": "codebase.note-on-file", "kind": "voice", "source": "permanent", "module": "ai.amberx.axf.axnotes.plugins.ai-codebase-reader", "label": "Note on a file",
      "phrases": ["note on <file> line <line:number> saying <text>", "note on <file> saying <text>", "note on <file> line <line:number>", "note on <file>"],
      "action": "codebase.note-on-file", "threshold": 80 },
    { "id": "codebase.ask-about-file", "kind": "voice", "source": "permanent", "module": "ai.amberx.axf.axnotes.plugins.ai-codebase-reader", "label": "Ask about a file",
      "phrases": ["ask about <file> line <line:number> question <question>", "ask about <file> question <question>", "ask about <file> line <line:number>", "ask about <file>"],
      "action": "codebase.ask-about-file", "threshold": 80 },
    { "id": "codebase.read-now", "kind": "voice", "source": "permanent", "module": "ai.amberx.axf.axnotes.plugins.ai-codebase-reader", "label": "Read my repos",
      "phrases": ["read my repos", "read the codebase", "harvest todos"], "action": "codebase.read-now", "threshold": 80 }
  ]
}
