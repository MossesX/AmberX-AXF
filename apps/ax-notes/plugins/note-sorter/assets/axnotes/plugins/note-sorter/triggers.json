{
  "$axf": "axnotes-plugin-triggers@1",
  "description": "Note sorter voice triggers (triggers@1 records, registered under the plugin's module id while it is installed).",
  "triggers": [
    { "id": "notesorter.digest-daily", "kind": "voice", "source": "permanent", "module": "ai.amberx.axf.axnotes.plugins.note-sorter", "label": "Today's digest",
      "phrases": ["daily digest", "today's digest", "make my daily digest"], "action": "notesorter.digest", "args": { "period": "daily" }, "threshold": 80 },
    { "id": "notesorter.digest-weekly", "kind": "voice", "source": "permanent", "module": "ai.amberx.axf.axnotes.plugins.note-sorter", "label": "This week's digest",
      "phrases": ["weekly digest", "this week's digest", "make my weekly digest"], "action": "notesorter.digest", "args": { "period": "weekly" }, "threshold": 80 },
    { "id": "notesorter.sort-all", "kind": "voice", "source": "permanent", "module": "ai.amberx.axf.axnotes.plugins.note-sorter", "label": "Sort my notes",
      "phrases": ["sort my notes", "sort notes"], "action": "notesorter.sort-all", "threshold": 80 }
  ]
}
