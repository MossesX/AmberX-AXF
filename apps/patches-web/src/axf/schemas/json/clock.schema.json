{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axf/clock.schema.json",
  "title": "AmberX AXF Clock asset",
  "type": "object",
  "required": [
    "$axf",
    "type",
    "id",
    "name",
    "version",
    "data"
  ],
  "properties": {
    "$axf": {
      "const": "asset@1"
    },
    "type": {
      "const": "clock"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "format",
        "seconds",
        "date"
      ],
      "properties": {
        "format": {
          "enum": [
            "24h",
            "12h"
          ]
        },
        "seconds": {},
        "date": {
          "enum": [
            "none",
            "short",
            "weekday"
          ]
        }
      }
    }
  }
}
