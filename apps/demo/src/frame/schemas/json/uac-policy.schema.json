{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "frame/uac-policy.schema.json",
  "title": "Frame User account control asset",
  "type": "object",
  "required": [
    "$frame",
    "type",
    "id",
    "name",
    "version",
    "data"
  ],
  "properties": {
    "$frame": {
      "const": "asset@1"
    },
    "type": {
      "const": "uac-policy"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "defaultRole",
        "gating",
        "roles",
        "permissions"
      ],
      "properties": {
        "defaultRole": {},
        "gating": {
          "enum": [
            "hide",
            "disable"
          ]
        },
        "roles": {},
        "permissions": {}
      }
    }
  }
}
