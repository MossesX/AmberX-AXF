{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "frame/toolbar.schema.json",
  "title": "Frame Toolbar asset",
  "type": "object",
  "required": [
    "$frame",
    "type",
    "id",
    "name",
    "version",
    "data"
  ],
  "properties": {
    "$frame": {
      "const": "asset@1"
    },
    "type": {
      "const": "toolbar"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "variant",
        "align",
        "groups",
        "showSearch"
      ],
      "properties": {
        "variant": {
          "enum": [
            "icons",
            "icons-labels",
            "labels"
          ]
        },
        "align": {
          "enum": [
            "start",
            "center",
            "spread"
          ]
        },
        "groups": {},
        "showSearch": {}
      }
    }
  }
}
