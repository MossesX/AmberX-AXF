{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axf/job-type.schema.json",
  "title": "AmberX AXF Job type asset",
  "type": "object",
  "required": [
    "$axf",
    "type",
    "id",
    "name",
    "version",
    "data"
  ],
  "properties": {
    "$axf": {
      "const": "asset@1"
    },
    "type": {
      "const": "job-type"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "specialty",
        "budget",
        "trigger",
        "brief"
      ],
      "properties": {
        "specialty": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,39}$",
          "description": "the owning agent skill id (swarm roster)"
        },
        "budget": {
          "type": "object",
          "required": [
            "tokens"
          ],
          "properties": {
            "tokens": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 10000000
            },
            "maxTurns": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            },
            "usd": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "trigger": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "on-demand",
                "schedule",
                "event"
              ]
            },
            "every": {
              "type": "string",
              "pattern": "^(\\d{1,4})(m|h|d)$"
            },
            "at": {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):([0-5]\\d)$"
            },
            "event": {
              "type": "string"
            }
          }
        },
        "brief": {
          "type": "string",
          "maxLength": 4000
        },
        "model": {
          "enum": [
            "haiku",
            "sonnet",
            "opus",
            "fable"
          ]
        },
        "readOnly": {
          "type": "boolean"
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 30
        },
        "inputs": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "required": {
                "type": "boolean"
              },
              "default": {
                "type": "string"
              },
              "about": {
                "type": "string"
              }
            }
          }
        },
        "command": {
          "type": "string"
        },
        "outputs": {
          "type": "object",
          "properties": {
            "report": {
              "type": "string"
            },
            "uiReviewGroup": {
              "type": "string"
            },
            "uiReviewApp": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
