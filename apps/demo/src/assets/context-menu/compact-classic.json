{
  "$frame": "asset@1",
  "type": "context-menu",
  "id": "compact-classic",
  "name": "Compact Classic",
  "version": "1.0.0",
  "description": "Tight desktop context menu with icons and shortcut hints.",
  "author": "Frame",
  "tags": [],
  "data": {
    "variant": "compact",
    "showIcons": true,
    "showShortcuts": true,
    "targets": {
      "default": [
        {
          "id": "cut",
          "label": "Cut",
          "icon": "cut",
          "action": "edit.cut"
        },
        {
          "id": "copy",
          "label": "Copy",
          "icon": "copy",
          "action": "edit.copy"
        },
        {
          "id": "paste",
          "label": "Paste",
          "icon": "paste",
          "action": "edit.paste"
        },
        {
          "id": "s1",
          "separator": true
        },
        {
          "id": "next-color",
          "label": "Next color theme",
          "icon": "palette",
          "action": "swap:color-theme:next",
          "shortcut": "Alt+C"
        },
        {
          "id": "next-style",
          "label": "Next style theme",
          "icon": "type",
          "action": "swap:style-theme:next",
          "shortcut": "Alt+S"
        },
        {
          "id": "next-layout",
          "label": "Next layout",
          "icon": "layout",
          "action": "swap:layout:next",
          "shortcut": "Alt+L"
        },
        {
          "id": "s2",
          "separator": true
        },
        {
          "id": "random",
          "label": "Randomize all",
          "icon": "shuffle",
          "action": "assets.random",
          "shortcut": "Alt+R"
        },
        {
          "id": "shortcuts",
          "label": "Shortcuts",
          "icon": "keyboard",
          "action": "view.shortcuts",
          "shortcut": "Alt+K"
        }
      ],
      "asset-card": [
        {
          "id": "activate",
          "label": "Activate",
          "icon": "zap",
          "action": "swap:{payload}",
          "requires": "assets.swap"
        },
        {
          "id": "json",
          "label": "View JSON",
          "icon": "code",
          "action": "asset.json:{payload}"
        },
        {
          "id": "copy",
          "label": "Copy JSON",
          "icon": "copy",
          "action": "asset.copy:{payload}"
        },
        {
          "id": "s1",
          "separator": true
        },
        {
          "id": "import",
          "label": "Import asset…",
          "icon": "upload",
          "action": "dialog:import-asset",
          "requires": "assets.import"
        }
      ],
      "nav-item": [
        {
          "id": "open",
          "label": "Open",
          "icon": "chevron-right",
          "action": "nav:{payload}"
        },
        {
          "id": "s1",
          "separator": true
        },
        {
          "id": "next-nav",
          "label": "Next navigation menu",
          "icon": "grid",
          "action": "swap:nav-menu:next"
        },
        {
          "id": "next-layout",
          "label": "Next layout",
          "icon": "layout",
          "action": "swap:layout:next",
          "shortcut": "Alt+L"
        }
      ]
    }
  }
}
