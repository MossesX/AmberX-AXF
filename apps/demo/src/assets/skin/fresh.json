{
  "$axf": "asset@1",
  "type": "skin",
  "id": "fresh",
  "name": "Fresh",
  "version": "2.0.0",
  "description": "Fresh: the framework's default look (Fresh Light + Fresh style, solid rounded buttons, soft cards), super-tight spacing, top toolbar hidden.",
  "author": "AmberX AXF",
  "tags": [
    "default",
    "skin"
  ],
  "data": {
    "colorTheme": "fresh-light",
    "styleTheme": "fresh",
    "layoutTheme": "classic-ide",
    "behaviorTheme": "standard",
    "assets": {
      "app-menu": "standard-desktop",
      "toolbar": "standard-icons",
      "nav-menu": "sidebar-list",
      "context-menu": "compact-classic",
      "tab-group": "underline",
      "dialog": "centered-modal",
      "popup": "corner-solid",
      "button": "rounded-solid",
      "slider": "classic-round",
      "container": "soft-card",
      "gauge": "classic-arc",
      "meter": "striped-pill",
      "banner": "amberx-thin",
      "clock": "digital-12h",
      "search-bar": "everything",
      "logo": "wordmark",
      "action-button": "settings",
      "label": "version",
      "status": "online",
      "counter": "alerts",
      "progress": "build",
      "avatar": "account",
      "link": "docs",
      "theme-switch": "fresh-day-night",
      "spacer": "gap",
      "divider": "rule",
      "badge": "new",
      "settings": "standard"
    },
    "extras": {
      "spacing": "tight",
      "hidden": {
        "toolbar": true
      }
    }
  }
}
