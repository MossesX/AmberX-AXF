{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axf/agent-skill.schema.json",
  "title": "AmberX AXF agent skill page (agent-skill@1)",
  "description": "Generated from framework/core/engines/swarm-rules.mjs. The parsed form of an agent's one-page skill file (markdown with front matter).",
  "type": "object",
  "required": [
    "id",
    "title",
    "schema",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 40
    },
    "title": {
      "type": "string"
    },
    "schema": {
      "const": "agent-skill@1"
    },
    "body": {
      "type": "string",
      "maxLength": 3000
    },
    "lines": {
      "type": "integer",
      "maximum": 50
    },
    "chars": {
      "type": "integer",
      "maximum": 3000
    }
  }
}
