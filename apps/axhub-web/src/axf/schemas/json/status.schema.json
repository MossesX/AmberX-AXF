{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axf/status.schema.json",
  "title": "AmberX AXF Status asset",
  "type": "object",
  "required": [
    "$axf",
    "type",
    "id",
    "name",
    "version",
    "data"
  ],
  "properties": {
    "$axf": {
      "const": "asset@1"
    },
    "type": {
      "const": "status"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "counter",
        "onLabel",
        "offLabel",
        "onTone",
        "offTone"
      ],
      "properties": {
        "counter": {},
        "onLabel": {},
        "offLabel": {},
        "onTone": {
          "enum": [
            "neutral",
            "success",
            "warning",
            "danger",
            "accent",
            "muted"
          ]
        },
        "offTone": {
          "enum": [
            "neutral",
            "success",
            "warning",
            "danger",
            "accent",
            "muted"
          ]
        }
      }
    }
  }
}
