{
  "$axf": "asset@1",
  "version": "1.0.0",
  "author": "AmberX AXF",
  "type": "settings",
  "id": "flagship",
  "name": "Flagship",
  "description": "The flagship settings interface for the console, axHub web and AmberX: a short list of sections (list and page side by side on wide screens), a compact header, search, descriptions, the settings toolbar on top and the level toolbar (Simple / Basic / Developer / Administrator) always on. Groups are flagship containers, so they fold.",
  "tags": [
    "flagship",
    "professional",
    "levels"
  ],
  "data": {
    "extends": "console",
    "layout": "list",
    "header": "compact",
    "search": true,
    "descriptions": true,
    "toolbar": "settings-page",
    "levels": true,
    "defaultLevel": "basic",
    "levelOf": {
      "appearance": "simple",
      "about": "simple",
      "account": "basic",
      "connections": "basic",
      "plugins": "basic",
      "banners": "basic",
      "axf.look.sliders": "simple",
      "axf.display": "simple",
      "axf.about": "simple",
      "axf.display.animations": "basic",
      "axf.settings-ui": "basic",
      "axf.appearance": "basic",
      "axf.account.role": "basic",
      "axf.plugins.libraries": "basic",
      "axf.banners": "basic",
      "axf.asset-appearance": "developer",
      "axf.roll": "developer",
      "axf.roll.assets": "administrator",
      "axf.account.profile": "administrator"
    }
  }
}
