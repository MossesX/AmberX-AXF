{
  "$axf": "asset@1",
  "type": "app-menu",
  "id": "standard-desktop",
  "name": "Standard Desktop",
  "version": "1.0.0",
  "description": "Classic File / Edit / View / Help menus with desktop shortcuts.",
  "author": "AmberX AXF",
  "tags": [
    "desktop"
  ],
  "data": {
    "menus": [
      {
        "id": "file",
        "label": "File",
        "items": [
          {
            "id": "new",
            "label": "New file",
            "icon": "plus",
            "action": "file.new",
            "shortcut": "Alt+N"
          },
          {
            "id": "open",
            "label": "Open…",
            "icon": "folder",
            "action": "file.open",
            "shortcut": "Alt+O"
          },
          {
            "id": "save",
            "label": "Save",
            "icon": "save",
            "action": "file.save",
            "shortcut": "Ctrl+S",
            "requires": "files.write"
          },
          {
            "id": "export",
            "label": "Export",
            "icon": "download",
            "requires": "files.write",
            "items": [
              {
                "id": "export-json",
                "label": "Active assets as JSON",
                "icon": "code",
                "action": "file.export"
              },
              {
                "id": "export-bundle",
                "label": "Asset bundle",
                "icon": "package",
                "action": "file.export"
              }
            ]
          },
          {
            "id": "s1",
            "separator": true
          },
          {
            "id": "import",
            "label": "Import asset…",
            "icon": "upload",
            "action": "dialog:import-asset",
            "requires": "assets.import"
          }
        ]
      },
      {
        "id": "edit",
        "label": "Edit",
        "items": [
          {
            "id": "undo",
            "label": "Undo",
            "icon": "undo",
            "action": "edit.undo",
            "shortcut": "Ctrl+Z"
          },
          {
            "id": "redo",
            "label": "Redo",
            "icon": "redo",
            "action": "edit.redo",
            "shortcut": "Ctrl+Shift+Z"
          },
          {
            "id": "s1",
            "separator": true
          },
          {
            "id": "cut",
            "label": "Cut",
            "icon": "cut",
            "action": "edit.cut"
          },
          {
            "id": "copy",
            "label": "Copy",
            "icon": "copy",
            "action": "edit.copy"
          },
          {
            "id": "paste",
            "label": "Paste",
            "icon": "paste",
            "action": "edit.paste"
          },
          {
            "id": "s2",
            "separator": true
          },
          {
            "id": "delete",
            "label": "Delete…",
            "icon": "trash",
            "action": "edit.delete",
            "requires": "files.write"
          }
        ]
      },
      {
        "id": "view",
        "label": "View",
        "items": [
          {
            "id": "next-color",
            "label": "Next color theme",
            "icon": "palette",
            "action": "swap:color-theme:next",
            "shortcut": "Alt+C"
          },
          {
            "id": "next-style",
            "label": "Next style theme",
            "icon": "type",
            "action": "swap:style-theme:next",
            "shortcut": "Alt+S"
          },
          {
            "id": "next-layout",
            "label": "Next layout",
            "icon": "layout",
            "action": "swap:layout:next",
            "shortcut": "Alt+L"
          },
          {
            "id": "random",
            "label": "Randomize all assets",
            "icon": "shuffle",
            "action": "assets.random",
            "shortcut": "Alt+R"
          },
          {
            "id": "reset",
            "label": "Reset to defaults",
            "icon": "refresh",
            "action": "assets.reset"
          },
          {
            "id": "settings",
            "label": "Settings",
            "icon": "settings",
            "action": "app.settings"
          },
          {
            "id": "s1",
            "separator": true
          },
          {
            "id": "shortcuts",
            "label": "Keyboard shortcuts",
            "icon": "keyboard",
            "action": "view.shortcuts",
            "shortcut": "Alt+K"
          }
        ]
      },
      {
        "id": "help",
        "label": "Help",
        "items": [
          {
            "id": "docs",
            "label": "Documentation",
            "icon": "help",
            "action": "help.docs"
          },
          {
            "id": "about",
            "label": "About",
            "icon": "info",
            "action": "help.about"
          }
        ]
      }
    ]
  }
}
