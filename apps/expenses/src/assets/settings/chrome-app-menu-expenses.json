{
  "$axf": "asset@1",
  "type": "settings",
  "id": "chrome-app-menu-expenses",
  "name": "Application menu settings (Expenses)",
  "version": "1.0.0",
  "description": "Expenses's own copy of the shared application menu settings interface (chrome-app-menu). It follows the default until it is edited; the default stays selected until you pick this one (chrome-settings@1).",
  "author": "AmberX AXF",
  "tags": [
    "custom",
    "chrome-settings",
    "expenses"
  ],
  "data": {
    "for": "app-menu",
    "layout": "tabs-top",
    "header": "compact",
    "search": false,
    "descriptions": true,
    "tabs": [
      {
        "id": "look",
        "label": "Look",
        "icon": "palette",
        "order": 10
      },
      {
        "id": "behaviour",
        "label": "Behaviour",
        "icon": "sliders",
        "order": 20
      },
      {
        "id": "asset",
        "label": "Asset",
        "icon": "layers",
        "order": 30
      },
      {
        "id": "interface",
        "label": "Interface",
        "icon": "settings",
        "order": 40
      }
    ],
    "hide": [],
    "groups": [],
    "levels": true,
    "defaultLevel": "basic",
    "levelOf": {
      "look": "simple",
      "behaviour": "basic",
      "asset": "basic",
      "interface": "developer"
    },
    "extends": "chrome-app-menu"
  }
}
