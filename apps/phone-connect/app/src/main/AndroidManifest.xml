<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Playback capture is filed under RECORD_AUDIO by Android; the recorder never opens the microphone itself. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- The AXF Console app's floating overlay opens console pages first (console-overlay@1, ConsoleOverlay.kt). -->
    <queries>
        <package android:name="ai.amberx.consoleapp" />
    </queries>
    <!-- Every framework module contributes its own manifest pieces; this file holds only the app's identity. -->
    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Axf">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="axf" android:host="${axfAppId}" />
            </intent-filter>
        </activity>
        <!-- Voice command intents → the console (phone.voice): shared text or the app's VOICE action with EXTRA_TEXT. -->
        <activity
            android:name=".VoiceIntentActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="ai.amberx.axf.phoneconnect.VOICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- The watch: keeps the link to the console open (phone-connect@1). -->
        <service
            android:name=".watch.WatchService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the owner's paired link to their own Dev Console open so approvals, notifications and pages they send arrive at once" />
        </service>
        <!-- Audio output recorder (recorder@1): what the phone plays, in 30-minute parts to axHub. -->
        <service
            android:name=".recorder.RecordService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
        <activity
            android:name=".recorder.RecordStartActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
