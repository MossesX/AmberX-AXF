<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Secrets (Keystore-backed prefs) are never backed up; the kernel's own state and assets are. -->
    <exclude domain="sharedpref" path="axf.secure.xml" />
    <!-- The hub session cookie lives in the WebView store: never backed up. -->
    <exclude domain="root" path="app_webview/" />
</full-backup-content>
