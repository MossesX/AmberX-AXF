<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Patches serves the notifications when it is installed: AXHub checks for it and stays quiet (ApprovalWatch). -->
    <queries>
        <package android:name="ai.amberx.axf.patches" />
        <package android:name="ai.amberx.droid" />
    </queries>
    <!-- Every framework module contributes its own manifest pieces (lib-notifications: POST_NOTIFICATIONS + full-screen
         intents; lib-work: foreground service + boot receiver); this file holds only the app's identity. -->
    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Axf">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="axf" android:host="${axfAppId}" />
            </intent-filter>
        </activity>
        <!-- The framework's work service (lib-work) hosts the approval watcher while watching is on (the user turns it on
             and off in the app); the special-use subtype is the app's own words for Play review. -->
        <service android:name="ai.amberx.axf.work.PollService">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Watches the user's own self-hosted hub for approval requests and alerts them" />
        </service>
    </application>
</manifest>
