{
  "name": "axf-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "axf": {
    "framework": "0.2.0",
    "template": "react-ts"
  },
  "scripts": {
    "dev": "node scripts/sync-data.mjs && vite",
    "build": "node scripts/sync-data.mjs && tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sync": "node scripts/sync-data.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.1.0"
  }
}
