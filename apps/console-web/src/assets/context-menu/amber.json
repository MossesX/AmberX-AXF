{
  "$axf": "asset@1",
  "type": "context-menu",
  "id": "amber",
  "name": "Amber",
  "version": "1.1.0",
  "description": "The console's Amber right-click menu: a quick-action strip on top (cut / copy / paste, colour theme previous / next / reset, reload data), every plugin under Plugins (each opens where it's set to open: main area, dialog or window), the everyday console tools, Settings (shown on top as Console settings, which leads every console menu) and Search anywhere pinned at the bottom. Shows only its own items.",
  "author": "AmberX AXF",
  "tags": [],
  "data": {
    "variant": "compact",
    "showIcons": true,
    "showShortcuts": true,
    "contributions": false,
    "search": "Search anywhere…",
    "targets": {
      "default": [
        {
          "id": "cut",
          "label": "Cut",
          "icon": "cut",
          "action": "edit.cut",
          "shortcut": "Ctrl+X",
          "place": "toolbar"
        },
        {
          "id": "copy",
          "label": "Copy",
          "icon": "copy",
          "action": "edit.copy",
          "shortcut": "Ctrl+C",
          "place": "toolbar"
        },
        {
          "id": "paste",
          "label": "Paste",
          "icon": "paste",
          "action": "edit.paste",
          "shortcut": "Ctrl+V",
          "place": "toolbar"
        },
        {
          "id": "prev-theme",
          "label": "Previous theme",
          "icon": "palette",
          "action": "swap:color-theme:prev",
          "place": "toolbar"
        },
        {
          "id": "next-theme",
          "label": "Next theme",
          "icon": "palette",
          "action": "swap:color-theme:next",
          "shortcut": "Alt+C",
          "place": "toolbar"
        },
        {
          "id": "reset-theme",
          "label": "Reset theme",
          "icon": "undo",
          "action": "swap:color-theme:default",
          "place": "toolbar"
        },
        {
          "id": "reload",
          "label": "Reload data",
          "icon": "refresh",
          "action": "console.refresh",
          "place": "toolbar"
        },
        {
          "id": "plugins",
          "label": "Plugins",
          "icon": "package",
          "provider": "amber.plugins"
        },
        {
          "id": "s-plugins",
          "separator": true
        },
        {
          "id": "ashes",
          "label": "AshesUI",
          "icon": "eye",
          "action": "ashes.toggle",
          "checked": "setting:axf.ashes.on"
        },
        {
          "id": "terminal",
          "label": "Open terminal",
          "icon": "terminal",
          "action": "terminal.new"
        },
        {
          "id": "handoff",
          "label": "Account handoff",
          "icon": "rocket",
          "action": "claude-handoff.open"
        },
        {
          "id": "plugin-switches",
          "label": "Plugin switches",
          "icon": "sliders",
          "action": "plugin-switches.open"
        },
        {
          "id": "ai",
          "label": "Ask the assistant",
          "icon": "sparkles",
          "action": "ai-assistant.open"
        },
        {
          "id": "alerts",
          "label": "Alerts",
          "icon": "bell",
          "action": "alerts.open"
        },
        {
          "id": "pending",
          "label": "Pending builds",
          "icon": "list",
          "action": "nav:pending"
        },
        {
          "id": "s-skin",
          "separator": true
        },
        {
          "id": "next-skin",
          "label": "Next skin",
          "icon": "palette",
          "action": "skin.next"
        },
        {
          "id": "prev-skin",
          "label": "Previous skin",
          "icon": "palette",
          "action": "skin.prev"
        },
        {
          "id": "spacer",
          "separator": true,
          "spacer": true
        },
        {
          "id": "settings",
          "label": "Settings",
          "icon": "settings",
          "action": "app.settings"
        }
      ]
    }
  }
}
