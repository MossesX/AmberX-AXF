{
  "$axf": "asset@1",
  "version": "1.0.0",
  "author": "AmberX AXF",
  "type": "density",
  "id": "flagship",
  "name": "Flagship",
  "description": "Flagship spacing: compact gaps and paddings, with list, menu and control rows kept at 2.5 lines or more so every row stays a comfortable tap on a phone.",
  "tags": [
    "flagship",
    "compact",
    "touch-safe"
  ],
  "data": {
    "gap": {
      "2xs": 0.1,
      "xs": 0.2,
      "sm": 0.3,
      "md": 0.45,
      "lg": 0.65,
      "xl": 0.9,
      "2xl": 1.25,
      "3xl": 1.7,
      "4xl": 2.4
    },
    "pad": {
      "control": 0.5,
      "card": 1.15,
      "page": 1.3,
      "row": 0.6,
      "cell": 0.55
    },
    "row": {
      "list": 2.6,
      "table": 2.3,
      "menu": 2.5,
      "control": 2.4
    }
  }
}
