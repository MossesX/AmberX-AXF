{
  "$axf": "asset@1",
  "type": "context-menu",
  "id": "roomy-touch",
  "name": "Roomy Touch",
  "version": "1.0.0",
  "description": "Large touch targets with nested pickers. No shortcut clutter.",
  "author": "AmberX AXF",
  "tags": [],
  "data": {
    "variant": "roomy",
    "showIcons": true,
    "showShortcuts": false,
    "targets": {
      "default": [
        {
          "id": "random",
          "label": "Surprise me",
          "icon": "shuffle",
          "action": "assets.random"
        },
        {
          "id": "about",
          "label": "About this app",
          "icon": "info",
          "action": "help.about"
        }
      ],
      "asset-card": [
        {
          "id": "activate",
          "label": "Activate",
          "icon": "zap",
          "action": "swap:{payload}",
          "requires": "assets.swap"
        },
        {
          "id": "json",
          "label": "View JSON",
          "icon": "code",
          "action": "asset.json:{payload}"
        },
        {
          "id": "copy",
          "label": "Copy JSON",
          "icon": "copy",
          "action": "asset.copy:{payload}"
        },
        {
          "id": "s1",
          "separator": true
        },
        {
          "id": "import",
          "label": "Import asset…",
          "icon": "upload",
          "action": "dialog:import-asset",
          "requires": "assets.import"
        }
      ],
      "nav-item": [
        {
          "id": "open",
          "label": "Open",
          "icon": "chevron-right",
          "action": "nav:{payload}"
        },
        {
          "id": "s1",
          "separator": true
        },
        {
          "id": "next-nav",
          "label": "Next navigation menu",
          "icon": "grid",
          "action": "swap:nav-menu:next"
        }
      ]
    }
  }
}
