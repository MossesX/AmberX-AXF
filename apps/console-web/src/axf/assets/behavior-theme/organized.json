{
  "$axf": "asset@1",
  "type": "behavior-theme",
  "id": "organized",
  "name": "Organized",
  "version": "1.0.0",
  "description": "Tidy: a 12 px snap grid, windows that remember their places, a dock for minimised ones.",
  "author": "AmberX AXF",
  "tags": [
    "pairs:project-hub"
  ],
  "data": {
    "motion": {
      "speed": "normal",
      "easing": "standard",
      "reduced": "system",
      "entrance": "rise"
    },
    "interaction": {
      "hover": "tint",
      "press": "darken",
      "focusRing": "auto",
      "cursor": "pointer",
      "longPressMs": 550,
      "doubleTapMs": 300,
      "dragThreshold": 8
    },
    "windows": {
      "dialogOpen": "scale",
      "backdrop": "dim",
      "popupOpen": "fade",
      "drawerOpen": "slide",
      "snap": true,
      "snapGrid": 12,
      "stack": "remember",
      "minimize": "dock",
      "closeOnBackdrop": true,
      "closeOnEscape": true
    },
    "feedback": {
      "toastPosition": "top-right",
      "toastMs": 5000,
      "sound": "off",
      "vibration": "off",
      "confirmDelete": "risky",
      "busyCursor": true
    }
  }
}
