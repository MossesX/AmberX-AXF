{
  "$axf": "asset@1",
  "type": "behavior-theme",
  "id": "precise",
  "name": "Precise",
  "version": "1.0.0",
  "description": "Fast, exact and quiet: short fades, tinted hovers, snapping windows that remember where they were, minimise to a dock, confirm only risky deletes.",
  "author": "AmberX AXF",
  "tags": [
    "pairs:developer-console"
  ],
  "data": {
    "motion": {
      "speed": "fast",
      "easing": "standard",
      "reduced": "system",
      "entrance": "fade"
    },
    "interaction": {
      "hover": "tint",
      "press": "darken",
      "focusRing": "auto",
      "cursor": "pointer",
      "longPressMs": 500,
      "doubleTapMs": 280,
      "dragThreshold": 6
    },
    "windows": {
      "dialogOpen": "fade",
      "backdrop": "dim",
      "popupOpen": "fade",
      "drawerOpen": "slide",
      "snap": true,
      "snapGrid": 8,
      "stack": "remember",
      "minimize": "dock",
      "closeOnBackdrop": true,
      "closeOnEscape": true
    },
    "feedback": {
      "toastPosition": "bottom-right",
      "toastMs": 3500,
      "sound": "off",
      "vibration": "off",
      "confirmDelete": "risky",
      "busyCursor": true
    }
  }
}
