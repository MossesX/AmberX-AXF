{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axf/icon-source.schema.json",
  "title": "AmberX AXF Icon source asset",
  "type": "object",
  "required": [
    "$axf",
    "type",
    "id",
    "name",
    "version",
    "data"
  ],
  "properties": {
    "$axf": {
      "const": "asset@1"
    },
    "type": {
      "const": "icon-source"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "kind",
        "root"
      ],
      "properties": {
        "kind": {
          "enum": [
            "local",
            "http",
            "rest",
            "mcp",
            "ftp",
            "sftp",
            "gdrive",
            "gphotos",
            "dropbox",
            "repo"
          ]
        },
        "root": {
          "type": "string",
          "maxLength": 1000,
          "description": "folder, URL, id or path, by kind"
        },
        "label": {
          "type": "string",
          "maxLength": 80
        },
        "auth": {
          "type": "object",
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "none",
                "basic",
                "password",
                "key",
                "token",
                "apikey",
                "oauth"
              ]
            },
            "secretRef": {
              "type": "string",
              "maxLength": 120,
              "description": "the id of the secret in the secure store; the secret itself never goes here"
            }
          },
          "additionalProperties": false
        },
        "options": {
          "type": "object",
          "description": "kind-specific fields (host, port, user, listPath …); never a secret"
        },
        "format": {
          "enum": [
            "auto",
            "svg",
            "icon-pack",
            "zip"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 12
        }
      }
    }
  }
}
