          "overrides": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          },
          "colorTheme": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        }
      },
      "description": "\"ui:<id>\" / \"plugin:<id>\" → its skin state; a missing key inherits"
    },
