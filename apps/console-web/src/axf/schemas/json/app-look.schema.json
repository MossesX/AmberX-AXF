          }
        },
        "colorTheme": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        }
      }
    },
    "scopes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "use": {
            "enum": [
              "on",
              "off",
              "inherit"
