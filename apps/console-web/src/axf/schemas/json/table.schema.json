{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axf/table.schema.json",
  "title": "AmberX AXF Table asset",
  "type": "object",
  "required": [
    "$axf",
    "type",
    "id",
    "name",
    "version",
    "data"
  ],
  "properties": {
    "$axf": {
      "const": "asset@1"
    },
    "type": {
      "const": "table"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [],
      "properties": {
        "form": {
          "enum": [
            "grid",
            "cards",
            "terminal"
          ]
        },
        "density": {
          "enum": [
            "compact",
            "regular",
            "roomy"
          ]
        },
        "rowActions": {
          "enum": [
            "hover",
            "always",
            "menu",
            "swipe"
          ]
        },
        "headerCase": {
          "enum": [
            "normal",
            "upper"
          ]
        },
        "stickyHeader": {
          "type": "boolean"
        },
        "zebra": {
          "type": "boolean"
        },
        "dividers": {
          "type": "boolean"
        }
      }
    }
  }
}
