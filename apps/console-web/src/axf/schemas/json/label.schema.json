{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axf/label.schema.json",
  "title": "AmberX AXF Label asset",
  "type": "object",
  "required": [
    "$axf",
    "type",
    "id",
    "name",
    "version",
    "data"
  ],
  "properties": {
    "$axf": {
      "const": "asset@1"
    },
    "type": {
      "const": "label"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "text",
        "tone"
      ],
      "properties": {
        "text": {},
        "tone": {
          "enum": [
            "neutral",
            "success",
            "warning",
            "danger",
            "accent",
            "muted"
          ]
        }
      }
    }
  }
}
