{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axf/data-set-bar.schema.json",
  "title": "AmberX AXF Data set bar asset",
  "type": "object",
  "required": [
    "$axf",
    "type",
    "id",
    "name",
    "version",
    "data"
  ],
  "properties": {
    "$axf": {
      "const": "asset@1"
    },
    "type": {
      "const": "data-set-bar"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "placement",
        "search",
        "filter",
        "sort"
      ],
      "properties": {
        "placement": {
          "enum": [
            "top",
            "bottom",
            "inline",
            "floating"
          ]
        },
        "search": {},
        "filter": {},
        "sort": {}
      }
    }
  }
}
