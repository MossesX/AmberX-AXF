{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axf/settings.schema.json",
  "title": "AmberX AXF Settings interface asset",
  "type": "object",
  "required": [
    "$axf",
    "type",
    "id",
    "name",
    "version",
    "data"
  ],
  "properties": {
    "$axf": {
      "const": "asset@1"
    },
    "type": {
      "const": "settings"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "layout",
        "header",
        "search",
        "descriptions"
      ],
      "properties": {
        "layout": {
          "enum": [
            "tabs-top",
            "tabs-side",
            "list"
          ]
        },
        "header": {
          "enum": [
            "full",
            "compact",
            "none"
          ]
        },
        "search": {},
        "descriptions": {}
      }
    }
  }
}
