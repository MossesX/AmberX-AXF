{
  "$defs": {
    "toolbarItem": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "action": {
          "type": "string",
          "description": "a console action id (as before), action:<id>, command:<plugin>/<command>, control:<address> or handler:<id>"
        },
        "args": {
          "type": "object",
          "description": "arguments for the action ref (a command's input, an action's params)"
        },
        "requires": {
          "type": "string"
        },
        "shortcut": {
          "type": "string"
        },
        "badge": {
          "type": "string",
          "description": "a runtime counter name, counter:<name> or state:<key>; hidden at 0"
        },
        "checked": {
          "type": "string",
          "pattern": "^(setting|counter|slot|hidden|state):.+$",
          "description": "toggle binding drawn pressed while true"
        },
        "enabledWhen": {
          "description": "enabled when every term holds over the page state: key, !key, key=value, key!=value, key>n, key<n",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 8
            }
          ]
        },
        "visibleWhen": {
          "description": "shown when every term holds over the page state: key, !key, key=value, key!=value, key>n, key<n",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 8
            }
          ]
        },
        "destructive": {
          "type": "boolean",
          "description": "drawn in the danger tone; pressing it through the API needs confirm"
        },
        "confirm": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "maxLength": 200
            }
          ],
          "description": "ask before running: true for the default question, or the question itself"
        },
        "priority": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000,
          "description": "overflow order: lower goes into More first (default 100)"
        },
        "overflow": {
          "enum": [
            "auto",
            "never",
            "always"
          ],
          "description": "auto (default), never (always on the bar), always (only in More)"
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axf/toolbar.schema.json",
  "title": "AmberX AXF Toolbar asset",
  "type": "object",
  "required": [
    "$axf",
    "type",
    "id",
    "name",
    "version",
    "data"
  ],
  "properties": {
    "$axf": {
      "const": "asset@1"
    },
    "type": {
      "const": "toolbar"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "variant",
        "align",
        "groups",
        "showSearch"
      ],
      "properties": {
        "variant": {
          "enum": [
            "icons",
            "icons-labels",
            "labels"
          ]
        },
        "align": {
          "enum": [
            "start",
            "center",
            "spread"
          ]
        },
        "groups": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "items": {
                "type": "array",
                "maxItems": 48,
                "items": {
                  "$ref": "#/$defs/toolbarItem"
                }
              },
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "max": {
                "type": "integer",
                "minimum": 1,
                "maximum": 24
              },
              "enabledWhen": {
                "description": "enabled when every term holds over the page state: key, !key, key=value, key!=value, key>n, key<n",
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 8
                  }
                ]
              },
              "visibleWhen": {
                "description": "shown when every term holds over the page state: key, !key, key=value, key!=value, key>n, key<n",
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 8
                  }
                ]
              },
              "priority": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000
              },
              "overflow": {
                "enum": [
                  "auto",
                  "never",
                  "always"
                ]
              }
            }
          }
        },
        "showSearch": {},
        "scope": {
          "type": "string",
          "pattern": "^(app|view:[A-Za-z0-9._:-]+|plugin:[A-Za-z0-9._:-]+)$",
          "description": "the page this toolbar is for: app (default, the frame toolbar), view:<view id> or plugin:<plugin id>"
        },
        "slot": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,47}$",
          "description": "the place on its page this toolbar fills when the page has several (default main); settings id <scope id>.<slot>"
        },
        "overflow": {
          "description": "what happens when the bar is too narrow: auto folds lowest-priority items into a More menu, never clips nothing (scrolls), always keeps only `keep` items on the bar",
          "oneOf": [
            {
              "enum": [
                "auto",
                "never",
                "always"
              ]
            },
            {
              "type": "object",
              "properties": {
                "when": {
                  "enum": [
                    "auto",
                    "never",
                    "always"
                  ]
                },
                "keep": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 48
                },
                "label": {
                  "type": "string"
                }
              }
            }
          ]
        }
      }
    }
  }
}
