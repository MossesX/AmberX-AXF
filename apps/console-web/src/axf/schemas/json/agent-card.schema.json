{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axf/agent-card.schema.json",
  "title": "AmberX AXF Agent card asset",
  "type": "object",
  "required": [
    "$axf",
    "type",
    "id",
    "name",
    "version",
    "data"
  ],
  "properties": {
    "$axf": {
      "const": "asset@1"
    },
    "type": {
      "const": "agent-card"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [],
      "properties": {
        "design": {
          "enum": [
            "badge",
            "license",
            "trading",
            "backstage"
          ],
          "default": "badge"
        },
        "orientation": {
          "enum": [
            "vertical",
            "horizontal"
          ],
          "default": "vertical"
        },
        "logo": {
          "enum": [
            "banner",
            "watermark",
            "corner",
            "none"
          ],
          "default": "banner"
        },
        "surface": {
          "enum": [
            "surface",
            "raised",
            "inverse",
            "accent"
          ],
          "default": "surface"
        },
        "accent": {
          "enum": [
            "accent",
            "brand-1",
            "brand-2",
            "brand-3",
            "info",
            "success",
            "warning",
            "danger"
          ],
          "default": "accent"
        },
        "finish": {
          "enum": [
            "flat",
            "foil",
            "hologram",
            "neon"
          ],
          "default": "flat"
        },
        "photo": {
          "enum": [
            "large",
            "small",
            "none"
          ],
          "default": "large"
        },
        "code": {
          "enum": [
            "barcode",
            "qr",
            "none"
          ],
          "default": "barcode"
        },
        "front": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "enum": [
              "name",
              "role",
              "specialty",
              "employeeId",
              "email",
              "hiredAt",
              "status",
              "catchphrase",
              "signature",
              "jobs",
              "successRate",
              "spend",
              "favoriteModel"
            ]
          },
          "default": [
            "name",
            "role",
            "specialty",
            "employeeId"
          ]
        },
        "back": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "enum": [
              "name",
              "role",
              "specialty",
              "employeeId",
              "email",
              "hiredAt",
              "status",
              "catchphrase",
              "signature",
              "jobs",
              "successRate",
              "spend",
              "favoriteModel"
            ]
          },
          "default": []
        },
        "labels": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "name",
              "role",
              "specialty",
              "employeeId",
              "email",
              "hiredAt",
              "status",
              "catchphrase",
              "signature",
              "jobs",
              "successRate",
              "spend",
              "favoriteModel"
            ]
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 24
          }
        }
      }
    }
  }
}
