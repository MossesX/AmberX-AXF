{
  "$axf": "plugin@1",
  "id": "ai.amberx.axf.console.ai-assistant",
  "name": "AI assistant",
  "version": "0.1.0",
  "kind": "module",
  "apiLevel": 1,
  "author": "Brett",
  "description": "AI assistant ported from xGallery and extended: Anthropic, Claude Code subscription, OpenAI, xAI Grok, Gemini, Mistral, Groq, DeepSeek, OpenRouter, Together, Fireworks, Perplexity, Cohere, Cerebras, Azure OpenAI, Ollama, LM Studio and any OpenAI-compatible server. Setup wizard in Settings → AI assistant; settings dialog inside the chat. Chats as an agent from an installed agent manager.",
  "targets": ["axf-console", "axf-web-app"],
  "provides": ["view:ai-assistant", "dialog:ai-assistant.chat", "settings-tab:ai-assistant", "action:ai-assistant.open", "service:axf.llm@1"],
  "optional": ["service:axf.agents@1"],
  "scopes": ["ROUTES", "NETWORK"],
  "enabledByDefault": true,
  "builtWith": { "model": "opus", "replacedBy": "pending item ai-assistant-plugin (Fable)" },
  "lifecycle": {
    "$axf": "plugin-lifecycle@1",
    "dataDir": ".axf-console/plugins/ai-assistant",
    "env": ["ANTHROPIC_API_KEY", "CLAUDE_CODE_OAUTH_TOKEN", "OPENAI_API_KEY", "XAI_API_KEY", "GEMINI_API_KEY", "MISTRAL_API_KEY", "GROQ_API_KEY", "DEEPSEEK_API_KEY", "OPENROUTER_API_KEY", "TOGETHER_API_KEY", "FIREWORKS_API_KEY", "PERPLEXITY_API_KEY", "COHERE_API_KEY", "CEREBRAS_API_KEY", "AZURE_OPENAI_API_KEY", "AXF_AI_ASSISTANT_DIR", "AXF_AI_TIMEOUT"],
    "mentions": ["CLAUDE.md", "apps/console-web/plugins/README.md"]
  }
}
