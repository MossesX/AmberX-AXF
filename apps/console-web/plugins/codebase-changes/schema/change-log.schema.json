{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amberxai.com/schemas/change-log@1.json",
  "title": "change-log@1 — one Codebase changes entry",
  "description": "One request Claude was asked to build, edit, remove or fix something: what was asked, its steps and its result. Stored one file per entry at changes/<YYYY>/<MM>/<id>.json in the shared data folder (the hub's /projects/amberx-axf/_data). The validators in changes-core.mjs (normalize) and server/store.py (normalize) are the source of truth: they also cut long text and hide secret-looking values. Build stats (Oct 21 2026, all optional): buildRef, status, surface, startedAt/finishedAt/lastSeenAt, estimate, actual, costEstimated, branch, areas, parent, doing, progress, verify.",
  "type": "object",
  "required": [
    "$axf",
    "id",
    "createdAt",
    "updatedAt",
    "kind",
    "title",
    "state",
    "steps",
    "result",
    "closed"
  ],
  "additionalProperties": false,
  "properties": {
    "$axf": {
      "const": "change-log@1"
    },
    "id": {
      "type": "string",
      "pattern": "^chg-\\d{8}-[0-9a-f]{6,16}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,23}$",
      "description": "Open set; known: build, edit, remove, fix, other."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "asked": {
      "type": "string",
      "maxLength": 4000,
      "description": "What was asked, cut short, secrets hidden."
    },
    "repos": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.-]{1,39}/[A-Za-z0-9_.-]{1,100}$"
      }
    },
    "model": {
      "type": "string",
      "maxLength": 40
    },
    "who": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "session": {
          "type": "string",
          "maxLength": 80
        },
        "where": {
          "type": "string",
          "maxLength": 80,
          "description": "vps, cloud, local, …"
        },
        "user": {
          "type": "string",
          "maxLength": 80
        },
        "host": {
          "type": "string",
          "maxLength": 80
        }
      }
    },
    "state": {
      "enum": [
        "running",
        "done",
        "failed",
        "partial",
        "cancelled"
      ],
      "description": "Derived: the result's state, else running."
    },
    "steps": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "text",
          "state"
        ],
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "state": {
            "enum": [
              "queued",
              "running",
              "done",
              "failed",
              "skipped"
            ]
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "finishedAt": {
            "type": "string",
            "format": "date-time"
          },
          "note": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    },
    "result": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "state",
            "summary"
          ],
          "additionalProperties": false,
          "properties": {
            "state": {
              "enum": [
                "done",
                "failed",
                "partial",
                "cancelled"
              ]
            },
            "summary": {
              "type": "string",
              "maxLength": 4000
            },
            "branch": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._/-]{1,120}$"
            },
            "commits": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "object",
                "required": [
                  "sha"
                ],
                "additionalProperties": false,
                "properties": {
                  "sha": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{7,40}$"
                  },
                  "message": {
                    "type": "string",
                    "maxLength": 200
                  }
                }
              }
            },
            "filesChanged": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "tests": {
              "type": "object",
              "maxProperties": 50,
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "before": {
                    "type": "string",
                    "maxLength": 60
                  },
                  "after": {
                    "type": "string",
                    "maxLength": 60
                  },
                  "state": {
                    "enum": [
                      "pass",
                      "fail",
                      "skip"
                    ]
                  }
                }
              }
            },
            "links": {
              "type": "object",
              "maxProperties": 20,
              "propertyNames": {
                "pattern": "^[a-z][a-z0-9-]{0,23}$"
              },
              "additionalProperties": {
                "type": "string",
                "maxLength": 500,
                "description": "An https URL or a repo path."
              }
            }
          }
        }
      ]
    },
    "closed": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "at",
            "by"
          ],
          "additionalProperties": false,
          "properties": {
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "by": {
              "type": "string",
              "maxLength": 80
            }
          }
        }
      ],
      "description": "Dismissed from the banner (everywhere)."
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "done",
        "failed"
      ],
      "description": "Derived build status: result done/partial → done, failed/cancelled → failed; no result → running (or queued when written so)."
    },
    "buildRef": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false,
      "description": "The build this entry is about: pending item, build-queue epic or plan feature.",
      "properties": {
        "kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,23}$",
          "description": "pending, queue, plan, other, … (open set)"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:/-]{1,120}$"
        }
      }
    },
    "surface": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$",
      "description": "Where it runs: vps-claude-code, claude-code, claude-ai, console-launch, subagent, backfill, … (open set)."
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "lastSeenAt": {
      "type": "string",
      "format": "date-time",
      "description": "Heartbeat while running; not seen for 10 minutes = 'no word' (stale)."
    },
    "estimate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minutes": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        },
        "costUsd": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        }
      }
    },
    "actual": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minutes": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        },
        "costUsd": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        },
        "inputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "cacheReadTokens": {
          "type": "integer",
          "minimum": 0
        },
        "cacheWriteTokens": {
          "type": "integer",
          "minimum": 0
        },
        "source": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,23}$",
          "description": "transcript, manual, git, …"
        }
      }
    },
    "costEstimated": {
      "type": "boolean",
      "description": "True when the cost shown is the estimate (no actual cost recorded)."
    },
    "branch": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._/-]{1,120}$"
    },
    "areas": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.@/*+-]{1,200}$"
      },
      "description": "Relative repo paths / folders it touches (overlap check)."
    },
    "parent": {
      "type": "string",
      "pattern": "^chg-\\d{8}-[0-9a-f]{6,16}$",
      "description": "The entry a subagent reports under."
    },
    "doing": {
      "type": "string",
      "maxLength": 160,
      "description": "What the session is doing right now (short; the hooks fill it from the current step or tool)."
    },
    "progress": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "verify": {
      "type": "object",
      "required": [
        "state"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "pending",
            "running",
            "verified",
            "broken",
            "skipped"
          ]
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "summary": {
          "type": "string",
          "maxLength": 1000
        },
        "checks": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "pass",
              "fail",
              "skip"
            ]
          }
        }
      }
    },
    "resume": {
      "type": "object",
      "additionalProperties": false,
      "description": "What another machine or Claude account needs to pick the work up (Oct 25 2026). The hook fills the git part; `changes.mjs resume` the rest.",
      "properties": {
        "repo": {
          "type": "string",
          "maxLength": 100,
          "description": "owner/name"
        },
        "folder": {
          "type": "string",
          "maxLength": 300,
          "description": "checkout folder where it ran"
        },
        "branch": {
          "type": "string",
          "maxLength": 120,
          "description": "branch the work is on"
        },
        "base": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$",
          "description": "commit it started from"
        },
        "head": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$",
          "description": "last commit"
        },
        "pushed": {
          "type": "boolean",
          "description": "head is on the remote"
        },
        "dirty": {
          "type": "integer",
          "minimum": 0,
          "description": "uncommitted files on the old machine"
        },
        "pr": {
          "type": "string",
          "maxLength": 500,
          "pattern": "^https://",
          "description": "pull request URL"
        },
        "plan": {
          "type": "string",
          "maxLength": 3000,
          "description": "the approach"
        },
        "next": {
          "type": "string",
          "maxLength": 1500,
          "description": "what is left"
        },
        "notes": {
          "type": "string",
          "maxLength": 3000,
          "description": "anything else the next session needs"
        },
        "files": {
          "type": "array",
          "maxItems": 300,
          "items": {
            "type": "string",
            "maxLength": 300
          },
          "description": "repo paths changed"
        },
        "tests": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "string",
            "maxLength": 300
          },
          "description": "commands that check it"
        },
        "read": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "string",
            "maxLength": 300
          },
          "description": "repo paths to read first"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
