{
  "$axf": "asset@1",
  "type": "toolbar",
  "id": "toolbar-push-banner-merge-queue-grouped",
  "name": "Merge queue: Grouped with overflow",
  "version": "0.1.0",
  "author": "UI Review choices",
  "description": "The first group on the bar, the rest in More: the calmest bar on a phone.",
  "tags": [
    "ui-choice",
    "choice-set:toolbar-push-banner-merge-queue",
    "choice-option:grouped"
  ],
  "data": {
    "scope": "view:push-banner",
    "slot": "merge-queue",
    "variant": "icons-labels",
    "align": "start",
    "showSearch": false,
    "overflow": {
      "when": "auto",
      "keep": 2,
      "label": "More"
    },
    "groups": [
      {
        "id": "line",
        "label": "The line",
        "items": [
          {
            "id": "add",
            "icon": "plus",
            "label": "Add PR to queue",
            "action": "command:push-banner/mergequeue-add",
            "args": {
              "pr": "$selection.pr"
            },
            "enabledWhen": "selection.canAdd",
            "priority": 300,
            "overflow": "never"
          },
          {
            "id": "up",
            "icon": "chevron-up",
            "label": "Move up",
            "action": "command:push-banner/mergequeue-move",
            "args": {
              "pr": "$selection.pr",
              "to": "$selection.up"
            },
            "enabledWhen": [
              "selection.inQueue",
              "selection.index>0"
            ],
            "priority": 260
          },
          {
            "id": "down",
            "icon": "chevron-down",
            "label": "Move down",
            "action": "command:push-banner/mergequeue-move",
            "args": {
              "pr": "$selection.pr",
              "to": "$selection.down"
            },
            "enabledWhen": [
              "selection.inQueue",
              "selection.canDown"
            ],
            "priority": 250
          },
          {
            "id": "remove",
            "icon": "x",
            "label": "Remove",
            "action": "command:push-banner/mergequeue-remove",
            "args": {
              "pr": "$selection.pr",
              "why": "removed from the merge queue toolbar"
            },
            "enabledWhen": "selection.inQueue",
            "destructive": true,
            "confirm": "Take this PR out of the queue until its next commit?",
            "priority": 200
          }
        ]
      },
      {
        "id": "run",
        "label": "Run",
        "items": [
          {
            "id": "run",
            "icon": "rocket",
            "label": "Run queue",
            "action": "command:push-banner/land-now",
            "args": {
              "build": "$selection.build"
            },
            "enabledWhen": "selection.build",
            "priority": 240,
            "overflow": "always"
          },
          {
            "id": "ci",
            "icon": "external",
            "label": "Open CI",
            "action": "handler:push-banner.open-ci",
            "enabledWhen": "selection.runUrl",
            "priority": 180,
            "overflow": "always"
          },
          {
            "id": "red",
            "icon": "alert",
            "label": "Show red reason",
            "action": "handler:push-banner.red-reason",
            "badge": "state:kicked",
            "enabledWhen": "selection.why",
            "priority": 170,
            "overflow": "always"
          }
        ]
      }
    ],
    "builtFor": "view:push-banner"
  }
}
