{
  "$axf": "claude-settings-registry@1",
  "readme": "What's shipped options (plugin-settings@1): the feed's window (GET / PUT /config) through server/plugin_options.py.",
  "service": "axf.plugin-options.whats-shipped@1",
  "groups": [
    {
      "id": "feed",
      "label": "Feed",
      "icon": "check-circle",
      "order": 10
    }
  ],
  "settings": [
    {
      "key": "whats-shipped.days",
      "label": "Show the last (days: 1, 3, 7, 14, 30, 60, 90 or 365)",
      "kind": "number",
      "default": 30,
      "min": 1,
      "max": 365,
      "group": "feed"
    },
    {
      "key": "whats-shipped.deployedOnly",
      "label": "Only what is deployed",
      "kind": "toggle",
      "default": false,
      "group": "feed"
    }
  ]
}
