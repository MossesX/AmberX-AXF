{
  "$axf": "asset@1",
  "type": "toolbar",
  "version": "1.0.0",
  "author": "AmberX AXF",
  "tags": [
    "page",
    "hub",
    "passes"
  ],
  "id": "hub-passes-grouped",
  "name": "Hub · Passes and veto (grouped)",
  "description": "The Passes and veto toolbar with labels only, its commands grouped by what they do and a More menu as soon as the row is tight.",
  "data": {
    "scope": "view:hub",
    "slot": "passes",
    "showSearch": false,
    "variant": "labels",
    "align": "start",
    "density": "regular",
    "divider": true,
    "overflow": {
      "when": "auto",
      "keep": 1,
      "label": "More"
    },
    "groups": [
      {
        "id": "do",
        "label": "Do",
        "items": [
          {
            "id": "request",
            "icon": "bell",
            "label": "Ask Brett for a pass",
            "action": "command:hub-admin/pass-request",
            "priority": 250
          },
          {
            "id": "go-end",
            "icon": "pause",
            "label": "End the go pass",
            "action": "command:hub-admin/go-pass-end",
            "priority": 250
          }
        ]
      },
      {
        "id": "go",
        "label": "Go to",
        "items": [
          {
            "id": "go-log",
            "icon": "list",
            "label": "Approval log",
            "action": "hub.open:log",
            "priority": 100
          },
          {
            "id": "go-approvals",
            "icon": "shield",
            "label": "Approvals",
            "action": "hub.open:approvals",
            "priority": 100
          }
        ]
      }
    ]
  }
}
