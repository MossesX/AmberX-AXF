{
  "$axf": "asset@1",
  "type": "toolbar",
  "version": "1.0.0",
  "author": "AmberX AXF",
  "tags": [
    "page",
    "hub",
    "approvals"
  ],
  "id": "hub-approvals-grouped",
  "name": "Hub · Approvals (grouped)",
  "description": "The Approvals toolbar with labels only, its commands grouped by what they do and a More menu as soon as the row is tight.",
  "data": {
    "scope": "view:hub",
    "slot": "approvals",
    "showSearch": false,
    "variant": "labels",
    "align": "start",
    "density": "regular",
    "divider": true,
    "overflow": {
      "when": "auto",
      "keep": 1,
      "label": "More"
    },
    "groups": [
      {
        "id": "read",
        "label": "Read",
        "items": [
          {
            "id": "check",
            "icon": "refresh",
            "label": "Check now",
            "action": "command:hub-admin/approvals-check",
            "priority": 300
          }
        ]
      },
      {
        "id": "do",
        "label": "Do",
        "items": [
          {
            "id": "auto-stop",
            "icon": "x-circle",
            "label": "Stop approving automatically",
            "action": "command:hub-admin/approvals-auto-stop",
            "priority": 250
          },
          {
            "id": "notify-phone",
            "icon": "smartphone",
            "label": "Tell the phone about the waiting calls now",
            "action": "command:hub-admin/approvals-notify-phone",
            "priority": 250
          }
        ]
      },
      {
        "id": "go",
        "label": "Go to",
        "items": [
          {
            "id": "go-log",
            "icon": "list",
            "label": "Approval log",
            "action": "hub.open:log",
            "priority": 100
          },
          {
            "id": "go-passes",
            "icon": "clock",
            "label": "Passes and veto",
            "action": "hub.open:passes",
            "priority": 100
          }
        ]
      }
    ]
  }
}
