{
  "$axf": "asset@1",
  "type": "toolbar",
  "version": "1.0.0",
  "author": "AmberX AXF",
  "tags": [
    "page",
    "hub",
    "overview"
  ],
  "id": "hub-overview",
  "name": "Hub · Hub",
  "description": "The Hub toolbar: its commands with icons and labels in one row, then the jumps to the hub screens it works with. Deciding (approve, deny, grant) stays on the rows and forms: Brett's own tap.",
  "data": {
    "scope": "view:hub",
    "slot": "overview",
    "showSearch": false,
    "variant": "icons-labels",
    "align": "start",
    "density": "regular",
    "overflow": {
      "when": "auto",
      "keep": 2,
      "label": "More"
    },
    "groups": [
      {
        "id": "do",
        "label": "Hub",
        "items": [
          {
            "id": "check",
            "icon": "refresh",
            "label": "Check the hub now",
            "action": "command:hub-admin/overview-check",
            "priority": 300
          },
          {
            "id": "sign-in",
            "icon": "shield",
            "label": "Sign in to axHub",
            "action": "command:hub-admin/overview-sign-in",
            "priority": 250
          }
        ]
      },
      {
        "id": "go",
        "label": "Go to",
        "items": [
          {
            "id": "go-approvals",
            "icon": "shield",
            "label": "Approvals",
            "action": "hub.open:approvals",
            "priority": 100
          },
          {
            "id": "go-connectors",
            "icon": "layers",
            "label": "Apps and connectors",
            "action": "hub.open:connectors",
            "priority": 100
          }
        ]
      }
    ]
  }
}
