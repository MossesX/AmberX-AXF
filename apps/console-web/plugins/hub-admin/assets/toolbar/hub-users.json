{
  "$axf": "asset@1",
  "type": "toolbar",
  "version": "1.0.0",
  "author": "AmberX AXF",
  "tags": [
    "page",
    "hub",
    "users"
  ],
  "id": "hub-users",
  "name": "Hub · Users",
  "description": "The Users toolbar: its commands with icons and labels in one row, then the jumps to the hub screens it works with. Deciding (approve, deny, grant) stays on the rows and forms: Brett's own tap.",
  "data": {
    "scope": "view:hub",
    "slot": "users",
    "showSearch": false,
    "variant": "icons-labels",
    "align": "start",
    "density": "regular",
    "overflow": {
      "when": "auto",
      "keep": 2,
      "label": "More"
    },
    "groups": [
      {
        "id": "do",
        "label": "Users",
        "items": [
          {
            "id": "invite",
            "icon": "plus",
            "label": "Add an account",
            "action": "command:hub-admin/users-invite",
            "priority": 200,
            "confirm": "Add an account?"
          }
        ]
      },
      {
        "id": "go",
        "label": "Go to",
        "items": [
          {
            "id": "go-auth",
            "icon": "lock",
            "label": "Auth admin",
            "action": "hub.open:auth",
            "priority": 100
          },
          {
            "id": "go-account",
            "icon": "key",
            "label": "Account",
            "action": "hub.open:account",
            "priority": 100
          }
        ]
      }
    ]
  }
}
