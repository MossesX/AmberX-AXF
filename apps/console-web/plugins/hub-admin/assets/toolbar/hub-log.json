{
  "$axf": "asset@1",
  "type": "toolbar",
  "version": "1.0.0",
  "author": "AmberX AXF",
  "tags": [
    "page",
    "hub",
    "log"
  ],
  "id": "hub-log",
  "name": "Hub · Approval log",
  "description": "The Approval log toolbar: its commands with icons and labels in one row, then the jumps to the hub screens it works with. Deciding (approve, deny, grant) stays on the rows and forms: Brett's own tap.",
  "data": {
    "scope": "view:hub",
    "slot": "log",
    "showSearch": false,
    "variant": "icons-labels",
    "align": "start",
    "density": "regular",
    "overflow": {
      "when": "auto",
      "keep": 2,
      "label": "More"
    },
    "groups": [
      {
        "id": "do",
        "label": "Approval log",
        "items": [
          {
            "id": "download",
            "icon": "download",
            "label": "Download JSON",
            "action": "command:hub-admin/log-download",
            "priority": 250
          }
        ]
      },
      {
        "id": "go",
        "label": "Go to",
        "items": [
          {
            "id": "go-approvals",
            "icon": "shield",
            "label": "Approvals",
            "action": "hub.open:approvals",
            "priority": 100
          }
        ]
      }
    ]
  }
}
