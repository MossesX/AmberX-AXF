{
  "$axf": "asset@1",
  "type": "toolbar",
  "version": "1.0.0",
  "author": "AmberX AXF",
  "tags": [
    "page",
    "hub",
    "handoff"
  ],
  "id": "hub-handoff-grouped",
  "name": "Hub · Handoff (grouped)",
  "description": "The Handoff toolbar with labels only, its commands grouped by what they do and a More menu as soon as the row is tight.",
  "data": {
    "scope": "view:hub",
    "slot": "handoff",
    "showSearch": false,
    "variant": "labels",
    "align": "start",
    "density": "regular",
    "divider": true,
    "overflow": {
      "when": "auto",
      "keep": 1,
      "label": "More"
    },
    "groups": [
      {
        "id": "go",
        "label": "Go to",
        "items": [
          {
            "id": "go-account",
            "icon": "key",
            "label": "Account",
            "action": "hub.open:account",
            "priority": 100
          }
        ]
      }
    ]
  }
}
