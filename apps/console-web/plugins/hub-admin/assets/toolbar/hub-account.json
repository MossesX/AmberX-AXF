{
  "$axf": "asset@1",
  "type": "toolbar",
  "version": "1.0.0",
  "author": "AmberX AXF",
  "tags": [
    "page",
    "hub",
    "account"
  ],
  "id": "hub-account",
  "name": "Hub · Account",
  "description": "The Account toolbar: its commands with icons and labels in one row, then the jumps to the hub screens it works with. Deciding (approve, deny, grant) stays on the rows and forms: Brett's own tap.",
  "data": {
    "scope": "view:hub",
    "slot": "account",
    "showSearch": false,
    "variant": "icons-labels",
    "align": "start",
    "density": "regular",
    "overflow": {
      "when": "auto",
      "keep": 2,
      "label": "More"
    },
    "groups": [
      {
        "id": "do",
        "label": "Account",
        "items": [
          {
            "id": "profile",
            "icon": "play",
            "label": "Save name and email",
            "action": "command:hub-admin/account-profile",
            "priority": 250
          },
          {
            "id": "signout-others",
            "icon": "play",
            "label": "Sign out the other browsers",
            "action": "command:hub-admin/account-signout-others",
            "priority": 200,
            "confirm": "Sign out the other browsers?"
          },
          {
            "id": "phone",
            "icon": "external",
            "label": "Linked phone",
            "action": "command:hub-admin/account-phone",
            "priority": 250
          },
          {
            "id": "notifications",
            "icon": "external",
            "label": "Notification preferences",
            "action": "command:hub-admin/account-notifications",
            "priority": 250
          }
        ]
      },
      {
        "id": "go",
        "label": "Go to",
        "items": [
          {
            "id": "go-users",
            "icon": "user",
            "label": "Users",
            "action": "hub.open:users",
            "priority": 100
          }
        ]
      }
    ]
  }
}
