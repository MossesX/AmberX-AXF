{
  "$axf": "asset@1",
  "type": "toolbar",
  "version": "1.0.0",
  "author": "AmberX AXF",
  "tags": [
    "page",
    "hub",
    "apps"
  ],
  "id": "hub-apps",
  "name": "Hub · Apps",
  "description": "The Apps toolbar: its commands with icons and labels in one row, then the jumps to the hub screens it works with. Deciding (approve, deny, grant) stays on the rows and forms: Brett's own tap.",
  "data": {
    "scope": "view:hub",
    "slot": "apps",
    "showSearch": false,
    "variant": "icons-labels",
    "align": "start",
    "density": "regular",
    "overflow": {
      "when": "auto",
      "keep": 2,
      "label": "More"
    },
    "groups": [
      {
        "id": "do",
        "label": "Apps",
        "items": []
      },
      {
        "id": "go",
        "label": "Go to",
        "items": [
          {
            "id": "go-overview",
            "icon": "shield",
            "label": "Hub",
            "action": "hub.open:overview",
            "priority": 100
          }
        ]
      }
    ]
  }
}
