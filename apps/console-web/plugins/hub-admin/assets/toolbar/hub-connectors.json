{
  "$axf": "asset@1",
  "type": "toolbar",
  "version": "1.0.0",
  "author": "AmberX AXF",
  "tags": [
    "page",
    "hub",
    "connectors"
  ],
  "id": "hub-connectors",
  "name": "Hub · Apps and connectors",
  "description": "The Apps and connectors toolbar: its commands with icons and labels in one row, then the jumps to the hub screens it works with. Deciding (approve, deny, grant) stays on the rows and forms: Brett's own tap.",
  "data": {
    "scope": "view:hub",
    "slot": "connectors",
    "showSearch": false,
    "variant": "icons-labels",
    "align": "start",
    "density": "regular",
    "overflow": {
      "when": "auto",
      "keep": 2,
      "label": "More"
    },
    "groups": [
      {
        "id": "do",
        "label": "Apps and connectors",
        "items": [
          {
            "id": "add",
            "icon": "plus",
            "label": "Add a connector",
            "action": "command:hub-admin/connector-add",
            "priority": 200,
            "confirm": "Add a connector?"
          }
        ]
      },
      {
        "id": "go",
        "label": "Go to",
        "items": [
          {
            "id": "go-log",
            "icon": "list",
            "label": "Approval log",
            "action": "hub.open:log",
            "priority": 100
          },
          {
            "id": "go-passes",
            "icon": "clock",
            "label": "Passes and veto",
            "action": "hub.open:passes",
            "priority": 100
          }
        ]
      }
    ]
  }
}
