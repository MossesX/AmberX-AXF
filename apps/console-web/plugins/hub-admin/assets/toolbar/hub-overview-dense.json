{
  "$axf": "asset@1",
  "type": "toolbar",
  "version": "1.0.0",
  "author": "AmberX AXF",
  "tags": [
    "page",
    "hub",
    "overview"
  ],
  "id": "hub-overview-dense",
  "name": "Hub · Hub (dense)",
  "description": "The Hub toolbar as icons only, compact: the phone's row. Labels are the tooltips.",
  "data": {
    "scope": "view:hub",
    "slot": "overview",
    "showSearch": false,
    "variant": "icons",
    "align": "start",
    "density": "compact",
    "overflow": {
      "when": "auto",
      "keep": 3,
      "label": "More"
    },
    "groups": [
      {
        "id": "do",
        "label": "Hub",
        "items": [
          {
            "id": "check",
            "icon": "refresh",
            "label": "Check the hub now",
            "action": "command:hub-admin/overview-check",
            "priority": 300
          },
          {
            "id": "sign-in",
            "icon": "shield",
            "label": "Sign in to axHub",
            "action": "command:hub-admin/overview-sign-in",
            "priority": 250
          }
        ]
      },
      {
        "id": "go",
        "label": "Go to",
        "items": [
          {
            "id": "go-approvals",
            "icon": "shield",
            "label": "Approvals",
            "action": "hub.open:approvals",
            "priority": 100
          },
          {
            "id": "go-connectors",
            "icon": "layers",
            "label": "Apps and connectors",
            "action": "hub.open:connectors",
            "priority": 100
          }
        ]
      }
    ]
  }
}
