      "buttons": [
        {
          "id": "approve",
          "label": "Confirm",
          "kind": "primary",
          "icon": "check"
        },
        {
          "id": "deny",
          "label": "Cancel",
          "kind": "neutral",
          "icon": "x"
        }
      ]
    },
    {
      "id": "model-upgrade",
      "label": "Model upgrade",
      "icon": "sparkles",
