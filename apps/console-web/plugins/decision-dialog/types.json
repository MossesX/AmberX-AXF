{
  "$axf": "decision-types@1",
  "note": "Every kind of decision that pops up the one decision dialog. A source may send its own buttons; these are the defaults. popup / notify are the defaults for Settings \u2192 Plugins \u2192 Decision dialog.",
  "types": [
    {
      "id": "review",
      "label": "UI Review",
      "icon": "eye",
      "popup": true,
      "notify": true,
      "description": "An item was submitted to UI Review: screenshots or options to approve or pick. Its notification is UI Review's own (one per group, Settings \u2192 Plugins \u2192 Claude \u2192 notify.uiReview).",
      "buttons": [
        {
          "id": "approve",
          "label": "Approve",
          "kind": "primary",
          "icon": "check"
        },
        {
          "id": "changes",
          "label": "Request changes",
          "kind": "neutral",
          "note": true,
          "icon": "edit"
        },
        {
          "id": "reject",
          "label": "Reject",
          "kind": "danger",
          "icon": "x"
        }
      ]
    },
    {
      "id": "veto",
      "label": "Veto countdown",
      "icon": "clock",
      "popup": false,
      "notify": true,
      "description": "axHub holds a call on its countdown: it runs by itself unless you stop it. Its own veto / approval screen already pops up, so here it waits in the queue and the counter unless you switch Pops up on.",
      "buttons": [
        {
          "id": "approve-now",
          "label": "Approve now",
          "kind": "primary",
          "icon": "check"
        },
        {
          "id": "deny",
          "label": "Deny",
          "kind": "danger",
          "icon": "x"
        },
        {
          "id": "shelve",
          "label": "Shelve",
          "kind": "neutral",
          "icon": "pause"
        }
      ]
    },
    {
      "id": "approval",
      "label": "Approval",
      "icon": "shield",
      "popup": false,
      "notify": true,
      "description": "A call waiting for your approval on axHub. Its own veto / approval screen already pops up, so here it waits in the queue and the counter unless you switch Pops up on.",
      "buttons": [
        {
          "id": "approve",
          "label": "Approve",
          "kind": "primary",
          "icon": "check"
        },
        {
          "id": "deny",
          "label": "Deny",
          "kind": "danger",
          "icon": "x"
        }
      ]
    },
    {
      "id": "confirm",
      "label": "Confirm",
      "icon": "help",
      "popup": true,
      "notify": false,
