      "buttons": [
        {
          "id": "approve",
          "label": "Approve upgrade",
          "kind": "primary",
          "icon": "check"
        },
        {
          "id": "deny",
          "label": "Keep the model",
          "kind": "neutral",
          "icon": "x"
        }
      ]
