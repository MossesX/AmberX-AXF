    },
    {
      "id": "other",
      "label": "Other",
      "icon": "info",
      "popup": true,
      "notify": true,
      "description": "Anything else that needs you.",
      "buttons": [
        {
          "id": "approve",
          "label": "Approve",
          "kind": "primary",
          "icon": "check"
        },
        {
          "id": "deny",
          "label": "Deny",
          "kind": "danger",
          "icon": "x"
        }
      ]
    }
