{
  "$axf": "asset@1",
  "type": "toolbar",
  "id": "skin-editor",
  "name": "Skin editor",
  "version": "1.0.0",
  "description": "The Skin editor toolbar: pick a screen anywhere in the console, pick a control inside the sandbox, show every element again, undo to the last snapshot and open the token registry. The UI pick and the edit count ride on the same bar.",
  "author": "AmberX AXF",
  "tags": ["page", "skin-editor", "skins"],
  "data": {
    "scope": "view:skin-editor",
    "variant": "icons-labels",
    "align": "start",
    "showSearch": false,
    "overflow": { "when": "auto", "keep": 1, "label": "More" },
    "groups": [
      {
        "id": "pick",
        "label": "Pick",
        "items": [
          { "id": "pick-screen", "icon": "eye", "label": "Pick on screen", "action": "handler:skin-editor.pick-screen", "priority": 300, "overflow": "never" },
          { "id": "pick-element", "icon": "layers", "label": "Pick element", "action": "handler:skin-editor.pick-element", "checked": "state:picking", "enabledWhen": "ui", "priority": 280 },
          { "id": "every-element", "icon": "x", "label": "Every element", "action": "handler:skin-editor.every-element", "visibleWhen": "element", "priority": 260 }
        ]
      },
      {
        "id": "skin",
        "label": "Skin",
        "items": [
          { "id": "undo", "icon": "undo", "label": "Undo", "action": "handler:skin-editor.undo", "enabledWhen": "undoable", "priority": 240 },
          { "id": "registry", "icon": "list", "label": "Token registry", "action": "handler:skin-editor.registry", "priority": 150 }
        ]
      }
    ]
  }
}
