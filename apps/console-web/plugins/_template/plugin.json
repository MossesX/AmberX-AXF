{
  "$axf": "plugin@1",
  "id": "ai.amberx.axf.console.example",
  "name": "Example",
  "version": "0.1.0",
  "kind": "module",
  "apiLevel": 1,
  "author": "Brett",
  "description": "Copy this folder (without the leading underscore) to start a console plugin. Follow plugin-lifecycle@1 (plugins/README.md \u2192 Lifecycle).",
  "targets": [
    "axf-console"
  ],
  "provides": [
    "view:example",
    "settings-tab:example"
  ],
  "scopes": [
    "ROUTES"
  ],
  "enabledByDefault": true,
  "optional": [],
  "banner": false,
  "tabable": false,
  "lifecycle": {
    "$axf": "plugin-lifecycle@1",
    "dataDir": ".axf-console/plugins/example",
    "env": [],
    "mentions": [
      "CLAUDE.md",
      "apps/console-web/plugins/README.md"
    ]
  }
}
