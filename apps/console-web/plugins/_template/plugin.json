{
  "$axf": "plugin@1",
  "id": "ai.amberx.axf.console.example",
  "name": "Example",
  "version": "0.1.0",
  "kind": "module",
  "apiLevel": 1,
  "author": "Brett",
  "description": "Copy this folder (without the leading underscore) to start a console plugin. Follow plugin-lifecycle@1 (plugins/README.md → Lifecycle).",
  "targets": [
    "axf-console"
  ],
  "provides": [
    "view:example",
    "settings-tab:example"
  ],
  "scopes": [
    "ROUTES"
  ],
  "enabledByDefault": true,
  "optional": [],
  "banner": false,
  "tabable": false,
  "screens": {
    "example": {
      "layouts": [
        {
          "id": "compact",
          "label": "Compact",
          "icon": "list",
          "description": "Tight rows, more on one screen."
        },
        {
          "id": "standard",
          "label": "Standard",
          "icon": "layout",
          "description": "The everyday arrangement."
        },
        {
          "id": "spacious",
          "label": "Spacious",
          "icon": "grid",
          "description": "Room around every block, big targets."
        }
      ],
      "default": "standard"
    }
  },
  "lifecycle": {
    "$axf": "plugin-lifecycle@1",
    "dataDir": ".axf-console/plugins/example",
    "env": [],
    "mentions": [
      "CLAUDE.md",
      "_claude/memory/STATUS.md",
      "apps/console-web/plugins/README.md"
    ]
  },
  "commands": { "$axf": "plugin-commands@1", "auto": true },
  "builtWith": { "model": "", "builtAt": "" },
  "help": "help.json",
  "opens": "main"
}
