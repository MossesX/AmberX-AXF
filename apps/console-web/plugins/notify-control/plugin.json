{
  "$axf": "plugin@1",
  "id": "ai.amberx.axf.console.notify-control",
  "name": "Notifications",
  "version": "0.1.0",
  "kind": "module",
  "apiLevel": 1,
  "author": "Brett",
  "description": "The one Notifications control panel: every notification the console, AmberX and axHub can send, in one registry that every sender checks. Per type: on or off, channels (banner, AmberX push, sound, console pop-up, web push / ntfy), priority and a test send; plus a master switch, one switch per app, quiet hours and a list of what was sent or blocked lately. Approvals and veto notices are guarded: the master and app switches skip them and only your own click turns them down. A plugin adds its types in its own notify.json. REST /api/plugins/notify-control, MCP notify-control_*, CLI axf notify-control <command>, capability axf.notify@1.",
  "targets": ["axf-console"],
  "provides": [
    "view:notify-control",
    "settings-tab:notify-control",
    "action:notify-control.open",
    "service:axf.notify@1"
  ],
  "optional": ["service:control@1", "service:axf.claude-settings@1"],
  "scopes": ["ROUTES"],
  "enabledByDefault": true,
  "banner": false,
  "tabable": false,
  "builtWith": { "model": "opus", "builtAt": "2026-11-06" },
  "help": "help.json",
  "lifecycle": {
    "$axf": "plugin-lifecycle@1",
    "dataDir": ".axf-console/plugins/notify-control",
    "env": ["AXF_NOTIFY_DATA_DIR"],
    "mentions": ["_claude/rules/RULES.md", "_claude/memory/STATUS.md", "_claude/THREADS.md", "apps/console-web/plugins/README.md"]
  },
  "commands": {
    "$axf": "plugin-commands@1",
    "auto": true,
    "items": [
      { "route": "GET /state", "id": "state", "title": "The whole Notifications panel: master, apps, quiet hours, every type", "readOnly": true },
      { "route": "GET /types", "id": "types", "title": "List every notification type and what happens to it now", "readOnly": true },
      { "route": "GET /check", "id": "check", "title": "What happens to one notification type right now, and why", "readOnly": true, "input": { "type": "object", "properties": { "type": { "type": "string", "description": "the type id, e.g. ci.failed" } }, "required": ["type"], "additionalProperties": false } },
      { "route": "GET /recent", "id": "recent", "title": "What the gate sent or blocked lately", "readOnly": true },
      { "route": "POST /master", "id": "master", "title": "Turn all notifications on or off (approvals and veto stay on)", "input": { "type": "object", "properties": { "on": { "type": "boolean" } }, "required": ["on"], "additionalProperties": false } },
      { "route": "POST /app", "id": "app", "title": "Turn one app's notifications on or off", "input": { "type": "object", "properties": { "app": { "type": "string", "enum": ["console", "amberx", "webpush"] }, "on": { "type": "boolean" } }, "required": ["app", "on"], "additionalProperties": false } },
      { "route": "POST /set", "id": "set", "title": "Change one notification type: on or off, a channel, or its priority", "input": { "type": "object", "properties": { "type": { "type": "string", "description": "the type id, e.g. ci.failed" }, "enabled": { "type": "boolean" }, "channel": { "type": "string", "enum": ["banner", "amberx", "sound", "popup", "webpush"] }, "on": { "type": "boolean", "description": "with channel" }, "priority": { "type": "string", "enum": ["low", "normal", "high", "urgent"] } }, "required": ["type"], "additionalProperties": false } },
      { "route": "POST /quiet", "id": "quiet", "title": "Set quiet hours", "input": { "type": "object", "properties": { "enabled": { "type": "boolean" }, "start": { "type": "string", "description": "HH:MM, 24 hour" }, "end": { "type": "string", "description": "HH:MM, 24 hour" } }, "additionalProperties": false } },
      { "route": "POST /test", "id": "test", "title": "Send a test of one notification type", "input": { "type": "object", "properties": { "type": { "type": "string" } }, "required": ["type"], "additionalProperties": false } },
      { "route": "POST /reset", "id": "reset", "title": "Put one type, or everything, back to its defaults", "input": { "type": "object", "properties": { "type": { "type": "string" }, "confirm": { "type": "string", "enum": ["reset"] } }, "required": ["confirm"], "additionalProperties": false } }
    ]
  },
  "opens": "main"
}
