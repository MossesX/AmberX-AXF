{
  "$axf": "asset@1",
  "type": "toolbar",
  "id": "wake-listener",
  "name": "Wake word",
  "version": "1.0.0",
  "description": "The wake word toolbar: switch listening on or off, and let Claude understand what was heard (on or off). Runs the wake-listener plugin's own commands.",
  "author": "AmberX AXF",
  "tags": [
    "page",
    "wake-listener",
    "voice"
  ],
  "data": {
    "scope": "view:wake-listener",
    "variant": "icons-labels",
    "align": "start",
    "showSearch": false,
    "overflow": {
      "when": "auto",
      "keep": 2,
      "label": "More"
    },
    "groups": [
      {
        "id": "listen",
        "label": "Listening",
        "items": [
          {
            "id": "on",
            "icon": "mic",
            "label": "Listen",
            "action": "command:wake-listener/on",
            "priority": 300,
            "overflow": "never"
          },
          {
            "id": "off",
            "icon": "pause",
            "label": "Stop listening",
            "action": "command:wake-listener/off",
            "priority": 280,
            "overflow": "never"
          }
        ]
      },
      {
        "id": "claude",
        "label": "Claude",
        "items": [
          {
            "id": "claude-on",
            "icon": "sparkles",
            "label": "Claude understands",
            "action": "command:wake-listener/claude-on",
            "priority": 200
          },
          {
            "id": "claude-off",
            "icon": "x",
            "label": "Rules only",
            "action": "command:wake-listener/claude-off",
            "priority": 180
          }
        ]
      }
    ],
    "builtFor": "view:wake-listener"
  }
}
