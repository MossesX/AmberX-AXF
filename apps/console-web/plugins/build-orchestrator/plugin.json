{
  "$axf": "plugin@1",
  "id": "ai.amberx.axf.console.build-orchestrator",
  "name": "Build orchestrator",
  "version": "0.1.1",
  "kind": "module",
  "apiLevel": 1,
  "author": "Brett",
  "description": "Breaks every build into small steps (30 min or less), each pinned to Fable or Opus. Consecutive same-model steps form a phase; a phase that switches model waits for Brett's approval. Token rules on every build: one session, no sub-agents unless a step allows it, briefs carry only the current phase. Page = tab group (Builds, Approvals, Rules); the Builds tab looks and behaves like Pending builds, with more options (per-step model, phases, approve switch, next-phase brief, hide, archive, import from Pending, move/edit/remove steps). Tracker is a repo file, _claude/builds/orchestrator.json, so any session or account continues the build (orchestrator.mjs next | brief | act).",
  "targets": [
    "axf-console"
  ],
  "provides": [
    "view:build-orchestrator",
    "settings-tab:build-orchestrator",
    "service:orchestrator@1"
  ],
  "scopes": [
    "ROUTES"
  ],
  "enabledByDefault": true,
  "optional": [],
  "banner": false,
  "tabable": {
    "view": "build-orchestrator",
    "label": "Orchestrator",
    "icon": "layers"
  },
  "lifecycle": {
    "$axf": "plugin-lifecycle@1",
    "dataDir": ".axf-console/plugins/build-orchestrator",
    "env": [],
    "mentions": [
      "CLAUDE.md",
      "_claude/memory/STATUS.md",
      "_claude/THREADS.md",
      "_claude/builds/README.md",
      "_claude/rules/RULES.md",
      "_claude/shared/rules/RULES.md", "deploy/claude-headless.sh", "framework/spec/check-builds-live.mjs"
    ]
  },
  "commands": {
    "$axf": "plugin-commands@1",
    "auto": true,
    "items": [
      {
        "id": "origin",
        "route": "GET /origin/{build_id}",
        "title": "What Brett said",
        "description": "The verbatim words Brett used to start a build (build-origin@1): when, where, who launched it, the brief and later addenda.",
        "readOnly": true,
        "input": {
          "type": "object",
          "properties": {
            "build_id": {
              "type": "string"
            }
          },
          "required": [
            "build_id"
          ]
        },
        "output": "{ id, title, origin, subtitle }"
      },
      {
        "id": "origin-set",
        "route": "POST /origin/{build_id}",
        "title": "Record what Brett said",
        "description": "Record Brett's verbatim words on a build that has none (backfilled ones give way); his words are never replaced: use origin-addendum for a later change.",
        "input": {
          "type": "object",
          "properties": {
            "build_id": {
              "type": "string"
            },
            "said": {
              "type": "string",
              "description": "Brett's exact words, verbatim and unedited (never a paraphrase)"
            },
            "source": {
              "type": "string",
              "enum": [
                "voice",
                "chat",
                "console",
                "code"
              ]
            },
            "at": {
              "type": "string",
              "description": "when he said it (ISO)"
            },
            "session": {
              "type": "string"
            },
            "link": {
              "type": "string"
            },
            "by": {
              "type": "string",
              "description": "who is recording it"
            }
          },
          "required": [
            "build_id",
            "said"
          ]
        },
        "output": "{ id, origin }"
      },
      {
        "id": "origin-addendum",
        "route": "POST /origin/{build_id}/addendum",
        "title": "Add what Brett said later",
        "description": "Append a later change Brett asked for (verbatim) to a build's origin.",
        "input": {
          "type": "object",
          "properties": {
            "build_id": {
              "type": "string"
            },
            "said": {
              "type": "string",
              "description": "Brett's exact words, verbatim and unedited (never a paraphrase)"
            },
            "source": {
              "type": "string",
              "enum": [
                "voice",
                "chat",
                "console",
                "code"
              ]
            },
            "at": {
              "type": "string",
              "description": "when he said it (ISO)"
            },
            "session": {
              "type": "string"
            },
            "link": {
              "type": "string"
            },
            "by": {
              "type": "string",
              "description": "who is recording it"
            }
          },
          "required": [
            "build_id",
            "said"
          ]
        },
        "output": "{ id, origin }"
      }
    ]
  },
  "builtWith": {
    "model": "opus",
    "builtAt": "2026-10-27"
  },
  "opens": "main"
}
