{
  "$axf": "asset@1",
  "type": "toolbar",
  "id": "toolbar-build-orchestrator-pipeline-grouped",
  "name": "Builds: Grouped with overflow",
  "version": "0.1.0",
  "author": "UI Review choices",
  "description": "The first group on the bar, the rest in More: the calmest bar on a phone.",
  "tags": [
    "ui-choice",
    "choice-set:toolbar-build-orchestrator-pipeline",
    "choice-option:grouped"
  ],
  "data": {
    "scope": "view:build-orchestrator",
    "slot": "pipeline",
    "variant": "icons-labels",
    "align": "start",
    "showSearch": false,
    "overflow": {
      "when": "auto",
      "keep": 2,
      "label": "More"
    },
    "groups": [
      {
        "id": "dispatch",
        "label": "Dispatch",
        "items": [
          {
            "id": "queue",
            "icon": "play",
            "label": "Queue selected",
            "action": "handler:builds.queue-selected",
            "enabledWhen": "selection.canQueue>0",
            "badge": "state:selection.canQueue",
            "priority": 300,
            "overflow": "never"
          },
          {
            "id": "split",
            "icon": "layers",
            "label": "Split now",
            "action": "command:build-orchestrator/pipeline-split",
            "args": {
              "id": "$selection.id"
            },
            "enabledWhen": [
              "selection.count=1",
              "selection.canSplit"
            ],
            "priority": 250
          },
          {
            "id": "priority",
            "icon": "chevron-up",
            "label": "Set priority",
            "action": "command:build-orchestrator/priority-set",
            "args": {
              "builds": "$selection.ids",
              "priority": "$selection.nextPriority"
            },
            "enabledWhen": "selection.count>0",
            "priority": 240
          },
          {
            "id": "fable",
            "icon": "zap",
            "label": "Raise to Fable",
            "action": "handler:builds.raise-fable",
            "enabledWhen": [
              "selection.count=1",
              "selection.canRaise"
            ],
            "priority": 200
          }
        ]
      },
      {
        "id": "build",
        "label": "Build",
        "items": [
          {
            "id": "said",
            "icon": "mic",
            "label": "Show what Brett said",
            "action": "handler:builds.show-said",
            "enabledWhen": "selection.count=1",
            "priority": 180,
            "overflow": "always"
          },
          {
            "id": "pr",
            "icon": "external",
            "label": "Open PR",
            "action": "handler:builds.open-pr",
            "enabledWhen": [
              "selection.count=1",
              "selection.pr"
            ],
            "priority": 160,
            "overflow": "always"
          },
          {
            "id": "relaunch",
            "icon": "refresh",
            "label": "Relaunch",
            "action": "command:build-orchestrator/retry",
            "args": {
              "build": "$selection.id",
              "strategy": "retry",
              "why": "Relaunched from the Builds toolbar"
            },
            "enabledWhen": [
              "selection.count=1",
              "selection.canRelaunch"
            ],
            "confirm": "Relaunch this build now?",
            "priority": 150,
            "overflow": "always"
          }
        ]
      },
      {
        "id": "view",
        "label": "View",
        "items": [
          {
            "id": "status",
            "icon": "sliders",
            "label": "Filter by status",
            "action": "handler:builds.filter-status",
            "checked": "state:statusFilter",
            "badge": "state:statusFilterCount",
            "enabledWhen": "statuses>1",
            "priority": 120,
            "overflow": "always"
          }
        ]
      }
    ]
  }
}
