{
  "$axf": "plugin@1",
  "id": "ai.amberx.axf.console.amberx-tasks",
  "name": "AmberX to-dos",
  "version": "0.1.0",
  "kind": "module",
  "apiLevel": 1,
  "author": "Brett",
  "description": "The AmberX web app's Tasks screen on the console (Apps \u2192 AmberX \u2192 To-dos): every amberx-notes@1 to-do and task on every device in tabs Today \u00b7 Upcoming \u00b7 To-dos \u00b7 All \u00b7 Done, with add, tick off, reorder and delete (two-step confirm), through control@1 amberx.items. Deep link console_open(\"amberx-tasks\", focus=\"today|upcoming|todo|all|done\" | \"item:<id>\" | \"new\"). REST /api/plugins/amberx-tasks (state, items, add, complete, reorder, remove, settings) and /api/control/amberx.items; MCP amberx-tasks_* and amberx_* / control_*; CLI axf amberx-tasks \u2026 and axf todo \u2026; voice \"what's due today\", \"show todos\", \"new todo\".",
  "targets": [
    "axf-console"
  ],
  "provides": [
    "view:amberx-tasks",
    "settings-tab:amberx-tasks",
    "action:amberx-tasks.open",
    "action:amberx-tasks.focus"
  ],
  "optional": [
    "control@1"
  ],
  "scopes": [
    "ROUTES"
  ],
  "enabledByDefault": true,
  "banner": false,
  "tabable": {
    "view": "amberx-tasks",
    "label": "To-dos",
    "icon": "check-square"
  },
  "lifecycle": {
    "$axf": "plugin-lifecycle@1",
    "dataDir": ".axf-console/plugins/amberx-tasks",
    "env": [
      "AXF_AMBERX_TASKS_DATA_DIR"
    ],
    "mentions": [
      "docs/contracts/amberx-console-api.md",
      "_claude/THREADS.md"
    ],
    "keeps": [
      "/projects/amberx-axf/_data/amberx-notes on axHub: every to-do and task (AmberX's own, read and written through control@1)"
    ]
  },
  "commands": {
    "$axf": "plugin-commands@1",
    "auto": true,
    "items": [
      {
        "route": "GET /state",
        "id": "state",
        "title": "The To-dos screen's state: settings, every list and the count on each tab (today, upcoming, overdue, todo, all, done)",
        "readOnly": true
      },
      {
        "route": "GET /items",
        "id": "items",
        "title": "The to-dos and tasks one tab shows (tab today|upcoming|todo|all|done, list, q, limit)",
        "readOnly": true,
        "input": {
          "type": "object",
          "properties": {
            "tab": {
              "type": "string",
              "enum": [
                "today",
                "upcoming",
                "todo",
                "all",
                "done"
              ]
            },
            "list": {
              "type": "string"
            },
            "q": {
              "type": "string"
            },
            "limit": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        }
      },
      {
        "route": "POST /add",
        "id": "add",
        "title": "Add a to-do (or a task) with an optional due day and list",
        "input": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "todo",
                "task"
              ]
            },
            "list": {
              "type": "string"
            },
            "due": {
              "type": "string",
              "description": "YYYY-MM-DD"
            },
            "priority": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            }
          },
          "required": [
            "text"
          ],
          "additionalProperties": false
        }
      },
      {
        "route": "POST /complete",
        "id": "complete",
        "title": "Tick a to-do or task off (done false opens it again)",
        "input": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "done": {
              "type": "boolean"
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        }
      },
      {
        "route": "POST /reorder",
        "id": "reorder",
        "title": "Put to-dos in this order (ids, first to last)",
        "input": {
          "type": "object",
          "properties": {
            "ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "ids"
          ],
          "additionalProperties": false
        }
      },
      {
        "route": "POST /remove",
        "id": "remove",
        "title": "Delete a to-do: the first call answers a confirm token, repeat with confirm to delete",
        "input": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "confirm": {
              "type": "string"
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        }
      },
      {
        "route": "GET /settings",
        "id": "settings",
        "title": "The To-dos screen's settings and their defaults",
        "readOnly": true
      },
      {
        "route": "PUT /settings",
        "id": "set-settings",
        "title": "Change To-dos screen settings (defaultTab, defaultList, defaultKind todo|task, pageSize 10\u2013500, overdueInToday)",
        "input": {
          "type": "object",
          "properties": {
            "defaultTab": {
              "type": "string",
              "enum": [
                "today",
                "upcoming",
                "todo",
                "all",
                "done"
              ]
            },
            "defaultList": {
              "type": "string"
            },
            "defaultKind": {
              "type": "string",
              "enum": [
                "todo",
                "task"
              ]
            },
            "pageSize": {
              "type": "integer",
              "minimum": 10,
              "maximum": 500
            },
            "overdueInToday": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      {
        "route": "POST /settings/reset",
        "id": "reset-settings",
        "title": "Put the To-dos screen's settings back to the defaults"
      },
      {
        "route": "POST /control",
        "skip": "the page's own control@1 relay: MCP and the CLI call control_* / amberx_* and axf todo directly"
      }
    ]
  },
  "builtWith": {
    "model": "opus",
    "builtAt": "2026-11-12"
  },
  "help": "help.json",
  "opens": "main"
}
