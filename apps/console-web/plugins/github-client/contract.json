{
  "$axf": "github-client@1",
  "plugin": "ai.amberx.axf.console.github-client",
  "folder": "github-client",
  "about": "Actions contract of the GitHub client plugin (DESIGN.md §3–§5). `commands` is what plugin.json → commands.items carries verbatim (plugin-commands@1); `reads` are the GET routes; `screens` the console.screens / console_show deep links; `records` the JSON shapes every surface returns. s7 checks the shipped plugin against this file; s8 replays it in tests.",
  "records": {
    "pr": {
      "type": "object",
      "required": ["repo", "number", "title", "author", "head", "base", "draft", "state", "mergeable", "behind", "ahead", "checks", "review", "labels", "updatedAt", "ageDays", "stale", "linkedBuild", "queue", "ready", "url"],
      "properties": {
        "repo": { "type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})/[A-Za-z0-9._-]{1,100}$" },
        "number": { "type": "integer", "minimum": 1 },
        "title": { "type": "string" },
        "author": { "type": "string" },
        "head": { "type": "string" },
        "base": { "type": "string" },
        "draft": { "type": "boolean" },
        "state": { "enum": ["open", "closed", "merged"] },
        "mergeable": { "enum": ["clean", "conflict", "blocked", "unknown"] },
        "behind": { "type": "integer", "minimum": 0 },
        "ahead": { "type": "integer", "minimum": 0 },
        "checks": {
          "type": "object",
          "required": ["state", "total", "failed", "pending"],
          "properties": {
            "state": { "enum": ["success", "failure", "pending", "none"] },
            "total": { "type": "integer", "minimum": 0 },
            "failed": { "type": "array", "items": { "type": "string" } },
            "pending": { "type": "array", "items": { "type": "string" } }
          }
        },
        "review": { "enum": ["approved", "changes", "required", "none"] },
        "labels": { "type": "array", "items": { "type": "string" } },
        "updatedAt": { "type": "string", "format": "date-time" },
        "ageDays": { "type": "integer", "minimum": 0 },
        "stale": { "type": "boolean" },
        "linkedBuild": { "oneOf": [{ "type": "null" }, { "type": "object", "required": ["id", "title", "status"], "properties": { "id": { "type": "string" }, "title": { "type": "string" }, "status": { "type": "string" } } }] },
        "queue": { "oneOf": [{ "type": "null" }, { "type": "object", "required": ["state"], "properties": { "state": { "enum": ["queued", "landing", "none"] }, "position": { "type": "integer", "minimum": 0 } } }] },
        "ready": { "type": "boolean", "description": "ready(pr, policy): not draft, mergeable clean, checks success (or none when allowed), review satisfied, no do-not-merge label" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "branch": {
      "type": "object",
      "required": ["repo", "name", "sha", "ahead", "behind", "lastCommit", "pr", "protected", "default"],
      "properties": {
        "repo": { "type": "string" },
        "name": { "type": "string" },
        "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "ahead": { "type": "integer", "minimum": 0 },
        "behind": { "type": "integer", "minimum": 0 },
        "lastCommit": { "type": "object", "required": ["sha", "message", "author", "at"] },
        "pr": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 1 }] },
        "protected": { "type": "boolean" },
        "default": { "type": "boolean" }
      }
    },
    "commit": {
      "type": "object",
      "required": ["repo", "sha", "message", "author", "at", "parents"],
      "properties": {
        "repo": { "type": "string" },
        "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "message": { "type": "string" },
        "author": { "type": "string" },
        "at": { "type": "string", "format": "date-time" },
        "parents": { "type": "array", "items": { "type": "string" } },
        "files": { "type": "array", "items": { "type": "object", "required": ["path", "status", "additions", "deletions"] } },
        "stats": { "type": "object", "properties": { "additions": { "type": "integer" }, "deletions": { "type": "integer" } } }
      }
    },
    "check": {
      "type": "object",
      "required": ["repo", "ref", "name", "kind", "state"],
      "properties": {
        "repo": { "type": "string" },
        "ref": { "type": "string" },
        "name": { "type": "string" },
        "kind": { "enum": ["check-run", "status"] },
        "state": { "enum": ["queued", "waiting", "running", "success", "failure", "cancelled", "skipped"] },
        "startedAt": { "type": "string" },
        "finishedAt": { "type": "string" },
        "url": { "type": "string" },
        "runId": { "type": "integer" },
        "jobId": { "type": "integer" }
      }
    },
    "group": {
      "type": "object",
      "required": ["id", "repo", "name", "branch", "members", "pr", "state", "conflicts", "createdAt", "by"],
      "properties": {
        "id": { "type": "string" },
        "repo": { "type": "string" },
        "name": { "type": "string" },
        "branch": { "type": "string", "pattern": "^queue/group-[a-z0-9-]+$" },
        "members": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 1 },
        "pr": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 1 }] },
        "state": { "enum": ["building", "open", "conflict", "landed", "dissolved"] },
        "conflicts": { "type": "array", "items": { "type": "object", "required": ["member", "files"] } },
        "createdAt": { "type": "string", "format": "date-time" },
        "by": { "type": "string" }
      }
    },
    "job": {
      "type": "object",
      "required": ["id", "kind", "state", "items", "startedAt", "by"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "enum": ["update-main", "rebase", "group", "bulk", "restore", "import"] },
        "state": { "enum": ["queued", "running", "done", "failed", "cancelled"] },
        "items": { "type": "array", "items": { "type": "object", "required": ["target", "state"], "properties": { "target": { "type": "string" }, "state": { "enum": ["pending", "running", "ok", "failed", "skipped"] }, "note": { "type": "string" } } } },
        "startedAt": { "type": "string" },
        "finishedAt": { "type": "string" },
        "by": { "type": "string" }
      }
    },
    "log": {
      "type": "object",
      "required": ["id", "at", "repo", "kind", "target", "actor", "outcome", "restorable"],
      "properties": {
        "id": { "type": "string" },
        "at": { "type": "string", "format": "date-time" },
        "repo": { "type": "string" },
        "kind": { "enum": ["merge", "merge-failed", "retry", "update-main", "rebase", "close", "reopen", "comment", "rerun-checks", "ready", "label", "queue-add", "queue-remove", "branch-delete", "restore", "push", "pr-open", "pr-close", "group-create", "group-land", "group-dissolve", "bulk", "import"] },
        "target": { "type": "object", "properties": { "pr": { "type": "integer" }, "branch": { "type": "string" }, "sha": { "type": "string" }, "group": { "type": "string" } } },
        "actor": { "type": "object", "required": ["kind", "name"], "properties": { "kind": { "enum": ["console", "api", "claude", "queue", "import"] }, "name": { "type": "string" } } },
        "outcome": { "enum": ["ok", "failed"] },
        "why": { "type": "string" },
        "details": { "type": "string" },
        "savedSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "restorable": { "type": "boolean" }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "extraRepos": { "type": "array", "items": { "type": "string" } },
        "pollMinutes": { "type": "integer", "minimum": 1, "maximum": 60, "default": 2 },
        "staleDays": { "type": "integer", "minimum": 1, "default": 14 },
        "mergeMethod": { "enum": ["queue", "squash", "merge", "rebase"], "default": "queue" },
        "requireGreenChecks": { "type": "boolean", "default": true },
        "allowNoChecks": { "type": "boolean", "default": false },
        "requireReview": { "type": "boolean", "default": false },
        "doNotMergeLabel": { "type": "string", "default": "do-not-merge" }
      }
    }
  },
  "screens": {
    "github-client": {
      "title": "GitHub client",
      "menu": ["builds", "plugins"],
      "tabs": ["prs", "branches", "commits", "checks", "log"],
      "focus": [
        { "pattern": "pr [<repo>] <n>", "opens": "prs tab, row expanded" },
        { "pattern": "prs ready|stale|conflicts|failing|behind|drafts|mine", "opens": "prs tab with that filter" },
        { "pattern": "branch <name>", "opens": "branches tab, that branch expanded" },
        { "pattern": "commits <branch>", "opens": "commits tab on that branch" },
        { "pattern": "commit <sha>", "opens": "dialog github-client.commit" },
        { "pattern": "checks <ref>", "opens": "checks tab for the ref" },
        { "pattern": "log <query>", "opens": "log tab with the search filled" },
        { "pattern": "group <id>", "opens": "dialog github-client.group" }
      ]
    },
    "dialogs": ["github-client.group", "github-client.bulk", "github-client.commit", "github-client.comment"],
    "settings": "plugins/github-client"
  },
  "reads": [
    { "route": "GET /repos", "id": "repos", "title": "Repos of this project" },
    { "route": "GET /prs", "id": "prs", "title": "Pull requests", "input": { "type": "object", "properties": { "repo": { "type": "string" }, "filter": { "enum": ["all", "ready", "failing", "conflicts", "behind", "stale", "drafts", "mine"] }, "sort": { "enum": ["updated", "oldest", "number", "behind"] }, "q": { "type": "string" } } } },
    { "route": "GET /pr/{repo}/{n}", "id": "pr", "title": "One pull request" },
    { "route": "GET /pr/{repo}/{n}/checks", "id": "pr-checks", "title": "Checks of a pull request" },
    { "route": "GET /pr/{repo}/{n}/commits", "id": "pr-commits", "title": "Commits of a pull request" },
    { "route": "GET /pr/{repo}/{n}/files", "id": "pr-files", "title": "Files of a pull request" },
    { "route": "GET /branches", "id": "branches", "title": "Branches", "input": { "type": "object", "properties": { "repo": { "type": "string" } } } },
    { "route": "GET /branch/{repo}/{name}", "id": "branch", "title": "One branch" },
    { "route": "GET /commits", "id": "commits", "title": "Commits", "input": { "type": "object", "properties": { "repo": { "type": "string" }, "branch": { "type": "string" }, "page": { "type": "integer" } } } },
    { "route": "GET /commit/{repo}/{sha}", "id": "commit", "title": "One commit with files" },
    { "route": "GET /diff/{repo}/{base}/{head}", "id": "diff", "title": "Compare two refs" },
    { "route": "GET /checks", "id": "checks", "title": "Checks for a ref", "input": { "type": "object", "properties": { "repo": { "type": "string" }, "ref": { "type": "string" } }, "required": ["repo", "ref"] } },
    { "route": "GET /groups", "id": "groups", "title": "PR groups" },
    { "route": "GET /group/{id}", "id": "group", "title": "One PR group" },
    { "route": "GET /jobs", "id": "jobs", "title": "Jobs" },
    { "route": "GET /job/{id}", "id": "job", "title": "One job" },
    { "route": "GET /log", "id": "log", "title": "Git log", "input": { "type": "object", "properties": { "q": { "type": "string" }, "kind": { "type": "string" }, "repo": { "type": "string" }, "since": { "type": "string" }, "page": { "type": "integer" } } } },
    { "route": "GET /config", "id": "config", "title": "Settings" },
    { "route": "GET /status", "id": "status", "title": "Token source, rate limit, cache age, queue state, last error" },
    { "route": "GET /events", "skip": "server-sent events stream, not a command" }
  ],
  "commands": [
    { "route": "POST /pr/{repo}/{n}/merge", "id": "merge", "title": "Merge a pull request", "description": "Merge queue on: adds it to the queue. Off: merges with the policy's method. Refused unless ready.", "input": { "type": "object", "properties": { "repo": { "type": "string" }, "n": { "type": "integer" }, "method": { "enum": ["queue", "squash", "merge", "rebase"] }, "why": { "type": "string" } }, "required": ["repo", "n"] }, "deniedTo": ["claude"] },
    { "route": "POST /pr/{repo}/{n}/update-main", "id": "update-main", "title": "Pull main into a pull request", "description": "GitHub update-branch; a conflict becomes a job that heals builds files and reports the rest.", "job": true, "deniedTo": ["claude"] },
    { "route": "POST /pr/{repo}/{n}/rebase", "id": "rebase", "title": "Rebase a pull request onto its base", "confirm": true, "job": true, "deniedTo": ["claude"] },
    { "route": "POST /pr/{repo}/{n}/close", "id": "close", "title": "Close a pull request", "input": { "type": "object", "properties": { "repo": { "type": "string" }, "n": { "type": "integer" }, "why": { "type": "string" } }, "required": ["repo", "n"] } },
    { "route": "POST /pr/{repo}/{n}/reopen", "id": "reopen", "title": "Reopen a pull request" },
    { "route": "POST /pr/{repo}/{n}/comment", "id": "comment", "title": "Comment on a pull request", "input": { "type": "object", "properties": { "repo": { "type": "string" }, "n": { "type": "integer" }, "body": { "type": "string", "minLength": 1 } }, "required": ["repo", "n", "body"] } },
    { "route": "POST /pr/{repo}/{n}/rerun-checks", "id": "rerun-checks", "title": "Re-run checks", "input": { "type": "object", "properties": { "repo": { "type": "string" }, "n": { "type": "integer" }, "failedOnly": { "type": "boolean", "default": true } }, "required": ["repo", "n"] } },
    { "route": "POST /pr/{repo}/{n}/ready", "id": "ready", "title": "Mark a draft ready for review" },
    { "route": "POST /pr/{repo}/{n}/label", "id": "label", "title": "Add or remove labels", "input": { "type": "object", "properties": { "repo": { "type": "string" }, "n": { "type": "integer" }, "add": { "type": "array", "items": { "type": "string" } }, "remove": { "type": "array", "items": { "type": "string" } } }, "required": ["repo", "n"] } },
    { "route": "POST /pr/{repo}/{n}/queue-remove", "id": "queue-remove", "title": "Take a pull request out of the merge queue", "input": { "type": "object", "properties": { "repo": { "type": "string" }, "n": { "type": "integer" }, "why": { "type": "string" } }, "required": ["repo", "n", "why"] } },
    { "route": "POST /group", "id": "group-create", "title": "Group pull requests into one batch", "input": { "type": "object", "properties": { "repo": { "type": "string" }, "name": { "type": "string" }, "prs": { "type": "array", "items": { "type": "integer" }, "minItems": 2 } }, "required": ["repo", "name", "prs"] }, "job": true },
    { "route": "POST /group/{id}/add", "id": "group-add", "title": "Add pull requests to a group", "job": true },
    { "route": "POST /group/{id}/remove", "id": "group-remove", "title": "Remove pull requests from a group", "job": true },
    { "route": "POST /group/{id}/land", "id": "group-land", "title": "Land a group", "deniedTo": ["claude"] },
    { "route": "POST /group/{id}/dissolve", "id": "group-dissolve", "title": "Dissolve a group", "confirm": true },
    { "route": "POST /bulk", "id": "bulk", "title": "Bulk action on many pull requests", "input": { "type": "object", "properties": { "repo": { "type": "string" }, "action": { "enum": ["merge-ready", "close-stale", "update-main", "rerun-failed", "label"] }, "prs": { "type": "array", "items": { "type": "integer" } }, "filter": { "enum": ["ready", "stale", "behind", "failing", "all"] }, "why": { "type": "string" }, "add": { "type": "array", "items": { "type": "string" } }, "remove": { "type": "array", "items": { "type": "string" } } }, "required": ["repo", "action"] }, "confirm": true, "job": true, "deniedTo": ["claude"] },
    { "route": "DELETE /branch/{repo}/{name}", "id": "branch-delete", "title": "Delete a branch (SHA saved, restorable)", "destructive": true, "confirm": true },
    { "route": "POST /log/{id}/restore", "id": "restore", "title": "Restore a deleted branch at its saved SHA" },
    { "route": "POST /refresh", "id": "refresh", "title": "Refresh from GitHub now", "input": { "type": "object", "properties": { "repo": { "type": "string" } } } },
    { "route": "POST /log/import", "id": "log-import", "title": "Import deleted-branch lists" },
    { "route": "PUT /config", "id": "config-set", "title": "Change settings" },
    { "route": "POST /job/{id}/cancel", "id": "job-cancel", "title": "Cancel a running job" }
  ],
  "voice": [
    { "say": "what's ready to merge", "command": "prs", "input": { "filter": "ready" } },
    { "say": "merge PR 123", "command": "merge", "input": { "n": 123 } },
    { "say": "pull main into 123", "command": "update-main", "input": { "n": 123 } },
    { "say": "re-run the failed checks on 123", "command": "rerun-checks", "input": { "n": 123, "failedOnly": true } },
    { "say": "close the stale PRs", "command": "bulk", "input": { "action": "close-stale" } },
    { "say": "update every PR from main", "command": "bulk", "input": { "action": "update-main", "filter": "behind" } },
    { "say": "group 120 121 and 122", "command": "group-create", "input": { "prs": [120, 121, 122] } },
    { "say": "show the git log for today", "command": "log", "input": { "since": "today" } }
  ],
  "policy": {
    "mergeRespectsQueue": true,
    "neverForcePushMain": true,
    "neverDeleteProtectedOrDefault": true,
    "deletesSaveSha": true,
    "oneJobPerRepo": true,
    "claudeNeverMerges": "merge, update-main, rebase, group-land and bulk answer 403 to control@1 commands with by: claude"
  }
}
