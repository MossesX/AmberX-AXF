{
  "$axf": "github-client@1",
  "plugin": "ai.amberx.axf.console.github-client",
  "folder": "github-client",
  "about": "Actions contract of the GitHub client plugin (DESIGN.md §3–§5). `commands` is what plugin.json → commands.items carries verbatim (plugin-commands@1); `reads` are the GET routes; `screens` the console.screens / console_show deep links; `records` the JSON shapes every surface returns. test.py checks plugin.json against this file (every command and read id, route and flag).",
  "records": {
    "pr": {
      "type": "object",
      "required": [
        "repo",
        "number",
        "title",
        "author",
        "head",
        "base",
        "draft",
        "state",
        "mergeable",
        "behind",
        "ahead",
        "checks",
        "review",
        "labels",
        "updatedAt",
        "ageDays",
        "stale",
        "linkedBuild",
        "queue",
        "ready",
        "url",
        "why"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})/[A-Za-z0-9._-]{1,100}$"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "head": {
          "type": "string"
        },
        "base": {
          "type": "string"
        },
        "draft": {
          "type": "boolean"
        },
        "state": {
          "enum": [
            "open",
            "closed",
            "merged"
          ]
        },
        "mergeable": {
          "enum": [
            "clean",
            "conflict",
            "blocked",
            "unknown"
          ]
        },
        "behind": {
          "type": "integer",
          "minimum": 0
        },
        "ahead": {
          "type": "integer",
          "minimum": 0
        },
        "checks": {
          "type": "object",
          "required": [
            "state",
            "total",
            "failed",
            "pending"
          ],
          "properties": {
            "state": {
              "enum": [
                "success",
                "failure",
                "pending",
                "none"
              ]
            },
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "failed": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "pending": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "review": {
          "enum": [
            "approved",
            "changes",
            "required",
            "none"
          ]
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "ageDays": {
          "type": "integer",
          "minimum": 0
        },
        "stale": {
          "type": "boolean"
        },
        "linkedBuild": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "id",
                "title",
                "status"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "queue": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "state"
              ],
              "properties": {
                "state": {
                  "enum": [
                    "queued",
                    "landing",
                    "none"
                  ]
                },
                "position": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          ]
        },
        "ready": {
          "type": "boolean",
          "description": "ready(pr, policy): not draft, mergeable clean, checks success (or none when allowed), review satisfied, no do-not-merge label"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "why": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "ready_reasons: why it is not ready ([] when ready)"
        },
        "headSha": {
          "type": "string"
        }
      }
    },
    "branch": {
      "type": "object",
      "required": [
        "repo",
        "name",
        "sha",
        "ahead",
        "behind",
        "lastCommit",
        "pr",
        "protected",
        "default"
      ],
      "properties": {
        "repo": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "ahead": {
          "type": "integer",
          "minimum": 0
        },
        "behind": {
          "type": "integer",
          "minimum": 0
        },
        "lastCommit": {
          "type": "object",
          "required": [
            "sha",
            "message",
            "author",
            "at"
          ]
        },
        "pr": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ]
        },
        "protected": {
          "type": "boolean"
        },
        "default": {
          "type": "boolean"
        }
      }
    },
    "commit": {
      "type": "object",
      "required": [
        "repo",
        "sha",
        "message",
        "author",
        "at",
        "parents"
      ],
      "properties": {
        "repo": {
          "type": "string"
        },
        "sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "message": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "parents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "status",
              "additions",
              "deletions"
            ]
          }
        },
        "stats": {
          "type": "object",
          "properties": {
            "additions": {
              "type": "integer"
            },
            "deletions": {
              "type": "integer"
            }
          }
        }
      }
    },
    "check": {
      "type": "object",
      "required": [
        "repo",
        "ref",
        "name",
        "kind",
        "state"
      ],
      "properties": {
        "repo": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "check-run",
            "status"
          ]
        },
        "state": {
          "enum": [
            "queued",
            "waiting",
            "running",
            "success",
            "failure",
            "cancelled",
            "skipped"
          ]
        },
        "startedAt": {
          "type": "string"
        },
        "finishedAt": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "runId": {
          "type": "integer"
        },
        "jobId": {
          "type": "integer"
        }
      }
    },
    "group": {
      "type": "object",
      "required": [
        "id",
        "repo",
        "name",
        "branch",
        "base",
        "members",
        "merged",
        "pr",
        "state",
        "conflicts",
        "createdAt",
        "by",
        "autoLand",
        "tries"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "branch": {
          "type": "string",
          "pattern": "^queue/group-[a-z0-9-]+$"
        },
        "members": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 1
        },
        "pr": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ]
        },
        "state": {
          "enum": [
            "building",
            "open",
            "conflict",
            "landing",
            "checks-failed",
            "landed",
            "dissolved"
          ]
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "member",
              "files"
            ]
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "by": {
          "type": "string"
        },
        "base": {
          "type": "string"
        },
        "merged": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "autoLand": {
          "type": "boolean"
        },
        "tries": {
          "type": "integer",
          "minimum": 0
        },
        "fixBuild": {
          "type": "string",
          "description": "the orchestrator build Claude fixes the clash in"
        },
        "why": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "titles": {
          "type": "object"
        }
      }
    },
    "job": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "state",
        "items",
        "startedAt",
        "by"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "update-main",
            "rebase",
            "group",
            "bulk",
            "restore",
            "import"
          ]
        },
        "state": {
          "enum": [
            "queued",
            "running",
            "done",
            "failed",
            "cancelled"
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "target",
              "state"
            ],
            "properties": {
              "target": {
                "type": "string"
              },
              "state": {
                "enum": [
                  "pending",
                  "running",
                  "ok",
                  "failed",
                  "skipped"
                ]
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "startedAt": {
          "type": "string"
        },
        "finishedAt": {
          "type": "string"
        },
        "by": {
          "type": "string"
        }
      }
    },
    "log": {
      "type": "object",
      "required": [
        "id",
        "at",
        "repo",
        "kind",
        "target",
        "actor",
        "outcome",
        "restorable"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "repo": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "merge",
            "merge-failed",
            "retry",
            "update-main",
            "rebase",
            "close",
            "reopen",
            "comment",
            "rerun-checks",
            "ready",
            "label",
            "queue-add",
            "queue-remove",
            "branch-delete",
            "restore",
            "push",
            "pr-open",
            "pr-close",
            "group-create",
            "group-land",
            "group-dissolve",
            "bulk",
            "import"
          ]
        },
        "target": {
          "type": "object",
          "properties": {
            "pr": {
              "type": "integer"
            },
            "branch": {
              "type": "string"
            },
            "sha": {
              "type": "string"
            },
            "group": {
              "type": "string"
            }
          }
        },
        "actor": {
          "type": "object",
          "required": [
            "kind",
            "name"
          ],
          "properties": {
            "kind": {
              "enum": [
                "console",
                "api",
                "claude",
                "queue",
                "import"
              ]
            },
            "name": {
              "type": "string"
            }
          }
        },
        "outcome": {
          "enum": [
            "ok",
            "failed"
          ]
        },
        "why": {
          "type": "string"
        },
        "details": {
          "type": "string"
        },
        "savedSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "restorable": {
          "type": "boolean"
        }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "extraRepos": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pollMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60,
          "default": 2
        },
        "staleDays": {
          "type": "integer",
          "minimum": 1,
          "default": 14
        },
        "mergeMethod": {
          "enum": [
            "queue",
            "squash",
            "merge",
            "rebase"
          ],
          "default": "queue"
        },
        "requireGreenChecks": {
          "type": "boolean",
          "default": true
        },
        "allowNoChecks": {
          "type": "boolean",
          "default": false
        },
        "requireReview": {
          "type": "boolean",
          "default": false
        },
        "doNotMergeLabel": {
          "type": "string",
          "default": "do-not-merge"
        },
        "me": {
          "type": "string",
          "default": ""
        },
        "autoRetry": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "default": 1
        },
        "conflictHelp": {
          "enum": [
            "claude",
            "report"
          ],
          "default": "claude"
        }
      }
    }
  },
  "screens": {
    "github-client": {
      "title": "GitHub client",
      "menu": [
        "builds",
        "plugins"
      ],
      "tabs": [
        "prs",
        "batches",
        "branches",
        "commits",
        "checks",
        "log"
      ],
      "focus": [
        {
          "pattern": "pr [<owner/name>] <n>",
          "opens": "prs tab, row expanded"
        },
        {
          "pattern": "prs all|ready|failing|conflicts|behind|stale|drafts|mine",
          "opens": "prs tab with that filter"
        },
        {
          "pattern": "batches | batch <id>",
          "opens": "batches tab (that batch expanded)"
        },
        {
          "pattern": "branches | branch <name>",
          "opens": "branches tab (that branch expanded)"
        },
        {
          "pattern": "commits [<branch>]",
          "opens": "commits tab on that branch"
        },
        {
          "pattern": "commit <sha>",
          "opens": "dialog github-client.commit"
        },
        {
          "pattern": "checks <ref>",
          "opens": "checks tab for a branch, SHA or pr:<n>"
        },
        {
          "pattern": "log [<query>]",
          "opens": "git log tab with the search filled"
        }
      ],
      "action": "github-client.focus"
    },
    "dialogs": [
      "github-client.batch",
      "github-client.bulk",
      "github-client.commit",
      "github-client.diff"
    ],
    "settings": "plugins/github-client"
  },
  "reads": [
    {
      "route": "GET /prs",
      "id": "prs",
      "title": "Pull requests",
      "description": "Open PRs of a repo with status, checks, commits behind main, conflicts, review, linked build, merge-queue position and readiness (ready + why not). filter: all|ready|failing|conflicts|behind|stale|drafts|mine; sort: updated|oldest|number|behind; q searches number, title, branch, author, build. Voice: \"what's ready to merge\" (filter ready), \"which PRs are failing\", \"PRs behind main\". Each item carries repo (owner/name) for the other commands.",
      "input": {
        "type": "object",
        "properties": {
          "repo": {
            "type": "string"
          },
          "filter": {
            "enum": [
              "all",
              "ready",
              "failing",
              "conflicts",
              "behind",
              "stale",
              "drafts",
              "mine"
            ]
          },
          "sort": {
            "enum": [
              "updated",
              "oldest",
              "number",
              "behind"
            ]
          },
          "q": {
            "type": "string"
          },
          "refresh": {
            "type": "boolean"
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "route": "POST /bulk/preview",
      "id": "bulk-preview",
      "title": "Preview a bulk action",
      "description": "Which PRs a bulk action would take and which it skips (and why), without doing anything."
    },
    {
      "route": "GET /repos",
      "id": "repos",
      "title": "Repos of this project",
      "description": "The console's repo, the project's manifest repos, the merge queue's repo and the extra repos setting."
    },
    {
      "route": "GET /pr/{owner}/{name}/{n}",
      "id": "pr",
      "title": "One pull request",
      "description": "One PR read fresh: status, checks, behind/ahead, conflicts, review, linked build, queue position, ready and why not."
    },
    {
      "route": "GET /pr/{owner}/{name}/{n}/checks",
      "id": "pr-checks",
      "title": "Checks of a pull request"
    },
    {
      "route": "GET /pr/{owner}/{name}/{n}/commits",
      "id": "pr-commits",
      "title": "Commits of a pull request"
    },
    {
      "route": "GET /pr/{owner}/{name}/{n}/files",
      "id": "pr-files",
      "title": "Files of a pull request",
      "description": "Changed files with patches."
    },
    {
      "route": "GET /checks",
      "id": "checks",
      "title": "Checks for a ref",
      "description": "Check runs and statuses for a branch, a SHA or pr:<n>."
    },
    {
      "route": "GET /status",
      "id": "status",
      "title": "GitHub client status",
      "description": "Token set or not (never the token), rate limit left, last poll, last error, merge queue on/off, running jobs, last failure."
    },
    {
      "route": "GET /config",
      "id": "config",
      "title": "Settings"
    },
    {
      "route": "GET /jobs",
      "id": "jobs",
      "title": "Jobs",
      "description": "Recent long actions (pull main in, rebase, batch, bulk) with a result per PR."
    },
    {
      "route": "GET /job/{jid}",
      "id": "job",
      "title": "One job"
    },
    {
      "route": "GET /groups",
      "id": "groups",
      "title": "Batches",
      "description": "Batch merges: state, members, the batch PR, clashes and who is fixing them."
    },
    {
      "route": "GET /group/{gid}",
      "id": "group",
      "title": "One batch"
    },
    {
      "route": "GET /branches",
      "id": "branches",
      "title": "Branches",
      "description": "Every branch with ahead/behind main, last commit, PR, protected and default flags."
    },
    {
      "route": "GET /branch/{owner}/{name}/{branch:path}",
      "id": "branch",
      "title": "One branch"
    },
    {
      "route": "GET /commits",
      "id": "commits",
      "title": "Commits",
      "description": "Commits on a branch, newest first, 50 a page."
    },
    {
      "route": "GET /commit/{owner}/{name}/{sha}",
      "id": "commit",
      "title": "One commit",
      "description": "A commit with its files and patches."
    },
    {
      "route": "GET /diff",
      "id": "diff",
      "title": "Compare two refs",
      "description": "Commits and files with patches between base and head."
    },
    {
      "route": "GET /log",
      "id": "log",
      "title": "Git log",
      "description": "Every git action, newest first: merges, failed merges and why, retries, branch deletes (saved SHA, restorable), pushes, main pulled in, PRs opened/closed, batches, bulk runs. q searches; kind, repo, since (ISO or today), outcome (ok|failed), page. Voice: \"show the git log for today\" (since today), \"what failed to merge\" (outcome failed, kind merge-failed)."
    },
    {
      "route": "GET /events",
      "skip": "server-sent events stream, not a command"
    }
  ],
  "commands": [
    {
      "route": "POST /pr/{owner}/{name}/{n}/merge",
      "id": "merge",
      "title": "Merge a pull request",
      "description": "Merge queue on for the repo: adds it to the queue (it lands with the next green batch). Off: GitHub merges it with the policy's method. Refused unless ready. Brett's: a Claude session gets 403. Voice: \"merge PR 123\" (owner/name from prs → repo).",
      "input": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "description": "repo owner (MossesX)"
          },
          "name": {
            "type": "string",
            "description": "repo name (AmberX-AXF)"
          },
          "n": {
            "type": "integer",
            "description": "PR number"
          },
          "method": {
            "enum": [
              "queue",
              "squash",
              "merge",
              "rebase"
            ]
          },
          "why": {
            "type": "string"
          },
          "by": {
            "type": "string",
            "description": "who asks (a Claude session is refused merge, pull main in, rebase, land and bulk)"
          }
        },
        "required": [
          "owner",
          "name",
          "n"
        ],
        "additionalProperties": false
      },
      "deniedTo": [
        "claude"
      ]
    },
    {
      "route": "POST /pr/{owner}/{name}/{n}/update-main",
      "id": "update-main",
      "title": "Pull main into a pull request",
      "description": "GitHub update-branch; when GitHub can't (a conflict) a job merges main in a scratch clone, heals builds files and reports any other conflict. Brett's: a Claude session gets 403. Voice: \"pull main into 123\", \"update 123 from main\".",
      "input": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "description": "repo owner (MossesX)"
          },
          "name": {
            "type": "string",
            "description": "repo name (AmberX-AXF)"
          },
          "n": {
            "type": "integer",
            "description": "PR number"
          },
          "by": {
            "type": "string",
            "description": "who asks (a Claude session is refused merge, pull main in, rebase, land and bulk)"
          }
        },
        "required": [
          "owner",
          "name",
          "n"
        ],
        "additionalProperties": false
      },
      "deniedTo": [
        "claude"
      ],
      "job": true
    },
    {
      "route": "POST /pr/{owner}/{name}/{n}/rebase",
      "id": "rebase",
      "title": "Rebase a pull request onto its base",
      "description": "A job: rebase in a scratch clone, force-push with lease to the PR's own branch; the old head SHA is saved in the git log.",
      "input": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "description": "repo owner (MossesX)"
          },
