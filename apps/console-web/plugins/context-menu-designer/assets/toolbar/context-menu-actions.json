{
  "$axf": "asset@1",
  "type": "toolbar",
  "id": "context-menu-actions",
  "name": "Context menu actions",
  "version": "1.0.0",
  "description": "The Actions window toolbar of the context menu designer: open the action filter (its badge counts the filter choices changed from the defaults). The action search rides on the same bar.",
  "author": "AmberX AXF",
  "tags": ["page", "context-menu-designer", "actions"],
  "data": {
    "scope": "view:context-menu-actions",
    "variant": "icons-labels",
    "align": "start",
    "showSearch": false,
    "overflow": { "when": "never", "keep": 1, "label": "More" },
    "groups": [
      {
        "id": "actions",
        "label": "Actions",
        "items": [
          { "id": "filter", "icon": "sliders", "label": "Filter", "action": "handler:context-menu-actions.filter", "badge": "state:changed", "checked": "state:filtered", "priority": 300, "overflow": "never" }
        ]
      }
    ]
  }
}
