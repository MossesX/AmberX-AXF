{
  "$axf": "plugin@1",
  "id": "ai.amberx.axf.console.alerts-bell",
  "name": "Alerts bell",
  "version": "0.1.0",
  "kind": "module",
  "apiLevel": 1,
  "author": "Brett",
  "description": "The developer alerts bell on the banner (it used to sit on the toolbar): a bell button that opens the Alerts view and, next to it, the number of unread alerts (hidden at zero, 99+ past 99). Built from the framework's action-button and counter widgets; the alerts library (Alerts view, Settings \u2192 Alerts, delivery) stays in the framework. Show/hide and side in its settings. Notification history (s9): view alerts-history, every alert delivered to each device with delivered / read / tapped times from GET /api/alerts/history; deep link alerts-history.focus:<alert id | device:<name>>.",
  "targets": [
    "axf-console"
  ],
  "provides": [
    "asset:action-button/alerts-bell",
    "asset:counter/alerts-bell",
    "banner:right",
    "settings-tab:alerts-bell",
    "view:alerts-history",
    "action:alerts-history.focus",
    "action:alerts-history.open"
  ],
  "optional": [],
  "scopes": [
    "ROUTES"
  ],
  "enabledByDefault": true,
  "commands": {
    "$axf": "plugin-commands@1",
    "auto": true,
    "items": [
      {
        "route": "GET /feed",
        "id": "feed",
        "title": "The console's alerts (the phone's view when a device is named), unread count and version",
        "readOnly": true,
        "input": {
          "type": "object",
          "properties": {
            "device": {
              "type": "string"
            },
            "since": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        }
      },
      {
        "route": "GET /history",
        "id": "history",
        "title": "Every alert delivered to a device, with delivered / read / tapped times",
        "readOnly": true,
        "input": {
          "type": "object",
          "properties": {
            "device": {
              "type": "string"
            },
            "since": {
              "type": "string"
            },
            "limit": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        }
      },
      {
        "route": "POST /raise",
        "id": "raise",
        "title": "Raise (or refresh, same key) an alert; the console pushes it to the phone and the browsers",
        "input": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string"
            },
            "severity": {
              "type": "string",
              "enum": [
                "info",
                "success",
                "warning",
                "error",
                "critical"
              ]
            },
            "title": {
              "type": "string"
            },
            "body": {
              "type": "string"
            },
            "key": {
              "type": "string"
            },
            "link": {
              "type": "string"
            }
          },
          "required": [
            "title"
          ],
          "additionalProperties": false
        }
      },
      {
        "route": "POST /read",
        "id": "read",
        "title": "Mark alerts read (ids, or all)",
        "input": {
          "type": "object",
          "properties": {
            "ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "all": {
              "type": "boolean"
            },
            "device": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      {
        "route": "POST /dismiss",
        "id": "dismiss",
        "title": "Dismiss alerts",
        "input": {
          "type": "object",
          "properties": {
            "ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "ids"
          ],
          "additionalProperties": false
        }
      },
      {
        "route": "POST /resolve",
        "id": "resolve",
        "title": "Resolve alerts by key",
        "input": {
          "type": "object",
          "properties": {
            "keys": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "keys"
          ],
          "additionalProperties": false
        }
      },
      {
        "route": "POST /tapped",
        "skip": "a device reporting a tap"
      }
    ]
  },
  "builtWith": {
    "model": "opus",
    "builtAt": "2026-10-21"
  },
  "banner": false,
  "tabable": false,
  "lifecycle": {
    "$axf": "plugin-lifecycle@1",
    "dataDir": ".axf-console/plugins/alerts-bell",
    "env": [],
    "mentions": [
      "docs/contracts/amberx-console-api.md",
      "CLAUDE.md",
      "_claude/memory/STATUS.md",
      "apps/console-web/plugins/README.md"
    ]
  },
  "opens": false
}
