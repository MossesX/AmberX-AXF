{
  "$axf": "asset@1",
  "type": "toolbar",
  "id": "default-plugin-manager-toolbar",
  "name": "Plugin Manager",
  "version": "1.0.0",
  "description": "The Plugin Manager toolbar for the selected plugin: enable or disable it, open its settings, view its logs, show its dependencies, check clashes, and install, uninstall, update or replace it (the Install tab, where removing asks for the typed confirm). Every button runs the plugin-inventory@1 actions the detail pane uses.",
  "author": "AmberX AXF",
  "tags": [
    "default",
    "toolbar-owner@1",
    "page",
    "plugin-manager",
    "plugins"
  ],
  "data": {
    "scope": "view:plugin-manager",
    "variant": "icons-labels",
    "align": "start",
    "showSearch": false,
    "overflow": {
      "when": "auto",
      "keep": 2,
      "label": "More"
    },
    "groups": [
      {
        "id": "plugin",
        "label": "Selected plugin",
        "items": [
          {
            "id": "toggle",
            "icon": "play",
            "label": "Enable/Disable",
            "action": "handler:plugin-manager.toggle",
            "checked": "state:selection.enabled",
            "enabledWhen": [
              "selection.id",
              "!selection.removed"
            ],
            "priority": 300,
            "overflow": "never"
          },
          {
            "id": "settings",
            "icon": "settings",
            "label": "Open settings",
            "action": "handler:plugin-manager.settings",
            "enabledWhen": [
              "selection.hasSettings",
              "selection.enabled"
            ],
            "priority": 260
          },
          {
            "id": "logs",
            "icon": "terminal",
            "label": "View logs",
            "action": "handler:plugin-manager.logs",
            "badge": "state:selection.logCount",
            "enabledWhen": "selection.id",
            "priority": 240
          },
          {
            "id": "deps",
            "icon": "branch",
            "label": "Show dependencies",
            "action": "handler:plugin-manager.deps",
            "badge": "state:selection.blocking",
            "enabledWhen": "selection.id",
            "priority": 220
          }
        ]
      },
      {
        "id": "health",
        "label": "Health",
        "items": [
          {
            "id": "clashes",
            "icon": "alert",
            "label": "Check clashes",
            "action": "handler:plugin-manager.clashes",
            "badge": "state:clashes",
            "priority": 200
          }
        ]
      },
      {
        "id": "install",
        "label": "Install",
        "items": [
          {
            "id": "install",
            "icon": "package",
            "label": "Install/Uninstall",
            "action": "handler:plugin-manager.install",
            "priority": 160
          },
          {
            "id": "update",
            "icon": "download",
            "label": "Update/Replace",
            "action": "handler:plugin-manager.update",
            "badge": "state:selection.replacedBy",
            "enabledWhen": "selection.id",
            "priority": 140
          }
        ]
      }
    ],
    "builtFor": "plugin:plugin-manager"
  }
}
