{
  "$axf": "orchestrator-demo-voice@1",
  "description": "AmberX voice phrases for the Orchestrator demo, registered through the page's AmberX voice registry (globalThis.amberxVoice). Each runs the console action of the same id. 'next' and 'pause' only act while a demo run is live.",
  "owner": "Orchestrator demo",
  "commands": [
    { "id": "demo.start", "action": "demo.start", "phrases": ["start the orchestrator demo", "run the orchestrator demo", "start the demo", "show me the orchestrator demo"] },
    { "id": "demo.start-paused", "action": "demo.start:pause", "phrases": ["start the orchestrator demo with pauses", "start the demo step by step"] },
    { "id": "demo.next", "action": "demo.next", "phrases": ["next", "next act", "next step", "go on"] },
    { "id": "demo.pause", "action": "demo.pause", "phrases": ["pause the demo", "pause the orchestrator demo", "hold the demo"] },
    { "id": "demo.resume", "action": "demo.resume", "phrases": ["resume the demo", "continue the demo", "unpause the demo"] },
    { "id": "demo.stop", "action": "demo.stop", "phrases": ["stop the demo", "stop the orchestrator demo", "end the demo"] },
    { "id": "demo.state", "action": "demo.state", "phrases": ["where is the demo", "demo status", "how is the demo going"] },
    { "id": "demo.selftest", "action": "demo.selftest", "phrases": ["run the demo self-test", "run the lander self-test", "test the lander", "self-test the demo"] }
  ]
}
