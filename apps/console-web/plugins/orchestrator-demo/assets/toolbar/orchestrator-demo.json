{
  "$axf": "asset@1",
  "type": "toolbar",
  "id": "orchestrator-demo",
  "name": "Orchestrator demo",
  "version": "1.0.0",
  "description": "The Orchestrator demo toolbar: open the start overlay, see the summary, and drive a running demo (Next, Pause, Resume, Skip, Stop). Every button is the plugin's own REST command (plugin-commands@1), the same ones the caption bar, MCP, the CLI and voice use.",
  "author": "AmberX AXF",
  "tags": [
    "page",
    "orchestrator-demo"
  ],
  "data": {
    "scope": "view:orchestrator-demo",
    "variant": "icons-labels",
    "align": "start",
    "showSearch": false,
    "overflow": {
      "when": "auto",
      "keep": 2,
      "label": "More"
    },
    "groups": [
      {
        "id": "run",
        "label": "Demo",
        "items": [
          {
            "id": "start",
            "icon": "play",
            "label": "Start the demo",
            "action": "action:orchestrator-demo.open",
            "priority": 300,
            "overflow": "never"
          },
          {
            "id": "summary",
            "icon": "list",
            "label": "Summary",
            "action": "action:orchestrator-demo.summary",
            "priority": 260
          }
        ]
      },
      {
        "id": "live",
        "label": "While it runs",
        "items": [
          {
            "id": "next",
            "icon": "chevron-right",
            "label": "Next",
            "action": "command:orchestrator-demo/next",
            "priority": 240
          },
          {
            "id": "pause",
            "icon": "pause",
            "label": "Pause",
            "action": "command:orchestrator-demo/pause",
            "priority": 220
          },
          {
            "id": "resume",
            "icon": "play",
            "label": "Resume",
            "action": "command:orchestrator-demo/resume",
            "priority": 200
          },
          {
            "id": "skip",
            "icon": "arrow-right",
            "label": "Skip",
            "action": "command:orchestrator-demo/skip",
            "priority": 180
          },
          {
            "id": "stop",
            "icon": "x-circle",
            "label": "Stop",
            "action": "command:orchestrator-demo/stop",
            "confirm": "Stop the demo and remove its demo builds?",
            "priority": 160
          }
        ]
      }
    ],
    "builtFor": "view:orchestrator-demo"
  }
}
