{
  "$axf": "plugin@1",
  "id": "ai.amberx.axf.console.data-store",
  "name": "Data store",
  "version": "0.1.0",
  "kind": "module",
  "apiLevel": 1,
  "author": "Brett",
  "description": "axf-data holds all console data: the mode of each namespace (local, shadow, cutover, rollback), counts, backups, the drift log, and Backup now / Verify / Shadow / Cut over / Roll back. Brett, Nov 15 2026: \"the console goes down, all the data is still available, all the notes are available, and the builds keep running.\"",
  "targets": [
    "axf-console"
  ],
  "provides": [
    "settings-tab:data-store"
  ],
  "scopes": [
    "ROUTES"
  ],
  "enabledByDefault": true,
  "optional": [],
  "banner": false,
  "tabable": false,
  "lifecycle": {
    "$axf": "plugin-lifecycle@1",
    "dataDir": ".axf-console/plugins/data-store",
    "env": [
      "AXF_DATA_URL",
      "AXF_DATA_TOKEN"
    ],
    "mentions": [
      "CLAUDE.md",
      "_claude/memory/STATUS.md",
      "_claude/memory/decisions.md",
      "apps/console-web/plugins/README.md"
    ]
  },
  "commands": {
    "$axf": "plugin-commands@1",
    "auto": true
  },
  "tokens": {
    "$axf": "token-registry@1",
    "uses": [],
    "defines": []
  },
  "builtWith": {
    "model": "Opus",
    "builtAt": "2026-11-15"
  },
  "help": "help.json",
  "opens": false
}
