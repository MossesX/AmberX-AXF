{
  "$axf": "asset@1",
  "type": "toolbar",
  "id": "data-store",
  "name": "Data store",
  "version": "1.0.0",
  "description": "The Data store toolbar: back up the store now, verify the latest backup, and sync the tables from their source. Runs the data-store plugin's own commands.",
  "author": "AmberX AXF",
  "tags": ["page", "data-store", "backups"],
  "data": {
    "scope": "view:data-store",
    "variant": "icons-labels",
    "align": "start",
    "showSearch": false,
    "overflow": { "when": "auto", "keep": 1, "label": "More" },
    "groups": [
      {
        "id": "store",
        "label": "Store",
        "items": [
          { "id": "backup", "icon": "save", "label": "Back up now", "action": "command:data-store/backup", "priority": 300, "overflow": "never" },
          { "id": "verify", "icon": "check-circle", "label": "Verify backup", "action": "command:data-store/verify", "priority": 250 },
          { "id": "sync", "icon": "refresh", "label": "Sync tables", "action": "command:data-store/sync-tables", "confirm": "Sync every table from its source now?", "priority": 200 }
        ]
      }
    ]
  }
}
