{
  "$axf": "plugin@1",
  "id": "ai.amberx.axf.console.gate",
  "name": "Gate & rules",
  "version": "0.1.0",
  "kind": "module",
  "apiLevel": 1,
  "author": "Brett",
  "description": "The gate a PR must pass before it lands, and the auto-lander that lands it, in one place (gate-rules@1, framework/spec/GATE.md). Rules tab: every gate rule (CI green, tests, theme, controls, toolbars, UI Review, code clash, merge-queue policy) with its on/off switch, severity and settings, Reset to defaults and Check a PR. Auto-lander tab: one mode switch Merge queue on/off (on = PRs go through the stacked merge queue; off, the default = the auto-lander lands each finished build one at a time), status, waiting PRs with the rule that holds each one and why, last runs, Land now, Pause and Resume. History tab: every rule change and lander action (who, when, before/after). The same calls through REST (/api/plugins/gate), MCP (gate_* and lander_*), the CLI (axf gate \u2026) and voice. Rules and history live in the plugin's data folder; the lander settings are mirrored into the merge-queue provider's config so one switch is the switch the lander obeys. Two adapters (gate-store.mjs, lander.mjs) are the only files a later axf-molly backend replaces.",
  "targets": [
    "axf-console"
  ],
  "provides": [
    "view:gate",
    "settings-tab:gate",
    "service:axf.gate@1"
  ],
  "optional": [
    "service:axf.merge-queue@1",
    "service:axf.health@1",
    "service:axf.alerts@1"
  ],
  "scopes": [
    "ROUTES"
  ],
  "enabledByDefault": true,
  "banner": false,
  "tabable": true,
  "uiEditor": [],
  "lifecycle": {
    "$axf": "plugin-lifecycle@1",
    "dataDir": ".axf-console/plugins/gate",
    "env": [
      "AXF_GATE_DIR",
      "AXF_GATE_LANDER_DIR",
      "AXF_GATE_LANDER_CLI"
    ],
    "mentions": [
      "apps/console-web/plugins/README.md",
      "framework/spec/GATE.md"
    ]
  },
  "commands": {
    "$axf": "plugin-commands@1",
    "auto": true,
    "items": [
      {
        "id": "rules-list",
        "route": "GET /rules",
        "title": "Gate rules: list",
        "readOnly": true
      },
      {
        "id": "rules-get",
        "route": "GET /rules/{rule_id}",
        "title": "Gate rules: one rule",
        "readOnly": true
      },
      {
        "id": "rules-set",
        "route": "PUT /rules/{rule_id}",
        "title": "Gate rules: change a rule"
      },
      {
        "id": "rules-toggle",
        "route": "POST /rules/{rule_id}/toggle",
        "title": "Gate rules: switch a rule on or off"
      },
      {
        "id": "rules-reset",
        "route": "POST /rules/reset",
        "title": "Gate rules: reset to defaults (confirm)"
      },
      {
        "id": "check-pr",
        "route": "GET /check",
        "title": "Gate: can this PR land?",
        "readOnly": true
      },
      {
        "id": "history",
        "route": "GET /history",
        "title": "Gate: history",
        "readOnly": true
      },
      {
        "id": "lander-status",
        "route": "GET /lander",
        "title": "Auto-lander: status",
        "readOnly": true
      },
      {
        "id": "lander-waiting",
        "route": "GET /lander/waiting",
        "title": "Auto-lander: waiting PRs",
        "readOnly": true
      },
      {
        "id": "lander-runs",
        "route": "GET /lander/runs",
        "title": "Auto-lander: last runs",
        "readOnly": true
      },
      {
        "id": "lander-mode",
        "route": "GET /lander/mode",
        "title": "Auto-lander: Merge queue switch",
        "readOnly": true
      },
      {
        "id": "lander-mode-set",
        "route": "POST /lander/mode",
        "title": "Auto-lander: flip the Merge queue switch"
      },
      {
        "id": "lander-land-now",
        "route": "POST /lander/land-now",
        "title": "Auto-lander: land a PR next (confirm)"
      },
      {
        "id": "lander-pause",
        "route": "POST /lander/pause",
        "title": "Auto-lander: pause"
      },
      {
        "id": "lander-resume",
        "route": "POST /lander/resume",
        "title": "Auto-lander: resume"
      },
      {
        "id": "settings",
        "route": "GET /settings",
        "title": "Gate: plugin settings",
        "readOnly": true
      },
      {
        "id": "settings-set",
        "route": "PUT /settings",
        "title": "Gate: change plugin settings"
      }
    ]
  },
  "cli": {
    "gate": "gate.mjs"
  },
  "tokens": {
    "$axf": "token-registry@1",
    "uses": [],
    "defines": []
  },
  "builtWith": {
    "model": "opus",
    "builtAt": "2026-11-15"
  },
  "help": "help.json",
  "opens": "main"
}
