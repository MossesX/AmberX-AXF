{
  "$axf": "voice-intents@1",
  "plugin": "inline-edit",
  "description": "What Brett can say to reach Inline edit by voice. AmberX (voice-command@1, Developer tab, group 'Inline edit' in apps/amberx-droid/src/plugins/commands/web/lib-developer.ts) hands each one to Gizmo, which runs the named plugin command through the console's MCP (inline-edit_<command>) or opens the screen with the console tool. The same commands answer REST /api/control/inline-edit/<command> and `axf inline-edit <command>`, so voice does exactly what the other surfaces do. test.mjs checks every intent names a real command and has its AmberX twin.",
  "intents": [
    { "id": "inline-mode", "phrases": ["inline edit {state}", "turn {state} inline edit", "inline edit mode {state}"], "slots": { "state": ["on", "off", "toggle", "status"] }, "command": "mode", "input": { "state": "{state}" } },
    { "id": "inline-status", "phrases": ["is inline edit on", "inline edit status"], "command": "mode-status", "input": {} },
    { "id": "inline-tokens", "phrases": ["tokens of {text}", "what tokens does {text} have"], "command": "tokens", "input": { "path": "{text}" } },
    { "id": "inline-set", "phrases": ["set {token} of {text} to {value}"], "command": "set", "input": { "path": "{text}", "token": "{token}", "value": "{value}" } },
    { "id": "inline-unset", "phrases": ["revert {token} of {text} to axhub"], "command": "unset", "input": { "path": "{text}", "token": "{token}" } },
    { "id": "inline-open", "phrases": ["edit element {text}", "open inline edit for {text}"], "command": "open-element", "input": { "args": "path={text}" } },
    { "id": "inline-view", "phrases": ["inline edit view {view}", "show the edit dialog as {view}"], "slots": { "view": ["tree", "classic", "grid"] }, "command": "element-set", "input": { "view": "{view}" } },
    { "id": "inline-overrides", "phrases": ["show overrides", "open the overrides list", "what did i change"], "command": "open-overrides", "input": {} },
    { "id": "inline-list", "phrases": ["read the overrides", "how many overrides"], "command": "overrides-list", "input": {} },
    { "id": "inline-search", "phrases": ["search overrides for {text}", "filter overrides {text}"], "command": "overrides-state", "input": { "q": "{text}" } },
    { "id": "inline-tab", "phrases": ["add overrides tab for {text}"], "command": "tab-add", "input": { "root": "{text}" } },
    { "id": "inline-reset", "phrases": ["reset {text} to axhub", "undo override {text}"], "command": "overrides-reset", "input": { "id": "{text}" }, "confirm": true }
  ]
}
