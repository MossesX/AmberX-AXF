{
  "$axf": "plugin@1",
  "id": "ai.amberx.axf.console.inline-edit",
  "name": "Inline edit",
  "version": "0.1.0",
  "kind": "module",
  "apiLevel": 1,
  "author": "Brett",
  "description": "Right-click any element, down to the child (app menus and every sub-menu row, navigation menus, toolbars, banners, widgets, tabs, dialogs), and edit every token it has in a dialog: tree, classic tree or a grid with expandable rows, colour / size / font / text editors with live preview, each token showing the value it inherits from axHub, a note that a change overrides that inheritance, this item or a chosen parent as the scope, and Revert to axHub per token. The master switch 'Inline edit mode' sits in Settings → Appearance. The overrides list is every value changed from axHub's inheritance: a tree with selectable roots, full-text search, filters (app, element type, token kind, scope, changed by, date), a multi-tab column with a root per tab (kept per user) and Reset to axHub per item. Everything also through REST, MCP, the CLI (axf inline-edit …) and AmberX voice.",
  "targets": [
    "axf-console"
  ],
  "provides": [
    "view:inline-edit-overrides",
    "dialog:inline-edit-element",
    "settings-tab:inline-edit"
  ],
  "scopes": [
    "ROUTES"
  ],
  "enabledByDefault": true,
  "optional": [],
  "banner": false,
  "tabable": {
    "view": "inline-edit-overrides",
    "label": "Overrides",
    "icon": "layers"
  },
  "uiEditor": [
    "style"
  ],
  "lifecycle": {
    "$axf": "plugin-lifecycle@1",
    "dataDir": ".axf-console/plugins/inline-edit",
    "env": [
      "AXF_APPEARANCE_FILE",
      "AXF_INLINE_EDIT_DATA_DIR"
    ],
    "mentions": [
      "apps/console-web/plugins/README.md",
      "apps/amberx-droid/src/plugins/commands/web/lib-developer.ts",
      "_claude/THREADS.md",
      ".github/workflows/android.yml"
    ]
  },
  "commands": {
    "$axf": "plugin-commands@1",
    "auto": true,
    "items": [
      {
        "route": "GET /mode",
        "id": "mode-status",
        "title": "Inline edit mode: is it on?",
        "readOnly": true,
        "input": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      },
      {
        "route": "PUT /mode",
        "id": "mode",
        "title": "Inline edit mode on, off or toggle (status reads it)",
        "description": "The master switch in Settings → Appearance. On: right-click any element in the console to edit its tokens. Every open console follows within seconds.",
        "input": {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "on",
                "off",
                "toggle",
                "status"
              ]
            }
          },
          "required": [
            "state"
          ],
          "additionalProperties": false
        }
      },
      {
        "route": "GET /tokens",
        "id": "tokens",
        "title": "Every token of an element and its parents",
        "readOnly": true,
        "description": "For an element path (inline-edit-tokens@1, e.g. toolbar:app/group:edit/item:undo): each token's value, the value it inherits from axHub and where that comes from (theme, skin, custom, inline).",
        "input": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "scope": {
              "type": "string",
              "enum": [
                "item",
                "parent"
              ]
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        }
      },
      {
        "route": "PUT /tokens",
        "id": "set",
        "title": "Set a token on an element (overrides axHub)",
        "description": "One inline-override@1 record. scope item = this element only; parent = this element and everything under it (send the parent's path).",
        "input": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "token": {
              "type": "string"
            },
            "value": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            },
            "scope": {
              "type": "string",
              "enum": [
                "item",
                "parent"
              ]
            },
            "reason": {
              "type": "string"
            },
            "app": {
              "type": "string"
            }
          },
          "required": [
            "path",
            "token",
            "value"
          ],
          "additionalProperties": false
        }
      },
      {
        "route": "POST /tokens/unset",
        "id": "unset",
        "title": "Revert one token to axHub",
        "description": "Removes exactly that override; nothing else re-inherits.",
        "input": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "token": {
              "type": "string"
            },
            "scope": {
              "type": "string",
              "enum": [
                "item",
                "parent"
              ]
            }
          },
          "required": [
            "path",
            "token"
          ],
          "additionalProperties": false
        }
      },
      {
        "route": "GET /element",
        "id": "element",
        "title": "The edit dialog's state (path, scope, view)",
        "readOnly": true,
        "input": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      },
      {
        "route": "PUT /element",
        "id": "element-set",
        "title": "Point the edit dialog at an element, a scope or a view",
        "description": "view: tree | classic | grid. An open dialog follows within seconds.",
        "input": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "scope": {
              "type": "string",
              "enum": [
                "item",
                "parent"
              ]
            },
            "view": {
              "type": "string",
              "enum": [
                "tree",
                "classic",
                "grid"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      {
        "route": "GET /overrides",
        "id": "overrides-list",
        "title": "Every value changed from axHub's inheritance",
        "readOnly": true,
        "description": "The overrides list: items, the tree, the roots a tab can take, the tabs and filter facets. Filters: app, kind (element type), role, tokenKind, group, token, scope, by, since, until.",
        "input": {
          "type": "object",
          "properties": {
            "root": {
              "type": "string"
            },
            "q": {
              "type": "string"
            },
            "filter": {
              "type": [
                "object",
                "string"
              ]
            },
            "tab": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      {
        "route": "PUT /overrides/state",
        "id": "overrides-state",
        "title": "Search, filter, select a root or a tab in the overrides list",
        "input": {
          "type": "object",
          "properties": {
            "q": {
              "type": "string"
            },
            "filter": {
              "type": [
                "object",
                "string"
              ]
            },
            "root": {
              "type": "string"
            },
            "tab": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      {
        "route": "POST /overrides/tabs",
        "id": "tab-add",
        "title": "Add a tab to the overrides list with its own root",
        "input": {
          "type": "object",
          "properties": {
            "root": {
              "type": "string"
            },
            "label": {
              "type": "string"
            }
          },
          "required": [
            "root"
          ],
          "additionalProperties": false
        }
      },
      {
        "route": "POST /overrides/tabs/close",
        "id": "tab-remove",
        "title": "Close (remove) a tab of the overrides list",
        "input": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        }
      },
      {
        "route": "POST /overrides/reset",
        "id": "overrides-reset",
        "title": "Reset one item to axHub",
        "description": "Restores only that override (the record id from overrides-list); everything else stays as it is.",
        "input": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        }
      },
      {
        "action": "inline-edit.mode.toggle",
        "id": "action-mode-toggle",
        "title": "Flip Inline edit mode in the open console",
        "navigate": false
      },
      {
        "action": "inline-edit.element",
        "id": "open-element",
        "title": "Open the edit dialog in the open console (deep link)",
        "navigate": true,
        "description": "args: \"path=<element path>&scope=item|parent&view=tree|classic|grid\" (or just the path)."
      },
      {
        "action": "inline-edit.overrides",
        "id": "open-overrides",
        "title": "Open the overrides list in the open console (deep link)",
        "navigate": true,
        "description": "args: \"root=<path>&q=<words>&filter=<json>&tab=<id>\" (all optional)."
      },
      {
        "action": "inline-edit.settings",
        "id": "open-settings",
        "title": "Open Settings → Plugins → Inline edit in the open console",
        "navigate": true
      }
    ]
  },
  "builtWith": {
    "model": "opus",
    "builtAt": "2026-11-10"
  },
  "help": "help.json",
  "opens": "main"
}
