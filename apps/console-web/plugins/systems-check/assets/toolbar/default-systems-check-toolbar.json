{
  "$axf": "asset@1",
  "type": "toolbar",
  "id": "default-systems-check-toolbar",
  "name": "Systems check",
  "version": "1.0.0",
  "description": "The Systems check toolbar: run every check again, Auto fix all, mute the banner until it is unmuted, and open the source of the open check (the plugin that registered it). Every button runs the systems check's own actions (health@1, the autofix routes).",
  "author": "AmberX AXF",
  "tags": [
    "default",
    "toolbar-owner@1",
    "page",
    "systems-check",
    "health"
  ],
  "data": {
    "scope": "view:systems-check",
    "variant": "icons-labels",
    "align": "start",
    "showSearch": false,
    "overflow": {
      "when": "auto",
      "keep": 2,
      "label": "More"
    },
    "groups": [
      {
        "id": "checks",
        "label": "Checks",
        "items": [
          {
            "id": "run",
            "icon": "refresh",
            "label": "Run checks",
            "action": "handler:systems-check.run",
            "enabledWhen": "!busy",
            "priority": 300,
            "overflow": "never"
          },
          {
            "id": "fix-all",
            "icon": "zap",
            "label": "Auto fix all",
            "action": "handler:systems-check.fix-all",
            "badge": "state:issues",
            "enabledWhen": [
              "issues>0",
              "!busy"
            ],
            "confirm": "Run every Auto fix now?",
            "priority": 280,
            "overflow": "never"
          },
          {
            "id": "mute",
            "icon": "bell",
            "label": "Mute",
            "action": "handler:systems-check.mute",
            "checked": "state:muted",
            "priority": 200
          },
          {
            "id": "source",
            "icon": "code",
            "label": "Open source",
            "action": "handler:systems-check.source",
            "enabledWhen": "selection.owner",
            "priority": 160
          }
        ]
      }
    ],
    "builtFor": "plugin:systems-check"
  }
}
