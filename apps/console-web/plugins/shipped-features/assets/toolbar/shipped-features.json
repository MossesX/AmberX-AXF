{
  "$axf": "asset@1",
  "type": "toolbar",
  "id": "shipped-features",
  "name": "Shipped features",
  "version": "1.0.0",
  "description": "The Shipped features toolbar: sync the list from the builds, import shipped manifests, and backfill what merged without one (a dry run first). Runs the shipped-features plugin's own commands.",
  "author": "AmberX AXF",
  "tags": ["page", "shipped-features"],
  "data": {
    "scope": "view:shipped-features",
    "variant": "icons-labels",
    "align": "start",
    "showSearch": false,
    "overflow": { "when": "auto", "keep": 1, "label": "More" },
    "groups": [
      {
        "id": "list",
        "label": "List",
        "items": [
          { "id": "sync", "icon": "refresh", "label": "Sync", "action": "command:shipped-features/sync", "priority": 300, "overflow": "never" },
          { "id": "import", "icon": "download", "label": "Import manifests", "action": "command:shipped-features/import", "priority": 250 },
          { "id": "backfill", "icon": "clock", "label": "Backfill (dry run)", "action": "command:shipped-features/backfill", "args": { "dry": true }, "priority": 200 }
        ]
      }
    ]
  }
}
