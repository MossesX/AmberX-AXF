{
  "$axf": "plugin@1",
  "id": "ai.amberx.axf.console.build-search",
  "name": "Build search",
  "version": "0.1.0",
  "kind": "module",
  "apiLevel": 1,
  "author": "Brett",
  "description": "Search every build, build note, build report, session log and session message (plus folders you add) in one box. Every hit is listed with an icon by type and numbered per session (instance 1, 2, 3…); tapping one opens that session's log scrolled to the spot and highlighted. Typed commands (>add source, >add action, >ai off) add sources and actions. Zero model calls: the AI switch is off by default and nothing uses AI unless it is turned on.",
  "targets": [
    "axf-console"
  ],
  "provides": [
    "view:build-search",
    "settings-tab:build-search"
  ],
  "scopes": [
    "ROUTES"
  ],
  "enabledByDefault": true,
  "optional": [],
  "banner": false,
  "tabable": {
    "view": "build-search",
    "label": "Build search",
    "icon": "search"
  },
  "lifecycle": {
    "$axf": "plugin-lifecycle@1",
    "dataDir": ".axf-console/plugins/build-search",
    "env": [],
    "mentions": [
      "apps/console-web/plugins/README.md",
      "_claude/THREADS.md"
    ]
  },
  "commands": {
    "$axf": "plugin-commands@1",
    "auto": true,
    "items": [
      {
        "route": "GET /search",
        "id": "search",
        "title": "Search builds, notes, reports and session logs",
        "description": "Every hit grouped per document, instances numbered 1, 2, 3…, icon by type. q: words, \"phrase\", /regex/, -word, type:log, build:<id>.",
        "readOnly": true
      },
      {
        "route": "GET /open",
        "id": "open",
        "title": "Open a document at a hit",
        "description": "The lines around a hit (`<doc id>#<line>`, e.g. log:<build>#42) with the hit line marked, plus the hit actions.",
        "readOnly": true
      },
      {
        "route": "POST /sources",
        "id": "source-add",
        "title": "Add a search source",
        "input": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "path": {
              "type": "string",
              "description": "file, folder or glob"
            },
            "type": {
              "type": "string",
              "description": "type shown on its hits (default file)"
            }
          },
          "required": [
            "name",
            "path"
          ]
        }
      },
      {
        "route": "POST /sources/remove",
        "id": "source-remove",
        "title": "Remove a search source",
        "input": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            }
          },
          "required": [
            "id"
          ]
        }
      },
      {
        "route": "POST /actions",
        "id": "action-add",
        "title": "Add a hit action",
        "input": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string"
            },
            "run": {
              "type": "string",
              "description": "console action, nav:<view> or https URL; {build} {line} {doc} {type} {n} {q} {text} {path}"
            },
            "types": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "icon": {
              "type": "string"
            }
          },
          "required": [
            "label",
            "run"
          ]
        }
      },
      {
        "route": "POST /actions/remove",
        "id": "action-remove",
        "title": "Remove a hit action",
        "input": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            }
          },
          "required": [
            "id"
          ]
        }
      },
      {
        "route": "PUT /settings",
        "id": "set",
        "title": "Change a Build search setting",
        "input": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "enum": [
                "maxHits",
                "maxPerDoc",
                "context",
                "snippet",
                "types"
              ]
            },
            "value": {}
          },
          "required": [
            "key",
            "value"
          ]
        }
      },
      {
        "route": "PUT /ai",
        "id": "ai-set",
        "title": "Turn Build search AI features on or off (off by default)",
        "input": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "required": [
            "enabled"
          ]
        }
      },
      {
        "route": "POST /command",
        "id": "command",
        "title": "Run a typed Build search command",
        "description": ">add source / remove source / add action / remove action / ai on|off / set / types / sources / actions / help",
        "input": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text"
          ]
        }
      }
    ]
  },
  "builtWith": {
    "model": "opus",
    "builtAt": "2026-11-10"
  },
  "help": "help.json",
  "opens": "main"
}
