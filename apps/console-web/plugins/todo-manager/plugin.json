{
  "$axf": "plugin@1",
  "id": "ai.amberx.axf.console.todo-manager",
  "name": "Todo manager",
  "version": "0.1.0",
  "kind": "module",
  "apiLevel": 1,
  "author": "Brett",
  "description": "Lists with nested groups holding notes, to-dos and tasks (subtasks, checklists, tags, due dates, custom fields per kind), shown as a tree (by lists, kind, status, priority, tag or due date) or a grid, with group actions and Markdown export. Ported from xGallery's developer task manager. Tabable: a host app can show it as a tab of its own. Every action is callable by name, without ids, through REST, MCP, the CLI and voice (voice.json: \"make a list called X\", \"add a note called Y to X\").",
  "targets": [
    "axf-console"
  ],
  "provides": [
    "view:todo-manager",
    "dialog:todo-manager.entry",
    "settings-tab:todo-manager"
  ],
  "scopes": [
    "ROUTES"
  ],
  "enabledByDefault": true,
  "optional": [],
  "banner": false,
  "tabable": {
    "view": "todo-manager",
    "label": "Todos",
    "icon": "list"
  },
  "commands": {
    "$axf": "plugin-commands@1",
    "auto": true,
    "items": [
      {
        "id": "by-name-list-create",
        "route": "POST /by-name/list-create",
        "title": "Make a list",
        "description": "Make a list by name (or return the one already called that). Voice: \"make a list called X\".",
        "input": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "description": "list name"
            },
            "parent": {
              "type": "string",
              "description": "put it inside this list (name)"
            }
          },
          "required": [
            "title"
          ]
        }
      },
      {
        "id": "by-name-list-rename",
        "route": "POST /by-name/list-rename",
        "title": "Rename a list",
        "description": "Rename a list found by name. Voice: \"rename the list X to Y\".",
        "input": {
          "type": "object",
          "properties": {
            "list": {
              "type": "string",
              "description": "current name"
            },
            "title": {
              "type": "string",
              "description": "new name"
            }
          },
          "required": [
            "list",
            "title"
          ]
        }
      },
      {
        "id": "by-name-list-move",
        "route": "POST /by-name/list-move",
        "title": "Move or reorder a list",
        "description": "Move a list to a position among its siblings (1 = first) or into another list ('top' = top level). Voice: \"move the list X to position 2\".",
        "input": {
          "type": "object",
          "properties": {
            "list": {
              "type": "string",
              "description": "list name"
            },
            "position": {
              "type": "integer",
              "minimum": 1
            },
            "parent": {
              "type": "string",
              "description": "list to nest it in, or top"
            }
          },
          "required": [
            "list"
          ]
        }
      },
      {
        "id": "by-name-list-delete",
        "route": "POST /by-name/list-delete",
        "title": "Delete a list",
        "description": "Delete a list with its groups and items, by name; needs confirm: true. Voice: \"delete the list X\" then \"… confirm\".",
        "input": {
          "type": "object",
          "properties": {
            "list": {
              "type": "string",
              "description": "list name"
            },
            "confirm": {
              "type": "boolean",
              "description": "true to really delete (asked first otherwise)"
            }
          },
          "required": [
            "list"
          ]
        }
      },
      {
        "id": "by-name-list-and-entry",
        "route": "POST /by-name/list-and-entry",
        "title": "Make a list with an item",
        "description": "Make a list (or use the one already called that) and add a note, to-do or task to it. Voice: \"make a new list called X and a note called Y\".",
        "input": {
          "type": "object",
          "properties": {
            "list": {
              "type": "string",
              "description": "list name"
            },
            "title": {
              "type": "string",
              "description": "item title"
            },
            "kind": {
              "type": "string",
              "enum": [
                "note",
                "todo",
                "task"
              ],
              "description": "note (default), todo or task"
            }
          },
          "required": [
            "list",
            "title"
          ]
        }
      },
      {
        "id": "by-name-entry-add",
        "route": "POST /by-name/entry-add",
        "title": "Add a note, to-do or task",
        "description": "Add an item to a list found by name. Voice: \"add a note called Y to X\".",
        "input": {
          "type": "object",
          "properties": {
            "list": {
              "type": "string",
              "description": "list name"
            },
            "title": {
              "type": "string",
              "description": "item title"
            },
            "kind": {
              "type": "string",
              "enum": [
                "note",
                "todo",
                "task"
              ],
              "description": "note (default), todo or task"
            },
            "body": {
              "type": "string",
              "description": "text"
            },
            "under": {
              "type": "string",
              "description": "nest under this item (title)"
            }
          },
          "required": [
            "list",
            "title"
          ]
        }
      },
      {
        "id": "by-name-entry-edit",
        "route": "POST /by-name/entry-edit",
        "title": "Edit an item",
        "description": "Change an item's title, text, status, priority or kind, found by title (list narrows it). Voice: \"rename X to Y\", \"set X priority to high\".",
        "input": {
          "type": "object",
          "properties": {
            "entry": {
              "type": "string",
              "description": "item title"
            },
            "list": {
              "type": "string",
              "description": "list name"
            },
            "title": {
              "type": "string",
              "description": "new title"
            },
            "body": {
              "type": "string",
              "description": "new text"
            },
            "status": {
              "type": "string",
              "description": "open, in_progress, blocked or done"
            },
            "priority": {
              "type": "string",
              "description": "low, normal, high or urgent"
            },
            "kind": {
              "type": "string",
              "enum": [
                "note",
                "todo",
                "task"
              ],
              "description": "note (default), todo or task"
            }
          },
          "required": [
            "entry"
          ]
        }
      },
      {
        "id": "by-name-entry-move",
        "route": "POST /by-name/entry-move",
        "title": "Move an item",
        "description": "Move an item (with its subtasks) to another list. Voice: \"move X to Y\".",
        "input": {
          "type": "object",
          "properties": {
            "entry": {
              "type": "string",
              "description": "item title"
            },
            "to": {
              "type": "string",
              "description": "target list"
            },
            "from": {
              "type": "string",
              "description": "list it is in now"
            }
          },
          "required": [
            "entry",
            "to"
          ]
        }
      },
      {
        "id": "by-name-entry-complete",
        "route": "POST /by-name/entry-complete",
        "title": "Complete an item",
        "description": "Mark an item done (done: false reopens it). Voice: \"mark X done\", \"reopen X\".",
        "input": {
          "type": "object",
          "properties": {
            "entry": {
              "type": "string",
              "description": "item title"
            },
            "list": {
              "type": "string",
              "description": "list name"
            },
            "done": {
              "type": "boolean"
            }
          },
          "required": [
            "entry"
          ]
        }
      },
      {
        "id": "by-name-entry-delete",
        "route": "POST /by-name/entry-delete",
        "title": "Delete an item",
        "description": "Delete an item and everything under it; needs confirm: true. Voice: \"delete X\" then \"… confirm\".",
        "input": {
          "type": "object",
          "properties": {
            "entry": {
              "type": "string",
              "description": "item title"
            },
            "list": {
              "type": "string",
              "description": "list name"
            },
            "confirm": {
              "type": "boolean",
              "description": "true to really delete (asked first otherwise)"
            }
          },
          "required": [
            "entry"
          ]
        }
      },
      {
        "id": "by-name-find",
        "route": "GET /by-name/find",
        "title": "Search items",
        "description": "Search notes, to-dos and tasks (title, text, tags), each with its list's name. Voice: \"find tasks about X\".",
        "input": {
          "type": "object",
          "properties": {
            "q": {
              "type": "string",
              "description": "words"
            },
            "kind": {
              "type": "string",
              "enum": [
                "note",
                "todo",
                "task"
              ],
              "description": "note (default), todo or task"
            },
            "status": {
              "type": "string",
              "description": "open, in_progress, blocked or done"
            }
          }
        }
      },
      {
        "id": "by-name-lists-read",
        "route": "GET /by-name/lists-read",
        "title": "Read lists",
        "description": "Every list, or what is in one list (by name). Voice: \"what's in X\", \"what lists do I have\".",
        "input": {
          "type": "object",
          "properties": {
            "list": {
              "type": "string",
              "description": "list name (empty = every list)"
            }
          }
        }
      },
      {
        "id": "by-name-export",
        "route": "GET /by-name/export",
        "title": "Export a list",
        "description": "A list as Markdown, by name. Voice: \"export the list X\".",
        "input": {
          "type": "object",
          "properties": {
            "list": {
              "type": "string",
              "description": "list name"
            }
          },
          "required": [
            "list"
          ]
        }
      },
      {
        "id": "voice",
        "route": "POST /voice",
        "title": "Say a Todo manager phrase",
        "description": "Run a spoken phrase (voice.json): make / rename / move / delete lists, add / edit / move / complete / delete items, find, read, export. Answers with say. The console's voice endpoint (console_control_voice) forwards these phrases here.",
        "input": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "description": "what was said"
            },
            "confirm": {
              "type": "boolean",
              "description": "confirm a delete"
            }
          },
          "required": [
            "text"
          ]
        }
      }
    ]
  },
  "builtWith": {
    "model": "opus",
    "builtAt": "2026-10-22"
  },
  "lifecycle": {
    "$axf": "plugin-lifecycle@1",
    "dataDir": ".axf-console/plugins/todo-manager",
    "env": [
      "AXF_TODO_DIR"
    ],
    "mentions": [
      "CLAUDE.md",
      "_claude/memory/STATUS.md",
      "apps/console-web/plugins/README.md",
      "framework/cli/project-seed.mjs",
      "framework/cli/project_seed_stores.py"
    ]
  },
  "opens": "main"
}
