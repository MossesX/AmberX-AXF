{
  "$axf": "asset@1",
  "type": "toolbar",
  "id": "chat-viewer",
  "name": "Chats",
  "version": "1.0.0",
  "description": "The chat viewer toolbar: sync every session source now, search every message, and export the open session as Markdown. Runs the chat viewer's own sync, search and export routes.",
  "author": "AmberX AXF",
  "tags": [
    "page",
    "chat-viewer",
    "chats"
  ],
  "data": {
    "scope": "view:chat-viewer",
    "variant": "icons-labels",
    "align": "start",
    "showSearch": false,
    "overflow": {
      "when": "auto",
      "keep": 1,
      "label": "More"
    },
    "groups": [
      {
        "id": "chats",
        "label": "Chats",
        "items": [
          {
            "id": "sync",
            "icon": "refresh",
            "label": "Sync chats",
            "action": "handler:chat-viewer.sync",
            "badge": "state:unseen",
            "enabledWhen": "!syncing",
            "priority": 300,
            "overflow": "never"
          },
          {
            "id": "search",
            "icon": "search",
            "label": "Search",
            "action": "handler:chat-viewer.search",
            "checked": "state:searching",
            "priority": 260
          },
          {
            "id": "export",
            "icon": "download",
            "label": "Export",
            "action": "handler:chat-viewer.export",
            "enabledWhen": "open.id",
            "priority": 200
          }
        ]
      }
    ],
    "builtFor": "view:chat-viewer"
  }
}
