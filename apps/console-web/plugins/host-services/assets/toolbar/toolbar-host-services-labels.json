{
 "$axf": "asset@1",
 "type": "toolbar",
 "id": "toolbar-host-services-labels",
 "name": "toolbar-host-services: Icons + labels, overflow (default)",
 "version": "0.1.0",
 "author": "UI Review choices",
 "description": "Refresh and Open all in a List group, Restart down services in a Fix group, icon + label buttons, the rest folds into More when the row is short. The default (asset host-services).",
 "tags": [
  "ui-choice",
  "choice-set:toolbar-host-services",
  "choice-option:labels"
 ],
 "data": {
  "scope": "view:host-services",
  "variant": "icons-labels",
  "align": "start",
  "showSearch": false,
  "overflow": {
   "when": "auto",
   "keep": 2,
   "label": "More"
  },
  "groups": [
   {
    "id": "list",
    "label": "List",
    "items": [
     {
      "id": "refresh",
      "icon": "refresh",
      "label": "Refresh",
      "action": "handler:host-services.refresh",
      "badge": "state:services",
      "priority": 300,
      "overflow": "never"
     },
     {
      "id": "expand",
      "icon": "list",
      "label": "Open all",
      "action": "handler:host-services.expand-all",
      "priority": 200
     }
    ]
   },
   {
    "id": "fix",
    "label": "Fix",
    "items": [
     {
      "id": "restart-down",
      "icon": "zap",
      "label": "Restart down services",
      "action": "handler:host-services.restart-down",
      "badge": "state:down",
      "enabledWhen": "down>0",
      "confirm": "Restart every host service that is down or limping?",
      "priority": 280
     }
    ]
   }
  ]
 }
}