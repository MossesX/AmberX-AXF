{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amberxai.com/schemas/plan@1.json",
  "title": "plan@1 (Plan Studio)",
  "description": "One plan: JSON with a Markdown body. Readers keep unknown fields. Older shapes (plan@0, pending@1 items, loose notes) are migrated on read by web/plan-core.mjs normalize(). Effort and cost are summed from the steps.",
  "type": "object",
  "required": ["$axf", "id", "title", "status", "priority", "steps"],
  "additionalProperties": true,
  "$defs": {
    "text": { "type": "object", "required": ["text"], "properties": { "text": { "type": "string", "maxLength": 2000 } }, "additionalProperties": true },
    "status": { "enum": ["idea", "draft", "parked", "ready", "building", "done", "dropped"] }
  },
  "properties": {
    "$axf": { "const": "plan@1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "summary": { "type": "string" }, "goal": { "type": "string" }, "why": { "type": "string" },
    "category": { "type": "string", "description": "A category path, parts joined by \" > \" (\"Framework > Docs\")" },
    "tags": { "type": "array", "items": { "type": "string", "maxLength": 40 } },
    "project": { "type": "string", "description": "project-manifest@1 name" },
    "touches": { "type": "array", "items": { "type": "object", "required": ["key"], "properties": { "key": { "type": "string", "description": "Catalog key: plugin:<folder> | app:<project> | library:<id> | module:<name> | service:<id>" } } } },
    "profile": { "type": "string", "description": "build-profiles@1 id" },
    "status": { "$ref": "#/$defs/status" },
    "priority": { "enum": ["P0", "P1", "P2", "P3"] },
    "effort": { "type": "object", "properties": { "minutes": { "type": "integer", "minimum": 0 }, "left": { "type": "integer", "minimum": 0 } } },
    "cost": { "type": "object", "properties": { "usd": { "type": "number", "minimum": 0 }, "estimated": { "type": "boolean" } } },
    "targetDate": { "type": "string", "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$" },
    "owner": { "type": "string" },
    "steps": { "type": "array", "items": { "type": "object", "required": ["id", "text", "model"], "properties": {
      "id": { "type": "string" }, "text": { "type": "string", "minLength": 1 }, "model": { "enum": ["Fable", "Opus", "Sonnet"] },
      "minutes": { "type": "integer", "minimum": 0 }, "dependsOn": { "type": "array", "items": { "type": "string" } },
      "done": { "type": "boolean" }, "doneAt": { "type": "string" }, "phase": { "type": "string" } } } },
    "requirements": { "type": "array", "items": { "$ref": "#/$defs/text" } },
    "acceptance": { "type": "array", "items": { "allOf": [{ "$ref": "#/$defs/text" }, { "properties": { "done": { "type": "boolean" } } }] } },
    "decisions": { "type": "array", "items": { "$ref": "#/$defs/text" } },
    "questions": { "type": "array", "items": { "allOf": [{ "$ref": "#/$defs/text" }, { "properties": { "answer": { "type": "string" } } }] } },
    "risks": { "type": "array", "items": { "allOf": [{ "$ref": "#/$defs/text" }, { "properties": { "mitigation": { "type": "string" } } }] } },
    "outOfScope": { "type": "array", "items": { "$ref": "#/$defs/text" } },
    "links": { "type": "array", "items": { "type": "object", "required": ["kind", "ref"], "properties": { "kind": { "enum": ["depends", "blocks", "part-of", "related", "pr", "branch", "build", "doc", "url"] }, "ref": { "type": "string", "minLength": 1 }, "label": { "type": "string" } } } },
    "features": { "type": "array", "items": { "type": "object", "required": ["entry", "state"], "properties": { "entry": { "type": "string" }, "feature": { "type": "string" }, "title": { "type": "string" }, "state": { "enum": ["have", "partial", "planned", "idea"] } } } },
    "attachments": { "type": "array", "items": { "type": "object", "required": ["id", "kind"], "properties": { "id": { "type": "string" }, "kind": { "enum": ["image", "file", "voice"] }, "name": { "type": "string" }, "url": { "type": "string" }, "size": { "type": "number" }, "transcript": { "type": "string" } } } },
    "body": { "type": "string", "description": "Markdown" },
    "comments": { "type": "array", "items": { "type": "object", "required": ["id", "text"], "properties": { "id": { "type": "string" }, "by": { "type": "string" }, "at": { "type": "string" }, "text": { "type": "string" } } } },
    "build": { "type": ["object", "null"], "properties": { "profile": { "type": "string" }, "id": { "type": "string" }, "linkedAt": { "type": "string" }, "status": { "type": "string" }, "progress": { "type": "integer" }, "landedCommit": { "type": "string" }, "landedAt": { "type": "string" }, "shipped": { "type": "object", "properties": { "id": { "type": "string" }, "rev": { "type": "integer" }, "at": { "type": "string" }, "source": { "type": "string" } } } } },
    "origin": { "type": ["object", "null"], "description": "build-origin@1: the words that started the build, verbatim unless verbatim is false", "properties": { "said": { "type": "string" }, "verbatim": { "type": "boolean" }, "at": { "type": "string" }, "source": { "type": "string" }, "by": { "type": "string" }, "addenda": { "type": "array" } } },
    "shipped": { "type": ["object", "null"], "description": "The shipped-manifest@1 the orchestrator sent when the build landed (framework/schemas/json/shipped-manifest.schema.json); set only after it validated", "$ref": "https://amberx.ai/axf/schemas/shipped-manifest.schema.json" },
    "shippedProblem": { "type": ["object", "null"], "description": "The last shipped manifest refused for this plan: field errors from the shared schema module", "properties": { "at": { "type": "string" }, "id": { "type": "string" }, "rev": { "type": "integer" }, "source": { "type": "string" }, "by": { "type": "string" }, "reason": { "type": "string" }, "errors": { "type": "array", "items": { "type": "object", "properties": { "field": { "type": "string" }, "message": { "type": "string" } } } } } },
    "actual": { "type": ["object", "null"], "description": "What the build really cost (from the shipped manifest); cost stays the estimate summed from the steps", "properties": { "usd": { "type": "number" }, "estimated": { "type": "boolean" }, "tokens": { "type": "object" }, "minutes": { "type": "integer" }, "estimateMinutes": { "type": "integer" }, "runs": { "type": "integer" }, "models": { "type": "array" }, "accounts": { "type": "array" } } },
    "createdAt": { "type": "string" }, "updatedAt": { "type": "string" }, "createdBy": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 }
  }
}
