{
  "$axf": "asset@1",
  "type": "toolbar",
  "id": "toolbar-plan-studio-plans-dense",
  "name": "Plans: Dense icons",
  "version": "0.1.0",
  "author": "UI Review choices",
  "description": "Icons only: every button on one short bar; the names are in the tooltips and the API.",
  "tags": [
    "ui-choice",
    "choice-set:toolbar-plan-studio-plans",
    "choice-option:dense"
  ],
  "data": {
    "scope": "view:plan-studio",
    "variant": "icons",
    "align": "start",
    "showSearch": false,
    "overflow": {
      "when": "auto",
      "keep": 0,
      "label": "More"
    },
    "groups": [
      {
        "id": "plans",
        "label": "Plans",
        "items": [
          {
            "id": "new",
            "icon": "plus",
            "label": "New plan",
            "action": "handler:plan-studio.new",
            "priority": 300,
            "overflow": "never"
          },
          {
            "id": "search",
            "icon": "search",
            "label": "Search",
            "action": "handler:plan-studio.search",
            "checked": "state:searching",
            "priority": 280
          }
        ]
      },
      {
        "id": "selected",
        "label": "Selected plans",
        "items": [
          {
            "id": "park",
            "icon": "clock",
            "label": "Park",
            "action": "handler:plan-studio.park",
            "enabledWhen": "selection.count>0",
            "badge": "state:selection.count",
            "priority": 250
          },
          {
            "id": "build",
            "icon": "play",
            "label": "Turn into a build",
            "action": "handler:plan-studio.build",
            "enabledWhen": [
              "selection.count=1",
              "selection.steps>0"
            ],
            "confirm": "Add this plan to the build orchestrator as a build?",
            "priority": 220
          },
          {
            "id": "category",
            "icon": "folder",
            "label": "Move category",
            "action": "handler:plan-studio.move-category",
            "enabledWhen": "selection.count>0",
            "priority": 200
          },
          {
            "id": "media",
            "icon": "upload",
            "label": "Attach media",
            "action": "handler:plan-studio.attach-media",
            "enabledWhen": "selection.count=1",
            "priority": 180
          }
        ]
      }
    ],
    "builtFor": "view:plan-studio"
  }
}
