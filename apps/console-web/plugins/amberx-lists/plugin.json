{
  "$axf": "plugin@1",
  "id": "ai.amberx.axf.console.amberx-lists",
  "name": "AmberX lists",
  "version": "0.1.0",
  "kind": "module",
  "apiLevel": 1,
  "author": "Brett",
  "description": "The AmberX web app's Lists screen on the console (Apps \u2192 AmberX \u2192 Lists): the amberx-notes@1 list tree with counts; make, rename, move and delete lists (system lists are kept, deletes confirm); add, edit, tick off and delete the items in a list; export a list as Markdown; through control@1 amberx.lists / amberx.items. Deep link console_open(\"amberx-lists\", focus=\"<list id>\" | \"new\"). REST /api/plugins/amberx-lists and /api/control/amberx.lists; MCP amberx-lists_* and control_*; CLI axf amberx-lists \u2026 and axf list \u2026; voice \"open lists\", \"make a new list\".",
  "targets": [
    "axf-console"
  ],
  "provides": [
    "view:amberx-lists",
    "settings-tab:amberx-lists",
    "action:amberx-lists.open",
    "action:amberx-lists.focus"
  ],
  "optional": [
    "control@1"
  ],
  "scopes": [
    "ROUTES"
  ],
  "enabledByDefault": true,
  "banner": false,
  "tabable": {
    "view": "amberx-lists",
    "label": "Lists",
    "icon": "list"
  },
  "lifecycle": {
    "$axf": "plugin-lifecycle@1",
    "dataDir": ".axf-console/plugins/amberx-lists",
    "env": [
      "AXF_AMBERX_LISTS_DATA_DIR"
    ],
    "mentions": [
      "docs/contracts/amberx-console-api.md",
      "_claude/THREADS.md"
    ],
    "keeps": [
      "/projects/amberx-axf/_data/amberx-notes on axHub: every list and its items (AmberX's own, read and written through control@1)"
    ]
  },
  "commands": {
    "$axf": "plugin-commands@1",
    "auto": true,
    "items": [
      {
        "route": "GET /state",
        "id": "state",
        "title": "Every AmberX list (tree order, path, item count) and the page settings",
        "readOnly": true
      },
      {
        "route": "GET /list",
        "id": "list",
        "title": "One list and the items in it",
        "readOnly": true,
        "input": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        }
      },
      {
        "route": "GET /export",
        "id": "export",
        "title": "One list as Markdown",
        "readOnly": true,
        "input": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        }
      },
      {
        "route": "POST /lists/add",
        "id": "add-list",
        "title": "Make a list (optionally inside another)",
        "input": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "parent": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        }
      },
      {
        "route": "POST /lists/rename",
        "id": "rename-list",
        "title": "Rename a list",
        "input": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "name"
          ],
          "additionalProperties": false
        }
      },
      {
        "route": "POST /lists/move",
        "id": "move-list",
        "title": "Move a list inside another (parent null = top level)",
        "input": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "parent": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        }
      },
      {
        "route": "POST /lists/remove",
        "id": "remove-list",
        "title": "Delete a list and its items: the first call answers a confirm token, repeat with confirm",
        "input": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "confirm": {
              "type": "string"
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        }
      },
      {
        "route": "POST /items/add",
        "id": "add-item",
        "title": "Add an item to a list",
        "input": {
          "type": "object",
          "properties": {
            "list": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "todo",
                "note",
                "task"
              ]
            }
          },
          "required": [
            "list",
            "text"
          ],
          "additionalProperties": false
        }
      },
      {
        "route": "POST /items/edit",
        "id": "edit-item",
        "title": "Change a list item's words",
        "input": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        }
      },
      {
        "route": "POST /items/check",
        "id": "check-item",
        "title": "Tick a list item off (done false unticks it)",
        "input": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "done": {
              "type": "boolean"
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        }
      },
      {
        "route": "POST /items/remove",
        "id": "remove-item",
        "title": "Delete a list item: the first call answers a confirm token, repeat with confirm",
        "input": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "confirm": {
              "type": "string"
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        }
      },
      {
        "route": "GET /settings",
        "id": "settings",
        "title": "The Lists screen's settings and their defaults",
        "readOnly": true
      },
      {
        "route": "PUT /settings",
        "id": "set-settings",
        "title": "Change Lists screen settings (itemKind todo|note, showChecked, checkedLast, showEmpty)",
        "input": {
          "type": "object",
          "properties": {
            "itemKind": {
              "type": "string",
              "enum": [
                "todo",
                "note"
              ]
            },
            "showChecked": {
              "type": "boolean"
            },
            "checkedLast": {
              "type": "boolean"
            },
            "showEmpty": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      {
        "route": "POST /settings/reset",
        "id": "reset-settings",
        "title": "Put the Lists screen's settings back to the defaults"
      },
      {
        "route": "POST /control",
        "skip": "the page's own control@1 relay: MCP and the CLI call control_* and axf list directly"
      }
    ]
  },
  "builtWith": {
    "model": "opus",
    "builtAt": "2026-11-12"
  },
  "help": "help.json",
  "opens": "main"
}
