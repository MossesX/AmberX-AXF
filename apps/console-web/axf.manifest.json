{
  "$axf": "manifest@1",
  "app": {
    "id": "axf-console",
    "name": "AXF Dev Console",
    "version": "0.1.0"
  },
  "framework": {
    "version": "0.2.0",
    "template": "react-ts"
  },
  "initializedAt": "2026-10-17T00:48:36.789Z",
  "targets": [
    "web"
  ],
  "startView": "home",
  "defaults": {
    "color-theme": "fresh-light",
    "style-theme": "fresh",
    "layout": "focus-top",
    "behavior-theme": "standard",
    "app-menu": "console",
    "toolbar": "standard-icons",
    "nav-menu": "console-nav",
    "context-menu": "amber",
    "tab-group": "underline",
    "dialog": "centered-modal",
    "popup": "corner-solid",
    "button": "rounded-solid",
    "slider": "classic-round",
    "container": "soft-card",
    "gauge": "classic-arc",
    "meter": "striped-pill",
    "settings": "console",
    "banner": "amberx-thin",
    "clock": "digital-12h",
    "search-bar": "everything",
    "logo": "wordmark",
    "action-button": "settings",
    "label": "version",
    "status": "online",
    "counter": "alerts",
    "progress": "build",
    "avatar": "account",
    "link": "docs",
    "theme-switch": "fresh-day-night",
    "spacer": "gap",
    "divider": "rule",
    "badge": "new",
    "uac-policy": "standard",
    "design-package": "fresh",
    "branding": "gizmox"
  },
  "hidden": [
    "toolbar",
    "nav-menu"
  ],
  "structure": [
    {
      "path": "axf.manifest.json",
      "purpose": "App identity, framework version and the default asset for every slot."
    },
    {
      "path": "axf.lock.json",
      "purpose": "Hashes of the baked framework files, used for conformance checks."
    },
    {
      "path": "src/axf",
      "purpose": "Baked framework runtime: engines, React layer and base CSS. Managed by the build engine."
    },
    {
      "path": "src/assets",
      "purpose": "Hot-swappable assets, one folder per asset type."
    },
    {
      "path": "src/views",
      "purpose": "App views registered with the shell."
    },
    {
      "path": "src/actions.ts",
      "purpose": "Handlers bound to the standard action vocabulary."
    },
    {
      "path": "src/dialogs.tsx",
      "purpose": "App-specific dialogs opened through the dialog engine."
    },
    {
      "path": "public",
      "purpose": "Static files served as-is."
    }
  ],
  "options": {
    "wrap-groups": true
  }
}
