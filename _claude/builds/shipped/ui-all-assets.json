 "build": {
  "id": "ui-all-assets",
  "title": "One place changes everything: typography, density and component-sizing assets that every app and plugin reads",
  "profile": "all",
  "category": "Framework",
  "priority": "",
  "repo": "amberx-axf"
 },
 "said": {
  "text": "three broad asset types instead of one per piece — typography (text sizes, weights, line spacing), density (spacing, padding, row heights, gaps; compact vs roomy is one pick), component sizing (page heads, list rows, chips, count strips, tables). Each app gets one update to read them; after that every change comes live from axHub. Includes moving the Oct 30 compact frame (axf.css compact block, settings compact CSS, console count strips) and the MCP servers pages (framework/libs/mcp) onto them. Profile: Angel. Android twins deferred.",
  "verbatim": false,
  "at": "",
  "source": "voice",
  "by": "backfill",
  "addenda": []
 },
 "brief": "",
 "models": [
  "Fable",
  "Opus"
 ],
