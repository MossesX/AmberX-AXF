    "wait": 7000
   },
   {
    "eval": "AXF.dispatch('md-studio.edit:repo:README.md')",
    "wait": 7000
   }
  ]
 },
 {
  "name": "md-studio-ide",
  "steps": [
   {
    "eval": "AXF.navigate('md-studio')",
    "wait": 5000
   },
   {
    "eval": "AXF.dispatch('md-studio.view:ide')",
    "wait": 7000
