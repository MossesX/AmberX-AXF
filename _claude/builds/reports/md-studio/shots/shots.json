 },
 {
  "name": "md-studio-context",
  "steps": [
   {
    "eval": "AXF.navigate('md-studio')",
    "wait": 5000
   },
   {
    "eval": "AXF.dispatch('md-studio.context:repo:CLAUDE.md')",
    "wait": 7000
