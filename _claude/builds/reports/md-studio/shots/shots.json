 },
 {
  "name": "md-studio-wizards",
  "steps": [
   {
    "eval": "AXF.navigate('md-studio')",
    "wait": 5000
   },
   {
    "eval": "document.querySelector('.axp-md-studio__drawer')?.setAttribute('open','')",
    "wait": 300
   },
   {
    "eval": "[...document.querySelectorAll('.fx-seg__opt')].find((b) => b.textContent.trim() === 'Wizards')?.click()",
    "wait": 600
   },
   {
    "eval": "[...document.querySelectorAll('.fx-nav__item')].find((b) => b.textContent.includes('Rules file'))?.click()",
    "wait": 800
   }
  ]
 },
 {
  "name": "md-studio-settings",
  "steps": [
