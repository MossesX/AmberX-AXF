[
 {
  "name": "md-studio-browse",
  "steps": [
   {
    "eval": "AXF.navigate('md-studio')",
    "wait": 5000
   },
   {
    "eval": "document.querySelector('.axp-md-studio__drawer')?.setAttribute('open','')",
    "wait": 300
   },
   {
    "eval": "AXF.dispatch('md-studio.open:repo:CLAUDE.md')",
    "wait": 7000
   }
  ]
 },
 {
