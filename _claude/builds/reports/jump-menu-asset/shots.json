      { "eval": "(() => { const el = document.querySelector('[data-axf-jump=\"plan-studio.plan\"] .fx-jump__item'); const r = el.getBoundingClientRect(); el.dispatchEvent(new MouseEvent('contextmenu', { bubbles: true, cancelable: true, clientX: r.left + 20, clientY: r.top + 10 })); })()" }, { "wait": 1200 }
    ]
  },
  {
    "name": "jump-menu-settings-dialog",
    "steps": [
      { "wait": 15000 }, { "eval": "location.reload()" }, { "wait": 20000 },
