  "name": "opt-status-first--auto-lander",
  "steps": [
   {
    "eval": "(async()=>{localStorage.setItem(\"axf-console:auto-lander-view\",JSON.stringify(\"status-first\"));for(let i=0;i<120;i++){if(window.AXF&&AXF.dispatch(\"build-orchestrator.auto-lander\"))return true;await new Promise(r=>setTimeout(r,1000))}return false})()"
